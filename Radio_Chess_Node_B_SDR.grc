- name: epy_transfer_chat_gui
  id: epy_block
  parameters:
    _source_code: |
      """Embedded Python Block: chat GUI only, with command/event PDU ports."""
      import json
      from pathlib import Path
      import queue
      import threading
      from gnuradio import gr
      import pmt
      from PyQt5 import QtCore, QtGui, QtWidgets


      class _CommandOutput:
          def __init__(self, block):
              self.block = block

          def put_nowait(self, command):
              if command[0] == 'send':
                  value = dict(cmd='send', kind=command[1], value=command[2])
              elif command[0] == 'cancel':
                  value = dict(cmd='cancel')
              else:
                  raise ValueError('Unsupported GUI command')
              raw = json.dumps(value, ensure_ascii=True).encode('utf-8')
              self.block.message_port_pub(pmt.intern('command_out'),
                  pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))


      class blk(gr.basic_block):
          """Chat window; protocol work happens in a separate block."""

          def __init__(self, my_addr='A1', peer_addr='B1',
                       receive_dir='./received_A1', show_gui=True):
              gr.basic_block.__init__(self, name='Transfer Chat GUI', in_sig=None, out_sig=None)
              self.my_addr = my_addr
              self.peer_addr = peer_addr
              self.receive_dir = str(Path(receive_dir).expanduser().resolve())
              self.show_gui = bool(show_gui)
              self.commands = _CommandOutput(self)
              self.events = queue.Queue()
              self.halt = threading.Event()
              self.bridge = None
              self.message_port_register_in(pmt.intern('event_in'))
              self.message_port_register_out(pmt.intern('command_out'))
              self.set_msg_handler(pmt.intern('event_in'), self._receive_event)

          def _receive_event(self, msg):
              if not pmt.is_pair(msg) or not pmt.is_u8vector(pmt.cdr(msg)):
                  return
              try:
                  raw = bytes(pmt.u8vector_elements(pmt.cdr(msg)))
                  if len(raw) <= 524288:
                      self.events.put_nowait(json.loads(raw.decode('utf-8')))
              except (ValueError, UnicodeError, queue.Full):
                  pass

          def start(self):
              self.halt.clear()
              if self.show_gui:
                  app = QtWidgets.QApplication.instance()
                  if app is None:
                      print('[Transfer GUI] Set Options > Generate Options = QT GUI')
                      return False
                  self.bridge = _WindowBridge(self)
                  self.bridge.moveToThread(app.thread())
                  self.bridge.open_requested.emit()
              return True

          def stop(self):
              self.halt.set()
              if self.bridge:
                  self.bridge.close_requested.emit()
              return True


      class _WindowBridge(QtCore.QObject):
          open_requested = QtCore.pyqtSignal()
          close_requested = QtCore.pyqtSignal()

          def __init__(self, block):
              super().__init__()
              self.block, self.window = block, None
              self.open_requested.connect(self.open_window, QtCore.Qt.QueuedConnection)
              self.close_requested.connect(self.close_window, QtCore.Qt.QueuedConnection)

          @QtCore.pyqtSlot()
          def open_window(self):
              if not self.block.halt.is_set():
                  self.window = _TransferWindow(self.block)
                  self.window.show()

          @QtCore.pyqtSlot()
          def close_window(self):
              if self.window:
                  self.window.timer.stop()
                  self.window.allow_close = True
                  self.window.close()
                  self.window.deleteLater()
                  self.window = None


      class _TransferWindow(QtWidgets.QWidget):
          """Chat view only. Packet handling stays in _TransferCore."""
          def __init__(self, block):
              super().__init__()
              self.block, self.allow_close = block, False
              self.tx_bubble = self.rx_bubble = None
              self.messages = []
              self.setWindowTitle('Chat | %s → %s' % (block.my_addr, block.peer_addr))
              self.resize(570, 780)
              self.setMinimumSize(440, 540)
              self.setStyleSheet('''
                  QWidget { color:#173b32; font-family:Sans; font-size:14px; }
                  QWidget#chat, QWidget#historyBody { background:#f3f1eb; }
                  QFrame#header, QFrame#composer { background:white; }
                  QLabel { background:transparent; }
                  QLabel#avatar { background:#128c7e; color:white; border-radius:23px;
                      font-size:18px; font-weight:600; }
                  QLabel#name { font-size:18px; font-weight:600; }
                  QLabel#secondary { color:#77847e; font-size:11px; }
                  QLabel#day { color:#7b8780; font-size:11px; padding:10px; }
                  QFrame#sent { background:#d9fdd3; border:1px solid #ccecc6; border-radius:14px; }
                  QFrame#received { background:white; border:1px solid #e1e6e2; border-radius:14px; }
                  QPlainTextEdit { background:#f4f6f4; border:1px solid #e7ebe7;
                      border-radius:20px; padding:8px; font-size:14px; }
                  QPushButton,QToolButton { background:#e8f3ed; border:0; border-radius:16px;
                      padding:8px 12px; color:#16785c; }
                  QPushButton:hover,QToolButton:hover { background:#d1eadd; }
                  QPushButton#send { background:#128c7e; color:white; font-weight:600; }
                  QToolButton#attach { background:transparent; font-size:28px; padding:0; }
                  QToolButton::menu-indicator { image:none; }
                  QPushButton:disabled,QToolButton:disabled { color:#a4b8ac; background:#e7ede8; }
                  QPushButton#file { background:transparent; text-align:left; padding:5px 0; }
                  QPushButton#cancel { background:transparent; color:#886958; padding:2px; font-size:11px; }
                  QMenu { background:white; border:1px solid #d7e3da; padding:6px; }
                  QMenu::item { padding:9px 22px; }
                  QMenu::item:selected { background:#e6f4eb; }
                  QProgressBar { background:#e7eae1; border:0; border-radius:3px; }
                  QProgressBar::chunk { background:#20a47d; border-radius:3px; }
                  QScrollArea { background:transparent; border:0; }
                  QScrollBar:vertical { width:6px; background:transparent; }
                  QScrollBar::handle:vertical { background:#cdd6cc; border-radius:3px; min-height:24px; }
                  QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical { height:0; }
              ''')
              self.setObjectName('chat')
              root = QtWidgets.QVBoxLayout(self)
              root.setContentsMargins(0, 0, 0, 0)
              root.setSpacing(0)

              header = QtWidgets.QFrame()
              header.setObjectName('header')
              top = QtWidgets.QHBoxLayout(header)
              top.setContentsMargins(20, 16, 18, 16)
              avatar = QtWidgets.QLabel(block.peer_addr)
              avatar.setObjectName('avatar')
              avatar.setAlignment(QtCore.Qt.AlignCenter)
              avatar.setFixedSize(46, 46)
              top.addWidget(avatar)
              contact = QtWidgets.QVBoxLayout()
              contact.setSpacing(4)
              name = QtWidgets.QLabel('Chat with ' + block.peer_addr)
              name.setObjectName('name')
              subtitle = QtWidgets.QLabel('Your node: ' + block.my_addr)
              subtitle.setObjectName('secondary')
              contact.addWidget(name)
              contact.addWidget(subtitle)
              top.addLayout(contact, 1)
              files = QtWidgets.QPushButton('Received files')
              files.clicked.connect(self.open_folder)
              top.addWidget(files)
              root.addWidget(header)

              self.scroll = QtWidgets.QScrollArea()
              self.scroll.setWidgetResizable(True)
              self.scroll.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarAlwaysOff)
              body = QtWidgets.QWidget()
              body.setObjectName('historyBody')
              self.history = QtWidgets.QVBoxLayout(body)
              self.history.setContentsMargins(16, 4, 16, 14)
              self.history.setSpacing(12)
              self.history.setSizeConstraint(QtWidgets.QLayout.SetMinAndMaxSize)
              day = QtWidgets.QLabel('TODAY')
              day.setObjectName('day')
              day.setAlignment(QtCore.Qt.AlignCenter)
              self.history.addWidget(day)
              self.history.addStretch(1)
              self.scroll.setWidget(body)
              root.addWidget(self.scroll, 1)

              composer = QtWidgets.QFrame()
              composer.setObjectName('composer')
              controls = QtWidgets.QVBoxLayout(composer)
              controls.setContentsMargins(12, 12, 16, 9)
              row = QtWidgets.QHBoxLayout()
              row.setSpacing(8)
              self.attach = QtWidgets.QToolButton()
              self.attach.setObjectName('attach')
              self.attach.setText('+')
              self.attach.setToolTip('Send an image or audio file')
              self.attach.setAccessibleName('Attach image or audio file')
              self.attach.setFixedSize(38, 44)
              menu = QtWidgets.QMenu(self.attach)
              menu.addAction('Image…', lambda: self.choose('image'))
              menu.addAction('Audio file…', lambda: self.choose('audio'))
              self.attach.setMenu(menu)
              self.attach.setPopupMode(QtWidgets.QToolButton.InstantPopup)
              self.text = QtWidgets.QPlainTextEdit()
              self.text.setPlaceholderText('Type a message…')
              self.text.setFixedHeight(60)
              self.text.installEventFilter(self)
              self.send_button = QtWidgets.QPushButton('Send')
              self.send_button.setObjectName('send')
              self.send_button.setFixedSize(68, 44)
              self.send_button.clicked.connect(self.send_text)
              row.addWidget(self.attach)
              row.addWidget(self.text, 1)
              row.addWidget(self.send_button)
              controls.addLayout(row)
              self.hint = QtWidgets.QLabel('Enter to send · Shift+Enter for a new line')
              self.hint.setObjectName('secondary')
              self.hint.setAlignment(QtCore.Qt.AlignCenter)
              self.hint.setWordWrap(True)
              controls.addWidget(self.hint)
              root.addWidget(composer)
              self.timer = QtCore.QTimer(self)
              self.timer.timeout.connect(self.poll)
              self.timer.start(50)

          def eventFilter(self, obj, event):
              if obj is self.text and event.type() == QtCore.QEvent.KeyPress:
                  if event.key() in (QtCore.Qt.Key_Return, QtCore.Qt.Key_Enter):
                      if not event.modifiers() & QtCore.Qt.ShiftModifier:
                          self.send_text()
                          return True
              return super().eventFilter(obj, event)

          def send_text(self):
              if self.send_button.isEnabled() and self.text.toPlainText().strip():
                  if self.submit('text', self.text.toPlainText()):
                      self.text.clear()

          def choose(self, kind):
              filters = ('Images (*.png *.jpg *.jpeg *.bmp *.gif *.webp);;All files (*)'
                         if kind == 'image' else
                         'Audio (*.wav *.mp3 *.ogg *.flac *.m4a *.aac);;All files (*)')
              path, _ = QtWidgets.QFileDialog.getOpenFileName(self, 'Choose ' + kind + ' to send', '', filters)
              if path:
                  self.submit(kind, path)

          def submit(self, kind, value):
              if self.tx_bubble is not None:
                  return False
              try:
                  self.block.commands.put_nowait(('send', kind, value))
              except queue.Full:
                  self.hint.setText('Please try again in a moment.')
                  return False
              caption = value if kind == 'text' else Path(value).name
              self.tx_bubble = self.add_bubble(True, kind, caption)
              if kind != 'text':
                  self.show_file(self.tx_bubble, value)
              self.set_busy(True)
              return True

          def add_bubble(self, outgoing, kind, caption):
              row = QtWidgets.QWidget()
              layout = QtWidgets.QHBoxLayout(row)
              layout.setContentsMargins(0, 0, 0, 0)
              card = QtWidgets.QFrame()
              card.setObjectName('sent' if outgoing else 'received')
              card.setMaximumWidth(max(260, int(self.width() * 0.73)))
              card.setSizePolicy(QtWidgets.QSizePolicy.Preferred, QtWidgets.QSizePolicy.Maximum)
              content = QtWidgets.QVBoxLayout(card)
              content.setContentsMargins(13, 11, 13, 9)
              content.setSpacing(7)
              label = QtWidgets.QLabel()
              label.setTextFormat(QtCore.Qt.PlainText)
              label.setText(caption[:4096] + ('\n[Preview shortened]' if len(caption) > 4096 else ''))
              label.setWordWrap(True)
              label.setTextInteractionFlags(QtCore.Qt.TextSelectableByMouse)
              label.setMinimumWidth(150)
              content.addWidget(label)
              preview = QtWidgets.QLabel()
              preview.setAlignment(QtCore.Qt.AlignCenter)
              preview.hide()
              content.addWidget(preview)
              open_button = QtWidgets.QPushButton('Play audio' if kind == 'audio' else 'Open file')
              open_button.setObjectName('file')
              open_button.hide()
              content.addWidget(open_button)
              progress = QtWidgets.QProgressBar()
              progress.setRange(0, 1000)
              progress.setValue(0)
              progress.setTextVisible(False)
              progress.setFixedHeight(5)
              content.addWidget(progress)
              footer = QtWidgets.QHBoxLayout()
              status = QtWidgets.QLabel('Preparing…' if outgoing else 'Receiving…')
              status.setObjectName('secondary')
              status.setTextFormat(QtCore.Qt.PlainText)
              status.setWordWrap(True)
              footer.addWidget(status, 1)
              cancel = QtWidgets.QPushButton('Cancel')
              cancel.setObjectName('cancel')
              cancel.setVisible(outgoing)
              cancel.clicked.connect(self.cancel_send)
              footer.addWidget(cancel)
              content.addLayout(footer)
              if outgoing:
                  layout.addStretch(1)
              layout.addWidget(card)
              if not outgoing:
                  layout.addStretch(1)
              self.history.insertWidget(self.history.count() - 1, row)
              record = dict(row=row, card=card, label=label, preview=preview, open=open_button,
                            bar=progress, status=status, cancel=cancel, kind=kind,
                            outgoing=outgoing, time=QtCore.QTime.currentTime().toString('HH:mm'),
                            path=None, text=None, state='Preparing', done=0, total=0)
              self.messages.append(record)
              # Bound widget memory; received files remain saved on disk.
              while len(self.messages) > 200:
                  old = next((m for m in self.messages if m is not self.tx_bubble and m is not self.rx_bubble), None)
                  if old is None:
                      break
                  self.messages.remove(old)
                  self.history.removeWidget(old['row'])
                  old['row'].deleteLater()
              QtCore.QTimer.singleShot(0, self.scroll_bottom)
              return record

          def show_file(self, bubble, path):
              bubble['path'] = path
              bubble['open'].setProperty('file_path', path)
              if not bubble.get('open_connected'):
                  bubble['open'].clicked.connect(self.open_file)
                  bubble['open_connected'] = True
              bubble['open'].show()
              if bubble['kind'] == 'image':
                  reader = QtGui.QImageReader(path)
                  size = reader.size()
                  if size.isValid() and size.width() * size.height() <= 40_000_000:
                      reader.setScaledSize(size.scaled(270, 170, QtCore.Qt.KeepAspectRatio))
                      picture = reader.read()
                      if not picture.isNull():
                          bubble['preview'].setPixmap(QtGui.QPixmap.fromImage(picture))
                          bubble['preview'].show()

          def open_file(self):
              path = self.sender().property('file_path')
              if path:
                  QtGui.QDesktopServices.openUrl(QtCore.QUrl.fromLocalFile(path))

          def show_full_text(self):
              message = self.sender().property('message_text')
              if message is None:
                  return
              dialog = QtWidgets.QDialog(self)
              dialog.setWindowTitle('Received message')
              dialog.resize(650, 480)
              layout = QtWidgets.QVBoxLayout(dialog)
              editor = QtWidgets.QPlainTextEdit()
              editor.setReadOnly(True)
              editor.setPlainText(message)
              layout.addWidget(editor)
              close = QtWidgets.QPushButton('Close')
              close.clicked.connect(dialog.accept)
              layout.addWidget(close)
              dialog.exec_()

          def cancel_send(self):
              try:
                  self.block.commands.put_nowait(('cancel',))
              except queue.Full:
                  self.hint.setText('Please try cancelling again in a moment.')

          def set_busy(self, busy):
              self.send_button.setEnabled(not busy)
              self.attach.setEnabled(not busy)
              self.hint.setText('Sending… You can type your next message.' if busy else
                                'Enter to send · Shift+Enter for a new line')

          def poll(self):
              bar = self.scroll.verticalScrollBar()
              following = bar.maximum() - bar.value() < 40
              changed = False
              for _ in range(300):
                  try:
                      event = self.block.events.get_nowait()
                  except queue.Empty:
                      break
                  self.display_event(event)
                  changed = True
              if changed and following:
                  QtCore.QTimer.singleShot(0, self.scroll_bottom)

          def display_event(self, e):
              direction, state = e['direction'], e['state']
              if direction == 'preparing':
                  if self.tx_bubble:
                      self.tx_bubble['status'].setText(state)
                  return
              if direction == 'notice':
                  if self.tx_bubble:
                      b = self.tx_bubble
                      b['status'].setText(state)
                      b['state'] = state
                      b['bar'].hide()
                      b['cancel'].hide()
                      self.tx_bubble = None
                  self.set_busy(False)
                  self.hint.setText(state)
                  return
              outgoing = direction == 'tx'
              bubble = self.tx_bubble if outgoing else self.rx_bubble
              if bubble is None:
                  caption = 'Receiving message…' if e['kind'] == 'text' else e['name']
                  bubble = self.add_bubble(outgoing, e['kind'], caption)
                  if outgoing:
                      self.tx_bubble = bubble
                  else:
                      self.rx_bubble = bubble
              complete = state.startswith('Complete')
              active = state.startswith(('Sending', 'Receiving', 'Waiting', 'Retry'))
              percent = 100.0 if complete else min(99.9, 100.0 * e['done'] / max(1, e['total']))
              bubble.update(state=state, done=e['done'], total=e['total'])
              bubble['bar'].setValue(round(percent * 10))
              if complete:
                  if not outgoing:
                      if e['kind'] == 'text':
                          message = e['text']
                          bubble['text'] = message
                          bubble['label'].setText(message[:4096] +
                              ('\n[Select View full message below]' if len(message) > 4096 else ''))
                          if len(message) > 4096:
                              bubble['open'].setText('View full message')
                              bubble['open'].setProperty('message_text', message)
                              bubble['open'].clicked.connect(self.show_full_text)
                              bubble['open'].show()
                      else:
                          self.show_file(bubble, e['path'])
                  bubble['status'].setText(bubble['time'] + ('  ·  ✓ Delivered' if outgoing else '  ·  Received'))
              elif active:
                  stage = ('Checking file…' if 'verification' in state else
                           state if state.startswith('Retry') else
                           'Sending' if outgoing else 'Receiving')
                  bubble['status'].setText('%s · %.1f%%' % (stage, percent))
              else:
                  bubble['status'].setText(state)
              if not active:
                  bubble['bar'].hide()
                  bubble['cancel'].hide()
                  if outgoing:
                      self.tx_bubble = None
                      self.set_busy(False)
                  else:
                      self.rx_bubble = None

          def scroll_bottom(self):
              bar = self.scroll.verticalScrollBar()
              bar.setValue(bar.maximum())

          def resizeEvent(self, event):
              super().resizeEvent(event)
              for message in self.messages:
                  message['card'].setMaximumWidth(max(260, int(self.width() * 0.73)))

          def open_folder(self):
              try:
                  Path(self.block.receive_dir).mkdir(parents=True, exist_ok=True)
                  QtGui.QDesktopServices.openUrl(QtCore.QUrl.fromLocalFile(self.block.receive_dir))
              except OSError as exc:
                  self.hint.setText(str(exc))

          def closeEvent(self, event):
              if self.allow_close:
                  event.accept()
              else:
                  self.showMinimized()
                  event.ignore()  # Use GRC Stop to close the flowgraph and both chats.
    affinity: ''
    alias: ''
