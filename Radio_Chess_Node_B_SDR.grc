- name: epy_transfer_protocol
  id: epy_block
  parameters:
    _source_code: |
      """Embedded Python Block: encrypted transfer protocol and ARQ, without GUI.
      Ports: rx_in, command_in, config_in; tx_out, event_out.
      """
      import hashlib
      import io
      import json
      import os
      from pathlib import Path
      import queue
      import re
      import secrets
      import struct
      import tempfile
      import threading
      import time
      import subprocess
      from collections import OrderedDict
      from cryptography.fernet import Fernet, InvalidToken
      from gnuradio import gr
      import pmt

      _META, _DATA, _END, _ACK, _ERROR, _CANCEL = range(1, 7)
      _HEADER = struct.Struct('!4sB2s2s16sI')
      _MAGIC = b'NGS2'


      class blk(gr.basic_block):
          """All protocol, encryption, file I/O, ACKs and retries."""

          def __init__(self, my_addr='A1', peer_addr='B1',
                       shared_key='u362K7J0T2sA_vB1C2D3E4F5G6H7I8J9K0L1M2N3O4P=',
                       receive_dir='./received_A1', max_retries=20,
                       max_file_mb=16, auto_encode_media=True,
                       image_max_edge=1600, image_quality=80,
                       audio_bitrate_kbps=64):
              gr.basic_block.__init__(self, name='Transfer Protocol', in_sig=None, out_sig=None)
              self.commands = queue.Queue(maxsize=2048)
              self.halt = threading.Event()
              self.worker = None
              self.settings = {'timeout': {}, 'size': {}, 'window': {}, 'interval': {}}
              self.config = (my_addr, peer_addr, shared_key, receive_dir,
                             self._publish, self._event, 512, 1.0,
                             max_retries, max_file_mb, 4, 0.02)
              self.core = None
              self.auto_encode_media = bool(auto_encode_media)
              self.image_max_edge = int(image_max_edge)
              self.image_quality = int(image_quality)
              self.audio_bitrate_kbps = int(audio_bitrate_kbps)
              if not 320 <= self.image_max_edge <= 8192:
                  raise ValueError('image_max_edge must be 320..8192')
              if not 40 <= self.image_quality <= 95:
                  raise ValueError('image_quality must be 40..95')
              if not 24 <= self.audio_bitrate_kbps <= 256:
                  raise ValueError('audio_bitrate_kbps must be 24..256')
              self.preparing = False
              self.prepare_id = 0
              for name, handler in (('rx_in', self._receive),
                                    ('command_in', self._command),
                                    ('config_in', self._configure)):
                  port = pmt.intern(name)
                  self.message_port_register_in(port)
                  self.set_msg_handler(port, handler)
              for name in ('tx_out', 'event_out'):
                  self.message_port_register_out(pmt.intern(name))

          @staticmethod
          def _bytes(msg):
              if pmt.is_pair(msg) and pmt.is_u8vector(pmt.cdr(msg)):
                  return bytes(pmt.u8vector_elements(pmt.cdr(msg)))
              return None

          def _publish(self, raw):
              self.message_port_pub(pmt.intern('tx_out'),
                  pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))

          def _event(self, event):
              raw = json.dumps(event, ensure_ascii=True).encode('utf-8')
              self.message_port_pub(pmt.intern('event_out'),
                  pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))

          def _receive(self, msg):
              raw = self._bytes(msg)
              if raw is not None and len(raw) <= 4092:
                  try:
                      self.commands.put_nowait(('rx', raw))
                  except queue.Full:
                      pass

          def _command(self, msg):
              raw = self._bytes(msg)
              if raw is None or len(raw) > 8192:
                  return
              try:
                  command = json.loads(raw.decode('utf-8'))
                  action = command.get('cmd')
                  if action == 'send' and command.get('kind') in ('text', 'image', 'audio'):
                      item = ('send', command['kind'], command['value'])
                  elif action == 'cancel':
                      item = ('cancel',)
                  else:
                      return
                  self.commands.put_nowait(item)
              except (ValueError, UnicodeError, KeyError, AttributeError, queue.Full):
                  pass

          def _configure(self, msg):
              raw = self._bytes(msg)
              if raw is None or len(raw) > 2048:
                  return
              try:
                  config = json.loads(raw.decode('utf-8'))
                  category = config['category']
                  values = config['values']
                  if category not in self.settings or set(values) != {'text', 'image', 'audio'}:
                      raise ValueError('Unknown profile category or transfer type')
                  checked = {}
                  for kind, value in values.items():
                      if category in ('size', 'window'):
                          if type(value) is not int:
                              raise ValueError(category + ' must be an integer')
                          if not (128 <= value <= 1024 if category == 'size' else 1 <= value <= 32):
                              raise ValueError(category + ' outside supported range')
                      else:
                          if type(value) not in (int, float):
                              raise ValueError(category + ' must be numeric')
                          if not (0.05 <= value <= 30 if category == 'timeout' else 0 <= value <= 5):
                              raise ValueError(category + ' outside supported range')
                      checked[kind] = value
                  self.settings[category] = checked
              except (ValueError, TypeError, KeyError, AttributeError) as exc:
                  self._event(dict(direction='notice', state='Invalid profile: ' + str(exc)))

          def start(self):
              self.halt.clear()
              self.worker = threading.Thread(target=self._run, name='file-transfer', daemon=True)
              self.worker.start()
              return True

          def _run(self):
              try:
                  while not self.halt.is_set():
                      if self.core is None and all(self.settings.values()):
                          profiles = {kind: (
                              self.settings['size'][kind], self.settings['timeout'][kind],
                              self.settings['interval'][kind], self.settings['window'][kind])
                              for kind in ('text', 'image', 'audio')}
                          self.core = _TransferCore(*self.config, profiles=profiles)
                          self._event(dict(direction='notice', state='Transfer profiles ready'))
                      try:
                          cmd = self.commands.get(timeout=0.01)
                      except queue.Empty:
                          if self.core is not None:
                              self.core.tick()
                          continue
                      if self.core is None:
                          if cmd[0] == 'send':
                              self._event(dict(direction='notice', state='Waiting for all four profile blocks'))
                          continue
                      if cmd[0] == 'rx':
                          self.core.receive(cmd[1])
                      elif cmd[0] == 'send':
                          try:
                              if self.preparing or self.core.tx is not None:
                                  raise ValueError('A transfer is already active')
                              if self.auto_encode_media and cmd[1] in ('image', 'audio'):
                                  self.preparing = True
                                  self.prepare_id += 1
                                  job = self.prepare_id
                                  self._event(dict(direction='preparing', state='Encoding file',
                                                   kind=cmd[1]))
                                  threading.Thread(target=self._prepare_media,
                                      args=(job, cmd[1], cmd[2]), daemon=True).start()
                              else:
                                  self.core.send(cmd[1], cmd[2])
                          except Exception as exc:
                              self._event(dict(direction='notice', state=str(exc)))
                      elif cmd[0] == 'prepared':
                          if self.preparing and cmd[1] == self.prepare_id:
                              self.preparing = False
                              try:
                                  self.core.send_prepared(cmd[2], cmd[3], cmd[4])
                              except Exception as exc:
                                  self._event(dict(direction='notice', state=str(exc)))
                      elif cmd[0] == 'prepare_error':
                          if self.preparing and cmd[1] == self.prepare_id:
                              self.preparing = False
                              self._event(dict(direction='notice', state=cmd[2]))
                      elif cmd[0] == 'cancel':
                          if self.preparing:
                              self.prepare_id += 1
                              self.preparing = False
                              self._event(dict(direction='tx', state='Cancelled', kind='',
                                               name='', total=0, done=0))
                          else:
                              self.core.cancel()
                      self.core.tick()
              except Exception as exc:
                  self._event(dict(direction='notice', state='Worker stopped: ' + str(exc)))
                  print('[Transfer Protocol] Worker stopped:', exc, flush=True)
              finally:
                  if self.core is not None:
                      self.core.close()

          def stop(self):
              self.halt.set()
              self.prepare_id += 1
              if self.worker is not None:
                  self.worker.join(timeout=3)
              return True

          def _prepare_media(self, job, kind, value):
              try:
                  path = Path(value)
                  if not path.is_file() or path.stat().st_size > self.core.limit:
                      raise ValueError('Choose a file within the configured size limit')
                  original = path.read_bytes()
                  data, name = original, path.name
                  try:
                      if kind == 'image':
                          data, name = self._encode_image(path, original)
                      else:
                          data, name = self._encode_audio(path, original)
                  except (ImportError, OSError, subprocess.SubprocessError, ValueError) as exc:
                      print('[Media] Encoder unavailable; sending original:', exc, flush=True)
                  if len(data) > self.core.limit:
                      raise ValueError('Encoded file exceeds the configured size limit')
                  if self.halt.is_set():
                      return
                  print('[Media] %s: %d -> %d bytes (%s)' %
                        (kind, len(original), len(data), name), flush=True)
                  self.commands.put(('prepared', job, kind, data, name), timeout=5)
              except Exception as exc:
                  try:
                      self.commands.put(('prepare_error', job, str(exc)), timeout=5)
                  except queue.Full:
                      pass

          def _encode_image(self, path, original):
              from PIL import Image, ImageOps
              with Image.open(path) as image:
                  if getattr(image, 'n_frames', 1) != 1 or image.width * image.height > 40_000_000:
                      return original, path.name
                  image = ImageOps.exif_transpose(image)
                  ext = path.suffix.lower()
                  if ext == '.png' or 'A' in image.getbands():
                      # Keep graphics, text and transparency lossless.
                      out = io.BytesIO()
                      image.save(out, format='PNG', optimize=True)
                      candidate, name = out.getvalue(), path.stem + '.png'
                  else:
                      image = image.convert('RGB')
                      image.thumbnail((self.image_max_edge, self.image_max_edge), Image.Resampling.LANCZOS)
                      out = io.BytesIO()
                      image.save(out, format='JPEG', quality=self.image_quality,
                                 optimize=True, progressive=True)
                      candidate, name = out.getvalue(), path.stem + '.jpg'
                  return (candidate, name) if len(candidate) < len(original) else (original, path.name)

          def _encode_audio(self, path, original):
              if path.suffix.lower() in ('.ogg', '.opus'):
                  return original, path.name
              result = subprocess.run([
                  'ffmpeg', '-nostdin', '-v', 'error', '-i', str(path), '-vn',
                  '-c:a', 'libopus', '-b:a', '%dk' % self.audio_bitrate_kbps,
                  '-vbr', 'on', '-compression_level', '10', '-ar', '48000',
                  '-f', 'ogg', 'pipe:1'], capture_output=True, timeout=300, check=True)
              candidate = result.stdout
              return (candidate, path.stem + '.ogg') if 0 < len(candidate) < len(original) else (original, path.name)


      class _TransferCore:
          """Selective Repeat, independently in each direction (one file per direction).

          META (0) is acknowledged before DATA (1..N). DATA uses a bounded sliding
          window and individual ACKs/timers. END (N+1) is sent after all DATA ACKs,
          and acknowledged only after SHA-256 verification and saving the file.
          32-bit sequence numbers never wrap within a transfer. A random 128-bit
          transfer ID separates transfers. All methods run on one worker thread.
          """
          def __init__(self, my_addr, peer_addr, shared_key, receive_dir, emit, event,
                       chunk_size=512, ack_timeout=1.0, max_retries=8,
                       max_file_mb=16, window_size=4, packet_interval=0.02,
                       clock=time.monotonic, profiles=None):
              for addr in (my_addr, peer_addr):
                  if not isinstance(addr, str) or len(addr.encode('ascii')) != 2:
                      raise ValueError('Addresses must be exactly two ASCII characters')
              if my_addr == peer_addr:
                  raise ValueError('Local and peer addresses must differ')
              if not 128 <= int(chunk_size) <= 1024:
                  raise ValueError('chunk_size must be 128..1024 bytes')
              if not 0.05 <= float(ack_timeout) <= 30 or not 0 <= int(max_retries) <= 20:
                  raise ValueError('ack_timeout: 0.05..30 seconds; max_retries: 0..20')
              if not 1 <= int(max_file_mb) <= 256:
                  raise ValueError('max_file_mb must be 1..256')
              if not 1 <= int(window_size) <= 32:
                  raise ValueError('window_size must be 1..32 packets')
              if not 0 <= float(packet_interval) <= 5:
                  raise ValueError('packet_interval must be 0..5 seconds')
              key = shared_key.encode('ascii') if isinstance(shared_key, str) else shared_key
              self.cipher = Fernet(key)
              self.me, self.peer = my_addr.encode('ascii'), peer_addr.encode('ascii')
              self.directory = Path(receive_dir).expanduser().resolve()
              self.emit, self.event, self.clock = emit, event, clock
              self.chunk, self.window = int(chunk_size), int(window_size)
              self.timeout, self.retries = float(ack_timeout), int(max_retries)
              self.interval = float(packet_interval)
              self.profiles = {}
              for kind in ('text', 'image', 'audio'):
                  values = (profiles or {}).get(kind, (chunk_size, ack_timeout, packet_interval, window_size))
                  chunk, timeout, interval, kind_window = values
                  if isinstance(chunk, bool) or int(chunk) != chunk or not 128 <= int(chunk) <= 1024:
                      raise ValueError(kind + '_chunk_size must be an integer, 128..1024 bytes')
                  if not 0.05 <= float(timeout) <= 30:
                      raise ValueError(kind + '_ack_timeout must be 0.05..30 seconds')
                  if not 0 <= float(interval) <= 5:
                      raise ValueError(kind + '_packet_interval must be 0..5 seconds')
                  if type(kind_window) is not int or not 1 <= kind_window <= 32:
                      raise ValueError(kind + '_window_size must be 1..32 packets')
                  self.profiles[kind] = dict(chunk=int(chunk), timeout=float(timeout),
                                             interval=float(interval), window=kind_window)
              self.limit = int(max_file_mb) * 1024 * 1024
              # Allow a complete retry round even when 32 packets are heavily paced.
              self.idle_timeout = max(120, 4 * (self.retries + 1) *
                                      (self.timeout + 32 * self.interval))
              self.idle_timeout = max(self.idle_timeout, *(self._idle_budget(
                  p['timeout'], p['interval'], self.retries, p['window']) for p in self.profiles.values()))
              # Retain completion receipts for the longest permitted remote retry budget.
              self.receipt_ttl = max(1800, 2 * self._idle_budget(30, 5, 20))
              self.tx = self.rx = None
              self.next_emit = 0.0
              self.receipts = OrderedDict()

          @staticmethod
          def _idle_budget(timeout, interval, retries, window=32):
              return max(120, 4 * (retries + 1) * (timeout + window * interval))

          def _event(self, direction, state, transfer=None, **extra):
              t = transfer or {}
              self.event(dict(direction=direction, state=state, name=t.get('name', ''),
                              kind=t.get('kind', ''), total=t.get('size', 0),
                              done=t.get('done', 0), started=t.get('started', self.clock()),
                              **extra))

          def _wire(self, typ, tid, seq, body=b''):
              plaintext = _HEADER.pack(_MAGIC, typ, self.me, self.peer, tid, seq) + body
              frame = self.me + self.peer + self.cipher.encrypt(plaintext)
              if len(frame) > 4092:
                  raise ValueError('Encrypted frame exceeds 4092-byte PDU budget')
              return frame

          def _reply(self, typ, tid, seq, body=b''):
              # ACK/error/control replies bypass DATA pacing. Already queued downstream
              # PDUs cannot be overtaken; size the timeout for the complete RF pipeline.
              self.emit(self._wire(typ, tid, seq, body))

          @staticmethod
          def _safe_name(name):
              name = str(name).replace('\\', '/').split('/')[-1]
              name = re.sub(r'[^\w. -]', '_', name, flags=re.UNICODE).strip('. ')[:100]
              return name or 'received.bin'

          def send(self, kind, value):
              if self.tx is not None:
                  raise ValueError('A transfer is already active')
              if kind == 'text':
                  data, name = value.encode('utf-8'), 'message.txt'
                  if not data or len(data) > 65536:
                      raise ValueError('Type a message of 1..65536 UTF-8 bytes')
              elif kind in ('image', 'audio'):
                  path = Path(value)
                  if not path.is_file() or path.stat().st_size > self.limit:
                      raise ValueError('Choose a file within the configured size limit')
                  with path.open('rb') as f:
                      data = f.read(self.limit + 1)
                  name = path.name
              else:
                  raise ValueError('Unsupported transfer type')
              self.send_prepared(kind, data, name)

          def send_prepared(self, kind, data, name):
              if self.tx is not None:
                  raise ValueError('A transfer is already active')
              if kind not in ('text', 'image', 'audio') or not isinstance(data, bytes):
                  raise ValueError('Invalid prepared transfer')
              if kind == 'text' and (not data or len(data) > 65536):
                  raise ValueError('Type a message of 1..65536 UTF-8 bytes')
              if len(data) > self.limit:
                  raise ValueError('File exceeds the configured size limit')
              profile = self.profiles[kind]
              chunk = profile['chunk']
              self.tx = dict(tid=secrets.token_bytes(16), data=data, kind=kind,
                             chunk=chunk, timeout=profile['timeout'], interval=profile['interval'],
                             window=profile['window'],
                             name=self._safe_name(name), size=len(data), done=0,
                             started=self.clock(), n=(len(data) + chunk - 1) // chunk,
                             digest=hashlib.sha256(data).hexdigest(), phase='meta',
                             base=1, next=1, acked=set(), pending={})
              t = self.tx
              meta = dict(kind=t['kind'], name=t['name'], size=t['size'], chunk=t['chunk'],
                          ack_timeout=t['timeout'], packet_interval=t['interval'], max_retries=self.retries,
                          window=t['window'], sha256=t['digest'])
              self._queue_packet(_META, 0, json.dumps(meta, ensure_ascii=True,
                                 separators=(',', ':')).encode())
              self._event('tx', 'Sending metadata', t)
              print('[Transfer profile] %s: payload=%d bytes, ACK timeout=%.3f s, interval=%.3f s'
                    % (kind, t['chunk'], t['timeout'], t['interval']), flush=True)
              self._pump()

          def _queue_packet(self, typ, seq, body):
              t = self.tx
              t['pending'][seq] = dict(wire=self._wire(typ, t['tid'], seq, body),
                                       sent=None, retry=0)

          def _fill_window(self):
              t = self.tx
              if t['phase'] != 'data':
                  return
              # The window is anchored at the oldest unacknowledged sequence number,
              # not merely at the number of pending packets. This bounds RX buffering.
              while t['next'] <= t['n'] and t['next'] < t['base'] + t['window']:
                  seq = t['next']
                  self._queue_packet(_DATA, seq,
                                     t['data'][(seq - 1) * t['chunk']:seq * t['chunk']])
                  t['next'] += 1
              if t['base'] > t['n']:
                  t['phase'] = 'end'
                  self._queue_packet(_END, t['n'] + 1, bytes.fromhex(t['digest']))
                  self._event('tx', 'Waiting for file verification', t)

          def _acknowledge(self, tid, seq, body):
              t = self.tx
              if body or t is None or t['tid'] != tid:
                  return
              packet = t['pending'].get(seq)
              if packet is None or packet['sent'] is None:
                  return  # Duplicate/stale ACK, or a sequence not yet transmitted.
              del t['pending'][seq]
              if t['phase'] == 'meta':
                  t['phase'] = 'data'
              elif t['phase'] == 'end':
                  self._event('tx', 'Complete — receiver verified', t)
                  self.tx = None
                  return
              else:
                  t['done'] += min(t['chunk'], t['size'] - (seq - 1) * t['chunk'])
                  t['acked'].add(seq)
                  while t['base'] in t['acked']:
                      t['acked'].remove(t['base'])
                      t['base'] += 1
                  self._event('tx', 'Sending', t)
              self._fill_window()
              self._pump()

          def _pump(self):
              """Emit at most one DATA/META/END PDU per call, with retry priority."""
              t, now = self.tx, self.clock()
              if t is None or now < self.next_emit:
                  return
              expired = [(p['sent'], seq) for seq, p in t['pending'].items()
                         if p['sent'] is not None and now - p['sent'] >= t['timeout']]
              if expired:
                  _, seq = min(expired)
                  p = t['pending'][seq]
                  if p['retry'] >= self.retries:
                      self._abort_tx('Unconfirmed — ACK timeout for packet %d' % seq)
                      return
                  p['retry'] += 1
                  self._event('tx', 'Retry packet %d (%d/%d)' %
                              (seq, p['retry'], self.retries), t)
              else:
                  seq = next((s for s, p in t['pending'].items() if p['sent'] is None), None)
                  if seq is None:
                      return
                  p = t['pending'][seq]
              p['sent'] = now  # Timestamp PDU submission, not an RF hardware timestamp.
              self.next_emit = now + t['interval']
              self.emit(p['wire'])

          def receive(self, frame):
              # The upstream CRC Check must drop failures and remove the CRC bytes.
              if len(frame) < 5 or len(frame) > 4092 or frame[:4] != self.peer + self.me:
                  return
              try:
                  raw = self.cipher.decrypt(frame[4:])
                  if len(raw) < _HEADER.size:
                      return
                  magic, typ, src, dst, tid, seq = _HEADER.unpack(raw[:_HEADER.size])
                  if magic != _MAGIC or src != self.peer or dst != self.me:
                      return
                  body = raw[_HEADER.size:]
              except (InvalidToken, ValueError, struct.error):
                  return
              if typ == _ACK:
                  self._acknowledge(tid, seq, body)
              elif typ == _ERROR:
                  if self.tx and tid == self.tx['tid'] and seq in self.tx['pending']:
                      self._abort_tx('Failed: ' + body.decode('utf-8', 'replace')[:180])
              elif typ == _CANCEL:
                  if body:
                      return
                  if self.rx and self.rx['tid'] == tid:
                      self._drop_rx('Cancelled by sender')
                  elif tid not in self.receipts:
                      # A reordered CANCEL can arrive before its META.
                      self._remember(tid, error='Cancelled by sender')
              elif typ in (_META, _DATA, _END):
                  try:
                      self._receive_data(typ, tid, seq, body)
                  except (ValueError, OSError, UnicodeError, KeyError, TypeError) as exc:
                      reason = str(exc)[:180]
                      if self.rx and self.rx['tid'] == tid:
                          self._drop_rx('Failed: ' + reason)
                      elif tid not in self.receipts:
                          self._remember(tid, error=reason)
                      self._reply(_ERROR, tid, seq, reason.encode('utf-8')[:180])

          def _remember(self, tid, **fields):
              self.receipts[tid] = dict(at=self.clock(), **fields)
              self.receipts.move_to_end(tid)
              while len(self.receipts) > 256:
                  self.receipts.popitem(last=False)

          def _receive_data(self, typ, tid, seq, body):
              if tid in self.receipts:
                  c = self.receipts[tid]
                  if 'error' in c:
                      self._reply(_ERROR, tid, seq, c['error'].encode('utf-8')[:180])
                  elif typ == _END and seq == c['seq'] and body == c['digest']:
                      self._reply(_ACK, tid, seq)  # Lost final ACK: never save twice.
                  return
              if typ == _META:
                  if seq != 0:
                      raise ValueError('Invalid metadata sequence')
                  if self.rx:
                      if self.rx['tid'] == tid and self.rx['meta'] == body:
                          self.rx['last'] = self.clock()
                          self._reply(_ACK, tid, seq)
                          return
                      raise ValueError('Receiver busy; retry after its current transfer')
                  meta = json.loads(body.decode('utf-8'))
                  if not isinstance(meta, dict):
                      raise ValueError('Invalid metadata')
                  size, chunk, window = meta.get('size'), meta.get('chunk'), meta.get('window')
                  digest, kind = meta.get('sha256'), meta.get('kind')
                  if type(size) is not int or not 0 <= size <= self.limit:
                      raise ValueError('Unsupported file size')
                  if type(chunk) is not int or not 128 <= chunk <= 1024:
                      raise ValueError('Invalid chunk size')
                  if type(window) is not int or not 1 <= window <= 32:
                      raise ValueError('Invalid window size')
                  if kind not in ('text', 'image', 'audio') or (kind == 'text' and size > 65536):
                      raise ValueError('Unsupported content type or text size')
                  if not isinstance(digest, str) or not re.fullmatch('[0-9a-f]{64}', digest):
                      raise ValueError('Invalid SHA-256')
                  if not isinstance(meta.get('name'), str) or len(meta['name']) > 200:
                      raise ValueError('Invalid filename')
                  # Optional fields allow older NGS2 senders to keep working.
                  timeout = meta.get('ack_timeout', self.timeout)
                  interval = meta.get('packet_interval', self.interval)
                  retries = meta.get('max_retries', self.retries)
                  if type(timeout) not in (int, float) or not 0.05 <= timeout <= 30:
                      raise ValueError('Invalid ACK timeout')
                  if type(interval) not in (int, float) or not 0 <= interval <= 5:
                      raise ValueError('Invalid packet interval')
                  if type(retries) is not int or not 0 <= retries <= 20:
                      raise ValueError('Invalid retry limit')
                  idle_timeout = max(self.idle_timeout, self._idle_budget(timeout, interval, retries))
                  if kind == 'text':
                      f, temp = io.BytesIO(), None
                  else:
                      self.directory.mkdir(parents=True, exist_ok=True)
                      f = tempfile.NamedTemporaryFile(mode='w+b', prefix='.incoming_',
                                                      suffix='.part', dir=self.directory, delete=False)
                      temp = Path(f.name)
                  self.rx = dict(tid=tid, meta=body, kind=kind, name=self._safe_name(meta['name']),
                                 size=size, chunk=chunk, window=window, digest=digest, idle_timeout=idle_timeout,
                                 n=(size + chunk - 1) // chunk, next=1, done=0, buffer={},
                                 hash=hashlib.sha256(), file=f, temp=temp,
                                 started=self.clock(), last=self.clock())
                  self._event('rx', 'Receiving', self.rx)
                  self._reply(_ACK, tid, seq)
                  return
              r = self.rx
              if r is None or r['tid'] != tid:
                  raise ValueError('No matching transfer; send again from the beginning')
              r['last'] = self.clock()
              if typ == _DATA:
                  if not 1 <= seq <= r['n']:
                      raise ValueError('Invalid data sequence')
                  expected = min(r['chunk'], r['size'] - (seq - 1) * r['chunk'])
                  if len(body) != expected:
                      raise ValueError('Invalid chunk length')
                  if seq < r['next']:
                      self._reply(_ACK, tid, seq)  # Re-ACK without writing twice.
                      return
                  if seq >= r['next'] + r['window']:
                      return  # Out of receive window: do not ACK unretained data.
                  if seq not in r['buffer']:
                      r['buffer'][seq] = body
                      r['done'] += len(body)  # Unique accepted bytes, including buffered ones.
                  elif r['buffer'][seq] != body:
                      raise ValueError('Conflicting duplicate packet')
                  while r['next'] in r['buffer']:
                      contiguous = r['buffer'].pop(r['next'])
                      r['file'].write(contiguous)
                      r['hash'].update(contiguous)
                      r['next'] += 1
                  self._event('rx', 'Receiving', r)
                  self._reply(_ACK, tid, seq)
              elif typ == _END:
                  if seq != r['n'] + 1 or r['next'] != seq or r['done'] != r['size'] or r['buffer']:
                      raise ValueError('Incomplete file')
                  if body != bytes.fromhex(r['digest']) or r['hash'].hexdigest() != r['digest']:
                      raise ValueError('Whole-file SHA-256 mismatch')
                  if r['kind'] == 'text':
                      message = r['file'].getvalue().decode('utf-8')
                      r['file'].close()
                      result = dict(text=message)
                      state = 'Complete — displayed and verified'
                  else:
                      r['file'].flush()
                      os.fsync(r['file'].fileno())
                      r['file'].close()
                      final = self.directory / (tid.hex() + '_' + r['name'])
                      os.replace(r['temp'], final)
                      result = dict(path=str(final))
                      state = 'Complete — saved and verified'
                  self._remember(tid, seq=seq, digest=body)
                  self.rx = None
                  self._reply(_ACK, tid, seq)
                  self._event('rx', state, r, **result)

          def tick(self):
              self._pump()
              now = self.clock()
              if self.rx and now - self.rx['last'] >= self.rx['idle_timeout']:
                  self._drop_rx('Timed out — partial file removed')
              for tid, entry in list(self.receipts.items()):
                  if now - entry['at'] > self.receipt_ttl:
                      del self.receipts[tid]

          def _abort_tx(self, reason):
              if self.tx:
                  t, self.tx = self.tx, None
                  self._reply(_CANCEL, t['tid'], 0)
                  self._event('tx', reason, t)

          def cancel(self):
              self._abort_tx('Cancelled — peer may have received some data')

          def _drop_rx(self, reason):
              r, self.rx = self.rx, None
              if r:
                  self._remember(r['tid'], error=reason)
                  try:
                      r['file'].close()
                  except OSError:
                      pass
                  if r['temp'] is not None:
                      try:
                          r['temp'].unlink(missing_ok=True)
                      except OSError as exc:
                          reason += '; partial-file cleanup failed: ' + str(exc)
                  self._event('rx', reason, r)

          def close(self):
              self.tx = None
              self._drop_rx('Stopped — partial file removed')
    affinity: ''
    alias: ''
    audio_bitrate_kbps: '64'
    auto_encode_media: 'True'
    comment: Encrypted transfer and ACK protocol
    image_max_edge: '1600'
    image_quality: '80'
    max_file_mb: '16'
    max_retries: '20'
    maxoutbuf: '0'
    minoutbuf: '0'
    my_addr: my_addr
    peer_addr: peer_addr
    receive_dir: '''./received_B1'''
