    _io_cache: ('Transfer Chat GUI', 'blk', [('my_addr', "'A1'"), ('peer_addr', "'B1'"), ('receive_dir', "'./received_A1'"), ('show_gui', 'True')], [('event_in', 'message', 1)], [('command_out', 'message', 1)], 'Chat window; protocol work happens in a separate block.', ['my_addr', 'peer_addr', 'receive_dir', 'show_gui'])
