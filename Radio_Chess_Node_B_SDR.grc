- name: epy_timeout_profiles
  id: epy_block
  parameters:
    _source_code: |
      """Embedded Python Block: timeout profiles for text, image and audio.
      Connect config_out to Transfer Protocol.config_in.
      """
      import json
      from gnuradio import gr
      import pmt


      class blk(gr.basic_block):
          def __init__(self, text=3.0, image=3.0, audio=3.0):
              gr.basic_block.__init__(self, name='Timeout Profiles',
                                      in_sig=None, out_sig=None)
              self.values = {'text': float(text), 'image': float(image),
                             'audio': float(audio)}
              for value in self.values.values():
                  if not (0.05, 30)[0] <= value <= (0.05, 30)[1]:
                      raise ValueError('timeout must be within (0.05, 30)')
              self.message_port_register_out(pmt.intern('config_out'))

          def start(self):
              raw = json.dumps({'category': 'timeout', 'values': self.values}).encode('utf-8')
              self.message_port_pub(pmt.intern('config_out'),
                  pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))
              return True
    affinity: ''
    alias: ''
    audio: '2.0'
    comment: ''
    image: '2.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    text: '1.0'
