- name: epy_window_profiles
  id: epy_block
  parameters:
    _source_code: |
      """Embedded Python Block: window profiles for text, image and audio.
      Connect config_out to Transfer Protocol.config_in.
      """
      import json
      from gnuradio import gr
      import pmt


      class blk(gr.basic_block):
          def __init__(self, text=4, image=4, audio=4):
              gr.basic_block.__init__(self, name='Window Profiles',
                                      in_sig=None, out_sig=None)
              self.values = {'text': int(text), 'image': int(image),
                             'audio': int(audio)}
              for value in self.values.values():
                  if not (1, 32)[0] <= value <= (1, 32)[1]:
                      raise ValueError('window must be within (1, 32)')
              self.message_port_register_out(pmt.intern('config_out'))

          def start(self):
              raw = json.dumps({'category': 'window', 'values': self.values}).encode('utf-8')
              self.message_port_pub(pmt.intern('config_out'),
                  pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))
              return True
    affinity: ''
    alias: ''
    audio: '32'
    comment: ''
    image: '32'
    maxoutbuf: '0'
    minoutbuf: '0'
    text: '4'
  states:
    _io_cache: ('Window Profiles', 'blk', [('text', '4'), ('image', '4'), ('audio', '4')], [], [('config_out', 'message', 1)], '', [])
