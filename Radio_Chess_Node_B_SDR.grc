- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: |
      from gnuradio import gr
      import pmt
      import threading
      import time


      class blk(gr.basic_block):
          """Observe RS/CRC outcomes; counters include controls and retransmissions."""
          def __init__(self, report_interval=1.0):
              gr.basic_block.__init__(self, name="Link Reliability Monitor",
                                      in_sig=None, out_sig=None)
              self.interval = max(0.2, float(report_interval))
              self._lock = threading.Lock()
              self._print_lock = threading.Lock()
              self._halt = threading.Event()
              self._worker = None
              self.counts = dict.fromkeys((
                  "tx", "rs_ok", "rs_fail", "corrected_packets", "corrected_bytes",
                  "corrected_bits", "crc_ok", "crc_fail", "crc_ok_bytes",
                  "missing_metadata"), 0)
              self._last_time = time.monotonic()
              self._last_bytes = 0
              for port in ("tx", "rs_ok", "rs_fail", "crc_ok", "crc_fail"):
                  self.message_port_register_in(pmt.intern(port))
              self.set_msg_handler(pmt.intern("tx"), self.handle_tx)
              self.set_msg_handler(pmt.intern("rs_ok"), self.handle_rs_ok)
              self.set_msg_handler(pmt.intern("rs_fail"), self.handle_rs_fail)
              self.set_msg_handler(pmt.intern("crc_ok"), self.handle_crc_ok)
              self.set_msg_handler(pmt.intern("crc_fail"), self.handle_crc_fail)

          def handle_tx(self, msg):
              with self._lock:
                  self.counts["tx"] += 1

          def handle_rs_ok(self, msg):
              changed_bytes = changed_bits = 0
              available = False
              if pmt.is_pair(msg):
                  meta = pmt.car(msg)
                  bk, ik = pmt.intern("rs_corrected_bytes"), pmt.intern("rs_corrected_bits")
                  if pmt.is_dict(meta) and pmt.dict_has_key(meta, bk) and pmt.dict_has_key(meta, ik):
                      changed_bytes = pmt.to_long(pmt.dict_ref(meta, bk, pmt.from_long(0)))
                      changed_bits = pmt.to_long(pmt.dict_ref(meta, ik, pmt.from_long(0)))
                      available = True
              with self._lock:
                  self.counts["rs_ok"] += 1
                  self.counts["corrected_packets"] += int(changed_bytes > 0)
                  self.counts["corrected_bytes"] += changed_bytes
                  self.counts["corrected_bits"] += changed_bits
                  self.counts["missing_metadata"] += int(not available)

          def handle_rs_fail(self, msg):
              with self._lock:
                  self.counts["rs_fail"] += 1

          def handle_crc_ok(self, msg):
              size = 0
              if pmt.is_pair(msg) and pmt.is_u8vector(pmt.cdr(msg)):
                  size = len(pmt.u8vector_elements(pmt.cdr(msg)))
              with self._lock:
                  self.counts["crc_ok"] += 1
                  self.counts["crc_ok_bytes"] += size

          def handle_crc_fail(self, msg):
              with self._lock:
                  self.counts["crc_fail"] += 1

          @staticmethod
          def percent(value, total):
              return f"{100.0 * value / total:.2f}%" if total else "n/a"

          def report(self):
              with self._print_lock:
                  with self._lock:
                      c = self.counts.copy()
                  now = time.monotonic()
                  elapsed = max(now - self._last_time, 1e-9)
                  rate = 8.0 * (c["crc_ok_bytes"] - self._last_bytes) / elapsed / 1000.0
                  self._last_time, self._last_bytes = now, c["crc_ok_bytes"]
                  rs_total = c["rs_ok"] + c["rs_fail"]
                  crc_total = c["crc_ok"] + c["crc_fail"]
                  completed = c["rs_fail"] + crc_total
                  rejected = c["rs_fail"] + c["crc_fail"]
                  print(
                      f"[LINK] TX_PDUs={c['tx']} | "
                      f"RS decoded={c['rs_ok']} fail={c['rs_fail']} "
                      f"({self.percent(c['rs_fail'], rs_total)}) | "
                      f"RS changed packets={c['corrected_packets']} "
                      f"bytes={c['corrected_bytes']} bits={c['corrected_bits']} | "
                      f"CRC pass={c['crc_ok']} fail={c['crc_fail']} "
                      f"({self.percent(c['crc_fail'], crc_total)}) | "
                      f"RS/CRC rejected={self.percent(rejected, completed)} | "
                      f"CRC-pass rate={rate:.2f} kbit/s | "
                      f"missing_RS_metadata={c['missing_metadata']}", flush=True)

          def _report_loop(self):
              while not self._halt.wait(self.interval):
                  self.report()

          def start(self):
              self._halt.clear()
              with self._lock:
                  self._last_bytes = self.counts["crc_ok_bytes"]
              self._last_time = time.monotonic()
              self._worker = threading.Thread(target=self._report_loop,
                                              name="link-reliability-monitor", daemon=True)
              self._worker.start()
              return True

          def stop(self):
              self._halt.set()
              if self._worker is not None:
                  self._worker.join()
              self.report()
              return True
    affinity: ''
    alias: ''
    comment: One report per second. RS changes include parity; rates include ACKs and retransmissions. Not end-to-end loss or BER.
    maxoutbuf: '0'
    minoutbuf: '0'
    report_interval: '1.0'
  states:
    _io_cache: ('Link Reliability Monitor', 'blk', [('report_interval', '1.0')], [('crc_fail', 'message', 1), ('rs_ok', 'message', 1), ('rs_fail', 'message', 1), ('tx', 'message', 1), ('crc_ok', 'message', 1)], [], 'Observe RS/CRC outcomes; counters include controls and retransmissions.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 3224
    - 224.0
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: |
      """Embedded Python Block: Chess Protocol — encrypted forwarding of chess packets to/from the radio chain.

      command_in  <- Chess GUI command_out   (JSON dict, chess==1) -> Fernet encrypt -> tx_out    -> CRC append -> RS encoder -> TX
      rx_in       <- CRC check ok output     (b'CH'+token)         -> Fernet decrypt -> event_out -> Chess GUI event_in
      Anything that is not an authentic chess frame (wrong key, other protocol traffic) is silently ignored.
      """
      import json
      from cryptography.fernet import Fernet, InvalidToken
      from gnuradio import gr
      import pmt

      _TAG = b'CH'


      class blk(gr.basic_block):
          def __init__(self, my_addr='A1', peer_addr='B1', time_control='3+0', player_color='random',
                       shared_key=b'u362K7J0T2sA_vB1C2D3E4F5G6H7I8J9K0L1M2N3O4P='):
              gr.basic_block.__init__(self, name='Chess Protocol', in_sig=None, out_sig=None)
              self.my_addr = my_addr
              self.peer_addr = peer_addr
              self.time_control = time_control
              self.player_color = player_color
              if isinstance(shared_key, str):
                  shared_key = shared_key.encode('ascii')
              self.cipher = Fernet(shared_key)
              for name in ('rx_in', 'command_in'):
                  self.message_port_register_in(pmt.intern(name))
                  self.set_msg_handler(pmt.intern(name), getattr(self, '_' + name))
              for name in ('tx_out', 'event_out'):
                  self.message_port_register_out(pmt.intern(name))

          @staticmethod
          def _bytes(msg):
              if pmt.is_pair(msg) and pmt.is_u8vector(pmt.cdr(msg)):
                  return bytes(pmt.u8vector_elements(pmt.cdr(msg)))
              return None

          def decode(self, raw):
              """b'CH'+token -> dict, or None if not an authentic chess frame."""
              if raw is None or not raw.startswith(_TAG):
                  return None
              try:
                  d = json.loads(self.cipher.decrypt(raw[len(_TAG):]).decode('utf-8'))
              except (InvalidToken, ValueError, UnicodeError):
                  return None
              return d if isinstance(d, dict) and d.get('chess') == 1 else None

          def encode(self, d):
              return _TAG + self.cipher.encrypt(json.dumps(d, separators=(',', ':')).encode('utf-8'))

          @staticmethod
          def _wrap(raw):
              return pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw)))

          def _command_in(self, msg):
              raw = self._bytes(msg)
              if raw is None:
                  return
              try:
                  d = json.loads(raw.decode('utf-8'))
              except ValueError:
                  return
              if isinstance(d, dict) and d.get('chess') == 1:
                  self.message_port_pub(pmt.intern('tx_out'), self._wrap(self.encode(d)))

          def _rx_in(self, msg):
              d = self.decode(self._bytes(msg))
              if d is not None:
                  ev = json.dumps({'direction': 'peer_move', 'data': d}, separators=(',', ':')).encode('utf-8')
                  self.message_port_pub(pmt.intern('event_out'), self._wrap(ev))
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    my_addr: my_addr
    peer_addr: peer_addr
    player_color: '''white'''
    time_control: '''5+0'''
    shared_key: shared_key
  states:
    _io_cache: ('Chess Protocol', 'blk', [('my_addr', "'A1'"), ('peer_addr', "'B1'"), ('time_control', "'3+0'"), ('player_color', "'random'")], [('rx_in', 'message', 1), ('command_in', 'message', 1)], [('event_out', 'message', 1), ('tx_out', 'message', 1)], 'Manages chess game state, turn timing, move validation, and wireless sync.', ['my_addr', 'peer_addr', 'player_color', 'time_control'])
