- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: |-
      """Add a repeatable prefix and a tail outside the packet header and payload."""

      import hashlib
      import os

      from gnuradio import gr
      import pmt


      def training_bytes(length):
          output = bytearray()
          counter = 0

          while len(output) < length:
              output.extend(
                  hashlib.sha256(
                      b"QPSK-training-v1" + counter.to_bytes(4, "big")
                  ).digest()
              )
              counter += 1

          return bytes(output[:length])


      class blk(gr.basic_block):
          def __init__(self, num_dummy_bytes=1500, num_tail_bytes=1024):
              gr.basic_block.__init__(
                  self,
                  name="Burst Prefix + Tail",
                  in_sig=None,
                  out_sig=None,
              )

              self.prefix = int(num_dummy_bytes)
              self.tail = int(num_tail_bytes)

              if self.prefix < 0 or self.tail < 0:
                  raise ValueError("Padding lengths must be nonnegative")

              self.message_port_register_in(pmt.intern("pdu_in"))
              self.message_port_register_out(pmt.intern("pdu_out"))
              self.set_msg_handler(pmt.intern("pdu_in"), self.handle)

          def handle(self, msg):
              if not pmt.is_pair(msg) or not pmt.is_u8vector(pmt.cdr(msg)):
                  return

              raw = bytes(pmt.u8vector_elements(pmt.cdr(msg)))
              padded = (
                  training_bytes(self.prefix)
                  + raw
                  + os.urandom(self.tail)
              )

              output = pmt.cons(
                  pmt.car(msg),
                  pmt.init_u8vector(len(padded), list(padded)),
              )
              self.message_port_pub(pmt.intern("pdu_out"), output)
    affinity: ''
    alias: ''
    comment: Random prefix for acquisition; tail flushes finite bursts
    maxoutbuf: '0'
    minoutbuf: '0'
    num_dummy_bytes: '2048'
    num_tail_bytes: '2570'
  states:
    _io_cache: ('Burst Prefix + Tail', 'blk', [('num_dummy_bytes', '1500'), ('num_tail_bytes', '1024')], [('pdu_in', 'message', 1)], [('pdu_out', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 4848
    - 416.0
    rotation: 0
    state: enabled
- name: epy_interval_profiles
  id: epy_block
  parameters:
    _source_code: |
      """Embedded Python Block: interval profiles for text, image and audio.
      Connect config_out to Transfer Protocol.config_in.
      """
      import json
      from gnuradio import gr
      import pmt


      class blk(gr.basic_block):
          def __init__(self, text=0.05, image=0.08, audio=0.08):
              gr.basic_block.__init__(self, name='Interval Profiles',
                                      in_sig=None, out_sig=None)
              self.values = {'text': float(text), 'image': float(image),
                             'audio': float(audio)}
              for value in self.values.values():
                  if not (0, 5)[0] <= value <= (0, 5)[1]:
                      raise ValueError('interval must be within (0, 5)')
              self.message_port_register_out(pmt.intern('config_out'))

          def start(self):
              raw = json.dumps({'category': 'interval', 'values': self.values}).encode('utf-8')
              self.message_port_pub(pmt.intern('config_out'),
                  pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))
              return True
    affinity: ''
    alias: ''
    audio: '0.0625'
    comment: ''
    image: '0.0625'
    maxoutbuf: '0'
    minoutbuf: '0'
    text: '0.05'
  states:
    _io_cache: ('Interval Profiles', 'blk', [('text', '0.05'), ('image', '0.08'), ('audio', '0.08')], [], [('config_out', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
