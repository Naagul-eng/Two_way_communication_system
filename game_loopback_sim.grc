- name: game_host
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: Game logic + PyQt5 window. node_id 0 = host.
    _source_code: "\"\"\"Among Us Lite node (host = node_id 0, clients = 1..n-1) for the QPSK GNU Radio link.\nPorts: rx_in (PDU from CRC Check 'ok'), tx_out (PDU to CRC Append).\nWire format (all small): 5-byte header (magic|type, sender, dest, seq16) + payload (keystream-XOR) + 4-byte MAC.\nSTATE (host->all, every tick) carries the whole world; INPUT (client->host) is sent in the client's own time slot.\nEvents (use/kill/report/chat) repeat until the host echoes their id, so no ACK packets are needed.\"\"\"\nimport hashlib, hmac, random, struct, threading, time\nfrom collections import deque\nfrom gnuradio import gr\nimport pmt\n\nMAP = [\"####################\",\n       \"#........#.........#\",\n       \"#.T......#......T..#\",\n       \"#........#.........#\",\n       \"#####.#######.######\",\n       \"#........V.........#\",\n       \"#####.#######.######\",\n       \"#........#.........#\",\n       \"#..T.....#.....T...#\",\n       \"#.......T#.........#\",\n       \"####################\"]\nW, H = len(MAP[0]), len(MAP)\nTASKS = [(x, y) for y in range(H) for x in range(W) if MAP[y][x] == 'T']\nBUTTON = [(x, y) for y in range(H) for x in range(W) if MAP[y][x] == 'V'][0]\nALL_TASKS = (1 << len(TASKS)) - 1\nDIRS = {1: (0, -1), 2: (0, 1), 3: (-1, 0), 4: (1, 0)}\nLOBBY, PLAY, MEET, END = 0, 1, 2, 3\nT_STATE, T_INPUT, T_ROLE = 1, 2, 3\nBCAST, MAGIC, SKIP = 255, 0xA0, 0xFE\n\n\ndef free(x, y):\n    return 0 <= x < W and 0 <= y < H and MAP[y][x] != '#'\n\n\ndef spawn(i):\n    return (2 + 2 * (i % 8), 5)\n\n\ndef bfs_dir(src, dst):\n    if src == dst:\n        return 0\n    q, seen = deque([(src, 0)]), {src}\n    while q:\n        (x, y), first = q.popleft()\n        for d, (dx, dy) in DIRS.items():\n            n = (x + dx, y + dy)\n            if n in seen or not free(*n):\n                continue\n            if n == dst:\n                return first or d\n            seen.add(n)\n            q.append((n, first or d))\n    return 0\n\n\n# ---------------- security / framing ----------------\ndef _ks(key, hdr, n):\n    out, c = b'', 0\n    while len(out) < n:\n        out += hashlib.sha256(key + hdr + bytes([c])).digest()\n        c += 1\n    return out[:n]\n\n\ndef seal(key, typ, sender, dest, seq, payload):\n    hdr = bytes([MAGIC | typ, sender, dest]) + struct.pack('!H', seq & 0xFFFF)\n    ct = bytes(a ^ b for a, b in zip(payload, _ks(key, hdr, len(payload))))\n    return hdr + ct + hmac.new(key, hdr + ct, hashlib.sha256).digest()[:4]\n\n\ndef unseal(key, raw):\n    if len(raw) < 9 or (raw[0] & 0xF0) != MAGIC:\n        return None\n    hdr, ct, mac = raw[:5], raw[5:-4], raw[-4:]\n    if not hmac.compare_digest(hmac.new(key, hdr + ct, hashlib.sha256).digest()[:4], mac):\n        return None\n    pt = bytes(a ^ b for a, b in zip(ct, _ks(key, hdr, len(ct))))\n    return hdr[0] & 0x0F, hdr[1], hdr[2], struct.unpack('!H', hdr[3:5])[0], pt\n\n\ndef newer(seq, last):\n    return last is None or 0 < ((seq - last) & 0xFFFF) < 0x8000\n\n\n# ---------------- authoritative game core (host only) ----------------\nclass Core:\n    def __init__(s, n, rng=None, kill_cd=8.0, meet_s=15.0):\n        s.n, s.rng, s.kill_cd, s.meet_s = n, rng or random.Random(), kill_cd, meet_s\n        s.lobby()\n\n    def lobby(s):\n        s.phase, s.winner, s.tasks, s.imp, s.eject = LOBBY, 0, 0, -1, 255\n        n = s.n\n        s.inplay, s.alive, s.body = [0] * n, [1] * n, [0] * n\n        s.dir, s.vote = [0] * n, [0] * n\n        s.pos = [spawn(i) for i in range(n)]\n        s.meet_end = s.kill_ready = 0\n\n    def start(s, now, present):\n        ids = [i for i in range(s.n) if present[i]]\n        if len(ids) < 3:\n            return False\n        s.lobby()\n        s.phase = PLAY\n        for i in ids:\n            s.inplay[i] = 1\n        s.alive = [1 if s.inplay[i] else 0 for i in range(s.n)]\n        s.imp, s.kill_ready = s.rng.choice(ids), now + s.kill_cd\n        return True\n\n    def end(s, w):\n        s.phase, s.winner = END, w\n\n    def check(s):\n        crew = [i for i in range(s.n) if s.inplay[i] and s.alive[i] and i != s.imp]\n        if not s.alive[s.imp]:\n            s.end(1)\n        elif len(crew) <= 1:\n            s.end(2)\n\n    def step(s, now):\n        if s.phase == PLAY:\n            for i in range(s.n):\n                if s.inplay[i] and s.alive[i] and s.dir[i] in DIRS:\n                    dx, dy = DIRS[s.dir[i]]\n                    x, y = s.pos[i]\n                    if free(x + dx, y + dy):\n                        s.pos[i] = (x + dx, y + dy)\n        elif s.phase == MEET:\n            voters = [i for i in range(s.n) if s.inplay[i] and s.alive[i]]\n            if now >= s.meet_end or all(s.vote[i] for i in voters):\n                s.tally(now)\n\n    def act(s, p, a, now):\n        if s.phase != PLAY or not s.inplay[p] or not s.alive[p]:\n            return\n        x, y = s.pos[p]\n        if a & 1 and p != s.imp and (x, y) in TASKS:\n            s.tasks |= 1 << TASKS.index((x, y))\n            if s.tasks == ALL_TASKS:\n                return s.end(1)\n        if a & 2 and p == s.imp and now >= s.kill_ready:\n            best = None\n            for q in range(s.n):\n                if q != p and s.inplay[q] and s.alive[q]:\n                    d = abs(s.pos[q][0] - x) + abs(s.pos[q][1] - y)\n                    if d <= 2 and (best is None or d < best[0]):\n                        best = (d, q)\n            if best:\n                q = best[1]\n                s.alive[q], s.body[q], s.kill_ready = 0, 1, now + s.kill_cd\n                s.check()\n        if a & 4 and s.phase == PLAY:\n            near = any(s.body[q] and abs(s.pos[q][0] - x) + abs(s.pos[q][1] - y) <= 2 for q in range(s.n))\n            if near or (x, y) == BUTTON:\n                s.phase, s.meet_end, s.vote, s.eject = MEET, now + s.meet_s, [0] * s.n, 255\n                s.body, s.dir = [0] * s.n, [0] * s.n\n                s.pos = [spawn(i) for i in range(s.n)]\n\n    def set_vote(s, p, v):\n        if s.phase == MEET and s.inplay[p] and s.alive[p]:\n            if v == SKIP or (1 <= v <= s.n and s.inplay[v - 1] and s.alive[v - 1]):\n                s.vote[p] = v\n\n    def tally(s, now):\n        cnt = {}\n        for i in range(s.n):\n            if s.inplay[i] and s.alive[i] and s.vote[i]:\n                cnt[s.vote[i]] = cnt.get(s.vote[i], 0) + 1\n        top = sorted(cnt.items(), key=lambda kv: -kv[1])\n        s.eject = 254\n        if top and (len(top) == 1 or top[0][1] > top[1][1]) and top[0][0] != SKIP:\n            q = top[0][0] - 1\n            s.alive[q], s.eject = 0, q\n            if q == s.imp:\n                return s.end(1)\n            s.check()\n            if s.phase == END:\n                return\n        s.phase, s.vote, s.dir, s.kill_ready = PLAY, [0] * s.n, [0] * s.n, now + s.kill_cd\n        s.pos = [spawn(i) for i in range(s.n)]\n\n    def view(s, present, now, acks):\n        pl = []\n        for i in range(s.n):\n            fl = s.alive[i] | ((1 if (s.inplay[i] or present[i]) else 0) << 1) | (s.body[i] << 2) | ((1 if s.vote[i] else 0) << 3)\n            pl.append((s.pos[i][0], s.pos[i][1], fl, acks[0][i], acks[1][i]))\n        return dict(phase=s.phase, winner=s.winner, tasks=s.tasks,\n                    meet_left=int(max(0, s.meet_end - now)) if s.phase == MEET else 0,\n                    n=s.n, reveal=s.imp if s.phase == END else 255, eject=s.eject, players=pl)\n\n\ndef pack_state(v, chat):\n    cid, cfrom, ctext = chat\n    out = struct.pack('!BBBBBBBBBB', v['phase'], v['winner'], v['tasks'], v['meet_left'], v['n'],\n                      v['reveal'], v['eject'], cid, cfrom, len(ctext)) + ctext\n    for x, y, fl, ca, ha in v['players']:\n        out += struct.pack('!BBBBB', x, y, fl, ca, ha)\n    return out\n\n\ndef unpack_state(pt):\n    ph, win, tk, ml, n, rev, ej, cid, cf, cl = struct.unpack('!BBBBBBBBBB', pt[:10])\n    text, o, pl = pt[10:10 + cl], 10 + cl, []\n    for i in range(n):\n        pl.append(struct.unpack('!BBBBB', pt[o + 5 * i:o + 5 * i + 5]))\n    return dict(phase=ph, winner=win, tasks=tk, meet_left=ml, n=n, reveal=rev, eject=ej, players=pl), (cid, cf, text)\n\n\n# ---------------- GNU Radio block ----------------\nclass blk(gr.basic_block):\n    def __init__(self, node_id=0, n_players=4, tick_ms=250, slot_ms=45, guard_ms=70,\n                 key='change-this-game-key', show_gui=1, bot=0, min_players=3, title='Among Us Lite'):\n        gr.basic_block.__init__(self, name=\"Among Us Lite Node\", in_sig=None, out_sig=None)\n        self.me, self.n = int(node_id), max(3, int(n_players))\n        self.host = self.me == 0\n        self.tick, self.slot, self.guard = tick_ms / 1000.0, slot_ms / 1000.0, guard_ms / 1000.0\n        self.key = str(key).encode()\n        self.show_gui, self.bot, self.title = bool(show_gui), bool(bot), str(title)\n        self.lk = threading.RLock()\n        self.running, self.seq, self.win = False, 0, None\n        self.dirv, self.pending, self.myvote, self.start_req = 0, 0, 0, False\n        self.chat_log, self.chat_out, self.cur_chat, self.last_chat_id = [], deque(), (0, b''), 0\n        self.role, self.view, self.t_state, self.prev, self.rng = None, None, 0.0, {}, random.Random()\n        self.cmd_id, self.bot_t, self.fail = 0, 0, 0\n        if self.host:\n            self.core, self.last_rx = Core(self.n), [0.0] * self.n\n            self.cmd_seen, self.chat_seen, self.roleack = [0] * self.n, [0] * self.n, [0] * self.n\n            self.seq_in, self.hchat, self.chat_id, self.chat_cur, self.rr = [None] * self.n, deque(), 0, (0, 0, b''), 0\n        else:\n            self.last_state_seq = None\n        self._bridge = None\n        if self.show_gui:\n            try:  # object created on the main (Qt) thread; its signal is queued to that thread\n                from PyQt5 import QtCore\n                if QtCore.QCoreApplication.instance() is not None:\n                    class _Bridge(QtCore.QObject):\n                        go = QtCore.pyqtSignal()\n                    self._bridge = _Bridge()\n                    self._bridge.go.connect(self._build_gui_safe)\n            except Exception as e:\n                print(\"game GUI bridge unavailable:\", e)\n        self.message_port_register_in(pmt.intern(\"rx_in\"))\n        self.message_port_register_out(pmt.intern(\"tx_out\"))\n        self.set_msg_handler(pmt.intern(\"rx_in\"), self.handle_rx)\n\n    # ---- lifecycle ----\n    def start(self):\n        self.running = True\n        if self.host:\n            threading.Thread(target=self._host_loop, daemon=True).start()\n        if self.show_gui:\n            if self._bridge is not None:\n                self._bridge.go.emit()\n            else:\n                self._build_gui_safe()\n        return True\n\n    def _build_gui_safe(self):\n        try:\n            self._build_gui()\n        except Exception as e:\n            print(\"game GUI disabled:\", repr(e))\n\n    def stop(self):\n        self.running = False\n        return True\n\n    # ---- radio I/O ----\n    def _send(self, typ, dest, payload):\n        self.seq = (self.seq + 1) & 0xFFFF\n        raw = seal(self.key, typ, self.me, dest, self.seq, payload)\n        self.message_port_pub(pmt.intern(\"tx_out\"), pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\n    def handle_rx(self, msg):\n        try:\n            if not pmt.is_pair(msg) or not pmt.is_u8vector(pmt.cdr(msg)):\n                return\n            r = unseal(self.key, bytes(pmt.u8vector_elements(pmt.cdr(msg))))\n            if r is None:\n                self.fail += 1\n                return\n            typ, snd, dst, seq, pt = r\n            now = time.time()\n            if snd == self.me:\n                return\n            with self.lk:\n                if self.host and typ == T_INPUT and 0 < snd < self.n and dst == 0:\n                    if newer(seq, self.seq_in[snd]):\n                        self.seq_in[snd] = seq\n                        self._on_input(snd, pt, now)\n                elif (not self.host) and snd == 0 and dst in (BCAST, self.me):\n                    if typ == T_STATE and newer(seq, self.last_state_seq):\n                        self.last_state_seq = seq\n                        self._on_state(pt, now)\n                    elif typ == T_ROLE and dst == self.me:\n                        self.role = pt[0]\n        except Exception as e:\n            print(\"game rx error:\", repr(e))\n\n    # ---- host ----\n    def _on_input(self, p, pt, now):\n        c = self.core\n        d, cmd, act, vote, cid, cl = struct.unpack('!BBBBBB', pt[:6])\n        text = pt[6:6 + cl]\n        self.last_rx[p] = now\n        c.dir[p] = d if d in DIRS else 0\n        if act & 0x80:\n            self.roleack[p] = 1\n        if (act & 7) and cmd != self.cmd_seen[p]:\n            c.act(p, act & 7, now)\n        self.cmd_seen[p] = cmd\n        c.set_vote(p, vote)\n        if cid and cid != self.chat_seen[p]:\n            self.hchat.append((p, text[:20]))\n            self.chat_seen[p] = cid\n\n    def _host_loop(self):\n        nxt = time.time()\n        while self.running:\n            now = time.time()\n            if now >= nxt:\n                nxt = max(nxt + self.tick, now + self.tick * 0.5)\n                try:\n                    self._host_tick(now)\n                except Exception as e:\n                    print(\"host tick error:\", repr(e))\n            time.sleep(0.002)\n\n    def _host_tick(self, now):\n        with self.lk:\n            c = self.core\n            present = [1 if (i == 0 or now - self.last_rx[i] < 3.0) else 0 for i in range(self.n)]\n            if self.bot:\n                self._bot(self.view_host(present, now), now, present)\n            if self.start_req:\n                self.start_req = False\n                if c.phase in (LOBBY, END):\n                    if c.phase == END:\n                        c.lobby()\n                    elif c.start(now, present):\n                        self.roleack = [1 if i == 0 else 0 for i in range(self.n)]\n                        self.role = 1 if c.imp == 0 else 0\n            c.dir[0] = self.dirv\n            if self.pending:\n                c.act(0, self.pending & 7, now)\n                self.pending = 0\n            if c.phase == MEET:\n                c.set_vote(0, self.myvote)\n            for i in range(1, self.n):\n                if not present[i]:\n                    c.dir[i] = 0\n            c.step(now)\n            if c.phase != MEET:\n                self.myvote = 0\n            if c.phase == LOBBY:\n                self.role = None\n            if self.hchat:\n                self.chat_id = self.chat_id % 255 + 1\n                f, t = self.hchat.popleft()\n                self.chat_cur = (self.chat_id, f, t)\n                self._log(f, t)\n            v = self.view_host(present, now)\n            self._set_view(v, now)\n            self._send(T_STATE, BCAST, pack_state(v, self.chat_cur))\n            if c.phase == PLAY:\n                for k in range(1, self.n):\n                    p = 1 + (self.rr + k - 1) % (self.n - 1)\n                    if c.inplay[p] and not self.roleack[p]:\n                        self.rr = p\n                        self._send(T_ROLE, p, bytes([1 if c.imp == p else 0]))\n                        break\n\n    def view_host(self, present, now):\n        return self.core.view(present, now, (self.cmd_seen, self.chat_seen))\n\n    # ---- client ----\n    def _on_state(self, pt, now):\n        v, chat = unpack_state(pt)\n        self._set_view(v, now)\n        cid, cf, text = chat\n        if cid and cid != self.last_chat_id:\n            self.last_chat_id = cid\n            self._log(cf, text)\n        if v['phase'] == LOBBY:\n            self.role = None\n        if v['phase'] != MEET:\n            self.myvote = 0\n        me = v['players'][self.me] if self.me < len(v['players']) else None\n        if me:\n            if me[3] == self.cmd_id:\n                self.pending = 0\n            if self.cur_chat[0] and me[4] == self.cur_chat[0]:\n                self.cur_chat = (0, b'')\n        if self.bot:\n            self._bot(v, now, None)\n        delay = self.guard + (self.me - 1) * self.slot\n        t = threading.Timer(delay, self._client_send)\n        t.daemon = True\n        t.start()\n\n    def _client_send(self):\n        if not self.running:\n            return\n        with self.lk:\n            if not self.cur_chat[0] and self.chat_out:\n                nid = self.cur_chat_id = (getattr(self, 'cur_chat_id', 0) % 255) + 1\n                self.cur_chat = (nid, self.chat_out.popleft()[:20])\n            cid, ct = self.cur_chat\n            act = (self.pending & 7) | (0x80 if self.role is not None else 0)\n            pl = struct.pack('!BBBBBB', self.dirv, self.cmd_id, act, self.myvote, cid, len(ct)) + ct\n        self._send(T_INPUT, 0, pl)\n\n    # ---- shared helpers ----\n    def _set_view(self, v, now):\n        old = self.view\n        if old:\n            self.prev = {i: self.display_pos(i, now) for i in range(len(old['players']))}\n        self.view, self.t_state = v, now\n\n    def display_pos(self, i, now):\n        v = self.view\n        if not v or i >= len(v['players']):\n            return (0, 0)\n        x, y = v['players'][i][0], v['players'][i][1]\n        px, py = self.prev.get(i, (x, y))\n        a = min(1.0, (now - self.t_state) / max(self.tick, 0.01))\n        return (px + (x - px) * a, py + (y - py) * a)\n\n    def _log(self, who, text):\n        try:\n            s = text.decode('utf-8', 'replace')\n        except Exception:\n            s = '?'\n        self.chat_log.append(\"P%d: %s\" % (who + 1, s))\n        del self.chat_log[:-60]\n\n    def request_action(self, bit):\n        with self.lk:\n            if self.host:\n                self.pending = bit\n            elif not self.pending:\n                self.cmd_id = self.cmd_id % 255 + 1\n                self.pending = bit\n\n    def send_chat(self, text):\n        t = text.encode('utf-8')[:20]\n        with self.lk:\n            if self.host:\n                self.hchat.append((0, t))\n            else:\n                self.chat_out.append(t)\n\n    def cast_vote(self, v):\n        with self.lk:\n            self.myvote = v\n\n    def _bot(self, v, now, present):\n        if now - self.bot_t < self.tick * 0.9:\n            return\n        self.bot_t = now\n        ph, me = v['phase'], self.me\n        pl = v['players']\n        if ph == LOBBY:\n            if self.host and present is not None and sum(present) >= self.min_players_n() and now - self.t0() > 1.5:\n                self.start_req = True\n            return\n        if ph == END:\n            if self.host and now - self.t_end(now) > 3:\n                self.start_req = True\n            return\n        mypos, alive = (pl[me][0], pl[me][1]), pl[me][2] & 1\n        if ph == MEET:\n            if alive and not self.myvote:\n                cands = [i + 1 for i in range(v['n']) if pl[i][2] & 1 and i != me]\n                self.cast_vote(self.rng.choice(cands + [SKIP]))\n            return\n        if not alive:\n            self.dirv = 0\n            return\n        imp = self.role == 1\n        self.dirv = 0\n        if imp:\n            tg = [(abs(p[0] - mypos[0]) + abs(p[1] - mypos[1]), i) for i, p in enumerate(pl)\n                  if i != me and p[2] & 1 and p[2] & 2]\n            if tg:\n                d, i = min(tg)\n                if d <= 2 and self.rng.random() < 0.5:\n                    self.request_action(2)\n                self.dirv = bfs_dir(mypos, (pl[i][0], pl[i][1]))\n        else:\n            todo = [t for k, t in enumerate(TASKS) if not v['tasks'] >> k & 1]\n            if todo:\n                tg = min(todo, key=lambda t: abs(t[0] - mypos[0]) + abs(t[1] - mypos[1]))\n                if mypos == tg:\n                    self.request_action(1)\n                else:\n                    self.dirv = bfs_dir(mypos, tg)\n            bodies = [(abs(p[0] - mypos[0]) + abs(p[1] - mypos[1])) for p in pl if p[2] & 4]\n            if bodies and min(bodies) <= 2:\n                self.request_action(4)\n\n    def min_players_n(self):\n        return 3\n\n    def t0(self):\n        if not hasattr(self, '_t0'):\n            self._t0 = time.time()\n        return self._t0\n\n    def t_end(self, now):\n        if not hasattr(self, '_te') or self._te_phase != END:\n            self._te, self._te_phase = now, END\n        return self._te\n\n    # ---- Qt GUI ----\n    def _build_gui(self):\n        from PyQt5 import QtCore, QtGui, QtWidgets\n        if QtWidgets.QApplication.instance() is None:\n            return\n        node = self\n        COL = ['#e53935', '#1e88e5', '#43a047', '#fdd835', '#8e24aa', '#fb8c00', '#00acc1', '#6d4c41']\n\n        class Board(QtWidgets.QWidget):\n            def __init__(s):\n                super().__init__()\n                s.setMinimumSize(640, 352)\n                s.setFocusPolicy(QtCore.Qt.StrongFocus)\n\n            def paintEvent(s, _):\n                p = QtGui.QPainter(s)\n                p.setRenderHint(QtGui.QPainter.Antialiasing)\n                cs = min(s.width() / W, s.height() / H)\n                p.fillRect(s.rect(), QtGui.QColor('#10141c'))\n                now = time.time()\n                with node.lk:\n                    v = node.view\n                    for y in range(H):\n                        for x in range(W):\n                            ch = MAP[y][x]\n                            col = '#2b3340' if ch == '#' else '#c9ccd3'\n                            p.fillRect(QtCore.QRectF(x * cs, y * cs, cs, cs), QtGui.QColor(col))\n                            if ch == 'T':\n                                k = TASKS.index((x, y))\n                                done = v and (v['tasks'] >> k & 1)\n                                p.fillRect(QtCore.QRectF(x * cs + cs * .2, y * cs + cs * .2, cs * .6, cs * .6),\n                                           QtGui.QColor('#43a047' if done else '#f9a825'))\n                            if ch == 'V':\n                                p.fillRect(QtCore.QRectF(x * cs + cs * .15, y * cs + cs * .15, cs * .7, cs * .7), QtGui.QColor('#d32f2f'))\n                    if v:\n                        for i, pl in enumerate(v['players']):\n                            if not pl[2] & 2:\n                                continue\n                            x, y = node.display_pos(i, now)\n                            c = QtGui.QColor(COL[i % 8])\n                            if pl[2] & 1:\n                                p.setBrush(c)\n                                p.setPen(QtGui.QPen(QtGui.QColor('white' if i == node.me else 'black'), 3 if i == node.me else 1))\n                                p.drawEllipse(QtCore.QRectF(x * cs + cs * .12, y * cs + cs * .12, cs * .76, cs * .76))\n                                p.setPen(QtGui.QColor('black'))\n                                p.drawText(QtCore.QRectF(x * cs, y * cs, cs, cs), QtCore.Qt.AlignCenter, str(i + 1))\n                            elif pl[2] & 4:\n                                p.setPen(QtGui.QPen(c, 4))\n                                p.drawLine(QtCore.QPointF(x * cs + 6, y * cs + 6), QtCore.QPointF(x * cs + cs - 6, y * cs + cs - 6))\n                                p.drawLine(QtCore.QPointF(x * cs + cs - 6, y * cs + 6), QtCore.QPointF(x * cs + 6, y * cs + cs - 6))\n                p.end()\n\n            def keyPressEvent(s, e):\n                if e.isAutoRepeat():\n                    return\n                k = {QtCore.Qt.Key_Up: 1, QtCore.Qt.Key_W: 1, QtCore.Qt.Key_Down: 2, QtCore.Qt.Key_S: 2,\n                     QtCore.Qt.Key_Left: 3, QtCore.Qt.Key_A: 3, QtCore.Qt.Key_Right: 4, QtCore.Qt.Key_D: 4}.get(e.key())\n                if k:\n                    held.append(k)\n                    node.dirv = k\n                elif e.key() == QtCore.Qt.Key_E:\n                    node.request_action(1)\n                elif e.key() == QtCore.Qt.Key_K:\n                    node.request_action(2)\n                elif e.key() == QtCore.Qt.Key_R:\n                    node.request_action(4)\n                elif QtCore.Qt.Key_1 <= e.key() <= QtCore.Qt.Key_8:\n                    node.cast_vote(e.key() - QtCore.Qt.Key_0)\n\n            def keyReleaseEvent(s, e):\n                if e.isAutoRepeat():\n                    return\n                k = {QtCore.Qt.Key_Up: 1, QtCore.Qt.Key_W: 1, QtCore.Qt.Key_Down: 2, QtCore.Qt.Key_S: 2,\n                     QtCore.Qt.Key_Left: 3, QtCore.Qt.Key_A: 3, QtCore.Qt.Key_Right: 4, QtCore.Qt.Key_D: 4}.get(e.key())\n                if k in held:\n                    held.remove(k)\n                node.dirv = held[-1] if held else 0\n\n        held = []\n        w = QtWidgets.QWidget()\n        w.setWindowTitle(\"%s - %s\" % (node.title, \"HOST\" if node.host else \"Player %d\" % (node.me + 1)))\n        board = Board()\n        status = QtWidgets.QLabel(\"\")\n        plist = QtWidgets.QListWidget()\n        chat = QtWidgets.QTextEdit()\n        chat.setReadOnly(True)\n        line = QtWidgets.QLineEdit()\n        line.setPlaceholderText(\"chat (20 chars), Enter to send; Esc = back to map\")\n        btns = QtWidgets.QHBoxLayout()\n        bt = {}\n        for key, label, fn in [(\"use\", \"Use [E]\", lambda: node.request_action(1)), (\"kill\", \"Kill [K] (impostor)\", lambda: node.request_action(2)),\n                               (\"report\", \"Report [R]\", lambda: node.request_action(4)), (\"skip\", \"Skip vote\", lambda: node.cast_vote(SKIP))]:\n            b = QtWidgets.QPushButton(label)\n            b.setFocusPolicy(QtCore.Qt.NoFocus)\n            b.clicked.connect(fn)\n            btns.addWidget(b)\n            bt[key] = b\n        if node.host:\n            sb = QtWidgets.QPushButton(\"START / NEW ROUND\")\n            sb.setFocusPolicy(QtCore.Qt.NoFocus)\n            sb.clicked.connect(lambda: setattr(node, 'start_req', True))\n            btns.addWidget(sb)\n        side = QtWidgets.QVBoxLayout()\n        plbl = QtWidgets.QLabel(\"Players\")\n        for x in (plbl, plist, chat, line):\n            side.addWidget(x)\n        top = QtWidgets.QHBoxLayout()\n        top.addWidget(board, 3)\n        top.addLayout(side, 1)\n        lay = QtWidgets.QVBoxLayout(w)\n        lay.addWidget(status)\n        lay.addLayout(top)\n        lay.addLayout(btns)\n        line.returnPressed.connect(lambda: (node.send_chat(line.text()), line.clear()))\n        plist.setFocusPolicy(QtCore.Qt.NoFocus)\n        plist.itemClicked.connect(lambda it: node.cast_vote(plist.row(it) + 1))\n        esc = QtWidgets.QShortcut(QtGui.QKeySequence(\"Esc\"), w)\n        esc.activated.connect(board.setFocus)\n        names = [\"LOBBY\", \"PLAYING\", \"MEETING\", \"GAME OVER\"]\n\n        def tick():\n            with node.lk:\n                v = node.view\n                if v:\n                    r = {None: \"\", 0: \"  |  You are CREW: do tasks (E)\", 1: \"  |  You are the IMPOSTOR: kill (K)\"}[node.role]\n                    t = \"%s%s  |  tasks %d/%d\" % (names[v['phase']], r, bin(v['tasks']).count('1'), len(TASKS))\n                    mv = \"SKIP\" if node.myvote == SKIP else (\"P%d\" % node.myvote if node.myvote else \"none yet\")\n                    me_alive = v['players'][node.me][2] & 1 if node.me < len(v['players']) else 0\n                    if v['phase'] == MEET:\n                        t += (\"  |  VOTE NOW (%ds left): click a player in the list, press 1-8, or Skip vote. Your vote: %s\" % (v['meet_left'], mv)) if me_alive else \"  |  meeting in progress (dead players cannot vote)\"\n                    if v['phase'] == END:\n                        t += \"  |  %s WIN (impostor was P%d)\" % (\"CREW\" if v['winner'] == 1 else \"IMPOSTOR\", v['reveal'] + 1)\n                    if not v['players'][node.me][2] & 1 and v['phase'] in (PLAY, MEET):\n                        t += \"  |  you are DEAD\"\n                    status.setText(t)\n                    playing, meeting = v['phase'] == PLAY and me_alive, v['phase'] == MEET and me_alive\n                    bt['use'].setEnabled(bool(playing))\n                    bt['kill'].setEnabled(bool(playing and node.role == 1))\n                    bt['report'].setEnabled(bool(playing))\n                    bt['skip'].setEnabled(bool(meeting))\n                    plbl.setText(\"CLICK A PLAYER TO VOTE FOR THEM\" if meeting else \"Players\")\n                    if plist.count() != v['n']:\n                        plist.clear()\n                        for i in range(v['n']):\n                            plist.addItem(\"\")\n                    for i, p in enumerate(v['players']):\n                        it = plist.item(i)\n                        it.setText(\"%d%s %s%s%s\" % (i + 1, \" (you)\" if i == node.me else \"\", \"\" if p[2] & 2 else \"[absent] \",\n                                                     \"\" if p[2] & 1 else \"[dead] \", \"[voted]\" if p[2] & 8 else (\"  <== your vote\" if (meeting and node.myvote == i + 1) else \"\")))\n                        it.setForeground(QtGui.QColor(COL[i % 8]))\n                else:\n                    status.setText(\"waiting for host signal...\")\n                txt = \"\\n\".join(node.chat_log)\n            if chat.toPlainText() != txt:\n                chat.setPlainText(txt)\n            board.update()\n\n        tm = QtCore.QTimer(w)\n        tm.timeout.connect(tick)\n        tm.start(40)\n        w.resize(1000, 520)\n        w.show()\n        board.setFocus()\n        self.win = (w, tm)\n"
    node_id: '0'
    n_players: n_players
    tick_ms: tick_ms
    slot_ms: slot_ms
    guard_ms: guard_ms
    key: game_key
    show_gui: '1'
    bot: '0'
    min_players: '3'
    title: '''Among Us Lite'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 5300
    - 200
    rotation: 0
    state: enabled
    _io_cache: ('Among Us Lite Node', 'blk', [('node_id', '0'), ('n_players', '4'), ('tick_ms', '250'), ('slot_ms', '45'), ('guard_ms', '70'), ('key', "'change-this-game-key'"), ('show_gui', '1'), ('bot', '0'), ('min_players', '3'), ('title', "'Among Us Lite'")], [('rx_in', 'message', 1)], [('tx_out', 'message', 1)], '', [])
- name: game_client_1
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: Game logic + PyQt5 window. node_id 0 = host.
    _source_code: "\"\"\"Among Us Lite node (host = node_id 0, clients = 1..n-1) for the QPSK GNU Radio link.\nPorts: rx_in (PDU from CRC Check 'ok'), tx_out (PDU to CRC Append).\nWire format (all small): 5-byte header (magic|type, sender, dest, seq16) + payload (keystream-XOR) + 4-byte MAC.\nSTATE (host->all, every tick) carries the whole world; INPUT (client->host) is sent in the client's own time slot.\nEvents (use/kill/report/chat) repeat until the host echoes their id, so no ACK packets are needed.\"\"\"\nimport hashlib, hmac, random, struct, threading, time\nfrom collections import deque\nfrom gnuradio import gr\nimport pmt\n\nMAP = [\"####################\",\n       \"#........#.........#\",\n       \"#.T......#......T..#\",\n       \"#........#.........#\",\n       \"#####.#######.######\",\n       \"#........V.........#\",\n       \"#####.#######.######\",\n       \"#........#.........#\",\n       \"#..T.....#.....T...#\",\n       \"#.......T#.........#\",\n       \"####################\"]\nW, H = len(MAP[0]), len(MAP)\nTASKS = [(x, y) for y in range(H) for x in range(W) if MAP[y][x] == 'T']\nBUTTON = [(x, y) for y in range(H) for x in range(W) if MAP[y][x] == 'V'][0]\nALL_TASKS = (1 << len(TASKS)) - 1\nDIRS = {1: (0, -1), 2: (0, 1), 3: (-1, 0), 4: (1, 0)}\nLOBBY, PLAY, MEET, END = 0, 1, 2, 3\nT_STATE, T_INPUT, T_ROLE = 1, 2, 3\nBCAST, MAGIC, SKIP = 255, 0xA0, 0xFE\n\n\ndef free(x, y):\n    return 0 <= x < W and 0 <= y < H and MAP[y][x] != '#'\n\n\ndef spawn(i):\n    return (2 + 2 * (i % 8), 5)\n\n\ndef bfs_dir(src, dst):\n    if src == dst:\n        return 0\n    q, seen = deque([(src, 0)]), {src}\n    while q:\n        (x, y), first = q.popleft()\n        for d, (dx, dy) in DIRS.items():\n            n = (x + dx, y + dy)\n            if n in seen or not free(*n):\n                continue\n            if n == dst:\n                return first or d\n            seen.add(n)\n            q.append((n, first or d))\n    return 0\n\n\n# ---------------- security / framing ----------------\ndef _ks(key, hdr, n):\n    out, c = b'', 0\n    while len(out) < n:\n        out += hashlib.sha256(key + hdr + bytes([c])).digest()\n        c += 1\n    return out[:n]\n\n\ndef seal(key, typ, sender, dest, seq, payload):\n    hdr = bytes([MAGIC | typ, sender, dest]) + struct.pack('!H', seq & 0xFFFF)\n    ct = bytes(a ^ b for a, b in zip(payload, _ks(key, hdr, len(payload))))\n    return hdr + ct + hmac.new(key, hdr + ct, hashlib.sha256).digest()[:4]\n\n\ndef unseal(key, raw):\n    if len(raw) < 9 or (raw[0] & 0xF0) != MAGIC:\n        return None\n    hdr, ct, mac = raw[:5], raw[5:-4], raw[-4:]\n    if not hmac.compare_digest(hmac.new(key, hdr + ct, hashlib.sha256).digest()[:4], mac):\n        return None\n    pt = bytes(a ^ b for a, b in zip(ct, _ks(key, hdr, len(ct))))\n    return hdr[0] & 0x0F, hdr[1], hdr[2], struct.unpack('!H', hdr[3:5])[0], pt\n\n\ndef newer(seq, last):\n    return last is None or 0 < ((seq - last) & 0xFFFF) < 0x8000\n\n\n# ---------------- authoritative game core (host only) ----------------\nclass Core:\n    def __init__(s, n, rng=None, kill_cd=8.0, meet_s=15.0):\n        s.n, s.rng, s.kill_cd, s.meet_s = n, rng or random.Random(), kill_cd, meet_s\n        s.lobby()\n\n    def lobby(s):\n        s.phase, s.winner, s.tasks, s.imp, s.eject = LOBBY, 0, 0, -1, 255\n        n = s.n\n        s.inplay, s.alive, s.body = [0] * n, [1] * n, [0] * n\n        s.dir, s.vote = [0] * n, [0] * n\n        s.pos = [spawn(i) for i in range(n)]\n        s.meet_end = s.kill_ready = 0\n\n    def start(s, now, present):\n        ids = [i for i in range(s.n) if present[i]]\n        if len(ids) < 3:\n            return False\n        s.lobby()\n        s.phase = PLAY\n        for i in ids:\n            s.inplay[i] = 1\n        s.alive = [1 if s.inplay[i] else 0 for i in range(s.n)]\n        s.imp, s.kill_ready = s.rng.choice(ids), now + s.kill_cd\n        return True\n\n    def end(s, w):\n        s.phase, s.winner = END, w\n\n    def check(s):\n        crew = [i for i in range(s.n) if s.inplay[i] and s.alive[i] and i != s.imp]\n        if not s.alive[s.imp]:\n            s.end(1)\n        elif len(crew) <= 1:\n            s.end(2)\n\n    def step(s, now):\n        if s.phase == PLAY:\n            for i in range(s.n):\n                if s.inplay[i] and s.alive[i] and s.dir[i] in DIRS:\n                    dx, dy = DIRS[s.dir[i]]\n                    x, y = s.pos[i]\n                    if free(x + dx, y + dy):\n                        s.pos[i] = (x + dx, y + dy)\n        elif s.phase == MEET:\n            voters = [i for i in range(s.n) if s.inplay[i] and s.alive[i]]\n            if now >= s.meet_end or all(s.vote[i] for i in voters):\n                s.tally(now)\n\n    def act(s, p, a, now):\n        if s.phase != PLAY or not s.inplay[p] or not s.alive[p]:\n            return\n        x, y = s.pos[p]\n        if a & 1 and p != s.imp and (x, y) in TASKS:\n            s.tasks |= 1 << TASKS.index((x, y))\n            if s.tasks == ALL_TASKS:\n                return s.end(1)\n        if a & 2 and p == s.imp and now >= s.kill_ready:\n            best = None\n            for q in range(s.n):\n                if q != p and s.inplay[q] and s.alive[q]:\n                    d = abs(s.pos[q][0] - x) + abs(s.pos[q][1] - y)\n                    if d <= 2 and (best is None or d < best[0]):\n                        best = (d, q)\n            if best:\n                q = best[1]\n                s.alive[q], s.body[q], s.kill_ready = 0, 1, now + s.kill_cd\n                s.check()\n        if a & 4 and s.phase == PLAY:\n            near = any(s.body[q] and abs(s.pos[q][0] - x) + abs(s.pos[q][1] - y) <= 2 for q in range(s.n))\n            if near or (x, y) == BUTTON:\n                s.phase, s.meet_end, s.vote, s.eject = MEET, now + s.meet_s, [0] * s.n, 255\n                s.body, s.dir = [0] * s.n, [0] * s.n\n                s.pos = [spawn(i) for i in range(s.n)]\n\n    def set_vote(s, p, v):\n        if s.phase == MEET and s.inplay[p] and s.alive[p]:\n            if v == SKIP or (1 <= v <= s.n and s.inplay[v - 1] and s.alive[v - 1]):\n                s.vote[p] = v\n\n    def tally(s, now):\n        cnt = {}\n        for i in range(s.n):\n            if s.inplay[i] and s.alive[i] and s.vote[i]:\n                cnt[s.vote[i]] = cnt.get(s.vote[i], 0) + 1\n        top = sorted(cnt.items(), key=lambda kv: -kv[1])\n        s.eject = 254\n        if top and (len(top) == 1 or top[0][1] > top[1][1]) and top[0][0] != SKIP:\n            q = top[0][0] - 1\n            s.alive[q], s.eject = 0, q\n            if q == s.imp:\n                return s.end(1)\n            s.check()\n            if s.phase == END:\n                return\n        s.phase, s.vote, s.dir, s.kill_ready = PLAY, [0] * s.n, [0] * s.n, now + s.kill_cd\n        s.pos = [spawn(i) for i in range(s.n)]\n\n    def view(s, present, now, acks):\n        pl = []\n        for i in range(s.n):\n            fl = s.alive[i] | ((1 if (s.inplay[i] or present[i]) else 0) << 1) | (s.body[i] << 2) | ((1 if s.vote[i] else 0) << 3)\n            pl.append((s.pos[i][0], s.pos[i][1], fl, acks[0][i], acks[1][i]))\n        return dict(phase=s.phase, winner=s.winner, tasks=s.tasks,\n                    meet_left=int(max(0, s.meet_end - now)) if s.phase == MEET else 0,\n                    n=s.n, reveal=s.imp if s.phase == END else 255, eject=s.eject, players=pl)\n\n\ndef pack_state(v, chat):\n    cid, cfrom, ctext = chat\n    out = struct.pack('!BBBBBBBBBB', v['phase'], v['winner'], v['tasks'], v['meet_left'], v['n'],\n                      v['reveal'], v['eject'], cid, cfrom, len(ctext)) + ctext\n    for x, y, fl, ca, ha in v['players']:\n        out += struct.pack('!BBBBB', x, y, fl, ca, ha)\n    return out\n\n\ndef unpack_state(pt):\n    ph, win, tk, ml, n, rev, ej, cid, cf, cl = struct.unpack('!BBBBBBBBBB', pt[:10])\n    text, o, pl = pt[10:10 + cl], 10 + cl, []\n    for i in range(n):\n        pl.append(struct.unpack('!BBBBB', pt[o + 5 * i:o + 5 * i + 5]))\n    return dict(phase=ph, winner=win, tasks=tk, meet_left=ml, n=n, reveal=rev, eject=ej, players=pl), (cid, cf, text)\n\n\n# ---------------- GNU Radio block ----------------\nclass blk(gr.basic_block):\n    def __init__(self, node_id=0, n_players=4, tick_ms=250, slot_ms=45, guard_ms=70,\n                 key='change-this-game-key', show_gui=1, bot=0, min_players=3, title='Among Us Lite'):\n        gr.basic_block.__init__(self, name=\"Among Us Lite Node\", in_sig=None, out_sig=None)\n        self.me, self.n = int(node_id), max(3, int(n_players))\n        self.host = self.me == 0\n        self.tick, self.slot, self.guard = tick_ms / 1000.0, slot_ms / 1000.0, guard_ms / 1000.0\n        self.key = str(key).encode()\n        self.show_gui, self.bot, self.title = bool(show_gui), bool(bot), str(title)\n        self.lk = threading.RLock()\n        self.running, self.seq, self.win = False, 0, None\n        self.dirv, self.pending, self.myvote, self.start_req = 0, 0, 0, False\n        self.chat_log, self.chat_out, self.cur_chat, self.last_chat_id = [], deque(), (0, b''), 0\n        self.role, self.view, self.t_state, self.prev, self.rng = None, None, 0.0, {}, random.Random()\n        self.cmd_id, self.bot_t, self.fail = 0, 0, 0\n        if self.host:\n            self.core, self.last_rx = Core(self.n), [0.0] * self.n\n            self.cmd_seen, self.chat_seen, self.roleack = [0] * self.n, [0] * self.n, [0] * self.n\n            self.seq_in, self.hchat, self.chat_id, self.chat_cur, self.rr = [None] * self.n, deque(), 0, (0, 0, b''), 0\n        else:\n            self.last_state_seq = None\n        self._bridge = None\n        if self.show_gui:\n            try:  # object created on the main (Qt) thread; its signal is queued to that thread\n                from PyQt5 import QtCore\n                if QtCore.QCoreApplication.instance() is not None:\n                    class _Bridge(QtCore.QObject):\n                        go = QtCore.pyqtSignal()\n                    self._bridge = _Bridge()\n                    self._bridge.go.connect(self._build_gui_safe)\n            except Exception as e:\n                print(\"game GUI bridge unavailable:\", e)\n        self.message_port_register_in(pmt.intern(\"rx_in\"))\n        self.message_port_register_out(pmt.intern(\"tx_out\"))\n        self.set_msg_handler(pmt.intern(\"rx_in\"), self.handle_rx)\n\n    # ---- lifecycle ----\n    def start(self):\n        self.running = True\n        if self.host:\n            threading.Thread(target=self._host_loop, daemon=True).start()\n        if self.show_gui:\n            if self._bridge is not None:\n                self._bridge.go.emit()\n            else:\n                self._build_gui_safe()\n        return True\n\n    def _build_gui_safe(self):\n        try:\n            self._build_gui()\n        except Exception as e:\n            print(\"game GUI disabled:\", repr(e))\n\n    def stop(self):\n        self.running = False\n        return True\n\n    # ---- radio I/O ----\n    def _send(self, typ, dest, payload):\n        self.seq = (self.seq + 1) & 0xFFFF\n        raw = seal(self.key, typ, self.me, dest, self.seq, payload)\n        self.message_port_pub(pmt.intern(\"tx_out\"), pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\n    def handle_rx(self, msg):\n        try:\n            if not pmt.is_pair(msg) or not pmt.is_u8vector(pmt.cdr(msg)):\n                return\n            r = unseal(self.key, bytes(pmt.u8vector_elements(pmt.cdr(msg))))\n            if r is None:\n                self.fail += 1\n                return\n            typ, snd, dst, seq, pt = r\n            now = time.time()\n            if snd == self.me:\n                return\n            with self.lk:\n                if self.host and typ == T_INPUT and 0 < snd < self.n and dst == 0:\n                    if newer(seq, self.seq_in[snd]):\n                        self.seq_in[snd] = seq\n                        self._on_input(snd, pt, now)\n                elif (not self.host) and snd == 0 and dst in (BCAST, self.me):\n                    if typ == T_STATE and newer(seq, self.last_state_seq):\n                        self.last_state_seq = seq\n                        self._on_state(pt, now)\n                    elif typ == T_ROLE and dst == self.me:\n                        self.role = pt[0]\n        except Exception as e:\n            print(\"game rx error:\", repr(e))\n\n    # ---- host ----\n    def _on_input(self, p, pt, now):\n        c = self.core\n        d, cmd, act, vote, cid, cl = struct.unpack('!BBBBBB', pt[:6])\n        text = pt[6:6 + cl]\n        self.last_rx[p] = now\n        c.dir[p] = d if d in DIRS else 0\n        if act & 0x80:\n            self.roleack[p] = 1\n        if (act & 7) and cmd != self.cmd_seen[p]:\n            c.act(p, act & 7, now)\n        self.cmd_seen[p] = cmd\n        c.set_vote(p, vote)\n        if cid and cid != self.chat_seen[p]:\n            self.hchat.append((p, text[:20]))\n            self.chat_seen[p] = cid\n\n    def _host_loop(self):\n        nxt = time.time()\n        while self.running:\n            now = time.time()\n            if now >= nxt:\n                nxt = max(nxt + self.tick, now + self.tick * 0.5)\n                try:\n                    self._host_tick(now)\n                except Exception as e:\n                    print(\"host tick error:\", repr(e))\n            time.sleep(0.002)\n\n    def _host_tick(self, now):\n        with self.lk:\n            c = self.core\n            present = [1 if (i == 0 or now - self.last_rx[i] < 3.0) else 0 for i in range(self.n)]\n            if self.bot:\n                self._bot(self.view_host(present, now), now, present)\n            if self.start_req:\n                self.start_req = False\n                if c.phase in (LOBBY, END):\n                    if c.phase == END:\n                        c.lobby()\n                    elif c.start(now, present):\n                        self.roleack = [1 if i == 0 else 0 for i in range(self.n)]\n                        self.role = 1 if c.imp == 0 else 0\n            c.dir[0] = self.dirv\n            if self.pending:\n                c.act(0, self.pending & 7, now)\n                self.pending = 0\n            if c.phase == MEET:\n                c.set_vote(0, self.myvote)\n            for i in range(1, self.n):\n                if not present[i]:\n                    c.dir[i] = 0\n            c.step(now)\n            if c.phase != MEET:\n                self.myvote = 0\n            if c.phase == LOBBY:\n                self.role = None\n            if self.hchat:\n                self.chat_id = self.chat_id % 255 + 1\n                f, t = self.hchat.popleft()\n                self.chat_cur = (self.chat_id, f, t)\n                self._log(f, t)\n            v = self.view_host(present, now)\n            self._set_view(v, now)\n            self._send(T_STATE, BCAST, pack_state(v, self.chat_cur))\n            if c.phase == PLAY:\n                for k in range(1, self.n):\n                    p = 1 + (self.rr + k - 1) % (self.n - 1)\n                    if c.inplay[p] and not self.roleack[p]:\n                        self.rr = p\n                        self._send(T_ROLE, p, bytes([1 if c.imp == p else 0]))\n                        break\n\n    def view_host(self, present, now):\n        return self.core.view(present, now, (self.cmd_seen, self.chat_seen))\n\n    # ---- client ----\n    def _on_state(self, pt, now):\n        v, chat = unpack_state(pt)\n        self._set_view(v, now)\n        cid, cf, text = chat\n        if cid and cid != self.last_chat_id:\n            self.last_chat_id = cid\n            self._log(cf, text)\n        if v['phase'] == LOBBY:\n            self.role = None\n        if v['phase'] != MEET:\n            self.myvote = 0\n        me = v['players'][self.me] if self.me < len(v['players']) else None\n        if me:\n            if me[3] == self.cmd_id:\n                self.pending = 0\n            if self.cur_chat[0] and me[4] == self.cur_chat[0]:\n                self.cur_chat = (0, b'')\n        if self.bot:\n            self._bot(v, now, None)\n        delay = self.guard + (self.me - 1) * self.slot\n        t = threading.Timer(delay, self._client_send)\n        t.daemon = True\n        t.start()\n\n    def _client_send(self):\n        if not self.running:\n            return\n        with self.lk:\n            if not self.cur_chat[0] and self.chat_out:\n                nid = self.cur_chat_id = (getattr(self, 'cur_chat_id', 0) % 255) + 1\n                self.cur_chat = (nid, self.chat_out.popleft()[:20])\n            cid, ct = self.cur_chat\n            act = (self.pending & 7) | (0x80 if self.role is not None else 0)\n            pl = struct.pack('!BBBBBB', self.dirv, self.cmd_id, act, self.myvote, cid, len(ct)) + ct\n        self._send(T_INPUT, 0, pl)\n\n    # ---- shared helpers ----\n    def _set_view(self, v, now):\n        old = self.view\n        if old:\n            self.prev = {i: self.display_pos(i, now) for i in range(len(old['players']))}\n        self.view, self.t_state = v, now\n\n    def display_pos(self, i, now):\n        v = self.view\n        if not v or i >= len(v['players']):\n            return (0, 0)\n        x, y = v['players'][i][0], v['players'][i][1]\n        px, py = self.prev.get(i, (x, y))\n        a = min(1.0, (now - self.t_state) / max(self.tick, 0.01))\n        return (px + (x - px) * a, py + (y - py) * a)\n\n    def _log(self, who, text):\n        try:\n            s = text.decode('utf-8', 'replace')\n        except Exception:\n            s = '?'\n        self.chat_log.append(\"P%d: %s\" % (who + 1, s))\n        del self.chat_log[:-60]\n\n    def request_action(self, bit):\n        with self.lk:\n            if self.host:\n                self.pending = bit\n            elif not self.pending:\n                self.cmd_id = self.cmd_id % 255 + 1\n                self.pending = bit\n\n    def send_chat(self, text):\n        t = text.encode('utf-8')[:20]\n        with self.lk:\n            if self.host:\n                self.hchat.append((0, t))\n            else:\n                self.chat_out.append(t)\n\n    def cast_vote(self, v):\n        with self.lk:\n            self.myvote = v\n\n    def _bot(self, v, now, present):\n        if now - self.bot_t < self.tick * 0.9:\n            return\n        self.bot_t = now\n        ph, me = v['phase'], self.me\n        pl = v['players']\n        if ph == LOBBY:\n            if self.host and present is not None and sum(present) >= self.min_players_n() and now - self.t0() > 1.5:\n                self.start_req = True\n            return\n        if ph == END:\n            if self.host and now - self.t_end(now) > 3:\n                self.start_req = True\n            return\n        mypos, alive = (pl[me][0], pl[me][1]), pl[me][2] & 1\n        if ph == MEET:\n            if alive and not self.myvote:\n                cands = [i + 1 for i in range(v['n']) if pl[i][2] & 1 and i != me]\n                self.cast_vote(self.rng.choice(cands + [SKIP]))\n            return\n        if not alive:\n            self.dirv = 0\n            return\n        imp = self.role == 1\n        self.dirv = 0\n        if imp:\n            tg = [(abs(p[0] - mypos[0]) + abs(p[1] - mypos[1]), i) for i, p in enumerate(pl)\n                  if i != me and p[2] & 1 and p[2] & 2]\n            if tg:\n                d, i = min(tg)\n                if d <= 2 and self.rng.random() < 0.5:\n                    self.request_action(2)\n                self.dirv = bfs_dir(mypos, (pl[i][0], pl[i][1]))\n        else:\n            todo = [t for k, t in enumerate(TASKS) if not v['tasks'] >> k & 1]\n            if todo:\n                tg = min(todo, key=lambda t: abs(t[0] - mypos[0]) + abs(t[1] - mypos[1]))\n                if mypos == tg:\n                    self.request_action(1)\n                else:\n                    self.dirv = bfs_dir(mypos, tg)\n            bodies = [(abs(p[0] - mypos[0]) + abs(p[1] - mypos[1])) for p in pl if p[2] & 4]\n            if bodies and min(bodies) <= 2:\n                self.request_action(4)\n\n    def min_players_n(self):\n        return 3\n\n    def t0(self):\n        if not hasattr(self, '_t0'):\n            self._t0 = time.time()\n        return self._t0\n\n    def t_end(self, now):\n        if not hasattr(self, '_te') or self._te_phase != END:\n            self._te, self._te_phase = now, END\n        return self._te\n\n    # ---- Qt GUI ----\n    def _build_gui(self):\n        from PyQt5 import QtCore, QtGui, QtWidgets\n        if QtWidgets.QApplication.instance() is None:\n            return\n        node = self\n        COL = ['#e53935', '#1e88e5', '#43a047', '#fdd835', '#8e24aa', '#fb8c00', '#00acc1', '#6d4c41']\n\n        class Board(QtWidgets.QWidget):\n            def __init__(s):\n                super().__init__()\n                s.setMinimumSize(640, 352)\n                s.setFocusPolicy(QtCore.Qt.StrongFocus)\n\n            def paintEvent(s, _):\n                p = QtGui.QPainter(s)\n                p.setRenderHint(QtGui.QPainter.Antialiasing)\n                cs = min(s.width() / W, s.height() / H)\n                p.fillRect(s.rect(), QtGui.QColor('#10141c'))\n                now = time.time()\n                with node.lk:\n                    v = node.view\n                    for y in range(H):\n                        for x in range(W):\n                            ch = MAP[y][x]\n                            col = '#2b3340' if ch == '#' else '#c9ccd3'\n                            p.fillRect(QtCore.QRectF(x * cs, y * cs, cs, cs), QtGui.QColor(col))\n                            if ch == 'T':\n                                k = TASKS.index((x, y))\n                                done = v and (v['tasks'] >> k & 1)\n                                p.fillRect(QtCore.QRectF(x * cs + cs * .2, y * cs + cs * .2, cs * .6, cs * .6),\n                                           QtGui.QColor('#43a047' if done else '#f9a825'))\n                            if ch == 'V':\n                                p.fillRect(QtCore.QRectF(x * cs + cs * .15, y * cs + cs * .15, cs * .7, cs * .7), QtGui.QColor('#d32f2f'))\n                    if v:\n                        for i, pl in enumerate(v['players']):\n                            if not pl[2] & 2:\n                                continue\n                            x, y = node.display_pos(i, now)\n                            c = QtGui.QColor(COL[i % 8])\n                            if pl[2] & 1:\n                                p.setBrush(c)\n                                p.setPen(QtGui.QPen(QtGui.QColor('white' if i == node.me else 'black'), 3 if i == node.me else 1))\n                                p.drawEllipse(QtCore.QRectF(x * cs + cs * .12, y * cs + cs * .12, cs * .76, cs * .76))\n                                p.setPen(QtGui.QColor('black'))\n                                p.drawText(QtCore.QRectF(x * cs, y * cs, cs, cs), QtCore.Qt.AlignCenter, str(i + 1))\n                            elif pl[2] & 4:\n                                p.setPen(QtGui.QPen(c, 4))\n                                p.drawLine(QtCore.QPointF(x * cs + 6, y * cs + 6), QtCore.QPointF(x * cs + cs - 6, y * cs + cs - 6))\n                                p.drawLine(QtCore.QPointF(x * cs + cs - 6, y * cs + 6), QtCore.QPointF(x * cs + 6, y * cs + cs - 6))\n                p.end()\n\n            def keyPressEvent(s, e):\n                if e.isAutoRepeat():\n                    return\n                k = {QtCore.Qt.Key_Up: 1, QtCore.Qt.Key_W: 1, QtCore.Qt.Key_Down: 2, QtCore.Qt.Key_S: 2,\n                     QtCore.Qt.Key_Left: 3, QtCore.Qt.Key_A: 3, QtCore.Qt.Key_Right: 4, QtCore.Qt.Key_D: 4}.get(e.key())\n                if k:\n                    held.append(k)\n                    node.dirv = k\n                elif e.key() == QtCore.Qt.Key_E:\n                    node.request_action(1)\n                elif e.key() == QtCore.Qt.Key_K:\n                    node.request_action(2)\n                elif e.key() == QtCore.Qt.Key_R:\n                    node.request_action(4)\n                elif QtCore.Qt.Key_1 <= e.key() <= QtCore.Qt.Key_8:\n                    node.cast_vote(e.key() - QtCore.Qt.Key_0)\n\n            def keyReleaseEvent(s, e):\n                if e.isAutoRepeat():\n                    return\n                k = {QtCore.Qt.Key_Up: 1, QtCore.Qt.Key_W: 1, QtCore.Qt.Key_Down: 2, QtCore.Qt.Key_S: 2,\n                     QtCore.Qt.Key_Left: 3, QtCore.Qt.Key_A: 3, QtCore.Qt.Key_Right: 4, QtCore.Qt.Key_D: 4}.get(e.key())\n                if k in held:\n                    held.remove(k)\n                node.dirv = held[-1] if held else 0\n\n        held = []\n        w = QtWidgets.QWidget()\n        w.setWindowTitle(\"%s - %s\" % (node.title, \"HOST\" if node.host else \"Player %d\" % (node.me + 1)))\n        board = Board()\n        status = QtWidgets.QLabel(\"\")\n        plist = QtWidgets.QListWidget()\n        chat = QtWidgets.QTextEdit()\n        chat.setReadOnly(True)\n        line = QtWidgets.QLineEdit()\n        line.setPlaceholderText(\"chat (20 chars), Enter to send; Esc = back to map\")\n        btns = QtWidgets.QHBoxLayout()\n        bt = {}\n        for key, label, fn in [(\"use\", \"Use [E]\", lambda: node.request_action(1)), (\"kill\", \"Kill [K] (impostor)\", lambda: node.request_action(2)),\n                               (\"report\", \"Report [R]\", lambda: node.request_action(4)), (\"skip\", \"Skip vote\", lambda: node.cast_vote(SKIP))]:\n            b = QtWidgets.QPushButton(label)\n            b.setFocusPolicy(QtCore.Qt.NoFocus)\n            b.clicked.connect(fn)\n            btns.addWidget(b)\n            bt[key] = b\n        if node.host:\n            sb = QtWidgets.QPushButton(\"START / NEW ROUND\")\n            sb.setFocusPolicy(QtCore.Qt.NoFocus)\n            sb.clicked.connect(lambda: setattr(node, 'start_req', True))\n            btns.addWidget(sb)\n        side = QtWidgets.QVBoxLayout()\n        plbl = QtWidgets.QLabel(\"Players\")\n        for x in (plbl, plist, chat, line):\n            side.addWidget(x)\n        top = QtWidgets.QHBoxLayout()\n        top.addWidget(board, 3)\n        top.addLayout(side, 1)\n        lay = QtWidgets.QVBoxLayout(w)\n        lay.addWidget(status)\n        lay.addLayout(top)\n        lay.addLayout(btns)\n        line.returnPressed.connect(lambda: (node.send_chat(line.text()), line.clear()))\n        plist.setFocusPolicy(QtCore.Qt.NoFocus)\n        plist.itemClicked.connect(lambda it: node.cast_vote(plist.row(it) + 1))\n        esc = QtWidgets.QShortcut(QtGui.QKeySequence(\"Esc\"), w)\n        esc.activated.connect(board.setFocus)\n        names = [\"LOBBY\", \"PLAYING\", \"MEETING\", \"GAME OVER\"]\n\n        def tick():\n            with node.lk:\n                v = node.view\n                if v:\n                    r = {None: \"\", 0: \"  |  You are CREW: do tasks (E)\", 1: \"  |  You are the IMPOSTOR: kill (K)\"}[node.role]\n                    t = \"%s%s  |  tasks %d/%d\" % (names[v['phase']], r, bin(v['tasks']).count('1'), len(TASKS))\n                    mv = \"SKIP\" if node.myvote == SKIP else (\"P%d\" % node.myvote if node.myvote else \"none yet\")\n                    me_alive = v['players'][node.me][2] & 1 if node.me < len(v['players']) else 0\n                    if v['phase'] == MEET:\n                        t += (\"  |  VOTE NOW (%ds left): click a player in the list, press 1-8, or Skip vote. Your vote: %s\" % (v['meet_left'], mv)) if me_alive else \"  |  meeting in progress (dead players cannot vote)\"\n                    if v['phase'] == END:\n                        t += \"  |  %s WIN (impostor was P%d)\" % (\"CREW\" if v['winner'] == 1 else \"IMPOSTOR\", v['reveal'] + 1)\n                    if not v['players'][node.me][2] & 1 and v['phase'] in (PLAY, MEET):\n                        t += \"  |  you are DEAD\"\n                    status.setText(t)\n                    playing, meeting = v['phase'] == PLAY and me_alive, v['phase'] == MEET and me_alive\n                    bt['use'].setEnabled(bool(playing))\n                    bt['kill'].setEnabled(bool(playing and node.role == 1))\n                    bt['report'].setEnabled(bool(playing))\n                    bt['skip'].setEnabled(bool(meeting))\n                    plbl.setText(\"CLICK A PLAYER TO VOTE FOR THEM\" if meeting else \"Players\")\n                    if plist.count() != v['n']:\n                        plist.clear()\n                        for i in range(v['n']):\n                            plist.addItem(\"\")\n                    for i, p in enumerate(v['players']):\n                        it = plist.item(i)\n                        it.setText(\"%d%s %s%s%s\" % (i + 1, \" (you)\" if i == node.me else \"\", \"\" if p[2] & 2 else \"[absent] \",\n                                                     \"\" if p[2] & 1 else \"[dead] \", \"[voted]\" if p[2] & 8 else (\"  <== your vote\" if (meeting and node.myvote == i + 1) else \"\")))\n                        it.setForeground(QtGui.QColor(COL[i % 8]))\n                else:\n                    status.setText(\"waiting for host signal...\")\n                txt = \"\\n\".join(node.chat_log)\n            if chat.toPlainText() != txt:\n                chat.setPlainText(txt)\n            board.update()\n\n        tm = QtCore.QTimer(w)\n        tm.timeout.connect(tick)\n        tm.start(40)\n        w.resize(1000, 520)\n        w.show()\n        board.setFocus()\n        self.win = (w, tm)\n"
    node_id: '1'
    n_players: n_players
    tick_ms: tick_ms
    slot_ms: slot_ms
    guard_ms: guard_ms
    key: game_key
    show_gui: '1'
    bot: '1'
    min_players: '3'
    title: '''Among Us Lite'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 5300
    - 300
    rotation: 0
    state: enabled
    _io_cache: ('Among Us Lite Node', 'blk', [('node_id', '0'), ('n_players', '4'), ('tick_ms', '250'), ('slot_ms', '45'), ('guard_ms', '70'), ('key', "'change-this-game-key'"), ('show_gui', '1'), ('bot', '0'), ('min_players', '3'), ('title', "'Among Us Lite'")], [('rx_in', 'message', 1)], [('tx_out', 'message', 1)], '', [])
- name: game_client_2
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: Game logic + PyQt5 window. node_id 0 = host.
    _source_code: "\"\"\"Among Us Lite node (host = node_id 0, clients = 1..n-1) for the QPSK GNU Radio link.\nPorts: rx_in (PDU from CRC Check 'ok'), tx_out (PDU to CRC Append).\nWire format (all small): 5-byte header (magic|type, sender, dest, seq16) + payload (keystream-XOR) + 4-byte MAC.\nSTATE (host->all, every tick) carries the whole world; INPUT (client->host) is sent in the client's own time slot.\nEvents (use/kill/report/chat) repeat until the host echoes their id, so no ACK packets are needed.\"\"\"\nimport hashlib, hmac, random, struct, threading, time\nfrom collections import deque\nfrom gnuradio import gr\nimport pmt\n\nMAP = [\"####################\",\n       \"#........#.........#\",\n       \"#.T......#......T..#\",\n       \"#........#.........#\",\n       \"#####.#######.######\",\n       \"#........V.........#\",\n       \"#####.#######.######\",\n       \"#........#.........#\",\n       \"#..T.....#.....T...#\",\n       \"#.......T#.........#\",\n       \"####################\"]\nW, H = len(MAP[0]), len(MAP)\nTASKS = [(x, y) for y in range(H) for x in range(W) if MAP[y][x] == 'T']\nBUTTON = [(x, y) for y in range(H) for x in range(W) if MAP[y][x] == 'V'][0]\nALL_TASKS = (1 << len(TASKS)) - 1\nDIRS = {1: (0, -1), 2: (0, 1), 3: (-1, 0), 4: (1, 0)}\nLOBBY, PLAY, MEET, END = 0, 1, 2, 3\nT_STATE, T_INPUT, T_ROLE = 1, 2, 3\nBCAST, MAGIC, SKIP = 255, 0xA0, 0xFE\n\n\ndef free(x, y):\n    return 0 <= x < W and 0 <= y < H and MAP[y][x] != '#'\n\n\ndef spawn(i):\n    return (2 + 2 * (i % 8), 5)\n\n\ndef bfs_dir(src, dst):\n    if src == dst:\n        return 0\n    q, seen = deque([(src, 0)]), {src}\n    while q:\n        (x, y), first = q.popleft()\n        for d, (dx, dy) in DIRS.items():\n            n = (x + dx, y + dy)\n            if n in seen or not free(*n):\n                continue\n            if n == dst:\n                return first or d\n            seen.add(n)\n            q.append((n, first or d))\n    return 0\n\n\n# ---------------- security / framing ----------------\ndef _ks(key, hdr, n):\n    out, c = b'', 0\n    while len(out) < n:\n        out += hashlib.sha256(key + hdr + bytes([c])).digest()\n        c += 1\n    return out[:n]\n\n\ndef seal(key, typ, sender, dest, seq, payload):\n    hdr = bytes([MAGIC | typ, sender, dest]) + struct.pack('!H', seq & 0xFFFF)\n    ct = bytes(a ^ b for a, b in zip(payload, _ks(key, hdr, len(payload))))\n    return hdr + ct + hmac.new(key, hdr + ct, hashlib.sha256).digest()[:4]\n\n\ndef unseal(key, raw):\n    if len(raw) < 9 or (raw[0] & 0xF0) != MAGIC:\n        return None\n    hdr, ct, mac = raw[:5], raw[5:-4], raw[-4:]\n    if not hmac.compare_digest(hmac.new(key, hdr + ct, hashlib.sha256).digest()[:4], mac):\n        return None\n    pt = bytes(a ^ b for a, b in zip(ct, _ks(key, hdr, len(ct))))\n    return hdr[0] & 0x0F, hdr[1], hdr[2], struct.unpack('!H', hdr[3:5])[0], pt\n\n\ndef newer(seq, last):\n    return last is None or 0 < ((seq - last) & 0xFFFF) < 0x8000\n\n\n# ---------------- authoritative game core (host only) ----------------\nclass Core:\n    def __init__(s, n, rng=None, kill_cd=8.0, meet_s=15.0):\n        s.n, s.rng, s.kill_cd, s.meet_s = n, rng or random.Random(), kill_cd, meet_s\n        s.lobby()\n\n    def lobby(s):\n        s.phase, s.winner, s.tasks, s.imp, s.eject = LOBBY, 0, 0, -1, 255\n        n = s.n\n        s.inplay, s.alive, s.body = [0] * n, [1] * n, [0] * n\n        s.dir, s.vote = [0] * n, [0] * n\n        s.pos = [spawn(i) for i in range(n)]\n        s.meet_end = s.kill_ready = 0\n\n    def start(s, now, present):\n        ids = [i for i in range(s.n) if present[i]]\n        if len(ids) < 3:\n            return False\n        s.lobby()\n        s.phase = PLAY\n        for i in ids:\n            s.inplay[i] = 1\n        s.alive = [1 if s.inplay[i] else 0 for i in range(s.n)]\n        s.imp, s.kill_ready = s.rng.choice(ids), now + s.kill_cd\n        return True\n\n    def end(s, w):\n        s.phase, s.winner = END, w\n\n    def check(s):\n        crew = [i for i in range(s.n) if s.inplay[i] and s.alive[i] and i != s.imp]\n        if not s.alive[s.imp]:\n            s.end(1)\n        elif len(crew) <= 1:\n            s.end(2)\n\n    def step(s, now):\n        if s.phase == PLAY:\n            for i in range(s.n):\n                if s.inplay[i] and s.alive[i] and s.dir[i] in DIRS:\n                    dx, dy = DIRS[s.dir[i]]\n                    x, y = s.pos[i]\n                    if free(x + dx, y + dy):\n                        s.pos[i] = (x + dx, y + dy)\n        elif s.phase == MEET:\n            voters = [i for i in range(s.n) if s.inplay[i] and s.alive[i]]\n            if now >= s.meet_end or all(s.vote[i] for i in voters):\n                s.tally(now)\n\n    def act(s, p, a, now):\n        if s.phase != PLAY or not s.inplay[p] or not s.alive[p]:\n            return\n        x, y = s.pos[p]\n        if a & 1 and p != s.imp and (x, y) in TASKS:\n            s.tasks |= 1 << TASKS.index((x, y))\n            if s.tasks == ALL_TASKS:\n                return s.end(1)\n        if a & 2 and p == s.imp and now >= s.kill_ready:\n            best = None\n            for q in range(s.n):\n                if q != p and s.inplay[q] and s.alive[q]:\n                    d = abs(s.pos[q][0] - x) + abs(s.pos[q][1] - y)\n                    if d <= 2 and (best is None or d < best[0]):\n                        best = (d, q)\n            if best:\n                q = best[1]\n                s.alive[q], s.body[q], s.kill_ready = 0, 1, now + s.kill_cd\n                s.check()\n        if a & 4 and s.phase == PLAY:\n            near = any(s.body[q] and abs(s.pos[q][0] - x) + abs(s.pos[q][1] - y) <= 2 for q in range(s.n))\n            if near or (x, y) == BUTTON:\n                s.phase, s.meet_end, s.vote, s.eject = MEET, now + s.meet_s, [0] * s.n, 255\n                s.body, s.dir = [0] * s.n, [0] * s.n\n                s.pos = [spawn(i) for i in range(s.n)]\n\n    def set_vote(s, p, v):\n        if s.phase == MEET and s.inplay[p] and s.alive[p]:\n            if v == SKIP or (1 <= v <= s.n and s.inplay[v - 1] and s.alive[v - 1]):\n                s.vote[p] = v\n\n    def tally(s, now):\n        cnt = {}\n        for i in range(s.n):\n            if s.inplay[i] and s.alive[i] and s.vote[i]:\n                cnt[s.vote[i]] = cnt.get(s.vote[i], 0) + 1\n        top = sorted(cnt.items(), key=lambda kv: -kv[1])\n        s.eject = 254\n        if top and (len(top) == 1 or top[0][1] > top[1][1]) and top[0][0] != SKIP:\n            q = top[0][0] - 1\n            s.alive[q], s.eject = 0, q\n            if q == s.imp:\n                return s.end(1)\n            s.check()\n            if s.phase == END:\n                return\n        s.phase, s.vote, s.dir, s.kill_ready = PLAY, [0] * s.n, [0] * s.n, now + s.kill_cd\n        s.pos = [spawn(i) for i in range(s.n)]\n\n    def view(s, present, now, acks):\n        pl = []\n        for i in range(s.n):\n            fl = s.alive[i] | ((1 if (s.inplay[i] or present[i]) else 0) << 1) | (s.body[i] << 2) | ((1 if s.vote[i] else 0) << 3)\n            pl.append((s.pos[i][0], s.pos[i][1], fl, acks[0][i], acks[1][i]))\n        return dict(phase=s.phase, winner=s.winner, tasks=s.tasks,\n                    meet_left=int(max(0, s.meet_end - now)) if s.phase == MEET else 0,\n                    n=s.n, reveal=s.imp if s.phase == END else 255, eject=s.eject, players=pl)\n\n\ndef pack_state(v, chat):\n    cid, cfrom, ctext = chat\n    out = struct.pack('!BBBBBBBBBB', v['phase'], v['winner'], v['tasks'], v['meet_left'], v['n'],\n                      v['reveal'], v['eject'], cid, cfrom, len(ctext)) + ctext\n    for x, y, fl, ca, ha in v['players']:\n        out += struct.pack('!BBBBB', x, y, fl, ca, ha)\n    return out\n\n\ndef unpack_state(pt):\n    ph, win, tk, ml, n, rev, ej, cid, cf, cl = struct.unpack('!BBBBBBBBBB', pt[:10])\n    text, o, pl = pt[10:10 + cl], 10 + cl, []\n    for i in range(n):\n        pl.append(struct.unpack('!BBBBB', pt[o + 5 * i:o + 5 * i + 5]))\n    return dict(phase=ph, winner=win, tasks=tk, meet_left=ml, n=n, reveal=rev, eject=ej, players=pl), (cid, cf, text)\n\n\n# ---------------- GNU Radio block ----------------\nclass blk(gr.basic_block):\n    def __init__(self, node_id=0, n_players=4, tick_ms=250, slot_ms=45, guard_ms=70,\n                 key='change-this-game-key', show_gui=1, bot=0, min_players=3, title='Among Us Lite'):\n        gr.basic_block.__init__(self, name=\"Among Us Lite Node\", in_sig=None, out_sig=None)\n        self.me, self.n = int(node_id), max(3, int(n_players))\n        self.host = self.me == 0\n        self.tick, self.slot, self.guard = tick_ms / 1000.0, slot_ms / 1000.0, guard_ms / 1000.0\n        self.key = str(key).encode()\n        self.show_gui, self.bot, self.title = bool(show_gui), bool(bot), str(title)\n        self.lk = threading.RLock()\n        self.running, self.seq, self.win = False, 0, None\n        self.dirv, self.pending, self.myvote, self.start_req = 0, 0, 0, False\n        self.chat_log, self.chat_out, self.cur_chat, self.last_chat_id = [], deque(), (0, b''), 0\n        self.role, self.view, self.t_state, self.prev, self.rng = None, None, 0.0, {}, random.Random()\n        self.cmd_id, self.bot_t, self.fail = 0, 0, 0\n        if self.host:\n            self.core, self.last_rx = Core(self.n), [0.0] * self.n\n            self.cmd_seen, self.chat_seen, self.roleack = [0] * self.n, [0] * self.n, [0] * self.n\n            self.seq_in, self.hchat, self.chat_id, self.chat_cur, self.rr = [None] * self.n, deque(), 0, (0, 0, b''), 0\n        else:\n            self.last_state_seq = None\n        self._bridge = None\n        if self.show_gui:\n            try:  # object created on the main (Qt) thread; its signal is queued to that thread\n                from PyQt5 import QtCore\n                if QtCore.QCoreApplication.instance() is not None:\n                    class _Bridge(QtCore.QObject):\n                        go = QtCore.pyqtSignal()\n                    self._bridge = _Bridge()\n                    self._bridge.go.connect(self._build_gui_safe)\n            except Exception as e:\n                print(\"game GUI bridge unavailable:\", e)\n        self.message_port_register_in(pmt.intern(\"rx_in\"))\n        self.message_port_register_out(pmt.intern(\"tx_out\"))\n        self.set_msg_handler(pmt.intern(\"rx_in\"), self.handle_rx)\n\n    # ---- lifecycle ----\n    def start(self):\n        self.running = True\n        if self.host:\n            threading.Thread(target=self._host_loop, daemon=True).start()\n        if self.show_gui:\n            if self._bridge is not None:\n                self._bridge.go.emit()\n            else:\n                self._build_gui_safe()\n        return True\n\n    def _build_gui_safe(self):\n        try:\n            self._build_gui()\n        except Exception as e:\n            print(\"game GUI disabled:\", repr(e))\n\n    def stop(self):\n        self.running = False\n        return True\n\n    # ---- radio I/O ----\n    def _send(self, typ, dest, payload):\n        self.seq = (self.seq + 1) & 0xFFFF\n        raw = seal(self.key, typ, self.me, dest, self.seq, payload)\n        self.message_port_pub(pmt.intern(\"tx_out\"), pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\n    def handle_rx(self, msg):\n        try:\n            if not pmt.is_pair(msg) or not pmt.is_u8vector(pmt.cdr(msg)):\n                return\n            r = unseal(self.key, bytes(pmt.u8vector_elements(pmt.cdr(msg))))\n            if r is None:\n                self.fail += 1\n                return\n            typ, snd, dst, seq, pt = r\n            now = time.time()\n            if snd == self.me:\n                return\n            with self.lk:\n                if self.host and typ == T_INPUT and 0 < snd < self.n and dst == 0:\n                    if newer(seq, self.seq_in[snd]):\n                        self.seq_in[snd] = seq\n                        self._on_input(snd, pt, now)\n                elif (not self.host) and snd == 0 and dst in (BCAST, self.me):\n                    if typ == T_STATE and newer(seq, self.last_state_seq):\n                        self.last_state_seq = seq\n                        self._on_state(pt, now)\n                    elif typ == T_ROLE and dst == self.me:\n                        self.role = pt[0]\n        except Exception as e:\n            print(\"game rx error:\", repr(e))\n\n    # ---- host ----\n    def _on_input(self, p, pt, now):\n        c = self.core\n        d, cmd, act, vote, cid, cl = struct.unpack('!BBBBBB', pt[:6])\n        text = pt[6:6 + cl]\n        self.last_rx[p] = now\n        c.dir[p] = d if d in DIRS else 0\n        if act & 0x80:\n            self.roleack[p] = 1\n        if (act & 7) and cmd != self.cmd_seen[p]:\n            c.act(p, act & 7, now)\n        self.cmd_seen[p] = cmd\n        c.set_vote(p, vote)\n        if cid and cid != self.chat_seen[p]:\n            self.hchat.append((p, text[:20]))\n            self.chat_seen[p] = cid\n\n    def _host_loop(self):\n        nxt = time.time()\n        while self.running:\n            now = time.time()\n            if now >= nxt:\n                nxt = max(nxt + self.tick, now + self.tick * 0.5)\n                try:\n                    self._host_tick(now)\n                except Exception as e:\n                    print(\"host tick error:\", repr(e))\n            time.sleep(0.002)\n\n    def _host_tick(self, now):\n        with self.lk:\n            c = self.core\n            present = [1 if (i == 0 or now - self.last_rx[i] < 3.0) else 0 for i in range(self.n)]\n            if self.bot:\n                self._bot(self.view_host(present, now), now, present)\n            if self.start_req:\n                self.start_req = False\n                if c.phase in (LOBBY, END):\n                    if c.phase == END:\n                        c.lobby()\n                    elif c.start(now, present):\n                        self.roleack = [1 if i == 0 else 0 for i in range(self.n)]\n                        self.role = 1 if c.imp == 0 else 0\n            c.dir[0] = self.dirv\n            if self.pending:\n                c.act(0, self.pending & 7, now)\n                self.pending = 0\n            if c.phase == MEET:\n                c.set_vote(0, self.myvote)\n            for i in range(1, self.n):\n                if not present[i]:\n                    c.dir[i] = 0\n            c.step(now)\n            if c.phase != MEET:\n                self.myvote = 0\n            if c.phase == LOBBY:\n                self.role = None\n            if self.hchat:\n                self.chat_id = self.chat_id % 255 + 1\n                f, t = self.hchat.popleft()\n                self.chat_cur = (self.chat_id, f, t)\n                self._log(f, t)\n            v = self.view_host(present, now)\n            self._set_view(v, now)\n            self._send(T_STATE, BCAST, pack_state(v, self.chat_cur))\n            if c.phase == PLAY:\n                for k in range(1, self.n):\n                    p = 1 + (self.rr + k - 1) % (self.n - 1)\n                    if c.inplay[p] and not self.roleack[p]:\n                        self.rr = p\n                        self._send(T_ROLE, p, bytes([1 if c.imp == p else 0]))\n                        break\n\n    def view_host(self, present, now):\n        return self.core.view(present, now, (self.cmd_seen, self.chat_seen))\n\n    # ---- client ----\n    def _on_state(self, pt, now):\n        v, chat = unpack_state(pt)\n        self._set_view(v, now)\n        cid, cf, text = chat\n        if cid and cid != self.last_chat_id:\n            self.last_chat_id = cid\n            self._log(cf, text)\n        if v['phase'] == LOBBY:\n            self.role = None\n        if v['phase'] != MEET:\n            self.myvote = 0\n        me = v['players'][self.me] if self.me < len(v['players']) else None\n        if me:\n            if me[3] == self.cmd_id:\n                self.pending = 0\n            if self.cur_chat[0] and me[4] == self.cur_chat[0]:\n                self.cur_chat = (0, b'')\n        if self.bot:\n            self._bot(v, now, None)\n        delay = self.guard + (self.me - 1) * self.slot\n        t = threading.Timer(delay, self._client_send)\n        t.daemon = True\n        t.start()\n\n    def _client_send(self):\n        if not self.running:\n            return\n        with self.lk:\n            if not self.cur_chat[0] and self.chat_out:\n                nid = self.cur_chat_id = (getattr(self, 'cur_chat_id', 0) % 255) + 1\n                self.cur_chat = (nid, self.chat_out.popleft()[:20])\n            cid, ct = self.cur_chat\n            act = (self.pending & 7) | (0x80 if self.role is not None else 0)\n            pl = struct.pack('!BBBBBB', self.dirv, self.cmd_id, act, self.myvote, cid, len(ct)) + ct\n        self._send(T_INPUT, 0, pl)\n\n    # ---- shared helpers ----\n    def _set_view(self, v, now):\n        old = self.view\n        if old:\n            self.prev = {i: self.display_pos(i, now) for i in range(len(old['players']))}\n        self.view, self.t_state = v, now\n\n    def display_pos(self, i, now):\n        v = self.view\n        if not v or i >= len(v['players']):\n            return (0, 0)\n        x, y = v['players'][i][0], v['players'][i][1]\n        px, py = self.prev.get(i, (x, y))\n        a = min(1.0, (now - self.t_state) / max(self.tick, 0.01))\n        return (px + (x - px) * a, py + (y - py) * a)\n\n    def _log(self, who, text):\n        try:\n            s = text.decode('utf-8', 'replace')\n        except Exception:\n            s = '?'\n        self.chat_log.append(\"P%d: %s\" % (who + 1, s))\n        del self.chat_log[:-60]\n\n    def request_action(self, bit):\n        with self.lk:\n            if self.host:\n                self.pending = bit\n            elif not self.pending:\n                self.cmd_id = self.cmd_id % 255 + 1\n                self.pending = bit\n\n    def send_chat(self, text):\n        t = text.encode('utf-8')[:20]\n        with self.lk:\n            if self.host:\n                self.hchat.append((0, t))\n            else:\n                self.chat_out.append(t)\n\n    def cast_vote(self, v):\n        with self.lk:\n            self.myvote = v\n\n    def _bot(self, v, now, present):\n        if now - self.bot_t < self.tick * 0.9:\n            return\n        self.bot_t = now\n        ph, me = v['phase'], self.me\n        pl = v['players']\n        if ph == LOBBY:\n            if self.host and present is not None and sum(present) >= self.min_players_n() and now - self.t0() > 1.5:\n                self.start_req = True\n            return\n        if ph == END:\n            if self.host and now - self.t_end(now) > 3:\n                self.start_req = True\n            return\n        mypos, alive = (pl[me][0], pl[me][1]), pl[me][2] & 1\n        if ph == MEET:\n            if alive and not self.myvote:\n                cands = [i + 1 for i in range(v['n']) if pl[i][2] & 1 and i != me]\n                self.cast_vote(self.rng.choice(cands + [SKIP]))\n            return\n        if not alive:\n            self.dirv = 0\n            return\n        imp = self.role == 1\n        self.dirv = 0\n        if imp:\n            tg = [(abs(p[0] - mypos[0]) + abs(p[1] - mypos[1]), i) for i, p in enumerate(pl)\n                  if i != me and p[2] & 1 and p[2] & 2]\n            if tg:\n                d, i = min(tg)\n                if d <= 2 and self.rng.random() < 0.5:\n                    self.request_action(2)\n                self.dirv = bfs_dir(mypos, (pl[i][0], pl[i][1]))\n        else:\n            todo = [t for k, t in enumerate(TASKS) if not v['tasks'] >> k & 1]\n            if todo:\n                tg = min(todo, key=lambda t: abs(t[0] - mypos[0]) + abs(t[1] - mypos[1]))\n                if mypos == tg:\n                    self.request_action(1)\n                else:\n                    self.dirv = bfs_dir(mypos, tg)\n            bodies = [(abs(p[0] - mypos[0]) + abs(p[1] - mypos[1])) for p in pl if p[2] & 4]\n            if bodies and min(bodies) <= 2:\n                self.request_action(4)\n\n    def min_players_n(self):\n        return 3\n\n    def t0(self):\n        if not hasattr(self, '_t0'):\n            self._t0 = time.time()\n        return self._t0\n\n    def t_end(self, now):\n        if not hasattr(self, '_te') or self._te_phase != END:\n            self._te, self._te_phase = now, END\n        return self._te\n\n    # ---- Qt GUI ----\n    def _build_gui(self):\n        from PyQt5 import QtCore, QtGui, QtWidgets\n        if QtWidgets.QApplication.instance() is None:\n            return\n        node = self\n        COL = ['#e53935', '#1e88e5', '#43a047', '#fdd835', '#8e24aa', '#fb8c00', '#00acc1', '#6d4c41']\n\n        class Board(QtWidgets.QWidget):\n            def __init__(s):\n                super().__init__()\n                s.setMinimumSize(640, 352)\n                s.setFocusPolicy(QtCore.Qt.StrongFocus)\n\n            def paintEvent(s, _):\n                p = QtGui.QPainter(s)\n                p.setRenderHint(QtGui.QPainter.Antialiasing)\n                cs = min(s.width() / W, s.height() / H)\n                p.fillRect(s.rect(), QtGui.QColor('#10141c'))\n                now = time.time()\n                with node.lk:\n                    v = node.view\n                    for y in range(H):\n                        for x in range(W):\n                            ch = MAP[y][x]\n                            col = '#2b3340' if ch == '#' else '#c9ccd3'\n                            p.fillRect(QtCore.QRectF(x * cs, y * cs, cs, cs), QtGui.QColor(col))\n                            if ch == 'T':\n                                k = TASKS.index((x, y))\n                                done = v and (v['tasks'] >> k & 1)\n                                p.fillRect(QtCore.QRectF(x * cs + cs * .2, y * cs + cs * .2, cs * .6, cs * .6),\n                                           QtGui.QColor('#43a047' if done else '#f9a825'))\n                            if ch == 'V':\n                                p.fillRect(QtCore.QRectF(x * cs + cs * .15, y * cs + cs * .15, cs * .7, cs * .7), QtGui.QColor('#d32f2f'))\n                    if v:\n                        for i, pl in enumerate(v['players']):\n                            if not pl[2] & 2:\n                                continue\n                            x, y = node.display_pos(i, now)\n                            c = QtGui.QColor(COL[i % 8])\n                            if pl[2] & 1:\n                                p.setBrush(c)\n                                p.setPen(QtGui.QPen(QtGui.QColor('white' if i == node.me else 'black'), 3 if i == node.me else 1))\n                                p.drawEllipse(QtCore.QRectF(x * cs + cs * .12, y * cs + cs * .12, cs * .76, cs * .76))\n                                p.setPen(QtGui.QColor('black'))\n                                p.drawText(QtCore.QRectF(x * cs, y * cs, cs, cs), QtCore.Qt.AlignCenter, str(i + 1))\n                            elif pl[2] & 4:\n                                p.setPen(QtGui.QPen(c, 4))\n                                p.drawLine(QtCore.QPointF(x * cs + 6, y * cs + 6), QtCore.QPointF(x * cs + cs - 6, y * cs + cs - 6))\n                                p.drawLine(QtCore.QPointF(x * cs + cs - 6, y * cs + 6), QtCore.QPointF(x * cs + 6, y * cs + cs - 6))\n                p.end()\n\n            def keyPressEvent(s, e):\n                if e.isAutoRepeat():\n                    return\n                k = {QtCore.Qt.Key_Up: 1, QtCore.Qt.Key_W: 1, QtCore.Qt.Key_Down: 2, QtCore.Qt.Key_S: 2,\n                     QtCore.Qt.Key_Left: 3, QtCore.Qt.Key_A: 3, QtCore.Qt.Key_Right: 4, QtCore.Qt.Key_D: 4}.get(e.key())\n                if k:\n                    held.append(k)\n                    node.dirv = k\n                elif e.key() == QtCore.Qt.Key_E:\n                    node.request_action(1)\n                elif e.key() == QtCore.Qt.Key_K:\n                    node.request_action(2)\n                elif e.key() == QtCore.Qt.Key_R:\n                    node.request_action(4)\n                elif QtCore.Qt.Key_1 <= e.key() <= QtCore.Qt.Key_8:\n                    node.cast_vote(e.key() - QtCore.Qt.Key_0)\n\n            def keyReleaseEvent(s, e):\n                if e.isAutoRepeat():\n                    return\n                k = {QtCore.Qt.Key_Up: 1, QtCore.Qt.Key_W: 1, QtCore.Qt.Key_Down: 2, QtCore.Qt.Key_S: 2,\n                     QtCore.Qt.Key_Left: 3, QtCore.Qt.Key_A: 3, QtCore.Qt.Key_Right: 4, QtCore.Qt.Key_D: 4}.get(e.key())\n                if k in held:\n                    held.remove(k)\n                node.dirv = held[-1] if held else 0\n\n        held = []\n        w = QtWidgets.QWidget()\n        w.setWindowTitle(\"%s - %s\" % (node.title, \"HOST\" if node.host else \"Player %d\" % (node.me + 1)))\n        board = Board()\n        status = QtWidgets.QLabel(\"\")\n        plist = QtWidgets.QListWidget()\n        chat = QtWidgets.QTextEdit()\n        chat.setReadOnly(True)\n        line = QtWidgets.QLineEdit()\n        line.setPlaceholderText(\"chat (20 chars), Enter to send; Esc = back to map\")\n        btns = QtWidgets.QHBoxLayout()\n        bt = {}\n        for key, label, fn in [(\"use\", \"Use [E]\", lambda: node.request_action(1)), (\"kill\", \"Kill [K] (impostor)\", lambda: node.request_action(2)),\n                               (\"report\", \"Report [R]\", lambda: node.request_action(4)), (\"skip\", \"Skip vote\", lambda: node.cast_vote(SKIP))]:\n            b = QtWidgets.QPushButton(label)\n            b.setFocusPolicy(QtCore.Qt.NoFocus)\n            b.clicked.connect(fn)\n            btns.addWidget(b)\n            bt[key] = b\n        if node.host:\n            sb = QtWidgets.QPushButton(\"START / NEW ROUND\")\n            sb.setFocusPolicy(QtCore.Qt.NoFocus)\n            sb.clicked.connect(lambda: setattr(node, 'start_req', True))\n            btns.addWidget(sb)\n        side = QtWidgets.QVBoxLayout()\n        plbl = QtWidgets.QLabel(\"Players\")\n        for x in (plbl, plist, chat, line):\n            side.addWidget(x)\n        top = QtWidgets.QHBoxLayout()\n        top.addWidget(board, 3)\n        top.addLayout(side, 1)\n        lay = QtWidgets.QVBoxLayout(w)\n        lay.addWidget(status)\n        lay.addLayout(top)\n        lay.addLayout(btns)\n        line.returnPressed.connect(lambda: (node.send_chat(line.text()), line.clear()))\n        plist.setFocusPolicy(QtCore.Qt.NoFocus)\n        plist.itemClicked.connect(lambda it: node.cast_vote(plist.row(it) + 1))\n        esc = QtWidgets.QShortcut(QtGui.QKeySequence(\"Esc\"), w)\n        esc.activated.connect(board.setFocus)\n        names = [\"LOBBY\", \"PLAYING\", \"MEETING\", \"GAME OVER\"]\n\n        def tick():\n            with node.lk:\n                v = node.view\n                if v:\n                    r = {None: \"\", 0: \"  |  You are CREW: do tasks (E)\", 1: \"  |  You are the IMPOSTOR: kill (K)\"}[node.role]\n                    t = \"%s%s  |  tasks %d/%d\" % (names[v['phase']], r, bin(v['tasks']).count('1'), len(TASKS))\n                    mv = \"SKIP\" if node.myvote == SKIP else (\"P%d\" % node.myvote if node.myvote else \"none yet\")\n                    me_alive = v['players'][node.me][2] & 1 if node.me < len(v['players']) else 0\n                    if v['phase'] == MEET:\n                        t += (\"  |  VOTE NOW (%ds left): click a player in the list, press 1-8, or Skip vote. Your vote: %s\" % (v['meet_left'], mv)) if me_alive else \"  |  meeting in progress (dead players cannot vote)\"\n                    if v['phase'] == END:\n                        t += \"  |  %s WIN (impostor was P%d)\" % (\"CREW\" if v['winner'] == 1 else \"IMPOSTOR\", v['reveal'] + 1)\n                    if not v['players'][node.me][2] & 1 and v['phase'] in (PLAY, MEET):\n                        t += \"  |  you are DEAD\"\n                    status.setText(t)\n                    playing, meeting = v['phase'] == PLAY and me_alive, v['phase'] == MEET and me_alive\n                    bt['use'].setEnabled(bool(playing))\n                    bt['kill'].setEnabled(bool(playing and node.role == 1))\n                    bt['report'].setEnabled(bool(playing))\n                    bt['skip'].setEnabled(bool(meeting))\n                    plbl.setText(\"CLICK A PLAYER TO VOTE FOR THEM\" if meeting else \"Players\")\n                    if plist.count() != v['n']:\n                        plist.clear()\n                        for i in range(v['n']):\n                            plist.addItem(\"\")\n                    for i, p in enumerate(v['players']):\n                        it = plist.item(i)\n                        it.setText(\"%d%s %s%s%s\" % (i + 1, \" (you)\" if i == node.me else \"\", \"\" if p[2] & 2 else \"[absent] \",\n                                                     \"\" if p[2] & 1 else \"[dead] \", \"[voted]\" if p[2] & 8 else (\"  <== your vote\" if (meeting and node.myvote == i + 1) else \"\")))\n                        it.setForeground(QtGui.QColor(COL[i % 8]))\n                else:\n                    status.setText(\"waiting for host signal...\")\n                txt = \"\\n\".join(node.chat_log)\n            if chat.toPlainText() != txt:\n                chat.setPlainText(txt)\n            board.update()\n\n        tm = QtCore.QTimer(w)\n        tm.timeout.connect(tick)\n        tm.start(40)\n        w.resize(1000, 520)\n        w.show()\n        board.setFocus()\n        self.win = (w, tm)\n"
    node_id: '2'
    n_players: n_players
    tick_ms: tick_ms
    slot_ms: slot_ms
    guard_ms: guard_ms
    key: game_key
    show_gui: '1'
    bot: '1'
    min_players: '3'
    title: '''Among Us Lite'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 5300
    - 390
    rotation: 0
    state: enabled
    _io_cache: ('Among Us Lite Node', 'blk', [('node_id', '0'), ('n_players', '4'), ('tick_ms', '250'), ('slot_ms', '45'), ('guard_ms', '70'), ('key', "'change-this-game-key'"), ('show_gui', '1'), ('bot', '0'), ('min_players', '3'), ('title', "'Among Us Lite'")], [('rx_in', 'message', 1)], [('tx_out', 'message', 1)], '', [])
- name: game_client_3
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    comment: Game logic + PyQt5 window. node_id 0 = host.
    _source_code: "\"\"\"Among Us Lite node (host = node_id 0, clients = 1..n-1) for the QPSK GNU Radio link.\nPorts: rx_in (PDU from CRC Check 'ok'), tx_out (PDU to CRC Append).\nWire format (all small): 5-byte header (magic|type, sender, dest, seq16) + payload (keystream-XOR) + 4-byte MAC.\nSTATE (host->all, every tick) carries the whole world; INPUT (client->host) is sent in the client's own time slot.\nEvents (use/kill/report/chat) repeat until the host echoes their id, so no ACK packets are needed.\"\"\"\nimport hashlib, hmac, random, struct, threading, time\nfrom collections import deque\nfrom gnuradio import gr\nimport pmt\n\nMAP = [\"####################\",\n       \"#........#.........#\",\n       \"#.T......#......T..#\",\n       \"#........#.........#\",\n       \"#####.#######.######\",\n       \"#........V.........#\",\n       \"#####.#######.######\",\n       \"#........#.........#\",\n       \"#..T.....#.....T...#\",\n       \"#.......T#.........#\",\n       \"####################\"]\nW, H = len(MAP[0]), len(MAP)\nTASKS = [(x, y) for y in range(H) for x in range(W) if MAP[y][x] == 'T']\nBUTTON = [(x, y) for y in range(H) for x in range(W) if MAP[y][x] == 'V'][0]\nALL_TASKS = (1 << len(TASKS)) - 1\nDIRS = {1: (0, -1), 2: (0, 1), 3: (-1, 0), 4: (1, 0)}\nLOBBY, PLAY, MEET, END = 0, 1, 2, 3\nT_STATE, T_INPUT, T_ROLE = 1, 2, 3\nBCAST, MAGIC, SKIP = 255, 0xA0, 0xFE\n\n\ndef free(x, y):\n    return 0 <= x < W and 0 <= y < H and MAP[y][x] != '#'\n\n\ndef spawn(i):\n    return (2 + 2 * (i % 8), 5)\n\n\ndef bfs_dir(src, dst):\n    if src == dst:\n        return 0\n    q, seen = deque([(src, 0)]), {src}\n    while q:\n        (x, y), first = q.popleft()\n        for d, (dx, dy) in DIRS.items():\n            n = (x + dx, y + dy)\n            if n in seen or not free(*n):\n                continue\n            if n == dst:\n                return first or d\n            seen.add(n)\n            q.append((n, first or d))\n    return 0\n\n\n# ---------------- security / framing ----------------\ndef _ks(key, hdr, n):\n    out, c = b'', 0\n    while len(out) < n:\n        out += hashlib.sha256(key + hdr + bytes([c])).digest()\n        c += 1\n    return out[:n]\n\n\ndef seal(key, typ, sender, dest, seq, payload):\n    hdr = bytes([MAGIC | typ, sender, dest]) + struct.pack('!H', seq & 0xFFFF)\n    ct = bytes(a ^ b for a, b in zip(payload, _ks(key, hdr, len(payload))))\n    return hdr + ct + hmac.new(key, hdr + ct, hashlib.sha256).digest()[:4]\n\n\ndef unseal(key, raw):\n    if len(raw) < 9 or (raw[0] & 0xF0) != MAGIC:\n        return None\n    hdr, ct, mac = raw[:5], raw[5:-4], raw[-4:]\n    if not hmac.compare_digest(hmac.new(key, hdr + ct, hashlib.sha256).digest()[:4], mac):\n        return None\n    pt = bytes(a ^ b for a, b in zip(ct, _ks(key, hdr, len(ct))))\n    return hdr[0] & 0x0F, hdr[1], hdr[2], struct.unpack('!H', hdr[3:5])[0], pt\n\n\ndef newer(seq, last):\n    return last is None or 0 < ((seq - last) & 0xFFFF) < 0x8000\n\n\n# ---------------- authoritative game core (host only) ----------------\nclass Core:\n    def __init__(s, n, rng=None, kill_cd=8.0, meet_s=15.0):\n        s.n, s.rng, s.kill_cd, s.meet_s = n, rng or random.Random(), kill_cd, meet_s\n        s.lobby()\n\n    def lobby(s):\n        s.phase, s.winner, s.tasks, s.imp, s.eject = LOBBY, 0, 0, -1, 255\n        n = s.n\n        s.inplay, s.alive, s.body = [0] * n, [1] * n, [0] * n\n        s.dir, s.vote = [0] * n, [0] * n\n        s.pos = [spawn(i) for i in range(n)]\n        s.meet_end = s.kill_ready = 0\n\n    def start(s, now, present):\n        ids = [i for i in range(s.n) if present[i]]\n        if len(ids) < 3:\n            return False\n        s.lobby()\n        s.phase = PLAY\n        for i in ids:\n            s.inplay[i] = 1\n        s.alive = [1 if s.inplay[i] else 0 for i in range(s.n)]\n        s.imp, s.kill_ready = s.rng.choice(ids), now + s.kill_cd\n        return True\n\n    def end(s, w):\n        s.phase, s.winner = END, w\n\n    def check(s):\n        crew = [i for i in range(s.n) if s.inplay[i] and s.alive[i] and i != s.imp]\n        if not s.alive[s.imp]:\n            s.end(1)\n        elif len(crew) <= 1:\n            s.end(2)\n\n    def step(s, now):\n        if s.phase == PLAY:\n            for i in range(s.n):\n                if s.inplay[i] and s.alive[i] and s.dir[i] in DIRS:\n                    dx, dy = DIRS[s.dir[i]]\n                    x, y = s.pos[i]\n                    if free(x + dx, y + dy):\n                        s.pos[i] = (x + dx, y + dy)\n        elif s.phase == MEET:\n            voters = [i for i in range(s.n) if s.inplay[i] and s.alive[i]]\n            if now >= s.meet_end or all(s.vote[i] for i in voters):\n                s.tally(now)\n\n    def act(s, p, a, now):\n        if s.phase != PLAY or not s.inplay[p] or not s.alive[p]:\n            return\n        x, y = s.pos[p]\n        if a & 1 and p != s.imp and (x, y) in TASKS:\n            s.tasks |= 1 << TASKS.index((x, y))\n            if s.tasks == ALL_TASKS:\n                return s.end(1)\n        if a & 2 and p == s.imp and now >= s.kill_ready:\n            best = None\n            for q in range(s.n):\n                if q != p and s.inplay[q] and s.alive[q]:\n                    d = abs(s.pos[q][0] - x) + abs(s.pos[q][1] - y)\n                    if d <= 2 and (best is None or d < best[0]):\n                        best = (d, q)\n            if best:\n                q = best[1]\n                s.alive[q], s.body[q], s.kill_ready = 0, 1, now + s.kill_cd\n                s.check()\n        if a & 4 and s.phase == PLAY:\n            near = any(s.body[q] and abs(s.pos[q][0] - x) + abs(s.pos[q][1] - y) <= 2 for q in range(s.n))\n            if near or (x, y) == BUTTON:\n                s.phase, s.meet_end, s.vote, s.eject = MEET, now + s.meet_s, [0] * s.n, 255\n                s.body, s.dir = [0] * s.n, [0] * s.n\n                s.pos = [spawn(i) for i in range(s.n)]\n\n    def set_vote(s, p, v):\n        if s.phase == MEET and s.inplay[p] and s.alive[p]:\n            if v == SKIP or (1 <= v <= s.n and s.inplay[v - 1] and s.alive[v - 1]):\n                s.vote[p] = v\n\n    def tally(s, now):\n        cnt = {}\n        for i in range(s.n):\n            if s.inplay[i] and s.alive[i] and s.vote[i]:\n                cnt[s.vote[i]] = cnt.get(s.vote[i], 0) + 1\n        top = sorted(cnt.items(), key=lambda kv: -kv[1])\n        s.eject = 254\n        if top and (len(top) == 1 or top[0][1] > top[1][1]) and top[0][0] != SKIP:\n            q = top[0][0] - 1\n            s.alive[q], s.eject = 0, q\n            if q == s.imp:\n                return s.end(1)\n            s.check()\n            if s.phase == END:\n                return\n        s.phase, s.vote, s.dir, s.kill_ready = PLAY, [0] * s.n, [0] * s.n, now + s.kill_cd\n        s.pos = [spawn(i) for i in range(s.n)]\n\n    def view(s, present, now, acks):\n        pl = []\n        for i in range(s.n):\n            fl = s.alive[i] | ((1 if (s.inplay[i] or present[i]) else 0) << 1) | (s.body[i] << 2) | ((1 if s.vote[i] else 0) << 3)\n            pl.append((s.pos[i][0], s.pos[i][1], fl, acks[0][i], acks[1][i]))\n        return dict(phase=s.phase, winner=s.winner, tasks=s.tasks,\n                    meet_left=int(max(0, s.meet_end - now)) if s.phase == MEET else 0,\n                    n=s.n, reveal=s.imp if s.phase == END else 255, eject=s.eject, players=pl)\n\n\ndef pack_state(v, chat):\n    cid, cfrom, ctext = chat\n    out = struct.pack('!BBBBBBBBBB', v['phase'], v['winner'], v['tasks'], v['meet_left'], v['n'],\n                      v['reveal'], v['eject'], cid, cfrom, len(ctext)) + ctext\n    for x, y, fl, ca, ha in v['players']:\n        out += struct.pack('!BBBBB', x, y, fl, ca, ha)\n    return out\n\n\ndef unpack_state(pt):\n    ph, win, tk, ml, n, rev, ej, cid, cf, cl = struct.unpack('!BBBBBBBBBB', pt[:10])\n    text, o, pl = pt[10:10 + cl], 10 + cl, []\n    for i in range(n):\n        pl.append(struct.unpack('!BBBBB', pt[o + 5 * i:o + 5 * i + 5]))\n    return dict(phase=ph, winner=win, tasks=tk, meet_left=ml, n=n, reveal=rev, eject=ej, players=pl), (cid, cf, text)\n\n\n# ---------------- GNU Radio block ----------------\nclass blk(gr.basic_block):\n    def __init__(self, node_id=0, n_players=4, tick_ms=250, slot_ms=45, guard_ms=70,\n                 key='change-this-game-key', show_gui=1, bot=0, min_players=3, title='Among Us Lite'):\n        gr.basic_block.__init__(self, name=\"Among Us Lite Node\", in_sig=None, out_sig=None)\n        self.me, self.n = int(node_id), max(3, int(n_players))\n        self.host = self.me == 0\n        self.tick, self.slot, self.guard = tick_ms / 1000.0, slot_ms / 1000.0, guard_ms / 1000.0\n        self.key = str(key).encode()\n        self.show_gui, self.bot, self.title = bool(show_gui), bool(bot), str(title)\n        self.lk = threading.RLock()\n        self.running, self.seq, self.win = False, 0, None\n        self.dirv, self.pending, self.myvote, self.start_req = 0, 0, 0, False\n        self.chat_log, self.chat_out, self.cur_chat, self.last_chat_id = [], deque(), (0, b''), 0\n        self.role, self.view, self.t_state, self.prev, self.rng = None, None, 0.0, {}, random.Random()\n        self.cmd_id, self.bot_t, self.fail = 0, 0, 0\n        if self.host:\n            self.core, self.last_rx = Core(self.n), [0.0] * self.n\n            self.cmd_seen, self.chat_seen, self.roleack = [0] * self.n, [0] * self.n, [0] * self.n\n            self.seq_in, self.hchat, self.chat_id, self.chat_cur, self.rr = [None] * self.n, deque(), 0, (0, 0, b''), 0\n        else:\n            self.last_state_seq = None\n        self._bridge = None\n        if self.show_gui:\n            try:  # object created on the main (Qt) thread; its signal is queued to that thread\n                from PyQt5 import QtCore\n                if QtCore.QCoreApplication.instance() is not None:\n                    class _Bridge(QtCore.QObject):\n                        go = QtCore.pyqtSignal()\n                    self._bridge = _Bridge()\n                    self._bridge.go.connect(self._build_gui_safe)\n            except Exception as e:\n                print(\"game GUI bridge unavailable:\", e)\n        self.message_port_register_in(pmt.intern(\"rx_in\"))\n        self.message_port_register_out(pmt.intern(\"tx_out\"))\n        self.set_msg_handler(pmt.intern(\"rx_in\"), self.handle_rx)\n\n    # ---- lifecycle ----\n    def start(self):\n        self.running = True\n        if self.host:\n            threading.Thread(target=self._host_loop, daemon=True).start()\n        if self.show_gui:\n            if self._bridge is not None:\n                self._bridge.go.emit()\n            else:\n                self._build_gui_safe()\n        return True\n\n    def _build_gui_safe(self):\n        try:\n            self._build_gui()\n        except Exception as e:\n            print(\"game GUI disabled:\", repr(e))\n\n    def stop(self):\n        self.running = False\n        return True\n\n    # ---- radio I/O ----\n    def _send(self, typ, dest, payload):\n        self.seq = (self.seq + 1) & 0xFFFF\n        raw = seal(self.key, typ, self.me, dest, self.seq, payload)\n        self.message_port_pub(pmt.intern(\"tx_out\"), pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\n    def handle_rx(self, msg):\n        try:\n            if not pmt.is_pair(msg) or not pmt.is_u8vector(pmt.cdr(msg)):\n                return\n            r = unseal(self.key, bytes(pmt.u8vector_elements(pmt.cdr(msg))))\n            if r is None:\n                self.fail += 1\n                return\n            typ, snd, dst, seq, pt = r\n            now = time.time()\n            if snd == self.me:\n                return\n            with self.lk:\n                if self.host and typ == T_INPUT and 0 < snd < self.n and dst == 0:\n                    if newer(seq, self.seq_in[snd]):\n                        self.seq_in[snd] = seq\n                        self._on_input(snd, pt, now)\n                elif (not self.host) and snd == 0 and dst in (BCAST, self.me):\n                    if typ == T_STATE and newer(seq, self.last_state_seq):\n                        self.last_state_seq = seq\n                        self._on_state(pt, now)\n                    elif typ == T_ROLE and dst == self.me:\n                        self.role = pt[0]\n        except Exception as e:\n            print(\"game rx error:\", repr(e))\n\n    # ---- host ----\n    def _on_input(self, p, pt, now):\n        c = self.core\n        d, cmd, act, vote, cid, cl = struct.unpack('!BBBBBB', pt[:6])\n        text = pt[6:6 + cl]\n        self.last_rx[p] = now\n        c.dir[p] = d if d in DIRS else 0\n        if act & 0x80:\n            self.roleack[p] = 1\n        if (act & 7) and cmd != self.cmd_seen[p]:\n            c.act(p, act & 7, now)\n        self.cmd_seen[p] = cmd\n        c.set_vote(p, vote)\n        if cid and cid != self.chat_seen[p]:\n            self.hchat.append((p, text[:20]))\n            self.chat_seen[p] = cid\n\n    def _host_loop(self):\n        nxt = time.time()\n        while self.running:\n            now = time.time()\n            if now >= nxt:\n                nxt = max(nxt + self.tick, now + self.tick * 0.5)\n                try:\n                    self._host_tick(now)\n                except Exception as e:\n                    print(\"host tick error:\", repr(e))\n            time.sleep(0.002)\n\n    def _host_tick(self, now):\n        with self.lk:\n            c = self.core\n            present = [1 if (i == 0 or now - self.last_rx[i] < 3.0) else 0 for i in range(self.n)]\n            if self.bot:\n                self._bot(self.view_host(present, now), now, present)\n            if self.start_req:\n                self.start_req = False\n                if c.phase in (LOBBY, END):\n                    if c.phase == END:\n                        c.lobby()\n                    elif c.start(now, present):\n                        self.roleack = [1 if i == 0 else 0 for i in range(self.n)]\n                        self.role = 1 if c.imp == 0 else 0\n            c.dir[0] = self.dirv\n            if self.pending:\n                c.act(0, self.pending & 7, now)\n                self.pending = 0\n            if c.phase == MEET:\n                c.set_vote(0, self.myvote)\n            for i in range(1, self.n):\n                if not present[i]:\n                    c.dir[i] = 0\n            c.step(now)\n            if c.phase != MEET:\n                self.myvote = 0\n            if c.phase == LOBBY:\n                self.role = None\n            if self.hchat:\n                self.chat_id = self.chat_id % 255 + 1\n                f, t = self.hchat.popleft()\n                self.chat_cur = (self.chat_id, f, t)\n                self._log(f, t)\n            v = self.view_host(present, now)\n            self._set_view(v, now)\n            self._send(T_STATE, BCAST, pack_state(v, self.chat_cur))\n            if c.phase == PLAY:\n                for k in range(1, self.n):\n                    p = 1 + (self.rr + k - 1) % (self.n - 1)\n                    if c.inplay[p] and not self.roleack[p]:\n                        self.rr = p\n                        self._send(T_ROLE, p, bytes([1 if c.imp == p else 0]))\n                        break\n\n    def view_host(self, present, now):\n        return self.core.view(present, now, (self.cmd_seen, self.chat_seen))\n\n    # ---- client ----\n    def _on_state(self, pt, now):\n        v, chat = unpack_state(pt)\n        self._set_view(v, now)\n        cid, cf, text = chat\n        if cid and cid != self.last_chat_id:\n            self.last_chat_id = cid\n            self._log(cf, text)\n        if v['phase'] == LOBBY:\n            self.role = None\n        if v['phase'] != MEET:\n            self.myvote = 0\n        me = v['players'][self.me] if self.me < len(v['players']) else None\n        if me:\n            if me[3] == self.cmd_id:\n                self.pending = 0\n            if self.cur_chat[0] and me[4] == self.cur_chat[0]:\n                self.cur_chat = (0, b'')\n        if self.bot:\n            self._bot(v, now, None)\n        delay = self.guard + (self.me - 1) * self.slot\n        t = threading.Timer(delay, self._client_send)\n        t.daemon = True\n        t.start()\n\n    def _client_send(self):\n        if not self.running:\n            return\n        with self.lk:\n            if not self.cur_chat[0] and self.chat_out:\n                nid = self.cur_chat_id = (getattr(self, 'cur_chat_id', 0) % 255) + 1\n                self.cur_chat = (nid, self.chat_out.popleft()[:20])\n            cid, ct = self.cur_chat\n            act = (self.pending & 7) | (0x80 if self.role is not None else 0)\n            pl = struct.pack('!BBBBBB', self.dirv, self.cmd_id, act, self.myvote, cid, len(ct)) + ct\n        self._send(T_INPUT, 0, pl)\n\n    # ---- shared helpers ----\n    def _set_view(self, v, now):\n        old = self.view\n        if old:\n            self.prev = {i: self.display_pos(i, now) for i in range(len(old['players']))}\n        self.view, self.t_state = v, now\n\n    def display_pos(self, i, now):\n        v = self.view\n        if not v or i >= len(v['players']):\n            return (0, 0)\n        x, y = v['players'][i][0], v['players'][i][1]\n        px, py = self.prev.get(i, (x, y))\n        a = min(1.0, (now - self.t_state) / max(self.tick, 0.01))\n        return (px + (x - px) * a, py + (y - py) * a)\n\n    def _log(self, who, text):\n        try:\n            s = text.decode('utf-8', 'replace')\n        except Exception:\n            s = '?'\n        self.chat_log.append(\"P%d: %s\" % (who + 1, s))\n        del self.chat_log[:-60]\n\n    def request_action(self, bit):\n        with self.lk:\n            if self.host:\n                self.pending = bit\n            elif not self.pending:\n                self.cmd_id = self.cmd_id % 255 + 1\n                self.pending = bit\n\n    def send_chat(self, text):\n        t = text.encode('utf-8')[:20]\n        with self.lk:\n            if self.host:\n                self.hchat.append((0, t))\n            else:\n                self.chat_out.append(t)\n\n    def cast_vote(self, v):\n        with self.lk:\n            self.myvote = v\n\n    def _bot(self, v, now, present):\n        if now - self.bot_t < self.tick * 0.9:\n            return\n        self.bot_t = now\n        ph, me = v['phase'], self.me\n        pl = v['players']\n        if ph == LOBBY:\n            if self.host and present is not None and sum(present) >= self.min_players_n() and now - self.t0() > 1.5:\n                self.start_req = True\n            return\n        if ph == END:\n            if self.host and now - self.t_end(now) > 3:\n                self.start_req = True\n            return\n        mypos, alive = (pl[me][0], pl[me][1]), pl[me][2] & 1\n        if ph == MEET:\n            if alive and not self.myvote:\n                cands = [i + 1 for i in range(v['n']) if pl[i][2] & 1 and i != me]\n                self.cast_vote(self.rng.choice(cands + [SKIP]))\n            return\n        if not alive:\n            self.dirv = 0\n            return\n        imp = self.role == 1\n        self.dirv = 0\n        if imp:\n            tg = [(abs(p[0] - mypos[0]) + abs(p[1] - mypos[1]), i) for i, p in enumerate(pl)\n                  if i != me and p[2] & 1 and p[2] & 2]\n            if tg:\n                d, i = min(tg)\n                if d <= 2 and self.rng.random() < 0.5:\n                    self.request_action(2)\n                self.dirv = bfs_dir(mypos, (pl[i][0], pl[i][1]))\n        else:\n            todo = [t for k, t in enumerate(TASKS) if not v['tasks'] >> k & 1]\n            if todo:\n                tg = min(todo, key=lambda t: abs(t[0] - mypos[0]) + abs(t[1] - mypos[1]))\n                if mypos == tg:\n                    self.request_action(1)\n                else:\n                    self.dirv = bfs_dir(mypos, tg)\n            bodies = [(abs(p[0] - mypos[0]) + abs(p[1] - mypos[1])) for p in pl if p[2] & 4]\n            if bodies and min(bodies) <= 2:\n                self.request_action(4)\n\n    def min_players_n(self):\n        return 3\n\n    def t0(self):\n        if not hasattr(self, '_t0'):\n            self._t0 = time.time()\n        return self._t0\n\n    def t_end(self, now):\n        if not hasattr(self, '_te') or self._te_phase != END:\n            self._te, self._te_phase = now, END\n        return self._te\n\n    # ---- Qt GUI ----\n    def _build_gui(self):\n        from PyQt5 import QtCore, QtGui, QtWidgets\n        if QtWidgets.QApplication.instance() is None:\n            return\n        node = self\n        COL = ['#e53935', '#1e88e5', '#43a047', '#fdd835', '#8e24aa', '#fb8c00', '#00acc1', '#6d4c41']\n\n        class Board(QtWidgets.QWidget):\n            def __init__(s):\n                super().__init__()\n                s.setMinimumSize(640, 352)\n                s.setFocusPolicy(QtCore.Qt.StrongFocus)\n\n            def paintEvent(s, _):\n                p = QtGui.QPainter(s)\n                p.setRenderHint(QtGui.QPainter.Antialiasing)\n                cs = min(s.width() / W, s.height() / H)\n                p.fillRect(s.rect(), QtGui.QColor('#10141c'))\n                now = time.time()\n                with node.lk:\n                    v = node.view\n                    for y in range(H):\n                        for x in range(W):\n                            ch = MAP[y][x]\n                            col = '#2b3340' if ch == '#' else '#c9ccd3'\n                            p.fillRect(QtCore.QRectF(x * cs, y * cs, cs, cs), QtGui.QColor(col))\n                            if ch == 'T':\n                                k = TASKS.index((x, y))\n                                done = v and (v['tasks'] >> k & 1)\n                                p.fillRect(QtCore.QRectF(x * cs + cs * .2, y * cs + cs * .2, cs * .6, cs * .6),\n                                           QtGui.QColor('#43a047' if done else '#f9a825'))\n                            if ch == 'V':\n                                p.fillRect(QtCore.QRectF(x * cs + cs * .15, y * cs + cs * .15, cs * .7, cs * .7), QtGui.QColor('#d32f2f'))\n                    if v:\n                        for i, pl in enumerate(v['players']):\n                            if not pl[2] & 2:\n                                continue\n                            x, y = node.display_pos(i, now)\n                            c = QtGui.QColor(COL[i % 8])\n                            if pl[2] & 1:\n                                p.setBrush(c)\n                                p.setPen(QtGui.QPen(QtGui.QColor('white' if i == node.me else 'black'), 3 if i == node.me else 1))\n                                p.drawEllipse(QtCore.QRectF(x * cs + cs * .12, y * cs + cs * .12, cs * .76, cs * .76))\n                                p.setPen(QtGui.QColor('black'))\n                                p.drawText(QtCore.QRectF(x * cs, y * cs, cs, cs), QtCore.Qt.AlignCenter, str(i + 1))\n                            elif pl[2] & 4:\n                                p.setPen(QtGui.QPen(c, 4))\n                                p.drawLine(QtCore.QPointF(x * cs + 6, y * cs + 6), QtCore.QPointF(x * cs + cs - 6, y * cs + cs - 6))\n                                p.drawLine(QtCore.QPointF(x * cs + cs - 6, y * cs + 6), QtCore.QPointF(x * cs + 6, y * cs + cs - 6))\n                p.end()\n\n            def keyPressEvent(s, e):\n                if e.isAutoRepeat():\n                    return\n                k = {QtCore.Qt.Key_Up: 1, QtCore.Qt.Key_W: 1, QtCore.Qt.Key_Down: 2, QtCore.Qt.Key_S: 2,\n                     QtCore.Qt.Key_Left: 3, QtCore.Qt.Key_A: 3, QtCore.Qt.Key_Right: 4, QtCore.Qt.Key_D: 4}.get(e.key())\n                if k:\n                    held.append(k)\n                    node.dirv = k\n                elif e.key() == QtCore.Qt.Key_E:\n                    node.request_action(1)\n                elif e.key() == QtCore.Qt.Key_K:\n                    node.request_action(2)\n                elif e.key() == QtCore.Qt.Key_R:\n                    node.request_action(4)\n                elif QtCore.Qt.Key_1 <= e.key() <= QtCore.Qt.Key_8:\n                    node.cast_vote(e.key() - QtCore.Qt.Key_0)\n\n            def keyReleaseEvent(s, e):\n                if e.isAutoRepeat():\n                    return\n                k = {QtCore.Qt.Key_Up: 1, QtCore.Qt.Key_W: 1, QtCore.Qt.Key_Down: 2, QtCore.Qt.Key_S: 2,\n                     QtCore.Qt.Key_Left: 3, QtCore.Qt.Key_A: 3, QtCore.Qt.Key_Right: 4, QtCore.Qt.Key_D: 4}.get(e.key())\n                if k in held:\n                    held.remove(k)\n                node.dirv = held[-1] if held else 0\n\n        held = []\n        w = QtWidgets.QWidget()\n        w.setWindowTitle(\"%s - %s\" % (node.title, \"HOST\" if node.host else \"Player %d\" % (node.me + 1)))\n        board = Board()\n        status = QtWidgets.QLabel(\"\")\n        plist = QtWidgets.QListWidget()\n        chat = QtWidgets.QTextEdit()\n        chat.setReadOnly(True)\n        line = QtWidgets.QLineEdit()\n        line.setPlaceholderText(\"chat (20 chars), Enter to send; Esc = back to map\")\n        btns = QtWidgets.QHBoxLayout()\n        bt = {}\n        for key, label, fn in [(\"use\", \"Use [E]\", lambda: node.request_action(1)), (\"kill\", \"Kill [K] (impostor)\", lambda: node.request_action(2)),\n                               (\"report\", \"Report [R]\", lambda: node.request_action(4)), (\"skip\", \"Skip vote\", lambda: node.cast_vote(SKIP))]:\n            b = QtWidgets.QPushButton(label)\n            b.setFocusPolicy(QtCore.Qt.NoFocus)\n            b.clicked.connect(fn)\n            btns.addWidget(b)\n            bt[key] = b\n        if node.host:\n            sb = QtWidgets.QPushButton(\"START / NEW ROUND\")\n            sb.setFocusPolicy(QtCore.Qt.NoFocus)\n            sb.clicked.connect(lambda: setattr(node, 'start_req', True))\n            btns.addWidget(sb)\n        side = QtWidgets.QVBoxLayout()\n        plbl = QtWidgets.QLabel(\"Players\")\n        for x in (plbl, plist, chat, line):\n            side.addWidget(x)\n        top = QtWidgets.QHBoxLayout()\n        top.addWidget(board, 3)\n        top.addLayout(side, 1)\n        lay = QtWidgets.QVBoxLayout(w)\n        lay.addWidget(status)\n        lay.addLayout(top)\n        lay.addLayout(btns)\n        line.returnPressed.connect(lambda: (node.send_chat(line.text()), line.clear()))\n        plist.setFocusPolicy(QtCore.Qt.NoFocus)\n        plist.itemClicked.connect(lambda it: node.cast_vote(plist.row(it) + 1))\n        esc = QtWidgets.QShortcut(QtGui.QKeySequence(\"Esc\"), w)\n        esc.activated.connect(board.setFocus)\n        names = [\"LOBBY\", \"PLAYING\", \"MEETING\", \"GAME OVER\"]\n\n        def tick():\n            with node.lk:\n                v = node.view\n                if v:\n                    r = {None: \"\", 0: \"  |  You are CREW: do tasks (E)\", 1: \"  |  You are the IMPOSTOR: kill (K)\"}[node.role]\n                    t = \"%s%s  |  tasks %d/%d\" % (names[v['phase']], r, bin(v['tasks']).count('1'), len(TASKS))\n                    mv = \"SKIP\" if node.myvote == SKIP else (\"P%d\" % node.myvote if node.myvote else \"none yet\")\n                    me_alive = v['players'][node.me][2] & 1 if node.me < len(v['players']) else 0\n                    if v['phase'] == MEET:\n                        t += (\"  |  VOTE NOW (%ds left): click a player in the list, press 1-8, or Skip vote. Your vote: %s\" % (v['meet_left'], mv)) if me_alive else \"  |  meeting in progress (dead players cannot vote)\"\n                    if v['phase'] == END:\n                        t += \"  |  %s WIN (impostor was P%d)\" % (\"CREW\" if v['winner'] == 1 else \"IMPOSTOR\", v['reveal'] + 1)\n                    if not v['players'][node.me][2] & 1 and v['phase'] in (PLAY, MEET):\n                        t += \"  |  you are DEAD\"\n                    status.setText(t)\n                    playing, meeting = v['phase'] == PLAY and me_alive, v['phase'] == MEET and me_alive\n                    bt['use'].setEnabled(bool(playing))\n                    bt['kill'].setEnabled(bool(playing and node.role == 1))\n                    bt['report'].setEnabled(bool(playing))\n                    bt['skip'].setEnabled(bool(meeting))\n                    plbl.setText(\"CLICK A PLAYER TO VOTE FOR THEM\" if meeting else \"Players\")\n                    if plist.count() != v['n']:\n                        plist.clear()\n                        for i in range(v['n']):\n                            plist.addItem(\"\")\n                    for i, p in enumerate(v['players']):\n                        it = plist.item(i)\n                        it.setText(\"%d%s %s%s%s\" % (i + 1, \" (you)\" if i == node.me else \"\", \"\" if p[2] & 2 else \"[absent] \",\n                                                     \"\" if p[2] & 1 else \"[dead] \", \"[voted]\" if p[2] & 8 else (\"  <== your vote\" if (meeting and node.myvote == i + 1) else \"\")))\n                        it.setForeground(QtGui.QColor(COL[i % 8]))\n                else:\n                    status.setText(\"waiting for host signal...\")\n                txt = \"\\n\".join(node.chat_log)\n            if chat.toPlainText() != txt:\n                chat.setPlainText(txt)\n            board.update()\n\n        tm = QtCore.QTimer(w)\n        tm.timeout.connect(tick)\n        tm.start(40)\n        w.resize(1000, 520)\n        w.show()\n        board.setFocus()\n        self.win = (w, tm)\n"
    node_id: '3'
    n_players: n_players
    tick_ms: tick_ms
    slot_ms: slot_ms
    guard_ms: guard_ms
    key: game_key
    show_gui: '1'
    bot: '1'
    min_players: '3'
    title: '''Among Us Lite'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 5300
