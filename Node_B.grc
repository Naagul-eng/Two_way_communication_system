      \     self.receipts = OrderedDict()\n        self.access = ChannelAccess(clock=clock)\n\
      \        self.replies = OrderedDict()\n\n    def _event(self, direction, state,\
      \ transfer=None, **extra):\n        t = transfer or {}\n        self.event(dict(direction=direction,\
      \ state=state, name=t.get('name', ''),\n                        kind=t.get('kind',\
      \ ''), total=t.get('size', 0),\n                        done=t.get('done', 0),\
      \ started=t.get('started', self.clock()),\n                        **extra))\n\
