- name: hdlc_flush
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\nimport json\nimport hashlib\n\
      import struct\nimport numpy as np\n\ndef control(value):\n    return pmt.intern(json.dumps(value,\
      \ separators=(',', ':'), allow_nan=False))\n\n\ndef decode(message):\n    value\
      \ = json.loads(pmt.symbol_to_string(message))\n    if not isinstance(value,\
      \ dict):\n        raise ValueError('Expected command dictionary')\n    return\
      \ value\n\n\ndef pdu(raw):\n    return pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw),\
      \ list(raw)))\n\n\ndef raw_pdu(message):\n    if not pmt.is_pair(message):\n\
      \        raise ValueError('Expected byte PDU')\n    body = pmt.cdr(message)\n\
      \    if pmt.is_u8vector(body):\n        return bytes(pmt.u8vector_elements(body))\n\
      \    # HDLC deframer's binary blob is converted by PMT's numpy adapter.\n  \
      \  return bytes(pmt.to_python(body))\n\n\nACQUISITION = hashlib.shake_256(b'Duplex-QPSK-acquisition-v2').digest(768)\n\
      TRAINING = hashlib.shake_256(b'Duplex-QPSK-START-v1').digest(128)\nSYNC = bytes.fromhex('d391c5a76e2b408f')\n\
      SYNC_BITS = np.unpackbits(np.frombuffer(SYNC, dtype=np.uint8))\nTAIL = hashlib.shake_256(b'Duplex-QPSK-tail-v2').digest(512)\n\
      MAX_HDLC_BITS = 40000\nMAX_CODE_BITS = 2 * (MAX_HDLC_BITS + 6)\n\n\n\n\nclass\
      \ HDLCFlush(gr.basic_block):\n    \"\"\"Flush native deframer scheduler locally;\
      \ these zeros never go on air.\"\"\"\n    def __init__(self):\n        gr.basic_block.__init__(self,\
      \ name='Decoded Bits + Local Flush', in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('in'))\n\
      \        self.message_port_register_out(pmt.intern('out'))\n        self.set_msg_handler(pmt.intern('in'),\
      \ self.handle)\n\n    def handle(self, msg):\n        bits = raw_pdu(msg)\n\
      \        if len(bits) <= MAX_HDLC_BITS:\n            self.message_port_pub(pmt.intern('out'),\
      \ pdu(bits + bytes(8192)))\n\n\nclass blk(HDLCFlush):\n    def __init__(self):\n\
      \        super().__init__()\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Decoded Bits + Local Flush', 'HDLCFlush', [], [('in', 'message',
      1)], [('out', 'message', 1)], 'Flush native deframer scheduler locally; these
      zeros never go on air.', [])
