- name: payload_size
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\nimport json\nimport math\n\
      \ndef control(value):\n    return pmt.intern(json.dumps(value, separators=(',',\
      \ ':'), allow_nan=False))\n\n\ndef decode(message):\n    value = json.loads(pmt.symbol_to_string(message))\n\
      \    if not isinstance(value, dict):\n        raise ValueError('Expected command\
      \ dictionary')\n    return value\n\n\ndef pdu(raw):\n    return pmt.cons(pmt.PMT_NIL,\
      \ pmt.init_u8vector(len(raw), list(raw)))\n\n\ndef raw_pdu(message):\n    if\
      \ not pmt.is_pair(message):\n        raise ValueError('Expected byte PDU')\n\
      \    body = pmt.cdr(message)\n    if pmt.is_u8vector(body):\n        return\
      \ bytes(pmt.u8vector_elements(body))\n    # HDLC deframer's binary blob is converted\
      \ by PMT's numpy adapter.\n    return bytes(pmt.to_python(body))\n\n\nKINDS\
      \ = ('text', 'image', 'audio')\n\n\ndef profile(text, image, audio, low, high,\
      \ integer=False):\n    values = [int(v) if integer else float(v) for v in (text,\
      \ image, audio)]\n    if any(not math.isfinite(v) or not low <= v <= high for\
      \ v in values):\n        raise ValueError('Profile values must be in %s..%s'\
      \ % (low, high))\n    return dict(zip(KINDS, values))\n\n\nclass TimeoutPolicy:\n\
      \    \"\"\"RFC 6298-style estimator, with application-specific bounds (not TCP).\"\
      \"\"\n    def __init__(self, initial, floors, maximum=30.0):\n        self.initial,\
      \ self.floors, self.maximum = initial, floors, maximum\n        if any(floors[k]\
      \ > initial[k] for k in KINDS):\n            raise ValueError('RTO floor must\
      \ not exceed its initial value')\n        self.estimates = {}\n\n    def observe(self,\
      \ kind, sample):\n        sample = float(sample)\n        if kind not in self.initial\
      \ or not math.isfinite(sample) or sample <= 0:\n            raise ValueError('Invalid\
      \ RTT observation')\n        if kind not in self.estimates:\n            srtt,\
      \ variation = sample, sample / 2.0\n        else:\n            srtt, variation\
      \ = self.estimates[kind]\n            variation = 0.75 * variation + 0.25 *\
      \ abs(srtt - sample)\n            srtt = 0.875 * srtt + 0.125 * sample\n   \
      \     self.estimates[kind] = srtt, variation\n        return self.timeout(kind)\n\
      \n    def timeout(self, kind):\n        if kind not in self.estimates:\n   \
      \         return self.initial[kind]\n        srtt, variation = self.estimates[kind]\n\
      \        return min(self.maximum, max(self.floors[kind], srtt + max(0.01, 4\
      \ * variation)))\n\n\nclass blk(gr.basic_block):\n    def __init__(self, text_bytes=256,\
      \ image_bytes=512, audio_bytes=512):\n        gr.basic_block.__init__(self,\
      \ name='Payload Size Selection', in_sig=None, out_sig=None)\n        self.sizes\
      \ = profile(text_bytes, image_bytes, audio_bytes, 128, 1024, True)\n       \
      \ self.message_port_register_in(pmt.intern('in'))\n        self.message_port_register_out(pmt.intern('out'))\n\
      \        self.set_msg_handler(pmt.intern('in'), self.handle)\n\n    def handle(self,\
      \ msg):\n        command = decode(msg)\n        if command.get('op') == 'send':\n\
      \            command['chunk_size'] = self.sizes[command['kind']]\n        self.message_port_pub(pmt.intern('out'),\
      \ control(command))\n"
    affinity: ''
    alias: ''
    audio_bytes: '512'
    comment: ''
    image_bytes: '512'
    maxoutbuf: '0'
    minoutbuf: '0'
    text_bytes: '256'
  states:
    _io_cache: ('Payload Size Selection', 'blk', [('text_bytes', '256'), ('image_bytes',
      '512'), ('audio_bytes', '512')], [('in', 'message', 1)], [('out', 'message',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 496.0]
    rotation: 0
    state: enabled
