      \    raise ValueError('Encrypted frame exceeds 4092-byte PDU budget')\n    \
      \    return frame\n\n    def _reply(self, typ, tid, seq, body=b''):\n      \
      \  # Coalesce duplicate replies. All frames obey carrier sense.\n        key\
      \ = (typ, tid, seq, body)\n        if key not in self.replies:\n           \
      \ if len(self.replies) >= 256:\n                self.replies.popitem(last=False)\n\
      \            self.replies[key] = self._wire(typ, tid, seq, body)\n\n    @staticmethod\n\
      \    def _safe_name(name):\n        name = str(name).replace('\\\\', '/').split('/')[-1]\n\
      \        name = re.sub(r'[^\\w. -]', '_', name, flags=re.UNICODE).strip('. ')[:100]\n\
      \        return name or 'received.bin'\n\n    def send(self, kind, value, chunk_size=None,\
