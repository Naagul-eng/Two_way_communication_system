- name: carrier_sense
  id: epy_block
  parameters:
    _source_code: "\"\"\"Paste into a GRC Embedded Python Block; float input is averaged\
      \ |IQ|**2.\"\"\"\nfrom gnuradio import gr\nimport numpy as np\nimport pmt\n\
      import json\nimport time\nimport math\n\n\nclass blk(gr.sync_block):\n    def\
      \ __init__(self, threshold_db=-40.0, hysteresis_db=3.0,\n                 report_period=0.005):\n\
      \        gr.sync_block.__init__(self, name='Carrier Sense',\n              \
      \                 in_sig=[np.float32], out_sig=None)\n        if not math.isfinite(threshold_db)\
      \ or hysteresis_db < 0 or report_period <= 0:\n            raise ValueError('Invalid\
      \ carrier-sense settings')\n        self.high = 10.0 ** (threshold_db / 10.0)\n\
      \        self.low = 10.0 ** ((threshold_db - hysteresis_db) / 10.0)\n      \
      \  self.period = float(report_period)\n        self.busy = True\n        self.last\
      \ = 0.0\n        self.message_port_register_out(pmt.intern('cca'))\n\n    def\
      \ work(self, input_items, output_items):\n        samples = input_items[0]\n\
      \        if not len(samples):\n            return 0\n        # Conservatively\
      \ retain even a short busy interval in this work batch.\n        peak = float(np.max(samples))\n\
      \        before = self.busy\n        if not math.isfinite(peak) or peak < 0:\n\
      \            self.busy = True\n        elif peak >= self.high:\n           \
      \ self.busy = True\n        elif peak < self.low:\n            self.busy = False\n\
      \        now = time.monotonic()\n        if before != self.busy or now - self.last\
      \ >= self.period:\n            self.last = now\n            message = dict(busy=self.busy,\
      \ observed=now,\n                           power_db=10.0 * math.log10(max(peak,\
      \ 1e-30))\n                           if math.isfinite(peak) else None)\n  \
      \          self.message_port_pub(pmt.intern('cca'),\n                      \
      \            pmt.intern(json.dumps(message)))\n        return len(samples)\n"
    affinity: ''
    alias: ''
    comment: Calibrate the absolute threshold before RF testing.
    hysteresis_db: '3.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    report_period: '0.005'
    threshold_db: cs_threshold_db
  states:
    _io_cache: ('Carrier Sense', 'blk', [('threshold_db', '-40.0'), ('hysteresis_db',
      '3.0'), ('report_period', '0.005')], [('0', 'float', 1)], [('cca', 'message',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 1736.0]
    rotation: 0
    state: enabled
