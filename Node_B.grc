      \ = None\n        self._drop_rx('Stopped \u2014 partial file removed')\n\n\n\
      class blk(gr.basic_block):\n    def __init__(self, my_addr='A1', peer_addr='B1',\n\
      \                 shared_key='u362K7J0T2sA_vB1C2D3E4F5G6H7I8J9K0L1M2N3O4P=',\n\
      \                 receive_dir='./received_A1', max_retries=20, max_file_mb=16,\
      \ packet_interval=0.005,\n                 difs=0.010, slot_time=0.005, cw_min=8,\
      \ cw_max=128,\n                 cca_timeout=0.100, tx_guard=0.020):\n      \
      \  gr.basic_block.__init__(self, name='CSMA + Selective Repeat ARQ', in_sig=None,\
      \ out_sig=None)\n        self.commands, self.halt = queue.Queue(maxsize=2048),\
      \ threading.Event()\n        self.worker = None\n        for port in ('commands',\
      \ 'rx_in', 'cca'):\n            self.message_port_register_in(pmt.intern(port))\n\
      \        for port in ('tx_out', 'events', 'rtt'):\n            self.message_port_register_out(pmt.intern(port))\n\
      \        self.set_msg_handler(pmt.intern('commands'), self.command)\n      \
      \  self.set_msg_handler(pmt.intern('rx_in'), self.receive)\n        self.set_msg_handler(pmt.intern('cca'),\
      \ self.sense)\n        self.access_config = dict(difs=difs, slot_time=slot_time,\
      \ cw_min=cw_min,\n                                  cw_max=cw_max, cca_timeout=cca_timeout,\
      \ tx_guard=tx_guard)\n        self.config = dict(my_addr=my_addr, peer_addr=peer_addr,\
      \ shared_key=shared_key,\n                           receive_dir=receive_dir,\
      \ emit=self.publish, event=self.event,\n                           max_retries=max_retries,\
      \ max_file_mb=max_file_mb, packet_interval=packet_interval)\n        self.core\
      \ = TransferCore(**self.config)\n        self.core.access = ChannelAccess(**self.access_config)\n\
      \n    def sense(self, msg):\n        try:\n            report = decode(msg)\n\
      \            self.core.access.observe(report['busy'], float(report['observed']))\n\
      \        except (ValueError, TypeError, KeyError):\n            self.core.access.observe(True,\
      \ time.monotonic())\n\n    def publish(self, raw):\n        self.message_port_pub(pmt.intern('tx_out'),\
      \ pdu(raw))\n\n    def event(self, event):\n        self.message_port_pub(pmt.intern('events'),\
      \ control(event))\n\n    def command(self, msg):\n        try:\n           \
      \ self.commands.put_nowait(('command', decode(msg)))\n        except (ValueError,\
      \ queue.Full) as exc:\n            self.event(dict(direction='notice', state='Command\
      \ rejected: ' + str(exc)))\n\n    def receive(self, msg):\n        try:\n  \
      \          raw = raw_pdu(msg)\n            if len(raw) <= 4092:\n          \
      \      self.commands.put_nowait(('rx', raw))\n        except (ValueError, TypeError,\
      \ queue.Full):\n            pass\n\n    def start(self):\n        self.halt.clear()\n\
      \        self.core = TransferCore(**self.config)\n        self.core.access =\
      \ ChannelAccess(**self.access_config)\n        self.core.rtt_event = lambda\
      \ kind, sample: self.message_port_pub(\n            pmt.intern('rtt'), control(dict(kind=kind,\
      \ seconds=sample)))\n        self.worker = threading.Thread(target=self.run,\
      \ name='selective-repeat', daemon=True)\n        self.worker.start()\n     \
      \   return True\n\n    def run(self):\n        try:\n            while not self.halt.is_set():\n\
      \                try:\n                    op, value = self.commands.get(timeout=0.001)\n\
      \                    if op == 'rx':\n                        self.core.receive(value)\n\
      \                    elif value['op'] == 'send':\n                        try:\n\
      \                            self.core.send(**{k: v for k, v in value.items()\
      \ if k != 'op'})\n                        except (ValueError, OSError) as exc:\n\
      \                            self.event(dict(direction='notice', state=str(exc)))\n\
      \                    elif value['op'] == 'cancel':\n                       \
      \ self.core.cancel()\n                    elif value['op'] == 'rto_update':\n\
      \                        self.core.rtos[value['kind']] = float(value['seconds'])\n\
      \                except queue.Empty:\n                    pass\n           \
      \     self.core.tick()\n        except Exception as exc:\n            self.event(dict(direction='notice',\
      \ state='ARQ worker stopped: ' + str(exc)))\n        finally:\n            self.core.close()\n\
      \n    def stop(self):\n        self.halt.set()\n        if self.worker:\n  \
      \          self.worker.join(timeout=3)\n        return True\n"
