- name: sr_arq
  id: epy_block
  parameters:
    _source_code: "import json\nimport os\nimport queue\nimport re\nimport secrets\n\
      import threading\nimport time\nfrom collections import OrderedDict\nfrom pathlib\
      \ import Path\nfrom gnuradio import gr\nimport pmt\nimport hashlib\nimport struct\n\
      import numpy as np\nimport tempfile\nfrom cryptography.fernet import Fernet,\
      \ InvalidToken\n\ndef control(value):\n    return pmt.intern(json.dumps(value,\
      \ separators=(',', ':'), allow_nan=False))\n\n\ndef decode(message):\n    value\
      \ = json.loads(pmt.symbol_to_string(message))\n    if not isinstance(value,\
      \ dict):\n        raise ValueError('Expected command dictionary')\n    return\
      \ value\n\n\ndef pdu(raw):\n    return pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw),\
      \ list(raw)))\n\n\ndef raw_pdu(message):\n    if not pmt.is_pair(message):\n\
      \        raise ValueError('Expected byte PDU')\n    body = pmt.cdr(message)\n\
      \    if pmt.is_u8vector(body):\n        return bytes(pmt.u8vector_elements(body))\n\
      \    # HDLC deframer's binary blob is converted by PMT's numpy adapter.\n  \
      \  return bytes(pmt.to_python(body))\n\n\nACQUISITION = hashlib.shake_256(b'Duplex-QPSK-acquisition-v2').digest(768)\n\
      TRAINING = hashlib.shake_256(b'Duplex-QPSK-START-v1').digest(128)\nSYNC = bytes.fromhex('d391c5a76e2b408f')\n\
      SYNC_BITS = np.unpackbits(np.frombuffer(SYNC, dtype=np.uint8))\nTAIL = hashlib.shake_256(b'Duplex-QPSK-tail-v2').digest(512)\n\
      MAX_HDLC_BITS = 40000\nMAX_CODE_BITS = 2 * (MAX_HDLC_BITS + 6)\n\n\n\n\ndef\
      \ airtime_bound(pdu_bytes, sample_rate=2400000, sps=4):\n    # Worst-case stuffing,\
      \ two flags, FCS, six CC termination bits and byte pad.\n    hdlc_bits = 16\
      \ + ((pdu_bytes + 2) * 8 * 6 + 4) // 5\n    coded_bytes = (2 * (hdlc_bits +\
      \ 6) + 7) // 8\n    burst_bytes = len(ACQUISITION) + len(TRAINING) + 32 + coded_bytes\
      \ + len(TAIL)\n    return burst_bytes * 8 / (2 * sample_rate / sps)\n\n\n\n\n\
      _META, _DATA, _END, _ACK, _ERROR, _CANCEL = range(1, 7)\n_HEADER = struct.Struct('!4sB2s2s16sI')\n\
      _MAGIC = b'NGH3'\n\n\nclass ChannelAccess:\n    \"\"\"Soft-timed CSMA: all frames\
      \ contend, replies have queue priority.\n\n    cw is a count of slots; random\
      \ choice is 0..cw-1. Busy freezes the\n    remaining count; each return to idle\
      \ requires another complete DIFS.\n    \"\"\"\n    def __init__(self, difs=0.010,\
      \ slot_time=0.005, cw_min=8, cw_max=128,\n                 cca_timeout=0.100,\
      \ tx_guard=0.020, clock=time.monotonic):\n        if not (0 < slot_time <= difs\
      \ and 1 <= cw_min <= cw_max\n                and cca_timeout > difs and tx_guard\
      \ >= 0):\n            raise ValueError('Invalid CSMA timing/window parameters')\n\
      \        self.difs, self.slot = float(difs), float(slot_time)\n        self.cw_min,\
      \ self.cw_max = int(cw_min), int(cw_max)\n        self.timeout, self.guard,\
      \ self.clock = cca_timeout, tx_guard, clock\n        self.lock = threading.Lock()\n\
      \        self.last = None\n        self.busy = True\n        self.idle_since\
      \ = None\n        self.token = None\n        self.remaining = None\n       \
      \ self.slot_at = None\n        self.until = 0.0\n\n    def observe(self, busy,\
      \ observed):\n        now = self.clock()\n        with self.lock:\n        \
      \    if (not isinstance(busy, bool) or not np.isfinite(observed)\n         \
      \           or observed > now or now - observed > self.timeout):\n         \
      \       self.busy, self.idle_since, self.slot_at = True, None, None\n      \
      \          return\n            if self.last is not None and observed < self.last:\n\
      \                return\n            gap = self.last is None or observed - self.last\
      \ > self.timeout\n            if busy:\n                self.idle_since = self.slot_at\
      \ = None\n            elif self.busy or gap or self.idle_since is None:\n  \
      \              self.idle_since = now\n                self.slot_at = None\n\
      \            self.busy, self.last = busy, observed\n\n    def grant(self, token,\
      \ retry=0):\n        now = self.clock()\n        with self.lock:\n         \
      \   if token != self.token:\n                self.token = token\n          \
      \      cw = min(self.cw_max, self.cw_min * (2 ** min(retry, 20)))\n        \
      \        self.remaining = secrets.randbelow(cw)\n                self.slot_at\
      \ = None\n            if (self.last is None or now - self.last > self.timeout\
      \ or self.busy):\n                self.idle_since = self.slot_at = None\n  \
      \              return False\n            if now < self.until:\n            \
      \    self.slot_at = None\n                return False\n            if self.idle_since\
      \ is None:\n                self.idle_since = now\n            ready = max(self.idle_since,\
      \ self.until) + self.difs\n            if now < ready:\n                return\
      \ False\n            if self.slot_at is None:\n                self.slot_at\
      \ = now\n            # No catch-up after host scheduling stalls: this is conservative.\n\
      \            if self.remaining and now - self.slot_at >= self.slot:\n      \
      \          self.remaining -= 1\n                self.slot_at = now\n       \
      \     return self.remaining == 0\n\n    def reserve(self, seconds):\n      \
      \  with self.lock:\n            self.until = self.clock() + seconds + self.guard\n\
      \            self.token = self.remaining = self.slot_at = None\n           \
      \ self.idle_since = None\n\n\nclass TransferCore:\n    \"\"\"Selective Repeat,\
      \ independently in each direction (one file per direction).\n\n    META (0)\
      \ is acknowledged before DATA (1..N). DATA uses a bounded sliding\n    window\
      \ and individual ACKs/timers. END (N+1) is sent after all DATA ACKs,\n    and\
      \ acknowledged only after SHA-256 verification and saving the file.\n    32-bit\
      \ sequence numbers never wrap within a transfer. A random 128-bit\n    transfer\
      \ ID separates transfers. All methods run on one worker thread.\n    \"\"\"\n\
      \    def __init__(self, my_addr, peer_addr, shared_key, receive_dir, emit, event,\n\
      \                 chunk_size=512, ack_timeout=1.0, max_retries=8,\n        \
      \         max_file_mb=16, window_size=4, packet_interval=0.02,\n           \
      \      clock=time.monotonic):\n        for addr in (my_addr, peer_addr):\n \
      \           if not isinstance(addr, str) or len(addr.encode('ascii')) != 2:\n\
      \                raise ValueError('Addresses must be exactly two ASCII characters')\n\
      \        if my_addr == peer_addr:\n            raise ValueError('Local and peer\
      \ addresses must differ')\n        if not 128 <= int(chunk_size) <= 1024:\n\
      \            raise ValueError('chunk_size must be 128..1024 bytes')\n      \
      \  if not 0.05 <= float(ack_timeout) <= 30 or not 0 <= int(max_retries) <= 20:\n\
      \            raise ValueError('ack_timeout: 0.05..30 seconds; max_retries: 0..20')\n\
      \        if not 1 <= int(max_file_mb) <= 256:\n            raise ValueError('max_file_mb\
      \ must be 1..256')\n        if not 1 <= int(window_size) <= 64:\n          \
      \  raise ValueError('window_size must be 1..64 packets')\n        if not 0 <=\
      \ float(packet_interval) <= 5:\n            raise ValueError('packet_interval\
      \ must be 0..5 seconds')\n        key = shared_key.encode('ascii') if isinstance(shared_key,\
      \ str) else shared_key\n        self.cipher = Fernet(key)\n        self.me,\
      \ self.peer = my_addr.encode('ascii'), peer_addr.encode('ascii')\n        self.directory\
      \ = Path(receive_dir).expanduser().resolve()\n        self.emit, self.event,\
      \ self.clock = emit, event, clock\n        self.chunk, self.window = int(chunk_size),\
      \ int(window_size)\n        self.rtt_event = lambda kind, sample: None\n   \
      \     self.rtos = {}\n        self.rto_floor = 0.5\n        self.timeout, self.retries\
      \ = float(ack_timeout), int(max_retries)\n        self.interval = float(packet_interval)\n\
      \        self.limit = int(max_file_mb) * 1024 * 1024\n        # Allow a complete\
      \ retry round even when 64 packets are heavily paced.\n        self.idle_timeout\
