      \ meta.get('window')\n            digest, kind = meta.get('sha256'), meta.get('kind')\n\
      \            if type(size) is not int or not 0 <= size <= self.limit:\n    \
      \            raise ValueError('Unsupported file size')\n            if type(chunk)\
      \ is not int or not 128 <= chunk <= 1024:\n                raise ValueError('Invalid\
      \ chunk size')\n            if type(window) is not int or not 1 <= window <=\
      \ 64:\n                raise ValueError('Invalid window size')\n           \
      \ if kind not in ('text', 'image', 'audio') or (kind == 'text' and size > 65536):\n\
