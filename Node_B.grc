      \      timeout = self.timeout if ack_timeout is None else float(ack_timeout)\n\
      \        floor = self.rto_floor if rto_floor is None else float(rto_floor)\n\
      \        if not 128 <= chunk <= 1024 or not 1 <= window <= 64:\n           \
      \ raise ValueError('Invalid payload size or window')\n        if not 0.05 <=\
      \ floor <= timeout <= 30:\n            raise ValueError('Invalid ACK timeout\
      \ policy')\n        self.chunk, self.window, self.timeout, self.rto_floor =\
      \ chunk, window, timeout, floor\n        self.rtos[kind] = timeout\n       \
      \ if kind == 'text':\n            data, name = value.encode('utf-8'), 'message.txt'\n\
      \            if not data or len(data) > 65536:\n                raise ValueError('Type\
      \ a message of 1..65536 UTF-8 bytes')\n        elif kind in ('image', 'audio'):\n\
      \            path = Path(value)\n            if not path.is_file() or path.stat().st_size\
      \ > self.limit:\n                raise ValueError('Choose a file within the\
      \ configured size limit')\n            with path.open('rb') as f:\n        \
      \        data = f.read(self.limit + 1)\n            name = path.name\n     \
      \   else:\n            raise ValueError('Unsupported transfer type')\n     \
      \   if len(data) > self.limit:\n            raise ValueError('File exceeds the\
      \ configured size limit')\n        self.tx = dict(tid=secrets.token_bytes(16),\
      \ data=data, kind=kind,\n                       name=self._safe_name(name),\
      \ size=len(data), done=0,\n                       started=self.clock(), n=(len(data)\
      \ + self.chunk - 1) // self.chunk,\n                       digest=hashlib.sha256(data).hexdigest(),\
      \ phase='meta',\n                       base=1, next=1, acked=set(), pending={})\n\
      \        t = self.tx\n        meta = dict(kind=t['kind'], name=t['name'], size=t['size'],\
      \ chunk=self.chunk,\n                    window=self.window, sha256=t['digest'])\n\
      \        self._queue_packet(_META, 0, json.dumps(meta, ensure_ascii=True,\n\
      \                           separators=(',', ':')).encode())\n        self._event('tx',\
      \ 'Sending metadata', t)\n        self._pump()\n\n    def _queue_packet(self,\
      \ typ, seq, body):\n        t = self.tx\n        t['pending'][seq] = dict(wire=self._wire(typ,\
      \ t['tid'], seq, body),\n                                 sent=None, retry=0,\
      \ rto=self.timeout)\n\n    def _fill_window(self):\n        t = self.tx\n  \
      \      if t['phase'] != 'data':\n            return\n        # The window is\
      \ anchored at the oldest unacknowledged sequence number,\n        # not merely\
      \ at the number of pending packets. This bounds RX buffering.\n        while\
      \ t['next'] <= t['n'] and t['next'] < t['base'] + self.window:\n           \
      \ seq = t['next']\n            self._queue_packet(_DATA, seq,\n            \
      \                   t['data'][(seq - 1) * self.chunk:seq * self.chunk])\n  \
      \          t['next'] += 1\n        if t['base'] > t['n']:\n            t['phase']\
      \ = 'end'\n            self._queue_packet(_END, t['n'] + 1, bytes.fromhex(t['digest']))\n\
      \            self._event('tx', 'Waiting for file verification', t)\n\n    def\
      \ _acknowledge(self, tid, seq, body):\n        t = self.tx\n        if body\
      \ or t is None or t['tid'] != tid:\n            return\n        packet = t['pending'].get(seq)\n\
      \        if packet is None or packet['sent'] is None:\n            return  #\
