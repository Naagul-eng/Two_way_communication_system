      \                                            suffix='.part', dir=self.directory,\
      \ delete=False)\n            self.rx = dict(tid=tid, meta=body, kind=kind, name=self._safe_name(meta['name']),\n\
      \                           size=size, chunk=chunk, window=window, digest=digest,\n\
      \                           n=(size + chunk - 1) // chunk, next=1, done=0, buffer={},\n\
      \                           hash=hashlib.sha256(), file=f, temp=Path(f.name),\n\
      \                           started=self.clock(), last=self.clock())\n     \
      \       self._event('rx', 'Receiving', self.rx)\n            self._reply(_ACK,\
      \ tid, seq)\n            return\n        r = self.rx\n        if r is None or\
