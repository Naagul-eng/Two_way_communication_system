- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\nimport json\nimport hashlib\n\
      import struct\nimport numpy as np\n\ndef control(value):\n    return pmt.intern(json.dumps(value,\
      \ separators=(',', ':'), allow_nan=False))\n\n\ndef decode(message):\n    value\
      \ = json.loads(pmt.symbol_to_string(message))\n    if not isinstance(value,\
      \ dict):\n        raise ValueError('Expected command dictionary')\n    return\
      \ value\n\n\ndef pdu(raw):\n    return pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw),\
      \ list(raw)))\n\n\ndef raw_pdu(message):\n    if not pmt.is_pair(message):\n\
      \        raise ValueError('Expected byte PDU')\n    body = pmt.cdr(message)\n\
      \    if pmt.is_u8vector(body):\n        return bytes(pmt.u8vector_elements(body))\n\
      \    # HDLC deframer's binary blob is converted by PMT's numpy adapter.\n  \
      \  return bytes(pmt.to_python(body))\n\n\nACQUISITION = hashlib.shake_256(b'Duplex-QPSK-acquisition-v2').digest(768)\n\
      TRAINING = hashlib.shake_256(b'Duplex-QPSK-START-v1').digest(128)\nSYNC = bytes.fromhex('d391c5a76e2b408f')\n\
      SYNC_BITS = np.unpackbits(np.frombuffer(SYNC, dtype=np.uint8))\nTAIL = hashlib.shake_256(b'Duplex-QPSK-tail-v2').digest(512)\n\
      MAX_HDLC_BITS = 40000\nMAX_CODE_BITS = 2 * (MAX_HDLC_BITS + 6)\n\n\n\n\ndef\
      \ waveform_bytes(encoded_bits):\n    bits = (np.frombuffer(encoded_bits, dtype=np.uint8)\n\
      \            if isinstance(encoded_bits, bytes) else np.asarray(encoded_bits,\
      \ dtype=np.uint8))\n    if not 12 < len(bits) <= MAX_CODE_BITS or len(bits)\
      \ % 2 or np.any(bits > 1):\n        raise ValueError('Invalid terminated FEC\
      \ bit count')\n    header = struct.pack('!II', len(bits), len(bits) ^ 0xffffffff)\n\
      \    return ACQUISITION + TRAINING + SYNC + header * 3 + np.packbits(bits).tobytes()\
      \ + TAIL\n\n\n\n\nclass BurstTX(gr.basic_block):\n    def __init__(self):\n\
      \        gr.basic_block.__init__(self, name='Known Preamble + FEC Burst', in_sig=None,\
      \ out_sig=None)\n        self.message_port_register_in(pmt.intern('pdu_in'))\n\
      \        self.message_port_register_out(pmt.intern('pdu_out'))\n        self.set_msg_handler(pmt.intern('pdu_in'),\
      \ self.handle)\n\n    def handle(self, msg):\n        self.message_port_pub(pmt.intern('pdu_out'),\
      \ pdu(waveform_bytes(raw_pdu(msg))))\n\n\n\n\nclass blk(BurstTX):\n    def __init__(self):\n\
      \        super().__init__()\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Known Preamble + FEC Burst', 'BurstTX', [], [('pdu_in', 'message',
      1)], [('pdu_out', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [984, 912.0]
    rotation: 0
    state: enabled
- name: fec_burst_rx
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\nimport hashlib\nimport struct\n\
      import numpy as np\n\nACQUISITION = hashlib.shake_256(b'Duplex-QPSK-acquisition-v2').digest(768)\n\
      TRAINING = hashlib.shake_256(b'Duplex-QPSK-START-v1').digest(128)\nSYNC = bytes.fromhex('d391c5a76e2b408f')\n\
      SYNC_BITS = np.unpackbits(np.frombuffer(SYNC, dtype=np.uint8))\nTAIL = hashlib.shake_256(b'Duplex-QPSK-tail-v2').digest(512)\n\
      MAX_HDLC_BITS = 40000\nMAX_CODE_BITS = 2 * (MAX_HDLC_BITS + 6)\n\n\n\n\nclass\
      \ BurstRX(gr.sync_block):\n    \"\"\"Recover codeword boundaries from hard bits,\
      \ then emit native FEC metrics.\n\n    Search is vectorized rather than a per-bit\
      \ Python callback. Corrupt length\n    headers are rejected; storage is bounded\
      \ by one maximum codeword. Header\n    redundancy is separate from the convolutionally\
      \ protected HDLC frame.\n    \"\"\"\n    def __init__(self, sync_errors=3):\n\
      \        gr.sync_block.__init__(self, name='FEC Burst Acquisition', in_sig=[np.uint8],\
      \ out_sig=None)\n        self.sync_errors = int(sync_errors)\n        self.buf\
      \ = np.empty(0, dtype=np.uint8)\n        self.message_port_register_out(pmt.intern('out'))\n\
      \        self.accepted = self.bad_headers = 0\n\n    def work(self, input_items,\
      \ output_items):\n        incoming = input_items[0]\n        self.buf = np.concatenate((self.buf,\
      \ incoming & 1))\n        while len(self.buf) >= 64:\n            # Candidate\
      \ sync, with <=3 errors. Retain candidate until complete.\n            windows\
      \ = np.lib.stride_tricks.sliding_window_view(self.buf, 64)\n            # XOR\
      \ avoids signed integer overflow in dot-product correlation.\n            candidates\
      \ = np.flatnonzero(np.count_nonzero(windows != SYNC_BITS, axis=1) <= self.sync_errors)\n\
      \            if not len(candidates):\n                self.buf = self.buf[-63:].copy()\n\
      \                break\n            pos = int(candidates[0])\n            if\
      \ pos:\n                self.buf = self.buf[pos:].copy()\n            if len(self.buf)\
      \ < 64 + 192:\n                break\n            copies = self.buf[64:256].reshape(3,\
      \ 64)\n            header = np.packbits(np.sum(copies, axis=0) >= 2).tobytes()\n\
      \            length, inverse = struct.unpack('!II', header)\n            if\
      \ length ^ inverse != 0xffffffff or not 12 < length <= MAX_CODE_BITS or length\
      \ % 2:\n                self.bad_headers += 1\n                self.buf = self.buf[1:]\n\
      \                continue\n            if len(self.buf) < 256 + length:\n  \
      \              break\n            metrics = self.buf[256:256 + length].astype(np.float32)\
      \ * 2 - 1\n            self.message_port_pub(pmt.intern('out'), pmt.cons(pmt.PMT_NIL,\n\
      \                pmt.init_f32vector(len(metrics), metrics)))\n            self.accepted\
      \ += 1\n            self.buf = self.buf[256 + length:].copy()\n        return\
      \ len(incoming)\n\n\n\n\nclass blk(BurstRX):\n    def __init__(self, sync_errors=3):\n\
      \        super().__init__(sync_errors)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    sync_errors: '3'
  states:
    _io_cache: ('FEC Burst Acquisition', 'BurstRX', [('sync_errors', '3')], [('0',
      'byte', 1)], [('out', 'message', 1)], 'Recover codeword boundaries from hard
      bits, then emit native FEC metrics.\n\n    Search is vectorized rather than
      a per-bit Python callback. Corrupt length\n    headers are rejected; storage
      is bounded by one maximum codeword. Header\n    redundancy is separate from
      the convolutionally protected HDLC frame.\n    ', ['sync_errors'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2744, 1496.0]
    rotation: 0
    state: enabled
