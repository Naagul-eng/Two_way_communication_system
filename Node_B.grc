      \ body\n                r['done'] += len(body)  # Unique accepted bytes, including\
      \ buffered ones.\n            elif r['buffer'][seq] != body:\n             \
      \   raise ValueError('Conflicting duplicate packet')\n            while r['next']\
      \ in r['buffer']:\n                contiguous = r['buffer'].pop(r['next'])\n\
