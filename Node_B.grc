      \ + '_' + r['name'])\n            os.replace(r['temp'], final)\n           \
      \ self._remember(tid, seq=seq, digest=body)\n            self.rx = None\n  \
      \          self._reply(_ACK, tid, seq)\n            self._event('rx', 'Complete\
      \ \u2014 saved and verified', r, path=str(final))\n\n    def tick(self):\n \
