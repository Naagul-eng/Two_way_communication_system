      \ packets cannot provide unambiguous RTT samples.\n        if packet['retry']\
      \ == 0:\n            self.rtt_event(t['kind'], max(0.001, self.clock() - packet['sent']))\n\
      \        del t['pending'][seq]\n        if t['phase'] == 'meta':\n         \
      \   t['phase'] = 'data'\n        elif t['phase'] == 'end':\n            self._event('tx',\
      \ 'Complete \u2014 receiver verified', t)\n            self.tx = None\n    \
      \        return\n        else:\n            t['done'] += min(self.chunk, t['size']\
      \ - (seq - 1) * self.chunk)\n            t['acked'].add(seq)\n            while\
      \ t['base'] in t['acked']:\n                t['acked'].remove(t['base'])\n \
      \               t['base'] += 1\n            self._event('tx', 'Sending', t)\n\
      \        self._fill_window()\n        self._pump()\n\n    def _pump(self):\n\
      \        \"\"\"Emit at most one DATA/META/END PDU per call, with retry priority.\"\
      \"\"\n        t, now = self.tx, self.clock()\n        if now < self.next_emit:\n\
      \            return\n        if self.replies:\n            key, wire = next(iter(self.replies.items()))\n\
      \            if self.access.grant(('reply', key)):\n                del self.replies[key]\n\
      \                duration = max(self.interval, 1.15 * airtime_bound(len(wire)))\n\
      \                self.access.reserve(duration)\n                self.next_emit\
      \ = now + duration\n                self.emit(wire)\n            return\n  \
      \      if t is None:\n            return\n        expired = [(p['sent'], seq)\
      \ for seq, p in t['pending'].items()\n                   if p['sent'] is not\
      \ None and now - p['sent'] >= p['rto']]\n        if expired:\n            _,\
      \ seq = min(expired)\n            p = t['pending'][seq]\n            if p['retry']\
      \ >= self.retries:\n                self._abort_tx('Unconfirmed \u2014 ACK timeout\
      \ for packet %d' % seq)\n                return\n            if not self.access.grant((t['tid'],\
      \ seq, p['retry'] + 1), p['retry'] + 1):\n                return\n         \
      \   p['retry'] += 1\n            self._event('tx', 'Retry packet %d (%d/%d)'\
      \ %\n                        (seq, p['retry'], self.retries), t)\n        else:\n\
      \            seq = next((s for s, p in t['pending'].items() if p['sent'] is\
      \ None), None)\n            if seq is None:\n                return\n      \
      \      p = t['pending'][seq]\n            if not self.access.grant((t['tid'],\
      \ seq, 0)):\n                return\n        if p['retry']:\n            p['rto']\
      \ = min(30.0, 2.0 * p['rto'])\n        else:\n            p['rto'] = max(self.rto_floor,\
      \ self.rtos.get(t['kind'], self.timeout))\n            if t['phase'] == 'end':\n\
      \                p['rto'] = max(2.0, p['rto'])  # File hash and fsync allowance.\n\
      \        p['sent'] = now  # Timestamp PDU submission, not an RF hardware timestamp.\n\
      \        self.next_emit = now + max(self.interval, 1.15 * airtime_bound(len(p['wire'])))\n\
      \        self.access.reserve(self.next_emit - now)\n        self.emit(p['wire'])\n\
      \n    def receive(self, frame):\n        # The upstream HDLC deframer drops\
      \ bad FCS and removes framing/FCS.\n        if len(frame) < 5 or len(frame)\
      \ > 4092 or frame[:4] != self.peer + self.me:\n            return\n        try:\n\
      \            raw = self.cipher.decrypt(frame[4:])\n            if len(raw) <\
      \ _HEADER.size:\n                return\n            magic, typ, src, dst, tid,\
      \ seq = _HEADER.unpack(raw[:_HEADER.size])\n            if magic != _MAGIC or\
      \ src != self.peer or dst != self.me:\n                return\n            body\
      \ = raw[_HEADER.size:]\n        except (InvalidToken, ValueError, struct.error):\n\
      \            return\n        if typ == _ACK:\n            self._acknowledge(tid,\
      \ seq, body)\n        elif typ == _ERROR:\n            if self.tx and tid ==\
      \ self.tx['tid'] and seq in self.tx['pending']:\n                self._abort_tx('Failed:\
      \ ' + body.decode('utf-8', 'replace')[:180])\n        elif typ == _CANCEL:\n\
      \            if body:\n                return\n            if self.rx and self.rx['tid']\
      \ == tid:\n                self._drop_rx('Cancelled by sender')\n          \
      \  elif tid not in self.receipts:\n                # A reordered CANCEL can\
      \ arrive before its META.\n                self._remember(tid, error='Cancelled\
      \ by sender')\n        elif typ in (_META, _DATA, _END):\n            try:\n\
      \                self._receive_data(typ, tid, seq, body)\n            except\
      \ (ValueError, OSError, UnicodeError, KeyError, TypeError) as exc:\n       \
      \         reason = str(exc)[:180]\n                if self.rx and self.rx['tid']\
      \ == tid:\n                    self._drop_rx('Failed: ' + reason)\n        \
      \        elif tid not in self.receipts:\n                    self._remember(tid,\
      \ error=reason)\n                self._reply(_ERROR, tid, seq, reason.encode('utf-8')[:180])\n\
      \n    def _remember(self, tid, **fields):\n        self.receipts[tid] = dict(at=self.clock(),\
      \ **fields)\n        self.receipts.move_to_end(tid)\n        while len(self.receipts)\
      \ > 256:\n            self.receipts.popitem(last=False)\n\n    def _receive_data(self,\
      \ typ, tid, seq, body):\n        if tid in self.receipts:\n            c = self.receipts[tid]\n\
      \            if 'error' in c:\n                self._reply(_ERROR, tid, seq,\
      \ c['error'].encode('utf-8')[:180])\n            elif typ == _END and seq ==\
      \ c['seq'] and body == c['digest']:\n                self._reply(_ACK, tid,\
      \ seq)  # Lost final ACK: never save twice.\n            return\n        if\
      \ typ == _META:\n            if seq != 0:\n                raise ValueError('Invalid\
