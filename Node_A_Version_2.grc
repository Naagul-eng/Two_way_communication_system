- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: "\"\"\"Replace the code in epy_block_3 with this ENTIRE file.\n\n\
      Put padding OUTSIDE the protocol header and CRC-protected payload.\nThe suffix\
      \ flushes finite bursts through filters and hardware buffers.\n\"\"\"\nimport\
      \ os\nfrom gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self, num_dummy_bytes=1500, num_tail_bytes=1024):\n      \
      \  gr.basic_block.__init__(self, name='Burst Prefix + Tail',\n             \
      \                   in_sig=None, out_sig=None)\n        self.prefix, self.tail\
      \ = int(num_dummy_bytes), int(num_tail_bytes)\n        if self.prefix < 0 or\
      \ self.tail < 0:\n            raise ValueError('Padding lengths must be nonnegative')\n\
      \        self.message_port_register_in(pmt.intern('pdu_in'))\n        self.message_port_register_out(pmt.intern('pdu_out'))\n\
      \        self.set_msg_handler(pmt.intern('pdu_in'), self.handle)\n\n    def\
      \ handle(self, msg):\n        if not pmt.is_pair(msg) or not pmt.is_u8vector(pmt.cdr(msg)):\n\
      \            return\n        raw = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n\
      \        padded = os.urandom(self.prefix) + raw + os.urandom(self.tail)\n  \
      \      self.message_port_pub(pmt.intern('pdu_out'),\n                      \
      \        pmt.cons(pmt.car(msg), pmt.init_u8vector(len(padded), list(padded))))\n"
    affinity: ''
    alias: ''
    comment: Random prefix for acquisition; tail flushes finite bursts
    maxoutbuf: '0'
    minoutbuf: '0'
    num_dummy_bytes: '1500'
    num_tail_bytes: '1024'
  states:
    _io_cache: ('Burst Prefix + Tail', 'blk', [('num_dummy_bytes', '1500'), ('num_tail_bytes',
      '1024')], [('pdu_in', 'message', 1)], [('pdu_out', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [4536, 344.0]
    rotation: 0
    state: enabled
- name: epy_transfer_gui
  id: epy_block
  parameters:
    _source_code: "\"\"\"Complete GNU Radio 3.10 Embedded Python Block: Selective\
      \ Repeat chat.\n\nPaste the ENTIRE plain .py file into the block editor on BOTH\
      \ nodes.\nPorts: rx_in = CRC-checked byte PDU, tx_out = encrypted byte PDU for\
      \ CRC Append.\nKeep QPSK, framing, and FEC outside this block. Options must\
      \ use QT GUI.\nNot wire-compatible with the previous Stop-and-Wait version (NGF1).\n\
      DATA has a sliding window; META and END are individually acknowledged handshakes.\n\
      Default shared_key is for demonstration: retain your matching key on both nodes.\n\
      \"\"\"\n\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\n\
      import queue\nimport re\nimport secrets\nimport struct\nimport tempfile\nimport\
      \ threading\nimport time\nfrom collections import OrderedDict\nfrom cryptography.fernet\
      \ import Fernet, InvalidToken\n\n_META, _DATA, _END, _ACK, _ERROR, _CANCEL =\
      \ range(1, 7)\n_HEADER = struct.Struct('!4sB2s2s16sI')\n_MAGIC = b'NGS2'\n\n\
      \n# GNU Radio / Qt adapter. The protocol core below is independently testable.\n\
      from gnuradio import gr\nimport pmt\nfrom PyQt5 import QtCore, QtGui, QtWidgets\n\
      \n\nclass blk(gr.basic_block):\n    \"\"\"Duplex text/image/audio GUI + encrypted\
      \ Selective Repeat file transfer.\"\"\"\n    def __init__(self, my_addr='A1',\
      \ peer_addr='B1',\n                 shared_key='u362K7J0T2sA_vB1C2D3E4F5G6H7I8J9K0L1M2N3O4P=',\n\
      \                 receive_dir='./received_A1', chunk_size=512, ack_timeout=1.0,\n\
      \                 max_retries=8, max_file_mb=16, show_gui=True,\n          \
      \       window_size=4, packet_interval=0.02):\n        gr.basic_block.__init__(self,\
      \ name='Selective Repeat Chat GUI',\n                                in_sig=None,\
      \ out_sig=None)\n        self.my_addr, self.peer_addr = my_addr, peer_addr\n\
      \        self.receive_dir = str(Path(receive_dir).expanduser().resolve())\n\
      \        self.max_file_mb, self.show_gui = max_file_mb, show_gui\n        self.commands,\
      \ self.events = queue.Queue(maxsize=2048), queue.Queue()\n        self.halt\
      \ = threading.Event()\n        self.worker = self.bridge = None\n        self._config\
      \ = (my_addr, peer_addr, shared_key, receive_dir, self._publish,\n         \
      \               self.events.put, chunk_size, ack_timeout, max_retries, max_file_mb,\n\
      \                        window_size, packet_interval)\n        self.core =\
      \ _TransferCore(*self._config)  # Validate only; no window/thread/files.\n \
      \       self.message_port_register_in(pmt.intern('rx_in'))\n        self.message_port_register_out(pmt.intern('tx_out'))\n\
      \        self.set_msg_handler(pmt.intern('rx_in'), self._receive)\n\n    def\
      \ _publish(self, raw):\n        self.message_port_pub(pmt.intern('tx_out'),\n\
      \                              pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw),\
      \ list(raw))))\n\n    def _receive(self, msg):\n        if pmt.is_pair(msg)\
      \ and pmt.is_u8vector(pmt.cdr(msg)):\n            raw = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n\
      \            if len(raw) <= 4092:\n                try:\n                  \
      \  self.commands.put_nowait(('rx', raw))\n                except queue.Full:\n\
      \                    pass  # ARQ recovers an overloaded receiver like a dropped\
      \ packet.\n\n    def start(self):\n        self.halt.clear()\n        self.core\
      \ = _TransferCore(*self._config)\n        if self.show_gui:\n            app\
      \ = QtWidgets.QApplication.instance()\n            if app is None:\n       \
      \         print('[Transfer GUI] Set Options > Generate Options = QT GUI')\n\
      \                return False\n            self.bridge = _WindowBridge(self)\n\
      \            self.bridge.moveToThread(app.thread())\n            self.bridge.open_requested.emit()\n\
      \        self.worker = threading.Thread(target=self._run, name='file-transfer',\
      \ daemon=True)\n        self.worker.start()\n        return True\n\n    def\
      \ _run(self):\n        try:\n            while not self.halt.is_set():\n   \
      \             try:\n                    cmd = self.commands.get(timeout=0.01)\n\
      \                    if cmd[0] == 'rx':\n                        self.core.receive(cmd[1])\n\
      \                    elif cmd[0] == 'send':\n                        try:\n\
      \                            self.core.send(cmd[1], cmd[2])\n              \
      \          except Exception as exc:\n                            self.events.put(dict(direction='notice',\
      \ state=str(exc)))\n                    elif cmd[0] == 'cancel':\n         \
      \               self.core.cancel()\n                except queue.Empty:\n  \
      \                  pass\n                self.core.tick()\n        except Exception\
      \ as exc:\n            self.events.put(dict(direction='notice', state='Worker\
      \ stopped: ' + str(exc)))\n            print('[Transfer GUI] Worker stopped:',\
      \ exc, flush=True)\n        finally:\n            self.core.close()\n\n    def\
      \ stop(self):\n        self.halt.set()\n        if self.worker:\n          \
      \  self.worker.join(timeout=3)\n        if self.bridge:\n            self.bridge.close_requested.emit()\n\
      \        return True\n\n\nclass _TransferCore:\n    \"\"\"Selective Repeat,\
      \ independently in each direction (one file per direction).\n\n    META (0)\
      \ is acknowledged before DATA (1..N). DATA uses a bounded sliding\n    window\
      \ and individual ACKs/timers. END (N+1) is sent after all DATA ACKs,\n    and\
      \ acknowledged only after SHA-256 verification and saving the file.\n    32-bit\
      \ sequence numbers never wrap within a transfer. A random 128-bit\n    transfer\
