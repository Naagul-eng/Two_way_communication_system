- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import secrets\nimport struct\n\nfrom gnuradio import gr\nimport\
      \ pmt\n\n\nTYPE_TEXT = 0x01\nTYPE_IMAGE = 0x02\nTYPE_AUDIO = 0x03\n\nMAX_PAYLOAD\
      \ = 200\nMAX_SEGMENTS = 255\n\n# SRC, DST, TYPE, MESSAGE_ID, SEQ, TOTAL, PAYLOAD_LENGTH\n\
      HEADER_FORMAT = \">BBBIBBH\"\nHEADER_LEN = struct.calcsize(HEADER_FORMAT)\n\n\
      \nclass blk(gr.basic_block):\n\n    def __init__(self, src_addr=0x01, dst_addr=0x03,\n\
      \                 msg_type=TYPE_TEXT):\n        gr.basic_block.__init__(\n \
      \           self,\n            name=\"Packet Builder\",\n            in_sig=None,\n\
      \            out_sig=None\n        )\n\n        self.src_addr = src_addr & 0xFF\n\
      \        self.dst_addr = dst_addr & 0xFF\n        self.msg_type = msg_type &\
      \ 0xFF\n\n        # Random starting point reduces collisions after restarting\
      \ TX.\n        self._next_message_id = secrets.randbits(32)\n\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\
      \        self.set_msg_handler(\n            pmt.intern(\"pdu_in\"),\n      \
      \      self.handle_msg\n        )\n\n    def handle_msg(self, msg):\n      \
      \  if not pmt.is_pair(msg):\n            print(\"[TX] Invalid PDU\")\n     \
      \       return\n\n        meta = pmt.car(msg)\n        data = pmt.cdr(msg)\n\
      \n        if not pmt.is_u8vector(data):\n            print(\"[TX] PDU data is\
      \ not a u8vector\")\n            return\n\n        try:\n            payload\
      \ = bytes(pmt.u8vector_elements(data))\n        except Exception as exc:\n \
      \           print(\"[TX] Could not extract payload:\", exc)\n            return\n\
      \n        segments = [\n            payload[offset:offset + MAX_PAYLOAD]\n \
      \           for offset in range(0, len(payload), MAX_PAYLOAD)\n        ]\n\n\
      \        # Preserve support for an empty message.\n        if not segments:\n\
      \            segments = [b\"\"]\n\n        total = len(segments)\n\n       \
      \ if total > MAX_SEGMENTS:\n            print(\n                \"[TX] Message\
      \ too large:\",\n                len(payload),\n                \"bytes; maximum\
      \ is\",\n                MAX_PAYLOAD * MAX_SEGMENTS\n            )\n       \
      \     return\n\n        message_id = self._next_message_id\n        self._next_message_id\
      \ = (\n            self._next_message_id + 1\n        ) & 0xFFFFFFFF\n\n   \
      \     for seq, segment in enumerate(segments):\n            header = struct.pack(\n\
      \                HEADER_FORMAT,\n                self.src_addr,\n          \
      \      self.dst_addr,\n                self.msg_type,\n                message_id,\n\
      \                seq,\n                total,\n                len(segment)\n\
      \            )\n\n            packet = header + segment\n\n            output_vector\
      \ = pmt.init_u8vector(\n                len(packet),\n                list(packet)\n\
      \            )\n\n            self.message_port_pub(\n                pmt.intern(\"\
      pdu_out\"),\n                pmt.cons(meta, output_vector)\n            )\n\n\
      \        print(\n            \"[TX] Message ID\",\n            message_id,\n\
      \            \"sent as\",\n            total,\n            \"segment(s)\"\n\
      \        )"
    affinity: ''
    alias: ''
    comment: ''
    dst_addr: '3'
    maxoutbuf: '0'
    minoutbuf: '0'
    msg_type: '1'
    src_addr: '1'
  states:
    _io_cache: ('Packet Builder', 'blk', [('src_addr', '1'), ('dst_addr', '3'), ('msg_type',
      '1')], [('pdu_in', 'message', 1)], [('pdu_out', 'message', 1)], '', ['dst_addr',
      'msg_type', 'src_addr'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [336, 472.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\
      \n    def __init__(self):\n        gr.basic_block.__init__(\n            self,\n\
      \            name=\"Message to PDU\",\n            in_sig=None,\n          \
      \  out_sig=None\n        )\n\n        # Input from QT GUI Message Edit Box\n\
      \        self.message_port_register_in(\n            pmt.intern(\"msg_in\")\n\
      \        )\n\n        # Output to your Packet Builder\n        self.message_port_register_out(\n\
      \            pmt.intern(\"pdu_out\")\n        )\n\n        self.set_msg_handler(\n\
      \            pmt.intern(\"msg_in\"),\n            self.handle_message\n    \
      \    )\n\n\n    def handle_message(self, msg):\n\n        try:\n           \
      \ # QT Message Edit Box normally sends PMT string\n            if pmt.is_symbol(msg):\n\
      \                text = pmt.symbol_to_string(msg)\n\n            elif pmt.is_pair(msg):\n\
      \                value = pmt.cdr(msg)\n\n                if pmt.is_symbol(value):\n\
      \                    text = pmt.symbol_to_string(value)\n                else:\n\
      \                    text = str(pmt.to_python(value))\n\n            else:\n\
      \                text = str(pmt.to_python(msg))\n\n        except Exception\
      \ as e:\n            print(\"[TX] Could not read message:\", e)\n          \
      \  return\n\n\n        # Ignore empty messages\n        if not text.strip():\n\
      \            print(\"[TX] Empty message ignored\")\n            return\n\n\n\
      \        # Convert text to UTF-8 bytes\n        payload = text.encode(\"utf-8\"\
      )\n\n\n        # Make u8 vector\n        vector = pmt.init_u8vector(\n     \
      \       len(payload),\n            list(payload)\n        )\n\n\n        # Make\
      \ standard PDU\n        pdu = pmt.cons(\n            pmt.PMT_NIL,\n        \
      \    vector\n        )\n\n\n        # Send exactly once\n        self.message_port_pub(\n\
      \            pmt.intern(\"pdu_out\"),\n            pdu\n        )\n\n\n    \
      \    print(\"[TX] Sending:\", text)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Message to PDU', 'blk', [], [('msg_in', 'message', 1)], [('pdu_out',
      'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [272, 384.0]
    rotation: 0
    state: enabled
- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: BPSK Acquisition Preamble\n\nPrepends\
      \ a deterministic acquisition preamble to every packet.\n\nPreamble structure:\n\
      \    1. Repeating 0x55 bytes for AGC and timing acquisition.\n    2. Deterministic\
      \ pseudo-random bytes for carrier-loop and\n       equalizer convergence.\n\
      \    3. The original packet, beginning with its access code.\n\nThe receiver\
      \ does not need to remove the preamble. Its access-code\ncorrelator detects\
      \ the beginning of the actual packet.\n\"\"\"\n\nimport numpy as np\n\nfrom\
      \ gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\n    def\
      \ __init__(self, num_dummy_bytes=512):\n        gr.basic_block.__init__(\n \
      \           self,\n            name=\"PDU Prepend BPSK Acquisition Preamble\"\
      ,\n            in_sig=None,\n            out_sig=None\n        )\n\n       \
      \ self.num_dummy_bytes = max(\n            0,\n            int(num_dummy_bytes)\n\
      \        )\n\n        # Create the preamble once so every packet uses the same\n\
      \        # deterministic sequence.\n        self.preamble = self._create_preamble(\n\
      \            self.num_dummy_bytes\n        )\n\n        self.message_port_register_in(\n\
      \            pmt.intern(\"pdu_in\")\n        )\n\n        self.message_port_register_out(\n\
      \            pmt.intern(\"pdu_out\")\n        )\n\n        self.set_msg_handler(\n\
      \            pmt.intern(\"pdu_in\"),\n            self.handle_msg\n        )\n\
      \n        print(\n            \"[TX] BPSK preamble configured:\",\n        \
      \    self.num_dummy_bytes,\n            \"bytes\"\n        )\n\n    def _create_preamble(self,\
      \ total_length):\n        \"\"\"\n        Create a deterministic two-part preamble.\n\
      \n        The first section uses 0x55 for regular transitions.\n        The\
      \ remaining section uses deterministic pseudo-random\n        bytes to provide\
      \ a broadband BPSK training signal.\n        \"\"\"\n\n        if total_length\
      \ <= 0:\n            return np.empty(\n                0,\n                dtype=np.uint8\n\
      \            )\n\n        # Use up to 64 bytes of alternating 01010101 bits.\n\
      \        alternating_length = min(\n            64,\n            total_length\n\
      \        )\n\n        alternating_data = np.full(\n            alternating_length,\n\
      \            0x55,\n            dtype=np.uint8\n        )\n\n        pn_length\
      \ = total_length - alternating_length\n\n        if pn_length <= 0:\n      \
      \      return alternating_data\n\n        # A fixed seed ensures that the same\
      \ pseudo-random\n        # sequence is produced each time the flowgraph starts.\n\
      \        rng = np.random.default_rng(\n            seed=0xB5A1\n        )\n\n\
      \        pn_data = rng.integers(\n            low=0,\n            high=256,\n\
      \            size=pn_length,\n            dtype=np.uint8\n        )\n\n    \
      \    return np.concatenate(\n            (\n                alternating_data,\n\
      \                pn_data\n            )\n        )\n\n    def handle_msg(self,\
      \ msg):\n        \"\"\"\n        Validate the input PDU, prepend the acquisition\
      \ preamble,\n        and publish the resulting PDU.\n        \"\"\"\n\n    \
      \    if not pmt.is_pair(msg):\n            print(\"[TX] Preamble block received\
      \ an invalid PDU\")\n            return\n\n        metadata = pmt.car(msg)\n\
      \        data_pmt = pmt.cdr(msg)\n\n        if not pmt.is_u8vector(data_pmt):\n\
      \            print(\n                \"[TX] Preamble block expected a u8vector\"\
      \n            )\n            return\n\n        try:\n            packet_data\
      \ = np.asarray(\n                pmt.u8vector_elements(data_pmt),\n        \
      \        dtype=np.uint8\n            )\n\n        except Exception as exc:\n\
      \            print(\n                \"[TX] Could not extract packet data:\"\
      ,\n                exc\n            )\n            return\n\n        output_data\
      \ = np.concatenate(\n            (\n                self.preamble,\n       \
      \         packet_data\n            )\n        )\n\n        output_vector = pmt.init_u8vector(\n\
      \            len(output_data),\n            output_data.tolist()\n        )\n\
      \n        output_pdu = pmt.cons(\n            metadata,\n            output_vector\n\
      \        )\n\n        self.message_port_pub(\n            pmt.intern(\"pdu_out\"\
      ),\n            output_pdu\n        )\n\n        print(\n            \"[TX]\
      \ Added\",\n            len(self.preamble),\n            \"preamble bytes; packet:\"\
      ,\n            len(packet_data),\n            \"bytes; total:\",\n         \
      \   len(output_data),\n            \"bytes\"\n        )"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_dummy_bytes: '512'
  states:
    _io_cache: ('PDU Prepend BPSK Acquisition Preamble', 'blk', [('num_dummy_bytes',
      '512')], [('pdu_in', 'message', 1)], [('pdu_out', 'message', 1)], '', ['num_dummy_bytes'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1632, 488.0]
    rotation: 0
    state: enabled
