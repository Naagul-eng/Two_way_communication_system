- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\
      \n    def __init__(self):\n        gr.basic_block.__init__(\n            self,\n\
      \            name=\"Received Message Display\",\n            in_sig=None,\n\
      \            out_sig=None\n        )\n\n        self.message_port_register_in(\n\
      \            pmt.intern(\"pdu_in\")\n        )\n\n        self.message_port_register_out(\n\
      \            pmt.intern(\"text_out\")\n        )\n\n        self.set_msg_handler(\n\
      \            pmt.intern(\"pdu_in\"),\n            self.handle_msg\n        )\n\
      \n\n    def handle_msg(self, msg):\n\n        if not pmt.is_pair(msg):\n   \
      \         return\n\n        try:\n            raw_bytes = bytes(\n         \
      \       pmt.u8vector_elements(\n                    pmt.cdr(msg)\n         \
      \       )\n            )\n\n        except Exception as e:\n            print(\"\
      [RX] Could not extract message:\", e)\n            return\n\n\n        # IMPORTANT:\n\
      \        # CRC has already been removed by CRC Check.\n        # Custom 7-byte\
      \ packet header has already been\n        # removed by Packet Parser.\n    \
      \    #\n        # Therefore raw_bytes IS the actual message.\n\n        try:\n\
      \            text = raw_bytes.decode(\n                \"utf-8\",\n        \
      \        errors=\"replace\"\n            )\n\n        except Exception as e:\n\
      \            print(\"[RX] Decode error:\", e)\n            return\n\n\n    \
      \    print(\"\\n==============================\")\n        print(\"[RX] RECEIVED\
      \ MESSAGE:\", text)\n        print(\"==============================\\n\")\n\n\
      \n        # Update Received Message QT box\n        self.message_port_pub(\n\
      \            pmt.intern(\"text_out\"),\n            pmt.intern(text)\n     \
      \   )"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Received Message Display', 'blk', [], [('pdu_in', 'message', 1)],
      [('text_out', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 960.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import struct\nimport time\n\nfrom gnuradio import gr\nimport pmt\n\
      \n\nMAX_PAYLOAD = 200\nMAX_SEGMENTS = 255\nMAX_ACTIVE_MESSAGES = 64\nREASSEMBLY_TIMEOUT\
      \ = 10.0\n\n# Must exactly match the transmitter.\nHEADER_FORMAT = \">BBBIBBH\"\
      \nHEADER_LEN = struct.calcsize(HEADER_FORMAT)\n\n\nclass blk(gr.basic_block):\n\
      \n    def __init__(self, my_addr=0x03):\n        gr.basic_block.__init__(\n\
      \            self,\n            name=\"Safe Packet Parser\",\n            in_sig=None,\n\
      \            out_sig=None\n        )\n\n        self.my_addr = my_addr & 0xFF\n\
      \        self._reassembly = {}\n\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\
      \        self.set_msg_handler(\n            pmt.intern(\"pdu_in\"),\n      \
      \      self.handle_msg\n        )\n\n    def _remove_expired(self, now):\n \
      \       expired_keys = [\n            key\n            for key, state in self._reassembly.items()\n\
      \            if now - state[\"updated\"] > REASSEMBLY_TIMEOUT\n        ]\n\n\
      \        for key in expired_keys:\n            state = self._reassembly.pop(key)\n\
      \            print(\n                \"[RX] Expired incomplete message\",\n\
      \                key,\n                \"received\",\n                len(state[\"\
      parts\"]),\n                \"of\",\n                state[\"total\"],\n   \
      \             \"segments\"\n            )\n\n    def _make_space(self):\n  \
      \      if len(self._reassembly) < MAX_ACTIVE_MESSAGES:\n            return\n\
      \n        # Remove the oldest incomplete message.\n        oldest_key = min(\n\
      \            self._reassembly,\n            key=lambda key: self._reassembly[key][\"\
      updated\"]\n        )\n\n        del self._reassembly[oldest_key]\n        print(\"\
      [RX] Removed oldest incomplete message:\", oldest_key)\n\n    def handle_msg(self,\
      \ msg):\n        now = time.monotonic()\n        self._remove_expired(now)\n\
      \n        if not pmt.is_pair(msg):\n            print(\"[RX] Invalid PDU\")\n\
      \            return\n\n        meta = pmt.car(msg)\n        data = pmt.cdr(msg)\n\
      \n        if not pmt.is_u8vector(data):\n            print(\"[RX] PDU data is\
      \ not a u8vector\")\n            return\n\n        try:\n            raw = bytes(pmt.u8vector_elements(data))\n\
      \        except Exception as exc:\n            print(\"[RX] Could not extract\
      \ packet:\", exc)\n            return\n\n        if len(raw) < HEADER_LEN:\n\
      \            print(\"[RX] Packet shorter than header\")\n            return\n\
      \n        try:\n            (\n                src,\n                dst,\n\
      \                msg_type,\n                message_id,\n                seq,\n\
      \                total,\n                payload_len\n            ) = struct.unpack(\n\
      \                HEADER_FORMAT,\n                raw[:HEADER_LEN]\n        \
      \    )\n        except struct.error as exc:\n            print(\"[RX] Invalid\
      \ header:\", exc)\n            return\n\n        # Accept packets addressed\
      \ to this receiver or broadcast.\n        if dst != self.my_addr and dst !=\
      \ 0xFF:\n            return\n\n        if total == 0 or total > MAX_SEGMENTS:\n\
      \            print(\"[RX] Invalid segment total:\", total)\n            return\n\
      \n        if seq >= total:\n            print(\n                \"[RX] Invalid\
      \ segment number:\",\n                seq,\n                \"total:\",\n  \
      \              total\n            )\n            return\n\n        if payload_len\
      \ > MAX_PAYLOAD:\n            print(\"[RX] Payload too large:\", payload_len)\n\
      \            return\n\n        # CRC has already been removed by the CRC Check\
      \ block.\n        expected_length = HEADER_LEN + payload_len\n\n        if len(raw)\
      \ != expected_length:\n            print(\n                \"[RX] Packet length\
      \ mismatch:\",\n                len(raw),\n                \"expected:\",\n\
      \                expected_length\n            )\n            return\n\n    \
      \    payload = raw[HEADER_LEN:expected_length]\n        key = (src, message_id,\
      \ msg_type)\n\n        state = self._reassembly.get(key)\n\n        if state\
      \ is None:\n            self._make_space()\n\n            state = {\n      \
      \          \"total\": total,\n                \"parts\": {},\n             \
      \   \"bytes\": 0,\n                \"updated\": now\n            }\n\n     \
      \       self._reassembly[key] = state\n\n        elif state[\"total\"] != total:\n\
      \            # Same ID but conflicting header: discard the whole message.\n\
      \            del self._reassembly[key]\n            print(\"[RX] Conflicting\
      \ segment total for:\", key)\n            return\n\n        existing = state[\"\
      parts\"].get(seq)\n\n        if existing is not None:\n            if existing\
      \ != payload:\n                # Two different payloads claim to be the same\
      \ segment.\n                del self._reassembly[key]\n                print(\"\
      [RX] Conflicting duplicate segment:\", key, seq)\n            else:\n      \
      \          print(\"[RX] Duplicate segment ignored:\", key, seq)\n\n        \
      \    return\n\n        state[\"parts\"][seq] = payload\n        state[\"bytes\"\
      ] += len(payload)\n        state[\"updated\"] = now\n\n        if len(state[\"\
      parts\"]) < total:\n            return\n\n        # Verify that every required\
      \ sequence number exists.\n        if not all(index in state[\"parts\"] for\
      \ index in range(total)):\n            return\n\n        full_message = b\"\"\
      .join(\n            state[\"parts\"][index]\n            for index in range(total)\n\
      \        )\n\n        del self._reassembly[key]\n\n        output_vector = pmt.init_u8vector(\n\
      \            len(full_message),\n            list(full_message)\n        )\n\
      \n        self.message_port_pub(\n            pmt.intern(\"pdu_out\"),\n   \
      \         pmt.cons(meta, output_vector)\n        )\n\n        print(\n     \
      \       \"[RX] Reassembled message ID\",\n            message_id,\n        \
      \    \"from\",\n            total,\n            \"segment(s),\",\n         \
      \   len(full_message),\n            \"bytes\"\n        )"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    my_addr: '3'
  states:
    _io_cache: ('Safe Packet Parser', 'blk', [('my_addr', '3')], [('pdu_in', 'message',
      1)], [('pdu_out', 'message', 1)], '', ['my_addr'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 1008.0]
    rotation: 0
    state: enabled
