      \                 message = e['text']\n                    bubble['text'] =\
      \ message\n                    bubble['label'].setText(message[:4096] +\n  \
      \                      ('\\n[Select View full message below]' if len(message)\
      \ > 4096 else ''))\n                    if len(message) > 4096:\n          \
