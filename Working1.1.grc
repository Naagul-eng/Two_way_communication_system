      \ 'Sending metadata', t)\n        print('[Transfer profile] %s: payload=%d bytes,\
      \ ACK timeout=%.3f s, interval=%.3f s'\n              % (kind, t['chunk'], t['timeout'],\
      \ t['interval']), flush=True)\n        self._pump()\n\n    def _queue_packet(self,\
      \ typ, seq, body):\n        t = self.tx\n        t['pending'][seq] = dict(wire=self._wire(typ,\
      \ t['tid'], seq, body),\n                                 sent=None, retry=0)\n\
      \n    def _fill_window(self):\n        t = self.tx\n        if t['phase'] !=\
      \ 'data':\n            return\n        # The window is anchored at the oldest\
