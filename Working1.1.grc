- name: epy_transfer_protocol
  id: epy_block
  parameters:
    _source_code: "\"\"\"Embedded Python Block: encrypted transfer protocol and ARQ,\
      \ without GUI.\nPorts: rx_in, command_in, config_in; tx_out, event_out.\n\"\"\
      \"\nimport hashlib\nimport io\nimport json\nimport os\nfrom pathlib import Path\n\
      import queue\nimport re\nimport secrets\nimport struct\nimport tempfile\nimport\
      \ threading\nimport time\nimport subprocess\nfrom collections import OrderedDict\n\
      from cryptography.fernet import Fernet, InvalidToken\nfrom gnuradio import gr\n\
      import pmt\n\n_META, _DATA, _END, _ACK, _ERROR, _CANCEL = range(1, 7)\n_HEADER\
      \ = struct.Struct('!4sB2s2s16sI')\n_MAGIC = b'NGS2'\n\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"All protocol, encryption, file I/O, ACKs and retries.\"\"\"\n\n \
      \   def __init__(self, my_addr='A1', peer_addr='B1',\n                 shared_key='u362K7J0T2sA_vB1C2D3E4F5G6H7I8J9K0L1M2N3O4P=',\n\
      \                 receive_dir='./received_A1', max_retries=20,\n           \
      \      max_file_mb=16, auto_encode_media=True,\n                 image_max_edge=1600,\
      \ image_quality=80,\n                 audio_bitrate_kbps=64):\n        gr.basic_block.__init__(self,\
      \ name='Transfer Protocol', in_sig=None, out_sig=None)\n        self.commands\
      \ = queue.Queue(maxsize=2048)\n        self.halt = threading.Event()\n     \
      \   self.worker = None\n        self.settings = {'timeout': {}, 'size': {},\
      \ 'window': {}, 'interval': {}}\n        self.config = (my_addr, peer_addr,\
      \ shared_key, receive_dir,\n                       self._publish, self._event,\
      \ 512, 1.0,\n                       max_retries, max_file_mb, 4, 0.02)\n   \
      \     self.core = None\n        self.auto_encode_media = bool(auto_encode_media)\n\
      \        self.image_max_edge = int(image_max_edge)\n        self.image_quality\
      \ = int(image_quality)\n        self.audio_bitrate_kbps = int(audio_bitrate_kbps)\n\
      \        if not 320 <= self.image_max_edge <= 8192:\n            raise ValueError('image_max_edge\
      \ must be 320..8192')\n        if not 40 <= self.image_quality <= 95:\n    \
      \        raise ValueError('image_quality must be 40..95')\n        if not 24\
      \ <= self.audio_bitrate_kbps <= 256:\n            raise ValueError('audio_bitrate_kbps\
      \ must be 24..256')\n        self.preparing = False\n        self.prepare_id\
      \ = 0\n        for name, handler in (('rx_in', self._receive),\n           \
      \                   ('command_in', self._command),\n                       \
      \       ('config_in', self._configure)):\n            port = pmt.intern(name)\n\
      \            self.message_port_register_in(port)\n            self.set_msg_handler(port,\
      \ handler)\n        for name in ('tx_out', 'event_out'):\n            self.message_port_register_out(pmt.intern(name))\n\
      \n    @staticmethod\n    def _bytes(msg):\n        if pmt.is_pair(msg) and pmt.is_u8vector(pmt.cdr(msg)):\n\
      \            return bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n        return\
      \ None\n\n    def _publish(self, raw):\n        self.message_port_pub(pmt.intern('tx_out'),\n\
      \            pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\
      \n    def _event(self, event):\n        raw = json.dumps(event, ensure_ascii=True).encode('utf-8')\n\
      \        self.message_port_pub(pmt.intern('event_out'),\n            pmt.cons(pmt.PMT_NIL,\
      \ pmt.init_u8vector(len(raw), list(raw))))\n\n    def _receive(self, msg):\n\
      \        raw = self._bytes(msg)\n        if raw is not None and len(raw) <=\
      \ 4092:\n            try:\n                self.commands.put_nowait(('rx', raw))\n\
      \            except queue.Full:\n                pass\n\n    def _command(self,\
      \ msg):\n        raw = self._bytes(msg)\n        if raw is None or len(raw)\
      \ > 8192:\n            return\n        try:\n            command = json.loads(raw.decode('utf-8'))\n\
      \            action = command.get('cmd')\n            if action == 'send' and\
      \ command.get('kind') in ('text', 'image', 'audio'):\n                item =\
      \ ('send', command['kind'], command['value'])\n            elif action == 'cancel':\n\
      \                item = ('cancel',)\n            else:\n                return\n\
      \            self.commands.put_nowait(item)\n        except (ValueError, UnicodeError,\
      \ KeyError, AttributeError, queue.Full):\n            pass\n\n    def _configure(self,\
      \ msg):\n        raw = self._bytes(msg)\n        if raw is None or len(raw)\
      \ > 2048:\n            return\n        try:\n            config = json.loads(raw.decode('utf-8'))\n\
      \            category = config['category']\n            values = config['values']\n\
      \            if category not in self.settings or set(values) != {'text', 'image',\
      \ 'audio'}:\n                raise ValueError('Unknown profile category or transfer\
      \ type')\n            checked = {}\n            for kind, value in values.items():\n\
      \                if category in ('size', 'window'):\n                    if\
      \ type(value) is not int:\n                        raise ValueError(category\
      \ + ' must be an integer')\n                    if not (128 <= value <= 1024\
      \ if category == 'size' else 1 <= value <= 32):\n                        raise\
      \ ValueError(category + ' outside supported range')\n                else:\n\
      \                    if type(value) not in (int, float):\n                 \
      \       raise ValueError(category + ' must be numeric')\n                  \
      \  if not (0.05 <= value <= 30 if category == 'timeout' else 0 <= value <= 5):\n\
      \                        raise ValueError(category + ' outside supported range')\n\
      \                checked[kind] = value\n            self.settings[category]\
      \ = checked\n        except (ValueError, TypeError, KeyError, AttributeError)\
      \ as exc:\n            self._event(dict(direction='notice', state='Invalid profile:\
      \ ' + str(exc)))\n\n    def start(self):\n        self.halt.clear()\n      \
      \  self.worker = threading.Thread(target=self._run, name='file-transfer', daemon=True)\n\
      \        self.worker.start()\n        return True\n\n    def _run(self):\n \
      \       try:\n            while not self.halt.is_set():\n                if\
      \ self.core is None and all(self.settings.values()):\n                    profiles\
      \ = {kind: (\n                        self.settings['size'][kind], self.settings['timeout'][kind],\n\
      \                        self.settings['interval'][kind], self.settings['window'][kind])\n\
      \                        for kind in ('text', 'image', 'audio')}\n         \
      \           self.core = _TransferCore(*self.config, profiles=profiles)\n   \
      \                 self._event(dict(direction='notice', state='Transfer profiles\
      \ ready'))\n                try:\n                    cmd = self.commands.get(timeout=0.01)\n\
      \                except queue.Empty:\n                    if self.core is not\
      \ None:\n                        self.core.tick()\n                    continue\n\
      \                if self.core is None:\n                    if cmd[0] == 'send':\n\
      \                        self._event(dict(direction='notice', state='Waiting\
      \ for all four profile blocks'))\n                    continue\n           \
      \     if cmd[0] == 'rx':\n                    self.core.receive(cmd[1])\n  \
      \              elif cmd[0] == 'send':\n                    try:\n          \
      \              if self.preparing or self.core.tx is not None:\n            \
      \                raise ValueError('A transfer is already active')\n        \
      \                if self.auto_encode_media and cmd[1] in ('image', 'audio'):\n\
      \                            self.preparing = True\n                       \
      \     self.prepare_id += 1\n                            job = self.prepare_id\n\
      \                            self._event(dict(direction='preparing', state='Encoding\
      \ file',\n                                             kind=cmd[1]))\n     \
      \                       threading.Thread(target=self._prepare_media,\n     \
      \                           args=(job, cmd[1], cmd[2]), daemon=True).start()\n\
      \                        else:\n                            self.core.send(cmd[1],\
      \ cmd[2])\n                    except Exception as exc:\n                  \
      \      self._event(dict(direction='notice', state=str(exc)))\n             \
      \   elif cmd[0] == 'prepared':\n                    if self.preparing and cmd[1]\
      \ == self.prepare_id:\n                        self.preparing = False\n    \
      \                    try:\n                            self.core.send_prepared(cmd[2],\
      \ cmd[3], cmd[4])\n                        except Exception as exc:\n      \
      \                      self._event(dict(direction='notice', state=str(exc)))\n\
      \                elif cmd[0] == 'prepare_error':\n                    if self.preparing\
      \ and cmd[1] == self.prepare_id:\n                        self.preparing = False\n\
      \                        self._event(dict(direction='notice', state=cmd[2]))\n\
      \                elif cmd[0] == 'cancel':\n                    if self.preparing:\n\
      \                        self.prepare_id += 1\n                        self.preparing\
      \ = False\n                        self._event(dict(direction='tx', state='Cancelled',\
      \ kind='',\n                                         name='', total=0, done=0))\n\
      \                    else:\n                        self.core.cancel()\n   \
      \             self.core.tick()\n        except Exception as exc:\n         \
      \   self._event(dict(direction='notice', state='Worker stopped: ' + str(exc)))\n\
      \            print('[Transfer Protocol] Worker stopped:', exc, flush=True)\n\
      \        finally:\n            if self.core is not None:\n                self.core.close()\n\
      \n    def stop(self):\n        self.halt.set()\n        self.prepare_id += 1\n\
      \        if self.worker is not None:\n            self.worker.join(timeout=3)\n\
      \        return True\n\n    def _prepare_media(self, job, kind, value):\n  \
      \      try:\n            path = Path(value)\n            if not path.is_file()\
      \ or path.stat().st_size > self.core.limit:\n                raise ValueError('Choose\
      \ a file within the configured size limit')\n            original = path.read_bytes()\n\
      \            data, name = original, path.name\n            try:\n          \
      \      if kind == 'image':\n                    data, name = self._encode_image(path,\
      \ original)\n                else:\n                    data, name = self._encode_audio(path,\
