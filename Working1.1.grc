      \ name = out.getvalue(), path.stem + '.jpg'\n            return (candidate,\
      \ name) if len(candidate) < len(original) else (original, path.name)\n\n   \
      \ def _encode_audio(self, path, original):\n        if path.suffix.lower() in\
