      \            bubble['open'].clicked.connect(self.show_full_text)\n         \
      \               bubble['open'].show()\n                else:\n             \
      \       self.show_file(bubble, e['path'])\n            bubble['status'].setText(bubble['time']\
      \ + ('  \xB7  \u2713 Delivered' if outgoing else '  \xB7  Received'))\n    \
      \    elif active:\n            stage = ('Checking file\u2026' if 'verification'\
