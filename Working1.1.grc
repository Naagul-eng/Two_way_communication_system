      \ = Path(receive_dir).expanduser().resolve()\n        self.emit, self.event,\
      \ self.clock = emit, event, clock\n        self.chunk, self.window = int(chunk_size),\
      \ int(window_size)\n        self.timeout, self.retries = float(ack_timeout),\
      \ int(max_retries)\n        self.interval = float(packet_interval)\n       \
      \ self.profiles = {}\n        for kind in ('text', 'image', 'audio'):\n    \
      \        values = (profiles or {}).get(kind, (chunk_size, ack_timeout, packet_interval,\
      \ window_size))\n            chunk, timeout, interval, kind_window = values\n\
      \            if isinstance(chunk, bool) or int(chunk) != chunk or not 128 <=\
      \ int(chunk) <= 1024:\n                raise ValueError(kind + '_chunk_size\
      \ must be an integer, 128..1024 bytes')\n            if not 0.05 <= float(timeout)\
      \ <= 30:\n                raise ValueError(kind + '_ack_timeout must be 0.05..30\
      \ seconds')\n            if not 0 <= float(interval) <= 5:\n               \
      \ raise ValueError(kind + '_packet_interval must be 0..5 seconds')\n       \
      \     if type(kind_window) is not int or not 1 <= kind_window <= 32:\n     \
