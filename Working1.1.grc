    affinity: ''
    alias: ''
    audio_bitrate_kbps: '64'
    auto_encode_media: 'True'
    comment: Encrypted transfer and ACK protocol
    image_max_edge: '1600'
    image_quality: '80'
    max_file_mb: '16'
    max_retries: '20'
    maxoutbuf: '0'
    minoutbuf: '0'
    my_addr: my_addr
    peer_addr: peer_addr
