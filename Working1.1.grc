options:
  parameters:
    author: naagul
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Working 1.1: optimized to reduce GRC console/UI stalls. RF settings
      and packet format match Working1.0.'
    copyright: ''
    description: 'Normal GRC transceiver with embedded Reed-Solomon implementation;
      no external reedsolo package needed. Both peers require matching FEC settings.
      Existing GNU Radio/Pluto/Qt/cryptography dependencies remain. Working 1.1: native
      training detector, quiet diagnostics, bounded GUI processing.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: working_1_1
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: QPSK Transceiver - Working 1.1
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: access_key
  id: variable
  parameters:
    comment: ''
    value: '"1110000101011010111010001001001111100001010110101110100010010011"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3928, 248.0]
    rotation: 0
    state: enabled
- name: corr_ref
  id: variable
  parameters:
    comment: ''
    value: np.column_stack((np.asarray(train_syms[:64]), np.zeros(64,dtype=np.complex64))).ravel().tolist()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 16.0]
    rotation: 0
    state: enabled
- name: damp_fac
  id: variable
  parameters:
    comment: ''
    value: '0.707'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1800, 64.0]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: ''
    value: '0.35'
  states:
