  parameters:
    comment: Enable/bypass on BOTH peers together; restart after changing.
    value: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2552, 40.0]
    rotation: 0
    state: enabled
- name: fec_log_every
