      \         try:\n                self.commands.put(('prepare_error', job, str(exc)),\
      \ timeout=5)\n            except queue.Full:\n                pass\n\n    def\
      \ _encode_image(self, path, original):\n        from PIL import Image, ImageOps\n\
      \        with Image.open(path) as image:\n            if getattr(image, 'n_frames',\
      \ 1) != 1 or image.width * image.height > 40_000_000:\n                return\
      \ original, path.name\n            image = ImageOps.exif_transpose(image)\n\
      \            ext = path.suffix.lower()\n            if ext == '.png' or 'A'\
