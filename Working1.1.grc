- name: epy_transfer_chat_gui
  id: epy_block
  parameters:
    _source_code: "\"\"\"Embedded Python Block: chat GUI only, with command/event\
      \ PDU ports.\"\"\"\nimport json\nfrom pathlib import Path\nimport queue\nimport\
      \ threading\nimport time\nfrom gnuradio import gr\nimport pmt\nfrom PyQt5 import\
      \ QtCore, QtGui, QtWidgets\n\n\nclass _CommandOutput:\n    def __init__(self,\
      \ block):\n        self.block = block\n\n    def put_nowait(self, command):\n\
      \        if command[0] == 'send':\n            value = dict(cmd='send', kind=command[1],\
      \ value=command[2])\n        elif command[0] == 'cancel':\n            value\
      \ = dict(cmd='cancel')\n        else:\n            raise ValueError('Unsupported\
      \ GUI command')\n        raw = json.dumps(value, ensure_ascii=True).encode('utf-8')\n\
      \        self.block.message_port_pub(pmt.intern('command_out'),\n          \
      \  pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\n\nclass\
      \ blk(gr.basic_block):\n    \"\"\"Chat window; protocol work happens in a separate\
      \ block.\"\"\"\n\n    def __init__(self, my_addr='A1', peer_addr='B1',\n   \
      \              receive_dir='./received_A1', show_gui=True):\n        gr.basic_block.__init__(self,\
      \ name='Transfer Chat GUI', in_sig=None, out_sig=None)\n        self.my_addr\
      \ = my_addr\n        self.peer_addr = peer_addr\n        self.receive_dir =\
      \ str(Path(receive_dir).expanduser().resolve())\n        self.show_gui = bool(show_gui)\n\
      \        self.commands = _CommandOutput(self)\n        self.events = queue.Queue(maxsize=2048)\n\
      \        self.halt = threading.Event()\n        self.bridge = None\n       \
      \ self.message_port_register_in(pmt.intern('event_in'))\n        self.message_port_register_out(pmt.intern('command_out'))\n\
      \        self.set_msg_handler(pmt.intern('event_in'), self._receive_event)\n\
      \n    def _receive_event(self, msg):\n        if not pmt.is_pair(msg) or not\
      \ pmt.is_u8vector(pmt.cdr(msg)):\n            return\n        try:\n       \
      \     raw = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n            if len(raw)\
      \ > 524288:\n                return\n            event = json.loads(raw.decode('utf-8'))\n\
      \            if not isinstance(event, dict) or not isinstance(event.get('state'),\
      \ str):\n                return\n            if event.get('direction') not in\
      \ ('notice', 'preparing', 'tx', 'rx'):\n                return\n           \
      \ try:\n                self.events.put_nowait(event)\n            except queue.Full:\n\
      \                # Keep the newest status, including completion, under overload.\n\
      \                try:\n                    self.events.get_nowait()\n      \
      \          except queue.Empty:\n                    pass\n                self.events.put_nowait(event)\n\
      \        except (ValueError, UnicodeError, queue.Full):\n            pass\n\n\
      \    def start(self):\n        self.halt.clear()\n        if self.show_gui:\n\
      \            app = QtWidgets.QApplication.instance()\n            if app is\
      \ None:\n                print('[Transfer GUI] Set Options > Generate Options\
      \ = QT GUI')\n                return False\n            self.bridge = _WindowBridge(self)\n\
      \            self.bridge.moveToThread(app.thread())\n            self.bridge.open_requested.emit()\n\
      \        return True\n\n    def stop(self):\n        self.halt.set()\n     \
      \   if self.bridge:\n            self.bridge.close_requested.emit()\n      \
      \  return True\n\n\nclass _WindowBridge(QtCore.QObject):\n    open_requested\
      \ = QtCore.pyqtSignal()\n    close_requested = QtCore.pyqtSignal()\n\n    def\
      \ __init__(self, block):\n        super().__init__()\n        self.block, self.window\
      \ = block, None\n        self.open_requested.connect(self.open_window, QtCore.Qt.QueuedConnection)\n\
      \        self.close_requested.connect(self.close_window, QtCore.Qt.QueuedConnection)\n\
      \n    @QtCore.pyqtSlot()\n    def open_window(self):\n        if not self.block.halt.is_set():\n\
      \            self.window = _TransferWindow(self.block)\n            self.window.show()\n\
      \n    @QtCore.pyqtSlot()\n    def close_window(self):\n        if self.window:\n\
      \            self.window.timer.stop()\n            self.window.allow_close =\
      \ True\n            self.window.close()\n            self.window.deleteLater()\n\
      \            self.window = None\n\n\nclass _TransferWindow(QtWidgets.QWidget):\n\
      \    \"\"\"Chat view only. Packet handling stays in _TransferCore.\"\"\"\n \
      \   def __init__(self, block):\n        super().__init__()\n        self.block,\
      \ self.allow_close = block, False\n        self.tx_bubble = self.rx_bubble =\
      \ None\n        self.messages = []\n        self.setWindowTitle('Chat | %s \u2192\
      \ %s' % (block.my_addr, block.peer_addr))\n        self.resize(570, 780)\n \
      \       self.setMinimumSize(440, 540)\n        self.setStyleSheet('''\n    \
      \        QWidget { color:#173b32; font-family:Sans; font-size:14px; }\n    \
      \        QWidget#chat, QWidget#historyBody { background:#f3f1eb; }\n       \
      \     QFrame#header, QFrame#composer { background:white; }\n            QLabel\
      \ { background:transparent; }\n            QLabel#avatar { background:#128c7e;\
      \ color:white; border-radius:23px;\n                font-size:18px; font-weight:600;\
      \ }\n            QLabel#name { font-size:18px; font-weight:600; }\n        \
      \    QLabel#secondary { color:#77847e; font-size:11px; }\n            QLabel#day\
      \ { color:#7b8780; font-size:11px; padding:10px; }\n            QFrame#sent\
      \ { background:#d9fdd3; border:1px solid #ccecc6; border-radius:14px; }\n  \
      \          QFrame#received { background:white; border:1px solid #e1e6e2; border-radius:14px;\
      \ }\n            QPlainTextEdit { background:#f4f6f4; border:1px solid #e7ebe7;\n\
      \                border-radius:20px; padding:8px; font-size:14px; }\n      \
      \      QPushButton,QToolButton { background:#e8f3ed; border:0; border-radius:16px;\n\
      \                padding:8px 12px; color:#16785c; }\n            QPushButton:hover,QToolButton:hover\
      \ { background:#d1eadd; }\n            QPushButton#send { background:#128c7e;\
      \ color:white; font-weight:600; }\n            QToolButton#attach { background:transparent;\
      \ font-size:28px; padding:0; }\n            QToolButton::menu-indicator { image:none;\
      \ }\n            QPushButton:disabled,QToolButton:disabled { color:#a4b8ac;\
      \ background:#e7ede8; }\n            QPushButton#file { background:transparent;\
      \ text-align:left; padding:5px 0; }\n            QPushButton#cancel { background:transparent;\
      \ color:#886958; padding:2px; font-size:11px; }\n            QMenu { background:white;\
      \ border:1px solid #d7e3da; padding:6px; }\n            QMenu::item { padding:9px\
      \ 22px; }\n            QMenu::item:selected { background:#e6f4eb; }\n      \
      \      QProgressBar { background:#e7eae1; border:0; border-radius:3px; }\n \
      \           QProgressBar::chunk { background:#20a47d; border-radius:3px; }\n\
      \            QScrollArea { background:transparent; border:0; }\n           \
      \ QScrollBar:vertical { width:6px; background:transparent; }\n            QScrollBar::handle:vertical\
      \ { background:#cdd6cc; border-radius:3px; min-height:24px; }\n            QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical\
      \ { height:0; }\n        ''')\n        self.setObjectName('chat')\n        root\
      \ = QtWidgets.QVBoxLayout(self)\n        root.setContentsMargins(0, 0, 0, 0)\n\
      \        root.setSpacing(0)\n\n        header = QtWidgets.QFrame()\n       \
      \ header.setObjectName('header')\n        top = QtWidgets.QHBoxLayout(header)\n\
      \        top.setContentsMargins(20, 16, 18, 16)\n        avatar = QtWidgets.QLabel(block.peer_addr)\n\
      \        avatar.setObjectName('avatar')\n        avatar.setAlignment(QtCore.Qt.AlignCenter)\n\
      \        avatar.setFixedSize(46, 46)\n        top.addWidget(avatar)\n      \
      \  contact = QtWidgets.QVBoxLayout()\n        contact.setSpacing(4)\n      \
      \  name = QtWidgets.QLabel('Chat with ' + block.peer_addr)\n        name.setObjectName('name')\n\
      \        subtitle = QtWidgets.QLabel('Your node: ' + block.my_addr)\n      \
      \  subtitle.setObjectName('secondary')\n        contact.addWidget(name)\n  \
      \      contact.addWidget(subtitle)\n        top.addLayout(contact, 1)\n    \
      \    files = QtWidgets.QPushButton('Received files')\n        files.clicked.connect(self.open_folder)\n\
      \        top.addWidget(files)\n        root.addWidget(header)\n\n        self.scroll\
      \ = QtWidgets.QScrollArea()\n        self.scroll.setWidgetResizable(True)\n\
      \        self.scroll.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarAlwaysOff)\n\
      \        body = QtWidgets.QWidget()\n        body.setObjectName('historyBody')\n\
      \        self.history = QtWidgets.QVBoxLayout(body)\n        self.history.setContentsMargins(16,\
      \ 4, 16, 14)\n        self.history.setSpacing(12)\n        self.history.setSizeConstraint(QtWidgets.QLayout.SetMinAndMaxSize)\n\
      \        day = QtWidgets.QLabel('TODAY')\n        day.setObjectName('day')\n\
      \        day.setAlignment(QtCore.Qt.AlignCenter)\n        self.history.addWidget(day)\n\
      \        self.history.addStretch(1)\n        self.scroll.setWidget(body)\n \
      \       root.addWidget(self.scroll, 1)\n\n        composer = QtWidgets.QFrame()\n\
      \        composer.setObjectName('composer')\n        controls = QtWidgets.QVBoxLayout(composer)\n\
      \        controls.setContentsMargins(12, 12, 16, 9)\n        row = QtWidgets.QHBoxLayout()\n\
