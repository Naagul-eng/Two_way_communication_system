      \ None\n        self.next_emit = 0.0\n        self.receipts = OrderedDict()\n\
      \n    @staticmethod\n    def _idle_budget(timeout, interval, retries, window=32):\n\
      \        return max(120, 4 * (retries + 1) * (timeout + window * interval))\n\
      \n    def _event(self, direction, state, transfer=None, **extra):\n        t\
      \ = transfer or {}\n        self.event(dict(direction=direction, state=state,\
