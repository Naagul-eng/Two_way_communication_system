- name: epy_size_profiles
  id: epy_block
  parameters:
    _source_code: "\"\"\"Embedded Python Block: size profiles for text, image and\
      \ audio.\nConnect config_out to Transfer Protocol.config_in.\n\"\"\"\nimport\
      \ json\nfrom gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self, text=128, image=512, audio=512):\n        gr.basic_block.__init__(self,\
      \ name='Size Profiles',\n                                in_sig=None, out_sig=None)\n\
      \        self.values = {'text': int(text), 'image': int(image),\n          \
      \             'audio': int(audio)}\n        for value in self.values.values():\n\
      \            if not (128, 1024)[0] <= value <= (128, 1024)[1]:\n           \
      \     raise ValueError('size must be within (128, 1024)')\n        self.message_port_register_out(pmt.intern('config_out'))\n\
      \n    def start(self):\n        raw = json.dumps({'category': 'size', 'values':\
      \ self.values}).encode('utf-8')\n        self.message_port_pub(pmt.intern('config_out'),\n\
      \            pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\
      \        return True\n"
    affinity: ''
    alias: ''
    audio: '1024'
    comment: ''
    image: '1024'
    maxoutbuf: '0'
    minoutbuf: '0'
    text: '128'
  states:
    _io_cache: ('Size Profiles', 'blk', [('text', '128'), ('image', '512'), ('audio',
      '512')], [], [('config_out', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2864, 472.0]
    rotation: 0
    state: enabled
- name: epy_timeout_profiles
  id: epy_block
  parameters:
    _source_code: "\"\"\"Embedded Python Block: timeout profiles for text, image and\
      \ audio.\nConnect config_out to Transfer Protocol.config_in.\n\"\"\"\nimport\
      \ json\nfrom gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self, text=3.0, image=3.0, audio=3.0):\n        gr.basic_block.__init__(self,\
      \ name='Timeout Profiles',\n                                in_sig=None, out_sig=None)\n\
      \        self.values = {'text': float(text), 'image': float(image),\n      \
      \                 'audio': float(audio)}\n        for value in self.values.values():\n\
      \            if not (0.05, 30)[0] <= value <= (0.05, 30)[1]:\n             \
      \   raise ValueError('timeout must be within (0.05, 30)')\n        self.message_port_register_out(pmt.intern('config_out'))\n\
      \n    def start(self):\n        raw = json.dumps({'category': 'timeout', 'values':\
      \ self.values}).encode('utf-8')\n        self.message_port_pub(pmt.intern('config_out'),\n\
      \            pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\
      \        return True\n"
