- name: epy_window_profiles
  id: epy_block
  parameters:
    _source_code: "\"\"\"Embedded Python Block: window profiles for text, image and audio.\nConnect config_out to Transfer Protocol.config_in.\n\"\"\"\nimport json\nfrom gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n    def __init__(self, text=4, image=4, audio=4):\n        gr.basic_block.__init__(self, name='Window Profiles',\n                                in_sig=None, out_sig=None)\n        self.values = {'text': int(text), 'image': int(image),\n                       'audio': int(audio)}\n        for value in self.values.values():\n            if not (1, 32)[0] <= value <= (1, 32)[1]:\n                raise ValueError('window must be within (1, 32)')\n        self.message_port_register_out(pmt.intern('config_out'))\n\n    def start(self):\n        raw = json.dumps({'category': 'window', 'values': self.values}).encode('utf-8')\n        self.message_port_pub(pmt.intern('config_out'),\n            pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n        return True\n"
    affinity: ''
    alias: ''
    audio: '32'
    comment: ''
    image: '32'
    maxoutbuf: '0'
    minoutbuf: '0'
    text: '4'
  states:
    _io_cache: ('Window Profiles', 'blk', [('text', '4'), ('image', '4'), ('audio', '4')], [], [('config_out', 'message', 1)], '', [])
