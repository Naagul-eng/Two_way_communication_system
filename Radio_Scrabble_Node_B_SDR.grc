- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\nimport threading\nimport time\n\n\nclass blk(gr.basic_block):\n    \"\"\"Observe RS/CRC outcomes; counters include controls and retransmissions.\"\"\"\n    def __init__(self, report_interval=1.0):\n        gr.basic_block.__init__(self, name=\"Link Reliability Monitor\",\n                                in_sig=None, out_sig=None)\n        self.interval = max(0.2, float(report_interval))\n        self._lock = threading.Lock()\n        self._print_lock = threading.Lock()\n        self._halt = threading.Event()\n        self._worker = None\n        self.counts = dict.fromkeys((\n            \"tx\", \"rs_ok\", \"rs_fail\", \"corrected_packets\", \"corrected_bytes\",\n            \"corrected_bits\", \"crc_ok\", \"crc_fail\", \"crc_ok_bytes\",\n            \"missing_metadata\"), 0)\n        self._last_time = time.monotonic()\n        self._last_bytes = 0\n        for port in (\"tx\", \"rs_ok\", \"rs_fail\", \"crc_ok\", \"crc_fail\"):\n            self.message_port_register_in(pmt.intern(port))\n        self.set_msg_handler(pmt.intern(\"tx\"), self.handle_tx)\n        self.set_msg_handler(pmt.intern(\"rs_ok\"), self.handle_rs_ok)\n        self.set_msg_handler(pmt.intern(\"rs_fail\"), self.handle_rs_fail)\n        self.set_msg_handler(pmt.intern(\"crc_ok\"), self.handle_crc_ok)\n        self.set_msg_handler(pmt.intern(\"crc_fail\"), self.handle_crc_fail)\n\n    def handle_tx(self, msg):\n        with self._lock:\n            self.counts[\"tx\"] += 1\n\n    def handle_rs_ok(self, msg):\n        changed_bytes = changed_bits = 0\n        available = False\n        if pmt.is_pair(msg):\n            meta = pmt.car(msg)\n            bk, ik = pmt.intern(\"rs_corrected_bytes\"), pmt.intern(\"rs_corrected_bits\")\n            if pmt.is_dict(meta) and pmt.dict_has_key(meta, bk) and pmt.dict_has_key(meta, ik):\n                changed_bytes = pmt.to_long(pmt.dict_ref(meta, bk, pmt.from_long(0)))\n                changed_bits = pmt.to_long(pmt.dict_ref(meta, ik, pmt.from_long(0)))\n                available = True\n        with self._lock:\n            self.counts[\"rs_ok\"] += 1\n            self.counts[\"corrected_packets\"] += int(changed_bytes > 0)\n            self.counts[\"corrected_bytes\"] += changed_bytes\n            self.counts[\"corrected_bits\"] += changed_bits\n            self.counts[\"missing_metadata\"] += int(not available)\n\n    def handle_rs_fail(self, msg):\n        with self._lock:\n            self.counts[\"rs_fail\"] += 1\n\n    def handle_crc_ok(self, msg):\n        size = 0\n        if pmt.is_pair(msg) and pmt.is_u8vector(pmt.cdr(msg)):\n            size = len(pmt.u8vector_elements(pmt.cdr(msg)))\n        with self._lock:\n            self.counts[\"crc_ok\"] += 1\n            self.counts[\"crc_ok_bytes\"] += size\n\n    def handle_crc_fail(self, msg):\n        with self._lock:\n            self.counts[\"crc_fail\"] += 1\n\n    @staticmethod\n    def percent(value, total):\n        return f\"{100.0 * value / total:.2f}%\" if total else \"n/a\"\n\n    def report(self):\n        with self._print_lock:\n            with self._lock:\n                c = self.counts.copy()\n            now = time.monotonic()\n            elapsed = max(now - self._last_time, 1e-9)\n            rate = 8.0 * (c[\"crc_ok_bytes\"] - self._last_bytes) / elapsed / 1000.0\n            self._last_time, self._last_bytes = now, c[\"crc_ok_bytes\"]\n            rs_total = c[\"rs_ok\"] + c[\"rs_fail\"]\n            crc_total = c[\"crc_ok\"] + c[\"crc_fail\"]\n            completed = c[\"rs_fail\"] + crc_total\n            rejected = c[\"rs_fail\"] + c[\"crc_fail\"]\n            print(\n                f\"[LINK] TX_PDUs={c['tx']} | \"\n                f\"RS decoded={c['rs_ok']} fail={c['rs_fail']} \"\n                f\"({self.percent(c['rs_fail'], rs_total)}) | \"\n                f\"RS changed packets={c['corrected_packets']} \"\n                f\"bytes={c['corrected_bytes']} bits={c['corrected_bits']} | \"\n                f\"CRC pass={c['crc_ok']} fail={c['crc_fail']} \"\n                f\"({self.percent(c['crc_fail'], crc_total)}) | \"\n                f\"RS/CRC rejected={self.percent(rejected, completed)} | \"\n                f\"CRC-pass rate={rate:.2f} kbit/s | \"\n                f\"missing_RS_metadata={c['missing_metadata']}\", flush=True)\n\n    def _report_loop(self):\n        while not self._halt.wait(self.interval):\n            self.report()\n\n    def start(self):\n        self._halt.clear()\n        with self._lock:\n            self._last_bytes = self.counts[\"crc_ok_bytes\"]\n        self._last_time = time.monotonic()\n        self._worker = threading.Thread(target=self._report_loop,\n                                        name=\"link-reliability-monitor\", daemon=True)\n        self._worker.start()\n        return True\n\n    def stop(self):\n        self._halt.set()\n        if self._worker is not None:\n            self._worker.join()\n        self.report()\n        return True\n"
    affinity: ''
    alias: ''
    comment: One report per second. RS changes include parity; rates include ACKs and retransmissions. Not end-to-end loss or BER.
    maxoutbuf: '0'
    minoutbuf: '0'
    report_interval: '1.0'
  states:
    _io_cache: ('Link Reliability Monitor', 'blk', [('report_interval', '1.0')], [('crc_fail', 'message', 1), ('rs_ok', 'message', 1), ('rs_fail', 'message', 1), ('tx', 'message', 1), ('crc_ok', 'message', 1)], [], 'Observe RS/CRC outcomes; counters include controls and retransmissions.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 3224
    - 224.0
    rotation: 0
    state: enabled
