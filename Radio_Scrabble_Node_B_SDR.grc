- name: epy_transfer_chat_gui
  id: epy_block
  parameters:
    _source_code: "\"\"\"Embedded Python Block: chat GUI only, with command/event PDU ports.\"\"\"\nimport json\nfrom pathlib import Path\nimport queue\nimport threading\nfrom gnuradio import gr\nimport pmt\nfrom PyQt5 import QtCore, QtGui, QtWidgets\n\n\nclass _CommandOutput:\n    def __init__(self, block):\n        self.block = block\n\n    def put_nowait(self, command):\n        if command[0] == 'send':\n            value = dict(cmd='send', kind=command[1], value=command[2])\n        elif command[0] == 'cancel':\n            value = dict(cmd='cancel')\n        else:\n            raise ValueError('Unsupported GUI command')\n        raw = json.dumps(value, ensure_ascii=True).encode('utf-8')\n        self.block.message_port_pub(pmt.intern('command_out'),\n            pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\n\nclass blk(gr.basic_block):\n    \"\"\"Chat window; protocol work happens in a separate block.\"\"\"\n\n    def __init__(self, my_addr='A1', peer_addr='B1',\n                 receive_dir='./received_A1', show_gui=True):\n        gr.basic_block.__init__(self, name='Transfer Chat GUI', in_sig=None, out_sig=None)\n        self.my_addr = my_addr\n        self.peer_addr = peer_addr\n        self.receive_dir = str(Path(receive_dir).expanduser().resolve())\n        self.show_gui = bool(show_gui)\n        self.commands = _CommandOutput(self)\n        self.events = queue.Queue()\n        self.halt = threading.Event()\n        self.bridge = None\n        self.message_port_register_in(pmt.intern('event_in'))\n        self.message_port_register_out(pmt.intern('command_out'))\n        self.set_msg_handler(pmt.intern('event_in'), self._receive_event)\n\n    def _receive_event(self, msg):\n        if not pmt.is_pair(msg) or not pmt.is_u8vector(pmt.cdr(msg)):\n            return\n        try:\n            raw = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n            if len(raw) <= 524288:\n                self.events.put_nowait(json.loads(raw.decode('utf-8')))\n        except (ValueError, UnicodeError, queue.Full):\n            pass\n\n    def start(self):\n        self.halt.clear()\n        if self.show_gui:\n            app = QtWidgets.QApplication.instance()\n            if app is None:\n                print('[Transfer GUI] Set Options > Generate Options = QT GUI')\n                return False\n            self.bridge = _WindowBridge(self)\n            self.bridge.moveToThread(app.thread())\n            self.bridge.open_requested.emit()\n        return True\n\n    def stop(self):\n        self.halt.set()\n        if self.bridge:\n            self.bridge.close_requested.emit()\n        return True\n\n\nclass _WindowBridge(QtCore.QObject):\n    open_requested = QtCore.pyqtSignal()\n    close_requested = QtCore.pyqtSignal()\n\n    def __init__(self, block):\n        super().__init__()\n        self.block, self.window = block, None\n        self.open_requested.connect(self.open_window, QtCore.Qt.QueuedConnection)\n        self.close_requested.connect(self.close_window, QtCore.Qt.QueuedConnection)\n\n    @QtCore.pyqtSlot()\n    def open_window(self):\n        if not self.block.halt.is_set():\n            self.window = _TransferWindow(self.block)\n            self.window.show()\n\n    @QtCore.pyqtSlot()\n    def close_window(self):\n        if self.window:\n            self.window.timer.stop()\n            self.window.allow_close = True\n            self.window.close()\n            self.window.deleteLater()\n            self.window = None\n\n\nclass _TransferWindow(QtWidgets.QWidget):\n    \"\"\"Chat view only. Packet handling stays in _TransferCore.\"\"\"\n    def __init__(self, block):\n        super().__init__()\n        self.block, self.allow_close = block, False\n        self.tx_bubble = self.rx_bubble = None\n        self.messages = []\n        self.setWindowTitle('Chat | %s → %s' % (block.my_addr, block.peer_addr))\n        self.resize(570, 780)\n        self.setMinimumSize(440, 540)\n        self.setStyleSheet('''\n            QWidget { color:#173b32; font-family:Sans; font-size:14px; }\n            QWidget#chat, QWidget#historyBody { background:#f3f1eb; }\n            QFrame#header, QFrame#composer { background:white; }\n            QLabel { background:transparent; }\n            QLabel#avatar { background:#128c7e; color:white; border-radius:23px;\n                font-size:18px; font-weight:600; }\n            QLabel#name { font-size:18px; font-weight:600; }\n            QLabel#secondary { color:#77847e; font-size:11px; }\n            QLabel#day { color:#7b8780; font-size:11px; padding:10px; }\n            QFrame#sent { background:#d9fdd3; border:1px solid #ccecc6; border-radius:14px; }\n            QFrame#received { background:white; border:1px solid #e1e6e2; border-radius:14px; }\n            QPlainTextEdit { background:#f4f6f4; border:1px solid #e7ebe7;\n                border-radius:20px; padding:8px; font-size:14px; }\n            QPushButton,QToolButton { background:#e8f3ed; border:0; border-radius:16px;\n                padding:8px 12px; color:#16785c; }\n            QPushButton:hover,QToolButton:hover { background:#d1eadd; }\n            QPushButton#send { background:#128c7e; color:white; font-weight:600; }\n            QToolButton#attach { background:transparent; font-size:28px; padding:0; }\n            QToolButton::menu-indicator { image:none; }\n            QPushButton:disabled,QToolButton:disabled { color:#a4b8ac; background:#e7ede8; }\n            QPushButton#file { background:transparent; text-align:left; padding:5px 0; }\n            QPushButton#cancel { background:transparent; color:#886958; padding:2px; font-size:11px; }\n            QMenu { background:white; border:1px solid #d7e3da; padding:6px; }\n            QMenu::item { padding:9px 22px; }\n            QMenu::item:selected { background:#e6f4eb; }\n            QProgressBar { background:#e7eae1; border:0; border-radius:3px; }\n            QProgressBar::chunk { background:#20a47d; border-radius:3px; }\n            QScrollArea { background:transparent; border:0; }\n            QScrollBar:vertical { width:6px; background:transparent; }\n            QScrollBar::handle:vertical { background:#cdd6cc; border-radius:3px; min-height:24px; }\n            QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical { height:0; }\n        ''')\n        self.setObjectName('chat')\n        root = QtWidgets.QVBoxLayout(self)\n        root.setContentsMargins(0, 0, 0, 0)\n        root.setSpacing(0)\n\n        header = QtWidgets.QFrame()\n        header.setObjectName('header')\n        top = QtWidgets.QHBoxLayout(header)\n        top.setContentsMargins(20, 16, 18, 16)\n        avatar = QtWidgets.QLabel(block.peer_addr)\n        avatar.setObjectName('avatar')\n        avatar.setAlignment(QtCore.Qt.AlignCenter)\n        avatar.setFixedSize(46, 46)\n        top.addWidget(avatar)\n        contact = QtWidgets.QVBoxLayout()\n        contact.setSpacing(4)\n        name = QtWidgets.QLabel('Chat with ' + block.peer_addr)\n        name.setObjectName('name')\n        subtitle = QtWidgets.QLabel('Your node: ' + block.my_addr)\n        subtitle.setObjectName('secondary')\n        contact.addWidget(name)\n        contact.addWidget(subtitle)\n        top.addLayout(contact, 1)\n        files = QtWidgets.QPushButton('Received files')\n        files.clicked.connect(self.open_folder)\n        top.addWidget(files)\n        root.addWidget(header)\n\n        self.scroll = QtWidgets.QScrollArea()\n        self.scroll.setWidgetResizable(True)\n        self.scroll.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarAlwaysOff)\n        body = QtWidgets.QWidget()\n        body.setObjectName('historyBody')\n        self.history = QtWidgets.QVBoxLayout(body)\n        self.history.setContentsMargins(16, 4, 16, 14)\n        self.history.setSpacing(12)\n        self.history.setSizeConstraint(QtWidgets.QLayout.SetMinAndMaxSize)\n        day = QtWidgets.QLabel('TODAY')\n        day.setObjectName('day')\n        day.setAlignment(QtCore.Qt.AlignCenter)\n        self.history.addWidget(day)\n        self.history.addStretch(1)\n        self.scroll.setWidget(body)\n        root.addWidget(self.scroll, 1)\n\n        composer = QtWidgets.QFrame()\n        composer.setObjectName('composer')\n        controls = QtWidgets.QVBoxLayout(composer)\n        controls.setContentsMargins(12, 12, 16, 9)\n        row = QtWidgets.QHBoxLayout()\n        row.setSpacing(8)\n        self.attach = QtWidgets.QToolButton()\n        self.attach.setObjectName('attach')\n        self.attach.setText('+')\n        self.attach.setToolTip('Send an image or audio file')\n        self.attach.setAccessibleName('Attach image or audio file')\n        self.attach.setFixedSize(38, 44)\n        menu = QtWidgets.QMenu(self.attach)\n        menu.addAction('Image…', lambda: self.choose('image'))\n        menu.addAction('Audio file…', lambda: self.choose('audio'))\n        self.attach.setMenu(menu)\n        self.attach.setPopupMode(QtWidgets.QToolButton.InstantPopup)\n        self.text = QtWidgets.QPlainTextEdit()\n        self.text.setPlaceholderText('Type a message…')\n        self.text.setFixedHeight(60)\n        self.text.installEventFilter(self)\n        self.send_button = QtWidgets.QPushButton('Send')\n        self.send_button.setObjectName('send')\n        self.send_button.setFixedSize(68, 44)\n        self.send_button.clicked.connect(self.send_text)\n        row.addWidget(self.attach)\n        row.addWidget(self.text, 1)\n        row.addWidget(self.send_button)\n        controls.addLayout(row)\n        self.hint = QtWidgets.QLabel('Enter to send · Shift+Enter for a new line')\n        self.hint.setObjectName('secondary')\n        self.hint.setAlignment(QtCore.Qt.AlignCenter)\n        self.hint.setWordWrap(True)\n        controls.addWidget(self.hint)\n        root.addWidget(composer)\n        self.timer = QtCore.QTimer(self)\n        self.timer.timeout.connect(self.poll)\n        self.timer.start(50)\n\n    def eventFilter(self, obj, event):\n        if obj is self.text and event.type() == QtCore.QEvent.KeyPress:\n            if event.key() in (QtCore.Qt.Key_Return, QtCore.Qt.Key_Enter):\n                if not event.modifiers() & QtCore.Qt.ShiftModifier:\n                    self.send_text()\n                    return True\n        return super().eventFilter(obj, event)\n\n    def send_text(self):\n        if self.send_button.isEnabled() and self.text.toPlainText().strip():\n            if self.submit('text', self.text.toPlainText()):\n                self.text.clear()\n\n    def choose(self, kind):\n        filters = ('Images (*.png *.jpg *.jpeg *.bmp *.gif *.webp);;All files (*)'\n                   if kind == 'image' else\n                   'Audio (*.wav *.mp3 *.ogg *.flac *.m4a *.aac);;All files (*)')\n        path, _ = QtWidgets.QFileDialog.getOpenFileName(self, 'Choose ' + kind + ' to send', '', filters)\n        if path:\n            self.submit(kind, path)\n\n    def submit(self, kind, value):\n        if self.tx_bubble is not None:\n            return False\n        try:\n            self.block.commands.put_nowait(('send', kind, value))\n        except queue.Full:\n            self.hint.setText('Please try again in a moment.')\n            return False\n        caption = value if kind == 'text' else Path(value).name\n        self.tx_bubble = self.add_bubble(True, kind, caption)\n        if kind != 'text':\n            self.show_file(self.tx_bubble, value)\n        self.set_busy(True)\n        return True\n\n    def add_bubble(self, outgoing, kind, caption):\n        row = QtWidgets.QWidget()\n        layout = QtWidgets.QHBoxLayout(row)\n        layout.setContentsMargins(0, 0, 0, 0)\n        card = QtWidgets.QFrame()\n        card.setObjectName('sent' if outgoing else 'received')\n        card.setMaximumWidth(max(260, int(self.width() * 0.73)))\n        card.setSizePolicy(QtWidgets.QSizePolicy.Preferred, QtWidgets.QSizePolicy.Maximum)\n        content = QtWidgets.QVBoxLayout(card)\n        content.setContentsMargins(13, 11, 13, 9)\n        content.setSpacing(7)\n        label = QtWidgets.QLabel()\n        label.setTextFormat(QtCore.Qt.PlainText)\n        label.setText(caption[:4096] + ('\\n[Preview shortened]' if len(caption) > 4096 else ''))\n        label.setWordWrap(True)\n        label.setTextInteractionFlags(QtCore.Qt.TextSelectableByMouse)\n        label.setMinimumWidth(150)\n        content.addWidget(label)\n        preview = QtWidgets.QLabel()\n        preview.setAlignment(QtCore.Qt.AlignCenter)\n        preview.hide()\n        content.addWidget(preview)\n        open_button = QtWidgets.QPushButton('Play audio' if kind == 'audio' else 'Open file')\n        open_button.setObjectName('file')\n        open_button.hide()\n        content.addWidget(open_button)\n        progress = QtWidgets.QProgressBar()\n        progress.setRange(0, 1000)\n        progress.setValue(0)\n        progress.setTextVisible(False)\n        progress.setFixedHeight(5)\n        content.addWidget(progress)\n        footer = QtWidgets.QHBoxLayout()\n        status = QtWidgets.QLabel('Preparing…' if outgoing else 'Receiving…')\n        status.setObjectName('secondary')\n        status.setTextFormat(QtCore.Qt.PlainText)\n        status.setWordWrap(True)\n        footer.addWidget(status, 1)\n        cancel = QtWidgets.QPushButton('Cancel')\n        cancel.setObjectName('cancel')\n        cancel.setVisible(outgoing)\n        cancel.clicked.connect(self.cancel_send)\n        footer.addWidget(cancel)\n        content.addLayout(footer)\n        if outgoing:\n            layout.addStretch(1)\n        layout.addWidget(card)\n        if not outgoing:\n            layout.addStretch(1)\n        self.history.insertWidget(self.history.count() - 1, row)\n        record = dict(row=row, card=card, label=label, preview=preview, open=open_button,\n                      bar=progress, status=status, cancel=cancel, kind=kind,\n                      outgoing=outgoing, time=QtCore.QTime.currentTime().toString('HH:mm'),\n                      path=None, text=None, state='Preparing', done=0, total=0)\n        self.messages.append(record)\n        # Bound widget memory; received files remain saved on disk.\n        while len(self.messages) > 200:\n            old = next((m for m in self.messages if m is not self.tx_bubble and m is not self.rx_bubble), None)\n            if old is None:\n                break\n            self.messages.remove(old)\n            self.history.removeWidget(old['row'])\n            old['row'].deleteLater()\n        QtCore.QTimer.singleShot(0, self.scroll_bottom)\n        return record\n\n    def show_file(self, bubble, path):\n        bubble['path'] = path\n        bubble['open'].setProperty('file_path', path)\n        if not bubble.get('open_connected'):\n            bubble['open'].clicked.connect(self.open_file)\n            bubble['open_connected'] = True\n        bubble['open'].show()\n        if bubble['kind'] == 'image':\n            reader = QtGui.QImageReader(path)\n            size = reader.size()\n            if size.isValid() and size.width() * size.height() <= 40_000_000:\n                reader.setScaledSize(size.scaled(270, 170, QtCore.Qt.KeepAspectRatio))\n                picture = reader.read()\n                if not picture.isNull():\n                    bubble['preview'].setPixmap(QtGui.QPixmap.fromImage(picture))\n                    bubble['preview'].show()\n\n    def open_file(self):\n        path = self.sender().property('file_path')\n        if path:\n            QtGui.QDesktopServices.openUrl(QtCore.QUrl.fromLocalFile(path))\n\n    def show_full_text(self):\n        message = self.sender().property('message_text')\n        if message is None:\n            return\n        dialog = QtWidgets.QDialog(self)\n        dialog.setWindowTitle('Received message')\n        dialog.resize(650, 480)\n        layout = QtWidgets.QVBoxLayout(dialog)\n        editor = QtWidgets.QPlainTextEdit()\n        editor.setReadOnly(True)\n        editor.setPlainText(message)\n        layout.addWidget(editor)\n        close = QtWidgets.QPushButton('Close')\n        close.clicked.connect(dialog.accept)\n        layout.addWidget(close)\n        dialog.exec_()\n\n    def cancel_send(self):\n        try:\n            self.block.commands.put_nowait(('cancel',))\n        except queue.Full:\n            self.hint.setText('Please try cancelling again in a moment.')\n\n    def set_busy(self, busy):\n        self.send_button.setEnabled(not busy)\n        self.attach.setEnabled(not busy)\n        self.hint.setText('Sending… You can type your next message.' if busy else\n                          'Enter to send · Shift+Enter for a new line')\n\n    def poll(self):\n        bar = self.scroll.verticalScrollBar()\n        following = bar.maximum() - bar.value() < 40\n        changed = False\n        for _ in range(300):\n            try:\n                event = self.block.events.get_nowait()\n            except queue.Empty:\n                break\n            self.display_event(event)\n            changed = True\n        if changed and following:\n            QtCore.QTimer.singleShot(0, self.scroll_bottom)\n\n    def display_event(self, e):\n        direction, state = e['direction'], e['state']\n        if direction == 'preparing':\n            if self.tx_bubble:\n                self.tx_bubble['status'].setText(state)\n            return\n        if direction == 'notice':\n            if self.tx_bubble:\n                b = self.tx_bubble\n                b['status'].setText(state)\n                b['state'] = state\n                b['bar'].hide()\n                b['cancel'].hide()\n                self.tx_bubble = None\n            self.set_busy(False)\n            self.hint.setText(state)\n            return\n        outgoing = direction == 'tx'\n        bubble = self.tx_bubble if outgoing else self.rx_bubble\n        if bubble is None:\n            caption = 'Receiving message…' if e['kind'] == 'text' else e['name']\n            bubble = self.add_bubble(outgoing, e['kind'], caption)\n            if outgoing:\n                self.tx_bubble = bubble\n            else:\n                self.rx_bubble = bubble\n        complete = state.startswith('Complete')\n        active = state.startswith(('Sending', 'Receiving', 'Waiting', 'Retry'))\n        percent = 100.0 if complete else min(99.9, 100.0 * e['done'] / max(1, e['total']))\n        bubble.update(state=state, done=e['done'], total=e['total'])\n        bubble['bar'].setValue(round(percent * 10))\n        if complete:\n            if not outgoing:\n                if e['kind'] == 'text':\n                    message = e['text']\n                    bubble['text'] = message\n                    bubble['label'].setText(message[:4096] +\n                        ('\\n[Select View full message below]' if len(message) > 4096 else ''))\n                    if len(message) > 4096:\n                        bubble['open'].setText('View full message')\n                        bubble['open'].setProperty('message_text', message)\n                        bubble['open'].clicked.connect(self.show_full_text)\n                        bubble['open'].show()\n                else:\n                    self.show_file(bubble, e['path'])\n            bubble['status'].setText(bubble['time'] + ('  ·  ✓ Delivered' if outgoing else '  ·  Received'))\n        elif active:\n            stage = ('Checking file…' if 'verification' in state else\n                     state if state.startswith('Retry') else\n                     'Sending' if outgoing else 'Receiving')\n            bubble['status'].setText('%s · %.1f%%' % (stage, percent))\n        else:\n            bubble['status'].setText(state)\n        if not active:\n            bubble['bar'].hide()\n            bubble['cancel'].hide()\n            if outgoing:\n                self.tx_bubble = None\n                self.set_busy(False)\n            else:\n                self.rx_bubble = None\n\n    def scroll_bottom(self):\n        bar = self.scroll.verticalScrollBar()\n        bar.setValue(bar.maximum())\n\n    def resizeEvent(self, event):\n        super().resizeEvent(event)\n        for message in self.messages:\n            message['card'].setMaximumWidth(max(260, int(self.width() * 0.73)))\n\n    def open_folder(self):\n        try:\n            Path(self.block.receive_dir).mkdir(parents=True, exist_ok=True)\n            QtGui.QDesktopServices.openUrl(QtCore.QUrl.fromLocalFile(self.block.receive_dir))\n        except OSError as exc:\n            self.hint.setText(str(exc))\n\n    def closeEvent(self, event):\n        if self.allow_close:\n            event.accept()\n        else:\n            self.showMinimized()\n            event.ignore()  # Use GRC Stop to close the flowgraph and both chats.\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    my_addr: my_addr
    peer_addr: peer_addr
    receive_dir: '''./received_B1'''
    show_gui: 'False'
  states:
    _io_cache: ('Transfer Chat GUI', 'blk', [('my_addr', "'A1'"), ('peer_addr', "'B1'"), ('receive_dir', "'./received_A1'"), ('show_gui', 'True')], [('event_in', 'message', 1)], [('command_out', 'message', 1)], 'Chat window; protocol work happens in a separate block.', ['my_addr', 'peer_addr', 'receive_dir', 'show_gui'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2800
    - 724.0
    rotation: 0
    state: disabled
- name: epy_transfer_protocol
  id: epy_block
  parameters:
    _source_code: "\"\"\"Embedded Python Block: encrypted transfer protocol and ARQ, without GUI.\nPorts: rx_in, command_in, config_in; tx_out, event_out.\n\"\"\"\nimport hashlib\nimport io\nimport json\nimport os\nfrom pathlib import Path\nimport queue\nimport re\nimport secrets\nimport struct\nimport tempfile\nimport threading\nimport time\nimport subprocess\nfrom collections import OrderedDict\nfrom cryptography.fernet import Fernet, InvalidToken\nfrom gnuradio import gr\nimport pmt\n\n_META, _DATA, _END, _ACK, _ERROR, _CANCEL = range(1, 7)\n_HEADER = struct.Struct('!4sB2s2s16sI')\n_MAGIC = b'NGS2'\n\n\nclass blk(gr.basic_block):\n    \"\"\"All protocol, encryption, file I/O, ACKs and retries.\"\"\"\n\n    def __init__(self, my_addr='A1', peer_addr='B1',\n                 shared_key='u362K7J0T2sA_vB1C2D3E4F5G6H7I8J9K0L1M2N3O4P=',\n                 receive_dir='./received_A1', max_retries=20,\n                 max_file_mb=16, auto_encode_media=True,\n                 image_max_edge=1600, image_quality=80,\n                 audio_bitrate_kbps=64):\n        gr.basic_block.__init__(self, name='Transfer Protocol', in_sig=None, out_sig=None)\n        self.commands = queue.Queue(maxsize=2048)\n        self.halt = threading.Event()\n        self.worker = None\n        self.settings = {'timeout': {}, 'size': {}, 'window': {}, 'interval': {}}\n        self.config = (my_addr, peer_addr, shared_key, receive_dir,\n                       self._publish, self._event, 512, 1.0,\n                       max_retries, max_file_mb, 4, 0.02)\n        self.core = None\n        self.auto_encode_media = bool(auto_encode_media)\n        self.image_max_edge = int(image_max_edge)\n        self.image_quality = int(image_quality)\n        self.audio_bitrate_kbps = int(audio_bitrate_kbps)\n        if not 320 <= self.image_max_edge <= 8192:\n            raise ValueError('image_max_edge must be 320..8192')\n        if not 40 <= self.image_quality <= 95:\n            raise ValueError('image_quality must be 40..95')\n        if not 24 <= self.audio_bitrate_kbps <= 256:\n            raise ValueError('audio_bitrate_kbps must be 24..256')\n        self.preparing = False\n        self.prepare_id = 0\n        for name, handler in (('rx_in', self._receive),\n                              ('command_in', self._command),\n                              ('config_in', self._configure)):\n            port = pmt.intern(name)\n            self.message_port_register_in(port)\n            self.set_msg_handler(port, handler)\n        for name in ('tx_out', 'event_out'):\n            self.message_port_register_out(pmt.intern(name))\n\n    @staticmethod\n    def _bytes(msg):\n        if pmt.is_pair(msg) and pmt.is_u8vector(pmt.cdr(msg)):\n            return bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n        return None\n\n    def _publish(self, raw):\n        self.message_port_pub(pmt.intern('tx_out'),\n            pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\n    def _event(self, event):\n        raw = json.dumps(event, ensure_ascii=True).encode('utf-8')\n        self.message_port_pub(pmt.intern('event_out'),\n            pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n\n    def _receive(self, msg):\n        raw = self._bytes(msg)\n        if raw is not None and len(raw) <= 4092:\n            try:\n                self.commands.put_nowait(('rx', raw))\n            except queue.Full:\n                pass\n\n    def _command(self, msg):\n        raw = self._bytes(msg)\n        if raw is None or len(raw) > 8192:\n            return\n        try:\n            command = json.loads(raw.decode('utf-8'))\n            action = command.get('cmd')\n            if action == 'send' and command.get('kind') in ('text', 'image', 'audio'):\n                item = ('send', command['kind'], command['value'])\n            elif action == 'cancel':\n                item = ('cancel',)\n            else:\n                return\n            self.commands.put_nowait(item)\n        except (ValueError, UnicodeError, KeyError, AttributeError, queue.Full):\n            pass\n\n    def _configure(self, msg):\n        raw = self._bytes(msg)\n        if raw is None or len(raw) > 2048:\n            return\n        try:\n            config = json.loads(raw.decode('utf-8'))\n            category = config['category']\n            values = config['values']\n            if category not in self.settings or set(values) != {'text', 'image', 'audio'}:\n                raise ValueError('Unknown profile category or transfer type')\n            checked = {}\n            for kind, value in values.items():\n                if category in ('size', 'window'):\n                    if type(value) is not int:\n                        raise ValueError(category + ' must be an integer')\n                    if not (128 <= value <= 1024 if category == 'size' else 1 <= value <= 32):\n                        raise ValueError(category + ' outside supported range')\n                else:\n                    if type(value) not in (int, float):\n                        raise ValueError(category + ' must be numeric')\n                    if not (0.05 <= value <= 30 if category == 'timeout' else 0 <= value <= 5):\n                        raise ValueError(category + ' outside supported range')\n                checked[kind] = value\n            self.settings[category] = checked\n        except (ValueError, TypeError, KeyError, AttributeError) as exc:\n            self._event(dict(direction='notice', state='Invalid profile: ' + str(exc)))\n\n    def start(self):\n        self.halt.clear()\n        self.worker = threading.Thread(target=self._run, name='file-transfer', daemon=True)\n        self.worker.start()\n        return True\n\n    def _run(self):\n        try:\n            while not self.halt.is_set():\n                if self.core is None and all(self.settings.values()):\n                    profiles = {kind: (\n                        self.settings['size'][kind], self.settings['timeout'][kind],\n                        self.settings['interval'][kind], self.settings['window'][kind])\n                        for kind in ('text', 'image', 'audio')}\n                    self.core = _TransferCore(*self.config, profiles=profiles)\n                    self._event(dict(direction='notice', state='Transfer profiles ready'))\n                try:\n                    cmd = self.commands.get(timeout=0.01)\n                except queue.Empty:\n                    if self.core is not None:\n                        self.core.tick()\n                    continue\n                if self.core is None:\n                    if cmd[0] == 'send':\n                        self._event(dict(direction='notice', state='Waiting for all four profile blocks'))\n                    continue\n                if cmd[0] == 'rx':\n                    self.core.receive(cmd[1])\n                elif cmd[0] == 'send':\n                    try:\n                        if self.preparing or self.core.tx is not None:\n                            raise ValueError('A transfer is already active')\n                        if self.auto_encode_media and cmd[1] in ('image', 'audio'):\n                            self.preparing = True\n                            self.prepare_id += 1\n                            job = self.prepare_id\n                            self._event(dict(direction='preparing', state='Encoding file',\n                                             kind=cmd[1]))\n                            threading.Thread(target=self._prepare_media,\n                                args=(job, cmd[1], cmd[2]), daemon=True).start()\n                        else:\n                            self.core.send(cmd[1], cmd[2])\n                    except Exception as exc:\n                        self._event(dict(direction='notice', state=str(exc)))\n                elif cmd[0] == 'prepared':\n                    if self.preparing and cmd[1] == self.prepare_id:\n                        self.preparing = False\n                        try:\n                            self.core.send_prepared(cmd[2], cmd[3], cmd[4])\n                        except Exception as exc:\n                            self._event(dict(direction='notice', state=str(exc)))\n                elif cmd[0] == 'prepare_error':\n                    if self.preparing and cmd[1] == self.prepare_id:\n                        self.preparing = False\n                        self._event(dict(direction='notice', state=cmd[2]))\n                elif cmd[0] == 'cancel':\n                    if self.preparing:\n                        self.prepare_id += 1\n                        self.preparing = False\n                        self._event(dict(direction='tx', state='Cancelled', kind='',\n                                         name='', total=0, done=0))\n                    else:\n                        self.core.cancel()\n                self.core.tick()\n        except Exception as exc:\n            self._event(dict(direction='notice', state='Worker stopped: ' + str(exc)))\n            print('[Transfer Protocol] Worker stopped:', exc, flush=True)\n        finally:\n            if self.core is not None:\n                self.core.close()\n\n    def stop(self):\n        self.halt.set()\n        self.prepare_id += 1\n        if self.worker is not None:\n            self.worker.join(timeout=3)\n        return True\n\n    def _prepare_media(self, job, kind, value):\n        try:\n            path = Path(value)\n            if not path.is_file() or path.stat().st_size > self.core.limit:\n                raise ValueError('Choose a file within the configured size limit')\n            original = path.read_bytes()\n            data, name = original, path.name\n            try:\n                if kind == 'image':\n                    data, name = self._encode_image(path, original)\n                else:\n                    data, name = self._encode_audio(path, original)\n            except (ImportError, OSError, subprocess.SubprocessError, ValueError) as exc:\n                print('[Media] Encoder unavailable; sending original:', exc, flush=True)\n            if len(data) > self.core.limit:\n                raise ValueError('Encoded file exceeds the configured size limit')\n            if self.halt.is_set():\n                return\n            print('[Media] %s: %d -> %d bytes (%s)' %\n                  (kind, len(original), len(data), name), flush=True)\n            self.commands.put(('prepared', job, kind, data, name), timeout=5)\n        except Exception as exc:\n            try:\n                self.commands.put(('prepare_error', job, str(exc)), timeout=5)\n            except queue.Full:\n                pass\n\n    def _encode_image(self, path, original):\n        from PIL import Image, ImageOps\n        with Image.open(path) as image:\n            if getattr(image, 'n_frames', 1) != 1 or image.width * image.height > 40_000_000:\n                return original, path.name\n            image = ImageOps.exif_transpose(image)\n            ext = path.suffix.lower()\n            if ext == '.png' or 'A' in image.getbands():\n                # Keep graphics, text and transparency lossless.\n                out = io.BytesIO()\n                image.save(out, format='PNG', optimize=True)\n                candidate, name = out.getvalue(), path.stem + '.png'\n            else:\n                image = image.convert('RGB')\n                image.thumbnail((self.image_max_edge, self.image_max_edge), Image.Resampling.LANCZOS)\n                out = io.BytesIO()\n                image.save(out, format='JPEG', quality=self.image_quality,\n                           optimize=True, progressive=True)\n                candidate, name = out.getvalue(), path.stem + '.jpg'\n            return (candidate, name) if len(candidate) < len(original) else (original, path.name)\n\n    def _encode_audio(self, path, original):\n        if path.suffix.lower() in ('.ogg', '.opus'):\n            return original, path.name\n        result = subprocess.run([\n            'ffmpeg', '-nostdin', '-v', 'error', '-i', str(path), '-vn',\n            '-c:a', 'libopus', '-b:a', '%dk' % self.audio_bitrate_kbps,\n            '-vbr', 'on', '-compression_level', '10', '-ar', '48000',\n            '-f', 'ogg', 'pipe:1'], capture_output=True, timeout=300, check=True)\n        candidate = result.stdout\n        return (candidate, path.stem + '.ogg') if 0 < len(candidate) < len(original) else (original, path.name)\n\n\nclass _TransferCore:\n    \"\"\"Selective Repeat, independently in each direction (one file per direction).\n\n    META (0) is acknowledged before DATA (1..N). DATA uses a bounded sliding\n    window and individual ACKs/timers. END (N+1) is sent after all DATA ACKs,\n    and acknowledged only after SHA-256 verification and saving the file.\n    32-bit sequence numbers never wrap within a transfer. A random 128-bit\n    transfer ID separates transfers. All methods run on one worker thread.\n    \"\"\"\n    def __init__(self, my_addr, peer_addr, shared_key, receive_dir, emit, event,\n                 chunk_size=512, ack_timeout=1.0, max_retries=8,\n                 max_file_mb=16, window_size=4, packet_interval=0.02,\n                 clock=time.monotonic, profiles=None):\n        for addr in (my_addr, peer_addr):\n            if not isinstance(addr, str) or len(addr.encode('ascii')) != 2:\n                raise ValueError('Addresses must be exactly two ASCII characters')\n        if my_addr == peer_addr:\n            raise ValueError('Local and peer addresses must differ')\n        if not 128 <= int(chunk_size) <= 1024:\n            raise ValueError('chunk_size must be 128..1024 bytes')\n        if not 0.05 <= float(ack_timeout) <= 30 or not 0 <= int(max_retries) <= 20:\n            raise ValueError('ack_timeout: 0.05..30 seconds; max_retries: 0..20')\n        if not 1 <= int(max_file_mb) <= 256:\n            raise ValueError('max_file_mb must be 1..256')\n        if not 1 <= int(window_size) <= 32:\n            raise ValueError('window_size must be 1..32 packets')\n        if not 0 <= float(packet_interval) <= 5:\n            raise ValueError('packet_interval must be 0..5 seconds')\n        key = shared_key.encode('ascii') if isinstance(shared_key, str) else shared_key\n        self.cipher = Fernet(key)\n        self.me, self.peer = my_addr.encode('ascii'), peer_addr.encode('ascii')\n        self.directory = Path(receive_dir).expanduser().resolve()\n        self.emit, self.event, self.clock = emit, event, clock\n        self.chunk, self.window = int(chunk_size), int(window_size)\n        self.timeout, self.retries = float(ack_timeout), int(max_retries)\n        self.interval = float(packet_interval)\n        self.profiles = {}\n        for kind in ('text', 'image', 'audio'):\n            values = (profiles or {}).get(kind, (chunk_size, ack_timeout, packet_interval, window_size))\n            chunk, timeout, interval, kind_window = values\n            if isinstance(chunk, bool) or int(chunk) != chunk or not 128 <= int(chunk) <= 1024:\n                raise ValueError(kind + '_chunk_size must be an integer, 128..1024 bytes')\n            if not 0.05 <= float(timeout) <= 30:\n                raise ValueError(kind + '_ack_timeout must be 0.05..30 seconds')\n            if not 0 <= float(interval) <= 5:\n                raise ValueError(kind + '_packet_interval must be 0..5 seconds')\n            if type(kind_window) is not int or not 1 <= kind_window <= 32:\n                raise ValueError(kind + '_window_size must be 1..32 packets')\n            self.profiles[kind] = dict(chunk=int(chunk), timeout=float(timeout),\n                                       interval=float(interval), window=kind_window)\n        self.limit = int(max_file_mb) * 1024 * 1024\n        # Allow a complete retry round even when 32 packets are heavily paced.\n        self.idle_timeout = max(120, 4 * (self.retries + 1) *\n                                (self.timeout + 32 * self.interval))\n        self.idle_timeout = max(self.idle_timeout, *(self._idle_budget(\n            p['timeout'], p['interval'], self.retries, p['window']) for p in self.profiles.values()))\n        # Retain completion receipts for the longest permitted remote retry budget.\n        self.receipt_ttl = max(1800, 2 * self._idle_budget(30, 5, 20))\n        self.tx = self.rx = None\n        self.next_emit = 0.0\n        self.receipts = OrderedDict()\n\n    @staticmethod\n    def _idle_budget(timeout, interval, retries, window=32):\n        return max(120, 4 * (retries + 1) * (timeout + window * interval))\n\n    def _event(self, direction, state, transfer=None, **extra):\n        t = transfer or {}\n        self.event(dict(direction=direction, state=state, name=t.get('name', ''),\n                        kind=t.get('kind', ''), total=t.get('size', 0),\n                        done=t.get('done', 0), started=t.get('started', self.clock()),\n                        **extra))\n\n    def _wire(self, typ, tid, seq, body=b''):\n        plaintext = _HEADER.pack(_MAGIC, typ, self.me, self.peer, tid, seq) + body\n        frame = self.me + self.peer + self.cipher.encrypt(plaintext)\n        if len(frame) > 4092:\n            raise ValueError('Encrypted frame exceeds 4092-byte PDU budget')\n        return frame\n\n    def _reply(self, typ, tid, seq, body=b''):\n        # ACK/error/control replies bypass DATA pacing. Already queued downstream\n        # PDUs cannot be overtaken; size the timeout for the complete RF pipeline.\n        self.emit(self._wire(typ, tid, seq, body))\n\n    @staticmethod\n    def _safe_name(name):\n        name = str(name).replace('\\\\', '/').split('/')[-1]\n        name = re.sub(r'[^\\w. -]', '_', name, flags=re.UNICODE).strip('. ')[:100]\n        return name or 'received.bin'\n\n    def send(self, kind, value):\n        if self.tx is not None:\n            raise ValueError('A transfer is already active')\n        if kind == 'text':\n            data, name = value.encode('utf-8'), 'message.txt'\n            if not data or len(data) > 65536:\n                raise ValueError('Type a message of 1..65536 UTF-8 bytes')\n        elif kind in ('image', 'audio'):\n            path = Path(value)\n            if not path.is_file() or path.stat().st_size > self.limit:\n                raise ValueError('Choose a file within the configured size limit')\n            with path.open('rb') as f:\n                data = f.read(self.limit + 1)\n            name = path.name\n        else:\n            raise ValueError('Unsupported transfer type')\n        self.send_prepared(kind, data, name)\n\n    def send_prepared(self, kind, data, name):\n        if self.tx is not None:\n            raise ValueError('A transfer is already active')\n        if kind not in ('text', 'image', 'audio') or not isinstance(data, bytes):\n            raise ValueError('Invalid prepared transfer')\n        if kind == 'text' and (not data or len(data) > 65536):\n            raise ValueError('Type a message of 1..65536 UTF-8 bytes')\n        if len(data) > self.limit:\n            raise ValueError('File exceeds the configured size limit')\n        profile = self.profiles[kind]\n        chunk = profile['chunk']\n        self.tx = dict(tid=secrets.token_bytes(16), data=data, kind=kind,\n                       chunk=chunk, timeout=profile['timeout'], interval=profile['interval'],\n                       window=profile['window'],\n                       name=self._safe_name(name), size=len(data), done=0,\n                       started=self.clock(), n=(len(data) + chunk - 1) // chunk,\n                       digest=hashlib.sha256(data).hexdigest(), phase='meta',\n                       base=1, next=1, acked=set(), pending={})\n        t = self.tx\n        meta = dict(kind=t['kind'], name=t['name'], size=t['size'], chunk=t['chunk'],\n                    ack_timeout=t['timeout'], packet_interval=t['interval'], max_retries=self.retries,\n                    window=t['window'], sha256=t['digest'])\n        self._queue_packet(_META, 0, json.dumps(meta, ensure_ascii=True,\n                           separators=(',', ':')).encode())\n        self._event('tx', 'Sending metadata', t)\n        print('[Transfer profile] %s: payload=%d bytes, ACK timeout=%.3f s, interval=%.3f s'\n              % (kind, t['chunk'], t['timeout'], t['interval']), flush=True)\n        self._pump()\n\n    def _queue_packet(self, typ, seq, body):\n        t = self.tx\n        t['pending'][seq] = dict(wire=self._wire(typ, t['tid'], seq, body),\n                                 sent=None, retry=0)\n\n    def _fill_window(self):\n        t = self.tx\n        if t['phase'] != 'data':\n            return\n        # The window is anchored at the oldest unacknowledged sequence number,\n        # not merely at the number of pending packets. This bounds RX buffering.\n        while t['next'] <= t['n'] and t['next'] < t['base'] + t['window']:\n            seq = t['next']\n            self._queue_packet(_DATA, seq,\n                               t['data'][(seq - 1) * t['chunk']:seq * t['chunk']])\n            t['next'] += 1\n        if t['base'] > t['n']:\n            t['phase'] = 'end'\n            self._queue_packet(_END, t['n'] + 1, bytes.fromhex(t['digest']))\n            self._event('tx', 'Waiting for file verification', t)\n\n    def _acknowledge(self, tid, seq, body):\n        t = self.tx\n        if body or t is None or t['tid'] != tid:\n            return\n        packet = t['pending'].get(seq)\n        if packet is None or packet['sent'] is None:\n            return  # Duplicate/stale ACK, or a sequence not yet transmitted.\n        del t['pending'][seq]\n        if t['phase'] == 'meta':\n            t['phase'] = 'data'\n        elif t['phase'] == 'end':\n            self._event('tx', 'Complete — receiver verified', t)\n            self.tx = None\n            return\n        else:\n            t['done'] += min(t['chunk'], t['size'] - (seq - 1) * t['chunk'])\n            t['acked'].add(seq)\n            while t['base'] in t['acked']:\n                t['acked'].remove(t['base'])\n                t['base'] += 1\n            self._event('tx', 'Sending', t)\n        self._fill_window()\n        self._pump()\n\n    def _pump(self):\n        \"\"\"Emit at most one DATA/META/END PDU per call, with retry priority.\"\"\"\n        t, now = self.tx, self.clock()\n        if t is None or now < self.next_emit:\n            return\n        expired = [(p['sent'], seq) for seq, p in t['pending'].items()\n                   if p['sent'] is not None and now - p['sent'] >= t['timeout']]\n        if expired:\n            _, seq = min(expired)\n            p = t['pending'][seq]\n            if p['retry'] >= self.retries:\n                self._abort_tx('Unconfirmed — ACK timeout for packet %d' % seq)\n                return\n            p['retry'] += 1\n            self._event('tx', 'Retry packet %d (%d/%d)' %\n                        (seq, p['retry'], self.retries), t)\n        else:\n            seq = next((s for s, p in t['pending'].items() if p['sent'] is None), None)\n            if seq is None:\n                return\n            p = t['pending'][seq]\n        p['sent'] = now  # Timestamp PDU submission, not an RF hardware timestamp.\n        self.next_emit = now + t['interval']\n        self.emit(p['wire'])\n\n    def receive(self, frame):\n        # The upstream CRC Check must drop failures and remove the CRC bytes.\n        if len(frame) < 5 or len(frame) > 4092 or frame[:4] != self.peer + self.me:\n            return\n        try:\n            raw = self.cipher.decrypt(frame[4:])\n            if len(raw) < _HEADER.size:\n                return\n            magic, typ, src, dst, tid, seq = _HEADER.unpack(raw[:_HEADER.size])\n            if magic != _MAGIC or src != self.peer or dst != self.me:\n                return\n            body = raw[_HEADER.size:]\n        except (InvalidToken, ValueError, struct.error):\n            return\n        if typ == _ACK:\n            self._acknowledge(tid, seq, body)\n        elif typ == _ERROR:\n            if self.tx and tid == self.tx['tid'] and seq in self.tx['pending']:\n                self._abort_tx('Failed: ' + body.decode('utf-8', 'replace')[:180])\n        elif typ == _CANCEL:\n            if body:\n                return\n            if self.rx and self.rx['tid'] == tid:\n                self._drop_rx('Cancelled by sender')\n            elif tid not in self.receipts:\n                # A reordered CANCEL can arrive before its META.\n                self._remember(tid, error='Cancelled by sender')\n        elif typ in (_META, _DATA, _END):\n            try:\n                self._receive_data(typ, tid, seq, body)\n            except (ValueError, OSError, UnicodeError, KeyError, TypeError) as exc:\n                reason = str(exc)[:180]\n                if self.rx and self.rx['tid'] == tid:\n                    self._drop_rx('Failed: ' + reason)\n                elif tid not in self.receipts:\n                    self._remember(tid, error=reason)\n                self._reply(_ERROR, tid, seq, reason.encode('utf-8')[:180])\n\n    def _remember(self, tid, **fields):\n        self.receipts[tid] = dict(at=self.clock(), **fields)\n        self.receipts.move_to_end(tid)\n        while len(self.receipts) > 256:\n            self.receipts.popitem(last=False)\n\n    def _receive_data(self, typ, tid, seq, body):\n        if tid in self.receipts:\n            c = self.receipts[tid]\n            if 'error' in c:\n                self._reply(_ERROR, tid, seq, c['error'].encode('utf-8')[:180])\n            elif typ == _END and seq == c['seq'] and body == c['digest']:\n                self._reply(_ACK, tid, seq)  # Lost final ACK: never save twice.\n            return\n        if typ == _META:\n            if seq != 0:\n                raise ValueError('Invalid metadata sequence')\n            if self.rx:\n                if self.rx['tid'] == tid and self.rx['meta'] == body:\n                    self.rx['last'] = self.clock()\n                    self._reply(_ACK, tid, seq)\n                    return\n                raise ValueError('Receiver busy; retry after its current transfer')\n            meta = json.loads(body.decode('utf-8'))\n            if not isinstance(meta, dict):\n                raise ValueError('Invalid metadata')\n            size, chunk, window = meta.get('size'), meta.get('chunk'), meta.get('window')\n            digest, kind = meta.get('sha256'), meta.get('kind')\n            if type(size) is not int or not 0 <= size <= self.limit:\n                raise ValueError('Unsupported file size')\n            if type(chunk) is not int or not 128 <= chunk <= 1024:\n                raise ValueError('Invalid chunk size')\n            if type(window) is not int or not 1 <= window <= 32:\n                raise ValueError('Invalid window size')\n            if kind not in ('text', 'image', 'audio') or (kind == 'text' and size > 65536):\n                raise ValueError('Unsupported content type or text size')\n            if not isinstance(digest, str) or not re.fullmatch('[0-9a-f]{64}', digest):\n                raise ValueError('Invalid SHA-256')\n            if not isinstance(meta.get('name'), str) or len(meta['name']) > 200:\n                raise ValueError('Invalid filename')\n            # Optional fields allow older NGS2 senders to keep working.\n            timeout = meta.get('ack_timeout', self.timeout)\n            interval = meta.get('packet_interval', self.interval)\n            retries = meta.get('max_retries', self.retries)\n            if type(timeout) not in (int, float) or not 0.05 <= timeout <= 30:\n                raise ValueError('Invalid ACK timeout')\n            if type(interval) not in (int, float) or not 0 <= interval <= 5:\n                raise ValueError('Invalid packet interval')\n            if type(retries) is not int or not 0 <= retries <= 20:\n                raise ValueError('Invalid retry limit')\n            idle_timeout = max(self.idle_timeout, self._idle_budget(timeout, interval, retries))\n            if kind == 'text':\n                f, temp = io.BytesIO(), None\n            else:\n                self.directory.mkdir(parents=True, exist_ok=True)\n                f = tempfile.NamedTemporaryFile(mode='w+b', prefix='.incoming_',\n                                                suffix='.part', dir=self.directory, delete=False)\n                temp = Path(f.name)\n            self.rx = dict(tid=tid, meta=body, kind=kind, name=self._safe_name(meta['name']),\n                           size=size, chunk=chunk, window=window, digest=digest, idle_timeout=idle_timeout,\n                           n=(size + chunk - 1) // chunk, next=1, done=0, buffer={},\n                           hash=hashlib.sha256(), file=f, temp=temp,\n                           started=self.clock(), last=self.clock())\n            self._event('rx', 'Receiving', self.rx)\n            self._reply(_ACK, tid, seq)\n            return\n        r = self.rx\n        if r is None or r['tid'] != tid:\n            raise ValueError('No matching transfer; send again from the beginning')\n        r['last'] = self.clock()\n        if typ == _DATA:\n            if not 1 <= seq <= r['n']:\n                raise ValueError('Invalid data sequence')\n            expected = min(r['chunk'], r['size'] - (seq - 1) * r['chunk'])\n            if len(body) != expected:\n                raise ValueError('Invalid chunk length')\n            if seq < r['next']:\n                self._reply(_ACK, tid, seq)  # Re-ACK without writing twice.\n                return\n            if seq >= r['next'] + r['window']:\n                return  # Out of receive window: do not ACK unretained data.\n            if seq not in r['buffer']:\n                r['buffer'][seq] = body\n                r['done'] += len(body)  # Unique accepted bytes, including buffered ones.\n            elif r['buffer'][seq] != body:\n                raise ValueError('Conflicting duplicate packet')\n            while r['next'] in r['buffer']:\n                contiguous = r['buffer'].pop(r['next'])\n                r['file'].write(contiguous)\n                r['hash'].update(contiguous)\n                r['next'] += 1\n            self._event('rx', 'Receiving', r)\n            self._reply(_ACK, tid, seq)\n        elif typ == _END:\n            if seq != r['n'] + 1 or r['next'] != seq or r['done'] != r['size'] or r['buffer']:\n                raise ValueError('Incomplete file')\n            if body != bytes.fromhex(r['digest']) or r['hash'].hexdigest() != r['digest']:\n                raise ValueError('Whole-file SHA-256 mismatch')\n            if r['kind'] == 'text':\n                message = r['file'].getvalue().decode('utf-8')\n                r['file'].close()\n                result = dict(text=message)\n                state = 'Complete — displayed and verified'\n            else:\n                r['file'].flush()\n                os.fsync(r['file'].fileno())\n                r['file'].close()\n                final = self.directory / (tid.hex() + '_' + r['name'])\n                os.replace(r['temp'], final)\n                result = dict(path=str(final))\n                state = 'Complete — saved and verified'\n            self._remember(tid, seq=seq, digest=body)\n            self.rx = None\n            self._reply(_ACK, tid, seq)\n            self._event('rx', state, r, **result)\n\n    def tick(self):\n        self._pump()\n        now = self.clock()\n        if self.rx and now - self.rx['last'] >= self.rx['idle_timeout']:\n            self._drop_rx('Timed out — partial file removed')\n        for tid, entry in list(self.receipts.items()):\n            if now - entry['at'] > self.receipt_ttl:\n                del self.receipts[tid]\n\n    def _abort_tx(self, reason):\n        if self.tx:\n            t, self.tx = self.tx, None\n            self._reply(_CANCEL, t['tid'], 0)\n            self._event('tx', reason, t)\n\n    def cancel(self):\n        self._abort_tx('Cancelled — peer may have received some data')\n\n    def _drop_rx(self, reason):\n        r, self.rx = self.rx, None\n        if r:\n            self._remember(r['tid'], error=reason)\n            try:\n                r['file'].close()\n            except OSError:\n                pass\n            if r['temp'] is not None:\n                try:\n                    r['temp'].unlink(missing_ok=True)\n                except OSError as exc:\n                    reason += '; partial-file cleanup failed: ' + str(exc)\n            self._event('rx', reason, r)\n\n    def close(self):\n        self.tx = None\n        self._drop_rx('Stopped — partial file removed')\n"
    affinity: ''
    alias: ''
