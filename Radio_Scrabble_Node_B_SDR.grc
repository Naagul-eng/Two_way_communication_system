  id: epy_block
  parameters:
    _source_code: "\"\"\"Embedded Python Block: Chess Protocol — encrypted forwarding of chess packets to/from the radio chain.\n\ncommand_in  <- Chess GUI command_out   (JSON dict, chess==1) -> Fernet encrypt -> tx_out    -> CRC append -> RS encoder -> TX\nrx_in       <- CRC check ok output     (b'CH'+token)         -> Fernet decrypt -> event_out -> Chess GUI event_in\nAnything that is not an authentic chess frame (wrong key, other protocol traffic) is silently ignored.\n\"\"\"\nimport json\nfrom cryptography.fernet import Fernet, InvalidToken\nfrom gnuradio import gr\nimport pmt\n\n_TAG = b'CH'\n\n\nclass blk(gr.basic_block):\n    def __init__(self, my_addr='A1', peer_addr='B1', time_control='3+0', player_color='random',\n                 shared_key=b'u362K7J0T2sA_vB1C2D3E4F5G6H7I8J9K0L1M2N3O4P='):\n        gr.basic_block.__init__(self, name='Chess Protocol', in_sig=None, out_sig=None)\n        self.my_addr = my_addr\n        self.peer_addr = peer_addr\n        self.time_control = time_control\n        self.player_color = player_color\n        if isinstance(shared_key, str):\n            shared_key = shared_key.encode('ascii')\n        self.cipher = Fernet(shared_key)\n        for name in ('rx_in', 'command_in'):\n            self.message_port_register_in(pmt.intern(name))\n            self.set_msg_handler(pmt.intern(name), getattr(self, '_' + name))\n        for name in ('tx_out', 'event_out'):\n            self.message_port_register_out(pmt.intern(name))\n\n    @staticmethod\n    def _bytes(msg):\n        if pmt.is_pair(msg) and pmt.is_u8vector(pmt.cdr(msg)):\n            return bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n        return None\n\n    def decode(self, raw):\n        \"\"\"b'CH'+token -> dict, or None if not an authentic chess frame.\"\"\"\n        if raw is None or not raw.startswith(_TAG):\n            return None\n        try:\n            d = json.loads(self.cipher.decrypt(raw[len(_TAG):]).decode('utf-8'))\n        except (InvalidToken, ValueError, UnicodeError):\n            return None\n        return d if isinstance(d, dict) and d.get('chess') == 1 else None\n\n    def encode(self, d):\n        return _TAG + self.cipher.encrypt(json.dumps(d, separators=(',', ':')).encode('utf-8'))\n\n    @staticmethod\n    def _wrap(raw):\n        return pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw)))\n\n    def _command_in(self, msg):\n        raw = self._bytes(msg)\n        if raw is None:\n            return\n        try:\n            d = json.loads(raw.decode('utf-8'))\n        except ValueError:\n            return\n        if isinstance(d, dict) and d.get('chess') == 1:\n            self.message_port_pub(pmt.intern('tx_out'), self._wrap(self.encode(d)))\n\n    def _rx_in(self, msg):\n        d = self.decode(self._bytes(msg))\n        if d is not None:\n            ev = json.dumps({'direction': 'peer_move', 'data': d}, separators=(',', ':')).encode('utf-8')\n            self.message_port_pub(pmt.intern('event_out'), self._wrap(ev))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    my_addr: my_addr
    peer_addr: peer_addr
    player_color: '''white'''
    time_control: '''5+0'''
    shared_key: shared_key
  states:
    _io_cache: ('Chess Protocol', 'blk', [('my_addr', "'A1'"), ('peer_addr', "'B1'"), ('time_control', "'3+0'"), ('player_color', "'random'")], [('rx_in', 'message', 1), ('command_in', 'message', 1)], [('event_out', 'message', 1), ('tx_out', 'message', 1)], 'Manages chess game state, turn timing, move validation, and wireless sync.', ['my_addr', 'peer_addr', 'player_color', 'time_control'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 3224
    - 428.0
    rotation: 0
    state: enabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "\"\"\"Embedded Python Block: Radio Scrabble - full Scrabble rules, clocks, challenges, radio sync, chat.\n\nPorts:  event_in  <- 'Chess Protocol' (encrypted game-frame forwarder) event_out\n        command_out -> same block's command_in\nChat:   chat_out -> Transfer Protocol command_in ; Transfer Protocol event_out -> chat_in\n\nRules implemented: 15x15 board with premium squares, 100 tiles (2 blanks), 7-tile racks, first word on the\ncentre star (2+ tiles), connected plays, cross-words, letter/word multipliers on NEW tiles only, blanks score 0,\n50-point bingo, pass, exchange (bag >= 7), challenge (lost challenge = lose turn, invalid word = play removed),\nend of game (rack out with empty bag / six scoreless turns), rack penalties, resign, optional 25-minute clock\nwith 10 points per overtime minute.\n\nThe game is a replicated state machine: both nodes deal from the same seed and exchange only small, numbered\nevents over the radio link (stop-and-wait retry on top of the link's own FEC/CRC/ACK). Opponent rack letters are\nnever displayed.\n\necho_test=True  : ONE window plays BOTH seats (hot-seat, single-laptop loopback test); chat goes through the loopback chain\necho_test=False : you play only your own seat; the two nodes MUST have different my_addr values (e.g. 'A1' and 'B1')\ndict_path       : optional word list (one word per line) for automatic challenge judging. Empty = auto-detect an external\n                  list (~/scrabble_words.txt, /usr/share/dict/words ...), else the BUILT-IN list embedded below is used.\n                  The built-in list is Collins Scrabble Words 2019 (279,496 words); dict_path overrides it.\n\"\"\"\nimport base64\nimport copy\nimport html as _html\nimport json\nimport math\nimport os\nimport random\nimport time\nimport zlib\nfrom gnuradio import gr\nimport pmt\nfrom PyQt5 import QtWidgets, QtCore, QtGui\n\nN = 15\nVAL = {'A': 1, 'B': 3, 'C': 3, 'D': 2, 'E': 1, 'F': 4, 'G': 2, 'H': 4, 'I': 1, 'J': 8, 'K': 5, 'L': 1, 'M': 3,\n       'N': 1, 'O': 1, 'P': 3, 'Q': 10, 'R': 1, 'S': 1, 'T': 1, 'U': 1, 'V': 4, 'W': 4, 'X': 8, 'Y': 4, 'Z': 10, '?': 0}\nDIST = {'A': 9, 'B': 2, 'C': 2, 'D': 4, 'E': 12, 'F': 2, 'G': 3, 'H': 2, 'I': 9, 'J': 1, 'K': 1, 'L': 4, 'M': 2,\n        'N': 6, 'O': 8, 'P': 2, 'Q': 1, 'R': 6, 'S': 4, 'T': 6, 'U': 4, 'V': 2, 'W': 2, 'X': 1, 'Y': 2, 'Z': 1, '?': 2}\nPREM = {}\nfor _r, _c in [(0, 0), (0, 7), (0, 14), (7, 0), (7, 14), (14, 0), (14, 7), (14, 14)]:\n    PREM[(_r, _c)] = 'TW'\nfor _r, _c in [(1, 1), (2, 2), (3, 3), (4, 4), (1, 13), (2, 12), (3, 11), (4, 10), (13, 1), (12, 2), (11, 3),\n               (10, 4), (13, 13), (12, 12), (11, 11), (10, 10), (7, 7)]:\n    PREM[(_r, _c)] = 'DW'\nfor _r, _c in [(1, 5), (1, 9), (5, 1), (5, 5), (5, 9), (5, 13), (9, 1), (9, 5), (9, 9), (9, 13), (13, 5), (13, 9)]:\n    PREM[(_r, _c)] = 'TL'\nfor _r, _c in [(0, 3), (0, 11), (2, 6), (2, 8), (3, 0), (3, 7), (3, 14), (6, 2), (6, 6), (6, 8), (6, 12), (7, 3),\n               (7, 11), (8, 2), (8, 6), (8, 8), (8, 12), (11, 0), (11, 7), (11, 14), (12, 6), (12, 8), (14, 3), (14, 11)]:\n    PREM[(_r, _c)] = 'DL'\nORTH = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n\ndef shuffle(lst, rng):\n    for i in range(len(lst) - 1, 0, -1):\n        j = int(rng.random() * (i + 1))\n        lst[i], lst[j] = lst[j], lst[i]\n\n\ndef rack_value(rack):\n    return sum(VAL[x] for x in rack)\n\n\ndef load_dictionary(path):\n    \"\"\"External list (dict_path, $SCRABBLE_DICT, ~/scrabble_words.txt, ./words.txt, system lists) wins;\n    otherwise the built-in list embedded at the bottom of this block is used.\"\"\"\n    cands = [path] if path else []\n    cands += [os.environ.get('SCRABBLE_DICT', ''), os.path.expanduser('~/scrabble_words.txt'), 'words.txt',\n              '/usr/share/dict/words', '/usr/share/dict/american-english']\n    for p in cands:\n        if p and os.path.isfile(p):\n            try:\n                strict = p.startswith('/usr/share/dict/')\n                words = set()\n                with open(p, encoding='utf-8', errors='ignore') as f:\n                    for line in f:\n                        w = line.strip()\n                        if len(w) >= 2 and w.isalpha() and w.isascii() and (not strict or w.islower()):\n                            words.add(w.upper())\n                if len(words) > 1000:\n                    return words, p\n            except OSError:\n                pass\n    try:\n        raw = zlib.decompress(base64.b64decode(_BUILTIN_WORDS_B64)).decode('ascii')\n        return set(raw.split('\\n')), 'built-in'\n    except Exception:\n        return None, ''\n\n\nclass Game:\n    \"\"\"Pure rules engine (deep-copyable).\"\"\"\n\n    def __init__(self):\n        self.board = [[None] * N for _ in range(N)]\n        self.racks = [[], []]\n        self.bag = []\n        self.scores = [0, 0]\n        self.turn = 0\n        self.scoreless = 0\n        self.over = False\n        self.result = ''\n\n    def deal(self, gid, first):\n        rng = random.Random(gid)\n        bag = [ch for ch, n in sorted(DIST.items()) for _ in range(n)]\n        shuffle(bag, rng)\n        self.bag = bag\n        for s in (0, 1):\n            self.racks[s] = [self.bag.pop(0) for _ in range(7)]\n        self.turn = first\n\n    # ---- geometry ----\n    def cell(self, r, c, new):\n        if not (0 <= r < N and 0 <= c < N):\n            return None\n        if (r, c) in new:\n            return new[(r, c)]\n        return self.board[r][c]\n\n    def word_at(self, r, c, dr, dc, new):\n        while self.cell(r - dr, c - dc, new):\n            r -= dr\n            c -= dc\n        sq = []\n        while self.cell(r, c, new):\n            sq.append((r, c))\n            r += dr\n            c += dc\n        return sq\n\n    def evaluate(self, seat, tiles):\n        \"\"\"tiles: [(r, c, LETTER, is_blank)]. Returns (score, [(word, pts)], bingo) or raises ValueError.\"\"\"\n        if not tiles:\n            raise ValueError('Place at least one tile.')\n        new = {}\n        for r, c, ch, bl in tiles:\n            if not (0 <= r < N and 0 <= c < N):\n                raise ValueError('Tile is off the board.')\n            if self.board[r][c] or (r, c) in new:\n                raise ValueError('That square is already occupied.')\n            if ch not in VAL or ch == '?':\n                raise ValueError('Bad letter.')\n            new[(r, c)] = (ch, bool(bl))\n        rack = list(self.racks[seat])\n        for r, c, ch, bl in tiles:\n            use = '?' if bl else ch\n            if use not in rack:\n                raise ValueError('Tile is not in the rack.')\n            rack.remove(use)\n        rows = {r for r, c in new}\n        cols = {c for r, c in new}\n        if len(rows) > 1 and len(cols) > 1:\n            raise ValueError('Tiles must lie in a single row or column.')\n        horiz = len(rows) == 1\n        if len(new) > 1:\n            r0, r1, c0, c1 = min(rows), max(rows), min(cols), max(cols)\n            if horiz:\n                gap = any(self.cell(r0, c, new) is None for c in range(c0, c1 + 1))\n            else:\n                gap = any(self.cell(r, c0, new) is None for r in range(r0, r1 + 1))\n            if gap:\n                raise ValueError('Tiles must form one continuous line (no gaps).')\n        first = all(self.board[r][c] is None for r in range(N) for c in range(N))\n        if first:\n            if (7, 7) not in new:\n                raise ValueError('The first word must cover the centre star.')\n            if len(new) < 2:\n                raise ValueError('The first word needs at least two tiles.')\n        elif not any(self.cell(r + dr, c + dc, {}) for (r, c) in new for dr, dc in ORTH):\n            raise ValueError('The word must connect to tiles already on the board.')\n        words = []\n        if len(new) > 1:\n            dr, dc = (0, 1) if horiz else (1, 0)\n            r, c = next(iter(new))\n            words.append(self.word_at(r, c, dr, dc, new))\n            for (r, c) in new:\n                w = self.word_at(r, c, dc, dr, new)\n                if len(w) > 1:\n                    words.append(w)\n        else:\n            (r, c), = new\n            for dr, dc in ((0, 1), (1, 0)):\n                w = self.word_at(r, c, dr, dc, new)\n                if len(w) > 1:\n                    words.append(w)\n        if not words:\n            raise ValueError('No word is formed.')\n        total = 0\n        detail = []\n        for sq in words:\n            s, wm, txt = 0, 1, ''\n            for (r, c) in sq:\n                ch, bl = self.cell(r, c, new)\n                txt += ch\n                v = 0 if bl else VAL[ch]\n                if (r, c) in new:\n                    p = PREM.get((r, c))\n                    if p == 'DL':\n                        v *= 2\n                    elif p == 'TL':\n                        v *= 3\n                    elif p == 'DW':\n                        wm *= 2\n                    elif p == 'TW':\n                        wm *= 3\n                s += v\n            s *= wm\n            total += s\n            detail.append((txt, s))\n        bingo = len(new) == 7\n        if bingo:\n            total += 50\n        return total, detail, bingo\n\n    # ---- moves ----\n    def apply_play(self, seat, tiles, clocks=None):\n        score, detail, bingo = self.evaluate(seat, tiles)\n        rack = self.racks[seat]\n        for r, c, ch, bl in tiles:\n            self.board[r][c] = (ch, bool(bl))\n            rack.remove('?' if bl else ch)\n        k = min(len(tiles), len(self.bag))\n        rack.extend(self.bag[:k])\n        del self.bag[:k]\n        self.scores[seat] += score\n        self.scoreless = 0\n        if not rack and not self.bag:\n            opp = 1 - seat\n            pen = rack_value(self.racks[opp])\n            self.scores[seat] += pen\n            self.scores[opp] -= pen\n            self.finish('%s went out (+%d from the opponent rack)' % ('Seat %d' % (seat + 1), pen), clocks)\n        else:\n            self.turn = 1 - seat\n        return score, detail, bingo\n\n    def apply_pass(self, seat, clocks=None):\n        self.scoreless += 1\n        self.turn = 1 - seat\n        self.check_scoreless(clocks)\n\n    def apply_exchange(self, seat, letters, seed, clocks=None):\n        if len(self.bag) < 7:\n            raise ValueError('Exchange needs at least 7 tiles left in the bag.')\n        if not letters:\n            raise ValueError('Choose tiles to exchange.')\n        rack = list(self.racks[seat])\n        for ch in letters:\n            if ch not in rack:\n                raise ValueError('Tile is not in the rack.')\n            rack.remove(ch)\n        drawn = self.bag[:len(letters)]\n        del self.bag[:len(letters)]\n        rack.extend(drawn)\n        self.bag.extend(letters)\n        shuffle(self.bag, random.Random(seed))\n        self.racks[seat] = rack\n        self.scoreless += 1\n        self.turn = 1 - seat\n        self.check_scoreless(clocks)\n\n    def check_scoreless(self, clocks=None):\n        if self.scoreless >= 6:\n            for s in (0, 1):\n                self.scores[s] -= rack_value(self.racks[s])\n            self.finish('Six scoreless turns in a row', clocks)\n\n    def apply_resign(self, seat):\n        self.over = True\n        self.result = 'Seat %d resigned - Seat %d wins' % (seat + 1, 2 - seat)\n\n    def finish(self, reason, clocks=None):\n        self.over = True\n        notes = []\n        if clocks:\n            for s in (0, 1):\n                over_s = -clocks[s] / 1000.0\n                if over_s > 0:\n                    mins = int(math.ceil(over_s / 60.0))\n                    self.scores[s] -= 10 * mins\n                    notes.append('Seat %d overtime -%d' % (s + 1, 10 * mins))\n        a, b = self.scores\n        win = 'Draw' if a == b else ('Seat 1 wins' if a > b else 'Seat 2 wins')\n        self.result = '%s. %s (%d : %d)%s' % (reason, win, a, b, (' (' + ', '.join(notes) + ')') if notes else '')\n\n\n# =====================================================================================================\n#                                                GUI\n# =====================================================================================================\ndef draw_tile(p, rect, ch, blank, fill, border, value=True):\n    p.setPen(QtGui.QPen(QtGui.QColor(border), 2))\n    p.setBrush(QtGui.QColor(fill))\n    p.drawRoundedRect(rect, rect.width() * 0.12, rect.width() * 0.12)\n    f = QtGui.QFont('Sans Serif')\n    f.setBold(True)\n    f.setPixelSize(max(8, int(rect.height() * 0.55)))\n    p.setFont(f)\n    p.setPen(QtGui.QColor('#3b2a10' if not blank else '#b3261e'))\n    p.drawText(rect, QtCore.Qt.AlignCenter, ch if ch != '?' else '')\n    if value and not blank and ch != '?':\n        f.setBold(False)\n        f.setPixelSize(max(6, int(rect.height() * 0.22)))\n        p.setFont(f)\n        p.setPen(QtGui.QColor('#3b2a10'))\n        p.drawText(rect.adjusted(0, 0, -rect.width() * 0.08, -rect.height() * 0.04),\n                   QtCore.Qt.AlignRight | QtCore.Qt.AlignBottom, str(VAL[ch]))\n\n\nclass BoardWidget(QtWidgets.QWidget):\n    COL = {'TW': '#d9534f', 'DW': '#f2a7b6', 'TL': '#2f7fc1', 'DL': '#a9d3f2', None: '#d9ead3'}\n\n    def __init__(self, g):\n        super().__init__()\n        self.g = g\n        self.setMinimumSize(480, 480)\n        self.setSizePolicy(QtWidgets.QSizePolicy.Expanding, QtWidgets.QSizePolicy.Expanding)\n\n    def cs(self):\n        return min(self.width(), self.height()) / float(N)\n\n    def paintEvent(self, e):\n        p = QtGui.QPainter(self)\n        p.setRenderHint(QtGui.QPainter.Antialiasing)\n        cs = self.cs()\n        gm = self.g.game\n        p.fillRect(0, 0, int(cs * N) + 1, int(cs * N) + 1, QtGui.QColor('#355e3b'))\n        for r in range(N):\n            for c in range(N):\n                rect = QtCore.QRectF(c * cs + 1, r * cs + 1, cs - 2, cs - 2)\n                cell = gm.board[r][c]\n                st = self.g.stage.get((r, c))\n                if cell:\n                    last = (r, c) in self.g.last_cells\n                    draw_tile(p, rect, cell[0], cell[1], '#ffe9a8' if last else '#f1d9a0',\n                              '#e0a100' if last else '#8a6d2f')\n                elif st:\n                    draw_tile(p, rect, st[1], st[2], '#fff6cf', '#2e7d32')\n                else:\n                    pm = PREM.get((r, c))\n                    p.setPen(QtCore.Qt.NoPen)\n                    p.setBrush(QtGui.QColor(self.COL[pm]))\n                    p.drawRoundedRect(rect, 3, 3)\n                    f = QtGui.QFont('Sans Serif')\n                    f.setPixelSize(max(7, int(cs * 0.3)))\n                    f.setBold(True)\n                    p.setFont(f)\n                    p.setPen(QtGui.QColor('#ffffff' if pm in ('TW', 'TL') else '#444444'))\n                    lab = '\\u2605' if (r, c) == (7, 7) else (pm or '')\n                    p.drawText(rect, QtCore.Qt.AlignCenter, lab)\n\n    def mousePressEvent(self, e):\n        cs = self.cs()\n        r, c = int(e.y() // cs), int(e.x() // cs)\n        if 0 <= r < N and 0 <= c < N:\n            self.g.on_board_click(r, c)\n\n\nclass RackWidget(QtWidgets.QWidget):\n    def __init__(self, g):\n        super().__init__()\n        self.g = g\n        self.setMinimumHeight(64)\n        self.setMaximumHeight(90)\n\n    def tile_rect(self, i):\n        s = min(self.height(), self.width() / 7.5)\n        return QtCore.QRectF(4 + i * (s + 4), 3, s, s)\n\n    def paintEvent(self, e):\n        p = QtGui.QPainter(self)\n        p.setRenderHint(QtGui.QPainter.Antialiasing)\n        used = {v[0] for v in self.g.stage.values()}\n        for i, ch in enumerate(self.g.view_rack()):\n            if i in used:\n                continue\n            sel = (i == self.g.sel)\n            draw_tile(p, self.tile_rect(i).adjusted(0, -2 if sel else 0, 0, -2 if sel else 0), ch, ch == '?',\n                      '#fff6cf' if sel else '#f1d9a0', '#2e7d32' if sel else '#8a6d2f')\n\n    def mousePressEvent(self, e):\n        for i in range(len(self.g.view_rack())):\n            if self.tile_rect(i).contains(e.x(), e.y()):\n                self.g.on_rack_click(i)\n                return\n\n\nclass ScrabbleWindow(QtWidgets.QWidget):\n    def __init__(self, g):\n        super().__init__()\n        self.g = g\n        self.setWindowTitle('Radio Scrabble (%s)' % g.my_addr)\n        self.board = BoardWidget(g)\n        self.rack = RackWidget(g)\n        self.lbl_opp = QtWidgets.QLabel()\n        self.lbl_me = QtWidgets.QLabel()\n        for lb in (self.lbl_opp, self.lbl_me):\n            lb.setStyleSheet('font-size:15px;font-weight:bold;padding:4px;border-radius:4px;background:#2b2b2b;color:#eee')\n        self.status = QtWidgets.QLabel()\n        self.status.setWordWrap(True)\n        self.hist = QtWidgets.QTextBrowser()\n        self.hist.setMaximumHeight(150)\n        self.chat_view = QtWidgets.QTextBrowser()\n        self.chat_input = QtWidgets.QLineEdit()\n        self.chat_input.setPlaceholderText('Chat with opponent (Enter to send)')\n        self.chat_input.setMaxLength(500)\n        self.chat_input.returnPressed.connect(self.on_chat_send)\n        b_send = QtWidgets.QPushButton('Send')\n        b_send.clicked.connect(self.on_chat_send)\n        chat_row = QtWidgets.QHBoxLayout()\n        chat_row.addWidget(self.chat_input, 1)\n        chat_row.addWidget(b_send)\n        self.btn = {}\n        grid = QtWidgets.QGridLayout()\n        for i, (key, text, fn) in enumerate([\n                ('play', 'Play word', g.do_play), ('recall', 'Recall', g.do_recall), ('shuffle', 'Shuffle', g.do_shuffle),\n                ('pass', 'Pass', g.do_pass), ('exch', 'Exchange', g.do_exchange), ('chal', 'Challenge', g.do_challenge),\n                ('resign', 'Resign', g.do_resign), ('new', 'New game', self.on_new)]):\n            b = QtWidgets.QPushButton(text)\n            b.clicked.connect(lambda _=False, f=fn: f())\n            self.btn[key] = b\n            grid.addWidget(b, i // 4, i % 4)\n        self.tc = QtWidgets.QComboBox()\n        for lab, v in (('Untimed', 0), ('25 min', 25), ('15 min', 15), ('10 min', 10)):\n            self.tc.addItem(lab, v)\n        self.sync_combos()\n        self.bag_lbl = QtWidgets.QLabel()\n        side = QtWidgets.QVBoxLayout()\n        side.addWidget(self.lbl_opp)\n        side.addWidget(self.lbl_me)\n        side.addWidget(self.bag_lbl)\n        side.addWidget(self.status)\n        side.addWidget(QtWidgets.QLabel('Moves'))\n        side.addWidget(self.hist)\n        side.addWidget(QtWidgets.QLabel('Your rack'))\n        side.addWidget(self.rack)\n        side.addLayout(grid)\n        trow = QtWidgets.QHBoxLayout()\n        trow.addWidget(QtWidgets.QLabel('Time:'))\n        trow.addWidget(self.tc)\n        trow.addStretch(1)\n        side.addLayout(trow)\n        side.addWidget(self.chat_view, 2)\n        side.addLayout(chat_row)\n        h = QtWidgets.QHBoxLayout(self)\n        h.addWidget(self.board, 3)\n        w = QtWidgets.QWidget()\n        w.setLayout(side)\n        w.setMinimumWidth(380)\n        h.addWidget(w, 2)\n        self.resize(1180, 760)\n\n    def sync_combos(self):\n        i = self.tc.findData(int(self.g.tc))\n        self.tc.setCurrentIndex(i if i >= 0 else 0)\n\n    def on_new(self):\n        self.g.new_game(self.tc.currentData())\n\n    def on_chat_send(self):\n        text = self.chat_input.text()\n        self.chat_input.clear()\n        self.g.send_chat(text)\n\n    def update_chat(self):\n        rows = []\n        for m in self.g.chat_log[-60:]:\n            t = _html.escape(m.get('text', ''))\n            if m['who'] == 'me':\n                rows.append(\"<p style='margin:2px'><b style='color:#81c784'>You:</b> %s <i style='color:#888'>%s</i></p>\"\n                            % (t, _html.escape(m.get('status', ''))))\n            elif m['who'] == 'peer':\n                rows.append(\"<p style='margin:2px'><b style='color:#64b5f6'>%s:</b> %s</p>\"\n                            % (_html.escape(m.get('tag', 'Opponent')), t))\n            else:\n                rows.append(\"<p style='margin:2px;color:#888'><i>%s</i></p>\" % t)\n        self.chat_view.setHtml(''.join(rows))\n        sb = self.chat_view.verticalScrollBar()\n        sb.setValue(sb.maximum())\n\n    def fmt_clock(self, ms):\n        s = int(abs(ms) / 1000)\n        return '%s%d:%02d' % ('-' if ms < 0 else '', s // 60, s % 60)\n\n    def update_clocks(self):\n        g = self.g\n        for seat, lb in ((1 - g.view_seat(), self.lbl_opp), (g.view_seat(), self.lbl_me)):\n            txt = '%s   %d pts' % (g.seat_name(seat), g.game.scores[seat])\n            if g.timed:\n                txt += '   \\u23f1 ' + self.fmt_clock(g.clocks[seat])\n            lb.setText(txt)\n            on = (not g.game.over) and g.game.turn == seat\n            lb.setStyleSheet('font-size:15px;font-weight:bold;padding:4px;border-radius:4px;'\n                             'background:%s;color:%s' % ('#2e7d32' if on else '#2b2b2b', '#fff' if on else '#eee'))\n\n    def refresh(self):\n        g = self.g\n        self.board.update()\n        self.rack.update()\n        self.update_clocks()\n        self.bag_lbl.setText('Tiles in bag: %d    Opponent rack: %d tiles' %\n                             (len(g.game.bag), len(g.game.racks[1 - g.view_seat()])))\n        self.status.setText(g.status_text())\n        self.hist.setHtml('<br>'.join(_html.escape(x) for x in g.hist[-40:]))\n        sb = self.hist.verticalScrollBar()\n        sb.setValue(sb.maximum())\n        mine = g.can_act_now()\n        over = g.game.over\n        for k in ('play', 'recall', 'shuffle', 'pass', 'exch'):\n            self.btn[k].setEnabled(mine if k != 'recall' and k != 'shuffle' else not over)\n        self.btn['chal'].setEnabled(g.can_challenge())\n        self.btn['resign'].setEnabled(not over)\n\n\nclass blk(gr.basic_block):\n    def __init__(self, my_addr='A', peer_addr='B', time_control='25', dict_path='', show_gui=True, echo_test=True):\n        gr.basic_block.__init__(self, name='Scrabble GUI', in_sig=None, out_sig=None)\n        self.my_addr = str(my_addr)\n        self.peer_addr = str(peer_addr)\n        self.show_gui = show_gui\n        self.echo_test = bool(echo_test)\n        self.my_seat = 0 if self.my_addr <= self.peer_addr else 1\n        self.message_port_register_in(pmt.intern('event_in'))\n        self.set_msg_handler(pmt.intern('event_in'), self.handle_event)\n        self.message_port_register_out(pmt.intern('command_out'))\n        self.message_port_register_in(pmt.intern('chat_in'))\n        self.set_msg_handler(pmt.intern('chat_in'), self.handle_chat_event)\n        self.message_port_register_out(pmt.intern('chat_out'))\n        self.events = []\n        self.chat_events = []\n        self.chat_log = []\n        self.chat_queue = []\n        self.chat_busy = False\n        self.chat_pending = {}\n        self.chat_id = 0\n        try:\n            tc = float(str(time_control).split('+')[0])\n        except Exception:\n            tc = 25.0\n        if tc < 0:\n            tc = 0.0\n        self.words, self.dict_file = load_dictionary(str(dict_path).strip())\n        self.window = None\n        self.pending_new = None\n        self.pending_move = None\n        gid0 = zlib.crc32('|'.join(sorted([self.my_addr, self.peer_addr])).encode()) % 1000000000\n        self.start_game(gid0, 0, tc)\n        if self.show_gui:\n            self.app = QtWidgets.QApplication.instance() or QtWidgets.QApplication([])\n            self.window = ScrabbleWindow(self)\n            self.window.show()\n            self.window.refresh()\n            self.timer = QtCore.QTimer()\n            self.timer.timeout.connect(self.on_tick)\n            self.timer.start(100)\n\n    # ---------------- helpers ----------------\n    def seat_name(self, seat):\n        if self.echo_test:\n            return 'Player %d' % (seat + 1)\n        return 'You' if seat == self.my_seat else 'Opponent'\n\n    def view_seat(self):\n        return self.game.turn if self.echo_test else self.my_seat\n\n    def view_rack(self):\n        return self.game.racks[self.view_seat()]\n\n    def can_act_now(self):\n        g = self.game\n        return (not g.over) and (self.echo_test or g.turn == self.my_seat)\n\n    def can_challenge(self):\n        if not self.log or self.log[-1].get('k') != 'play' or self.last_play is None or self.snap is None:\n            return False\n        ch = 1 - self.last_play['seat']\n        return self.echo_test or ch == self.my_seat\n\n    def start_game(self, gid, first, tc):\n        self.game = Game()\n        self.game.deal(gid, int(first) & 1)\n        self.gid = gid\n        self.tc = tc\n        self.timed = tc > 0\n        self.clocks = [tc * 60000.0, tc * 60000.0]\n        self.log = []\n        self.hist = []\n        self.snap = None\n        self.last_play = None\n        self.last_cells = set()\n        self.stage = {}\n        self.sel = None\n        self.note = ''\n        self.pending_new = None\n        self.pending_move = None\n        self.asking = False\n        self.last_tick = time.monotonic()\n        if self.window:\n            self.window.sync_combos()\n            self.window.refresh()\n\n    def new_game(self, tc):\n        gid = random.randrange(1, 1000000000)\n        while gid == self.gid:\n            gid = random.randrange(1, 1000000000)\n        first = random.randint(0, 1)\n        self.start_game(gid, first, float(tc or 0))\n        if not self.echo_test:\n            pk = {'type': 'new_game', 'gid': gid, 'first': first, 'tc': float(tc or 0)}\n            self.pending_new = (pk, time.monotonic())\n            self.send(pk)\n\n    def status_text(self):\n        g = self.game\n        if g.over:\n            return self.res_text()\n        s = '%s to move' % self.seat_name(g.turn)\n        if not self.echo_test:\n            s += '  (your turn)' if g.turn == self.my_seat else '  (waiting for opponent)'\n        if self.can_challenge():\n            s += '\\nYou may CHALLENGE the last play before you move.'\n        if self.timed and len(self.log) < 2:\n            s += '\\nClocks start after the second turn.'\n        if self.words is None:\n            s += '\\n(no word list: challenges are judged by a dialog)'\n        else:\n            s += '\\n(challenges auto-judged: %s word list)' % ('built-in' if self.dict_file == 'built-in' else 'external')\n        if self.note:\n            s += '\\n' + self.note\n        return s\n\n    def res_text(self):\n        t = self.game.result\n        for s in (0, 1):\n            t = t.replace('Seat %d' % (s + 1), self.seat_name(s))\n        return t.replace('You wins', 'You win').replace('You went', 'You went')\n\n    # ---------------- clocks ----------------\n    def tick(self):\n        now = time.monotonic()\n        dt = now - self.last_tick\n        self.last_tick = now\n        if self.timed and not self.game.over and len(self.log) >= 2 and not self.asking:\n            self.clocks[self.game.turn] -= dt * 1000.0\n\n    # ---------------- events (replicated state machine) ----------------\n    def apply_event(self, ev, net=False):\n        g = self.game\n        k = ev.get('k')\n        if g.over and k != 'chal':\n            return False\n        if not self.echo_test:\n            who = int(ev.get('s', g.turn)) if k in ('chal', 'resign') else g.turn\n            if (who == self.my_seat) == net:     # remote events must come from the peer, local ones from me\n                return False\n        self.tick()\n        self.clocks = [float(int(c)) for c in self.clocks]\n        clocks = self.clocks if self.timed else None\n        seq = len(self.log)\n        try:\n            if k == 'play':\n                seat = g.turn\n                tiles = [(int(a), int(b), str(c).upper()[:1], bool(d)) for a, b, c, d in ev['t']]\n                snap = copy.deepcopy(g)\n                score, detail, bingo = g.apply_play(seat, tiles, clocks)\n                self.snap = snap\n                self.last_play = {'seat': seat, 'words': [w for w, _ in detail]}\n                self.last_cells = {(r, c) for r, c, _, _ in tiles}\n                self.hist.append('%s: %s  +%d%s' % (self.seat_name(seat), ', '.join('%s(%d)' % x for x in detail), score,\n                                                    '  BINGO +50' if bingo else ''))\n            elif k == 'pass':\n                seat = g.turn\n                g.apply_pass(seat, clocks)\n                self.hist.append('%s passed' % self.seat_name(seat))\n                self.snap = self.last_play = None\n            elif k == 'exch':\n                seat = g.turn\n                g.apply_exchange(seat, list(ev['l']), self.gid * 1000 + seq, clocks)\n                self.hist.append('%s exchanged %d tile(s)' % (self.seat_name(seat), len(ev['l'])))\n                self.snap = self.last_play = None\n            elif k == 'chal':\n                if not self.log or self.log[-1].get('k') != 'play' or self.snap is None or self.last_play is None:\n                    return False\n                s = int(ev.get('s', g.turn))\n                if s == self.last_play['seat']:\n                    return False\n                words = ', '.join(self.last_play['words'])\n                if ev.get('v'):\n                    if not g.over:\n                        g.scoreless += 1\n                        g.turn = 1 - s\n                        g.check_scoreless(clocks)\n                    self.hist.append('%s challenged %s: VALID, %s loses the turn' % (self.seat_name(s), words, self.seat_name(s)))\n                else:\n                    self.game = g = self.snap\n                    g.scoreless += 1\n                    g.turn = s\n                    g.check_scoreless(clocks)\n                    self.last_cells = set()\n                    self.hist.append('%s challenged %s: INVALID, play removed' % (self.seat_name(s), words))\n                self.snap = self.last_play = None\n            elif k == 'resign':\n                s = int(ev.get('s', g.turn))\n                g.apply_resign(s)\n                self.hist.append('%s resigned' % self.seat_name(s))\n            else:\n                return False\n        except (ValueError, KeyError, TypeError):\n            return False\n        self.log.append(ev)\n        self.stage = {}\n        self.sel = None\n        self.note = ''\n        if self.game.over:\n            self.hist.append(self.res_text())\n        return True\n\n    def act(self, ev):\n        \"\"\"Local action: apply, then radio-sync.\"\"\"\n        if not self.apply_event(ev):\n            return False\n        if not self.echo_test:\n            self.send_events()\n        if self.window:\n            self.window.refresh()\n        return True\n\n    def send_events(self):\n        n = len(self.log)\n        start = max(0, n - 6)\n        pk = {'type': 'move', 'gid': self.gid, 'start': start, 'events': self.log[start:],\n              'clk': [int(c) for c in self.clocks]}\n        self.pending_move = (pk, n, time.monotonic())\n        self.send(dict(pk))\n\n    # ---------------- GUI actions ----------------\n    def on_rack_click(self, i):\n        if self.game.over:\n            return\n        used = {v[0] for v in self.stage.values()}\n        if i in used:\n            return\n        self.sel = None if self.sel == i else i\n        self.window.refresh()\n\n    def on_board_click(self, r, c):\n        if not self.can_act_now():\n            return\n        if (r, c) in self.stage:\n            del self.stage[(r, c)]\n        elif self.game.board[r][c] is None and self.sel is not None:\n            ch = self.view_rack()[self.sel]\n            blank = False\n            if ch == '?':\n                letters = [chr(65 + i) for i in range(26)]\n                self.asking = True\n                try:\n                    pick, ok = QtWidgets.QInputDialog.getItem(self.window, 'Blank tile', 'Letter for the blank:',\n                                                               letters, 0, False)\n                finally:\n                    self.asking = False\n                    self.last_tick = time.monotonic()\n                if not ok:\n                    return\n                ch, blank = pick, True\n            self.stage[(r, c)] = (self.sel, ch, blank)\n            self.sel = None\n        self.note = self.preview()\n        self.window.refresh()\n\n    def preview(self):\n        if not self.stage:\n            return ''\n        try:\n            tiles = [(r, c, v[1], v[2]) for (r, c), v in self.stage.items()]\n            sc, det, bingo = self.game.evaluate(self.view_seat(), tiles)\n            return 'Preview: %s = %d points' % (', '.join(w for w, _ in det), sc)\n        except ValueError as e:\n            return str(e)\n\n    def do_play(self):\n        if not self.can_act_now():\n            return\n        tiles = [[r, c, v[1], int(v[2])] for (r, c), v in sorted(self.stage.items())]\n        try:\n            self.game.evaluate(self.view_seat(), [(a, b, c, bool(d)) for a, b, c, d in tiles])\n        except ValueError as e:\n            self.note = str(e)\n            self.window.refresh()\n            return\n        self.act({'k': 'play', 't': tiles})\n\n    def do_recall(self):\n        self.stage = {}\n        self.sel = None\n        self.note = ''\n        self.window.refresh()\n\n    def do_shuffle(self):\n        if self.stage:\n            return\n        rack = self.view_rack()\n        random.shuffle(rack)\n        self.sel = None\n        self.window.refresh()\n\n    def do_pass(self):\n        if self.can_act_now() and self.ask_user('Pass your turn?'):\n            self.act({'k': 'pass'})\n\n    def do_exchange(self):\n        if not self.can_act_now():\n            return\n        if len(self.game.bag) < 7:\n            self.note = 'Exchange needs at least 7 tiles in the bag.'\n            self.window.refresh()\n            return\n        rack = list(self.view_rack())\n        dlg = QtWidgets.QDialog(self.window)\n        dlg.setWindowTitle('Exchange tiles')\n        v = QtWidgets.QVBoxLayout(dlg)\n        v.addWidget(QtWidgets.QLabel('Tick the tiles to exchange:'))\n        row = QtWidgets.QHBoxLayout()\n        boxes = []\n        for ch in rack:\n            b = QtWidgets.QPushButton('?' if ch == '?' else ch)\n            b.setCheckable(True)\n            b.setMinimumSize(44, 44)\n            boxes.append(b)\n            row.addWidget(b)\n        v.addLayout(row)\n        bb = QtWidgets.QDialogButtonBox(QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel)\n        bb.accepted.connect(dlg.accept)\n        bb.rejected.connect(dlg.reject)\n        v.addWidget(bb)\n        self.asking = True\n        try:\n            ok = dlg.exec_()\n        finally:\n            self.asking = False\n            self.last_tick = time.monotonic()\n        if ok:\n            letters = [ch for ch, b in zip(rack, boxes) if b.isChecked()]\n            if letters:\n                self.act({'k': 'exch', 'l': letters})\n\n    def do_challenge(self):\n        if not self.can_challenge():\n            return\n        s = 1 - self.last_play['seat']\n        words = self.last_play['words']\n        if self.words is not None:\n            valid = all(w in self.words for w in words)\n        else:\n            valid = self.ask_user('Words formed: %s\\n\\nAre ALL of them valid in your agreed dictionary?\\n'\n                                  'Yes = valid (you lose your turn)\\nNo = invalid (the play is removed)'\n                                  % ', '.join(words))\n        self.act({'k': 'chal', 's': s, 'v': bool(valid)})\n\n    def do_resign(self):\n        if self.game.over:\n            return\n        s = self.game.turn if self.echo_test else self.my_seat\n        if self.ask_user('Resign this game?'):\n            self.act({'k': 'resign', 's': s})\n\n    def ask_user(self, text):\n        self.asking = True\n        try:\n            box = QtWidgets.QMessageBox\n            return box.question(self.window, 'Radio Scrabble', text, box.Yes | box.No, box.No) == box.Yes\n        finally:\n            self.asking = False\n            self.last_tick = time.monotonic()\n\n    # ---------------- radio side ----------------\n    def send(self, d):\n        d['chess'] = 1          # wire tag kept so the existing encrypted link block forwards it unchanged\n        d['game'] = 'scrabble'\n        d['src'] = self.my_addr\n        d['dst'] = self.peer_addr\n        raw = json.dumps(d, separators=(',', ':')).encode('utf-8')\n        try:\n            self.message_port_pub(pmt.intern('command_out'),\n                                  pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n        except Exception:\n            pass\n\n    @staticmethod\n    def _bytes(msg):\n        if pmt.is_pair(msg) and pmt.is_u8vector(pmt.cdr(msg)):\n            return bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n        return None\n\n    def handle_event(self, msg):\n        raw = self._bytes(msg)\n        if raw is None:\n            return\n        try:\n            ev = json.loads(raw.decode('utf-8'))\n            if ev.get('direction') == 'peer_move':\n                self.events.append(ev.get('data', {}))\n        except ValueError:\n            pass\n\n    def on_packet(self, pk):\n        if not isinstance(pk, dict) or pk.get('chess') != 1 or pk.get('game') != 'scrabble':\n            return\n        if (self.echo_test and pk.get('type') == 'chat' and pk.get('src') == self.my_addr\n                and pk.get('dst') == self.peer_addr):\n            self.on_loopback_chat(pk)\n            return\n        if pk.get('src') == self.my_addr or pk.get('dst') != self.my_addr:\n            return\n        t = pk.get('type')\n        if t == 'new_game':\n            gid = pk.get('gid')\n            if gid != self.gid:\n                self.start_game(gid, int(pk.get('first', 0)), float(pk.get('tc', 0)))\n            self.send({'type': 'ack_new', 'gid': gid})\n        elif t == 'ack_new':\n            if self.pending_new and self.pending_new[0]['gid'] == pk.get('gid'):\n                self.pending_new = None\n        elif t == 'ack_move':\n            if self.pending_move and pk.get('gid') == self.gid and pk.get('n', 0) >= self.pending_move[1]:\n                self.pending_move = None\n        elif t == 'move':\n            if pk.get('gid') != self.gid:\n                return\n            start = int(pk.get('start', 0))\n            evs = pk.get('events', [])\n            n = len(self.log)\n            if start <= n < start + len(evs) and self.log[start:n] == evs[:n - start]:\n                clk = pk.get('clk')\n                if clk and len(clk) == 2:\n                    self.clocks = [float(clk[0]), float(clk[1])]\n                    self.last_tick = time.monotonic()\n                for e in evs[n - start:]:\n                    if not self.apply_event(e, net=True):\n                        break\n                if self.window:\n                    self.window.refresh()\n            self.send({'type': 'ack_move', 'gid': self.gid, 'n': len(self.log)})\n\n    # ---------------- text chat (via Transfer Protocol) ----------------\n    def handle_chat_event(self, msg):\n        raw = self._bytes(msg)\n        if raw is None:\n            return\n        try:\n            ev = json.loads(raw.decode('utf-8'))\n            if isinstance(ev, dict):\n                self.chat_events.append(ev)\n        except ValueError:\n            pass\n\n    def send_chat(self, text):\n        text = text.strip()[:500]\n        if not text:\n            return\n        entry = {'who': 'me', 'text': text, 'status': 'queued'}\n        self.chat_log.append(entry)\n        if self.echo_test:\n            self.chat_id += 1\n            entry['status'] = 'sending over radio loopback...'\n            self.chat_pending[self.chat_id] = (entry, time.monotonic())\n            self.send({'type': 'chat', 'id': self.chat_id, 'text': text})\n        else:\n            self.chat_queue.append(entry)\n            self.pump_chat()\n        self.refresh_chat()\n\n    def pump_chat(self):\n        if self.chat_busy or not self.chat_queue:\n            return\n        entry = self.chat_queue[0]\n        entry['status'] = 'sending...'\n        self.chat_busy = True\n        raw = json.dumps({'cmd': 'send', 'kind': 'text', 'value': entry['text']}).encode('utf-8')\n        try:\n            self.message_port_pub(pmt.intern('chat_out'),\n                                  pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(raw), list(raw))))\n        except Exception:\n            pass\n\n    def on_loopback_chat(self, pk):\n        got = self.chat_pending.pop(pk.get('id'), None)\n        if got is None:\n            return\n        entry, t0 = got\n        entry['status'] = 'delivered \\u2713 via radio loopback, %.1f s' % (time.monotonic() - t0)\n        self.chat_log.append({'who': 'peer', 'text': str(pk.get('text', '')), 'status': '',\n                              'tag': 'Opponent (loopback echo)'})\n        self.refresh_chat()\n\n    def on_chat_event(self, e):\n        d = e.get('direction')\n        st = str(e.get('state', ''))\n        kind = e.get('kind')\n        active = st.startswith(('Sending', 'Receiving', 'Waiting', 'Retry'))\n        if d == 'rx':\n            if st.startswith('Complete'):\n                if kind == 'text':\n                    self.chat_log.append({'who': 'peer', 'text': str(e.get('text', '')), 'status': ''})\n                else:\n                    self.chat_log.append({'who': 'sys', 'text': '[peer sent %s: saved to receive folder]' % kind,\n                                          'status': ''})\n        elif d in ('tx', 'notice'):\n            if d == 'tx' and (kind not in (None, 'text') or active):\n                return\n            if self.chat_busy and self.chat_queue:\n                entry = self.chat_queue.pop(0)\n                entry['status'] = ('delivered \\u2713' if (d == 'tx' and st.startswith('Complete'))\n                                   else 'failed: ' + st)\n                self.chat_busy = False\n                self.pump_chat()\n        self.refresh_chat()\n\n    def refresh_chat(self):\n        if self.window:\n            self.window.update_chat()\n\n    def on_tick(self):\n        while self.events and not self.asking:\n            self.on_packet(self.events.pop(0))\n        while self.chat_events:\n            self.on_chat_event(self.chat_events.pop(0))\n        self.tick()\n        now = time.monotonic()\n        if self.pending_new and now - self.pending_new[1] > 2.0:\n            self.pending_new = (self.pending_new[0], now)\n            self.send(dict(self.pending_new[0]))\n        if self.pending_move and now - self.pending_move[2] > 3.0:\n            pk, n, _ = self.pending_move\n            self.pending_move = (pk, n, now)\n            self.send(dict(pk))\n        for cid, (ent, t0) in list(self.chat_pending.items()):\n            if now - t0 > 10.0:\n                ent['status'] = 'no echo after 10 s: is the radio chain connected?'\n                del self.chat_pending[cid]\n                self.refresh_chat()\n        if self.window:\n            self.window.update_clocks()\n            self.window.status.setText(self.status_text())\n\n\n# Built-in word list: Collins Scrabble Words 2019 (279496 words, compressed). Used when no external list is found.\n_BUILTIN_WORDS_B64 = (\n    'eNpkvWuWqzzPtfv/6xUVvBI/BTgvh6xF+t+QjTXnlMS9x6hCl2T5iDHm5AzD/xuGV/8vY9/W5dnFdm2m/l8rtmbom3X8DOuvA0x/'\n    '2/RH8Clme/ZE1xAm94pt97D/T3uWyeEy/Vx/Q/9/2AbYfS9RbftrW1j2stZezo51yTSd4LZKIsYhUQz+7H37O2BrpqktRdIM8xvb'\n    'shYHBphYRmwLpTVhh7ZIKqgTSmZcgjbHNciNKcm5LHtm93H4O6wlMwNMvOsDrWTaVrAdKVC0rSgPEF1XCqoQL2yZwsuTeCmcJd9e'\n    'U9lo8tRfkXodKKgylu3rffiZrKA7tyOE0tmjlDtKubOUO0qxMznrdyZoR+dQ39gVH