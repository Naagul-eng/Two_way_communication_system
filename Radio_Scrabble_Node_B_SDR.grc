    alias: ''
    author: naagul
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: Radio Scrabble + encrypted text chat over QPSK/FEC/CRC/ACK link. Node B (B1) - run on laptop/SDR 2
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
