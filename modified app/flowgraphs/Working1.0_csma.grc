      \              '        for j in np.flatnonzero(score[lo:hi+1]>self.threshold)+lo:\\n'\n              '  \
      \          if score[j]<max(score[j-2:j]) or score[j]<=max(score[j+1:j+3]):continue\\n'\n              '  \
      \          absolute=base+int(j)\\n'\n              '            if absolute-self.last_position<512:continue\\\
      n'\n              '            offset=absolute+self.delay\\n'\n              '            if offset<self.nitems_written(0):continue\\\
      n'\n              '            '\n              \"self.add_item_tag(0,offset,pmt.intern('corr_est'),pmt.from_double(float(score[j])))\\\
      n\"\n              '            self.last_position=absolute;self.count+=1\\n'\n              '        if hi>=lo:self.next_position=base+hi+1\\\
      n'\n              '        return n\\n'\n              '\\n'\n              '\\n'\n              'class NLMS(gr.decim_block):\\\
