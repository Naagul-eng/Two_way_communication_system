      \ import gr\\n'\n              '\\n'\n              '\\n'\n              'def training_bytes(length=2048):\\\
      n'\n              \"    return b''.join(hashlib.sha256(b'QPSK-training-v1'+i.to_bytes(4,'big')).digest()\\\
