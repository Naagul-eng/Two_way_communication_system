      \ import Fernet\\n'\n             'from .reedsolo_bundled import RSCodec\\n'\n             '\\n'\n       \
      \      'TEXT, ACK = 1, 2\\n'\n             'BROADCAST = 0xFFFF\\n'\n             \"HEADER = struct.Struct('!HHIBBH')\\\
      n\"\n             \"ROUTE = struct.Struct('!HHIBB')\\n\"\n             \"FRAGMENT = struct.Struct('!16sHHH')\\\
      n\"\n             '\\n'\n             '\\n'\n             'class Codec:\\n'\n             '    def __init__(self,\
      \ key):\\n'\n             '        self.cipher = Fernet(key.encode() if isinstance(key, str) else key)\\n'\n\
      \             '        self.rs = RSCodec(16, nsize=255, fcr=0, prim=0x11d, generator=2, c_exp=8)\\n'\n   \
