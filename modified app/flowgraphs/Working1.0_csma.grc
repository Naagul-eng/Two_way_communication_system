      n'\n\nclass _EmbeddedRadioLoader(_abc.MetaPathFinder, _abc.Loader):\n    def find_spec(self, fullname, path=None,\
      \ target=None):\n        prefix = '_pixel_pulse_radio.'\n        if fullname.startswith(prefix) and fullname[len(prefix):]\
      \ in _RADIO_SOURCES:\n            return _util.spec_from_loader(fullname, self)\n        return None\n\n \
      \   def create_module(self, spec):\n        return None\n\n    def exec_module(self, module):\n        name\
      \ = module.__name__.split('.')[-1]\n        module.__file__ = '<Pixel Pulse GRC>/' + name + '.py'\n      \
      \  exec(compile(_RADIO_SOURCES[name], module.__file__, 'exec'), module.__dict__)\n\nif '_pixel_pulse_radio'\
      \ not in _sys.modules:\n    _package = _types.ModuleType('_pixel_pulse_radio')\n    _package.__path__ = []\n\
      \    _package.__package__ = '_pixel_pulse_radio'\n    _sys.modules['_pixel_pulse_radio'] = _package\n    _sys.meta_path.insert(0,\
      \ _EmbeddedRadioLoader())\n\nfrom _pixel_pulse_radio.radio_blocks import MacBridge\nclass blk(MacBridge):\n\
      \    def __init__(self, config_path=\"configs/node_a.json\"):\n        super().__init__(config_path)\n"
    affinity: ''
    alias: ''
    comment: ''
    config_path: os.environ.get("SDRCHAT_CONFIG", "configs/node_a.json")
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('CSMA/CA + app bridge', 'MacBridge', [('config_path', "'configs/node_a.json'")], [('0', 'complex',
      1), ('rx_in', 'message', 1)], [('tx_out', 'message', 1)], 'Raw RX energy observer + PDU socket/MAC service.
      No stream output.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 400
    - 528.0
    rotation: 0
    state: enabled
- name: epy_nlms
  id: epy_block
  parameters:
    _source_code: "# Pixel Pulse: all project radio modules are embedded below.\n# No sdrchat checkout or separately\
      \ supplied Python blocks are required.\nimport importlib.abc as _abc\nimport importlib.util as _util\nimport\
      \ sys as _sys\nimport types as _types\n\n_RADIO_SOURCES = {'config': 'import json\\n'\n           'from pathlib\
      \ import Path\\n'\n           '\\n'\n           '\\n'\n           'def load(path):\\n'\n           '    path\
      \ = Path(path).resolve()\\n'\n           '    c = json.loads(path.read_text())\\n'\n           \"    if not\
      \ 1 <= c['address'] <= 65534:\\n\"\n           \"        raise ValueError('Node address must be 0x0001..0xFFFE')\\\
      n\"\n           \"    c['state_dir'] = str((path.parent / c['state_dir']).resolve())\\n\"\n           \" \
      \   c['config_path'] = str(path)\\n\"\n           \"    Path(c['state_dir']).mkdir(parents=True, exist_ok=True)\\\
      n\"\n           '    return c\\n'\n           '\\n'\n           '\\n'\n           'def addr(value):\\n'\n\
      \           \"    return f'0x{int(value):04X}'\\n\"\n           '\\n'\n           '\\n'\n           \"_DEFAULT_CONFIG\
      \ = {'address': 16170, 'name': 'User 1', 'frequency': 2426500000, 'uri': \"\n           \"'ip:192.168.1.10',\
      \ 'commands_port': 5555, 'events_port': 5556, 'shared_key': \"\n           \"'u362K7J0T2sA_vB1C2D3E4F5G6H7I8J9K0L1M2N3O4P=',\
      \ 'state_dir': './data/node_a', 'sample_rate': \"\n           \"2400000, 'cs_threshold_db': -35.0, 'cs_hysteresis_db':\
      \ 3.0, 'difs_s': 0.02, 'slot_s': 0.015, \"\n           \"'ack_timeout_s': 1.0, 'retry_limit': 20, 'cw_min':\
      \ [8, 16, 32], 'cw_max': 1024, 'aging_s': 30.0, \"\n           \"'tx_delay_s': 0.02, 'tx_guard_s': 0.01, 'tx_attenuation_db':\
      \ 0.0, 'rx_gain_db': 45, 'nlms_taps': \"\n           \"7, 'nlms_mu': 0.2, 'nlms_dd_mu': 0.02, 'nlms_eps':\
      \ 1e-06, 'correlation_threshold': 0.6, \"\n           \"'contacts': [], 'local_radio_configured': True}\\\
      n\"\n           '_original_load = load\\n'\n           '\\n'\n           'def load(path):\\n'\n          \
      \ '    import os\\n'\n           '    path = Path(path)\\n'\n           '    if path.exists():\\n'\n     \
      \      '        return _original_load(path)\\n'\n           \"    if os.environ.get('SDRCHAT_CONFIG') or str(path)\
      \ != 'configs/node_a.json':\\n\"\n           \"        raise FileNotFoundError('Node configuration does not\
      \ exist: ' + str(path))\\n\"\n           '    c = dict(_DEFAULT_CONFIG)\\n'\n           \"    c['state_dir']\
      \ = str(Path(c['state_dir']).resolve())\\n\"\n           \"    Path(c['state_dir']).mkdir(parents=True, exist_ok=True)\\\
      n\"\n           '    return c\\n',\n 'engine': '\"\"\"Durable, single-flight ARQ with CSMA/CA. Owned by the\
      \ radio process.\"\"\"\\n'\n           'import hashlib\\n'\n           'import json\\n'\n           'import\
      \ random\\n'\n           'import sqlite3\\n'\n           'import time\\n'\n           'import uuid\\n'\n \
      \          'from collections import deque\\n'\n           'from pathlib import Path\\n'\n           'from\
      \ cryptography.fernet import InvalidToken\\n'\n           'from .protocol import Codec, TEXT, ACK, BROADCAST,\
      \ make_fragment, parse_fragment\\n'\n           '\\n'\n           '\\n'\n           'class Engine:\\n'\n \
      \          '    def __init__(self, config, transmit, event, clock=time.monotonic, rng=None):\\n'\n       \
      \    \"        self.c=config; self.me=config['address']; self.transmit=transmit; self.event=event\\n\"\n \
      \          '        self.clock=clock; self.rng=rng or random.SystemRandom(); '\n           \"self.codec=Codec(config['shared_key'])\\\
      n\"\n           \"        self.db=sqlite3.connect(str(Path(config['state_dir'])/'radio.sqlite'))\\n\"\n  \
      \         \"        self.db.execute('PRAGMA journal_mode=WAL'); self.db.execute('PRAGMA synchronous=FULL')\\\
      n\"\n           \"        self.db.executescript('''\\n\"\n           '        CREATE TABLE IF NOT EXISTS jobs(id\
      \ TEXT PRIMARY KEY,dst INTEGER,priority INTEGER,kind '\n           'TEXT,name TEXT,data BLOB,created REAL,status\
      \ TEXT,part INTEGER DEFAULT 0);\\n'\n           '        CREATE TABLE IF NOT EXISTS fragments(src INTEGER,id\
      \ TEXT,part INTEGER,total INTEGER,meta '\n           'TEXT,data BLOB,PRIMARY KEY(src,id,part));\\n'\n    \
      \       '        CREATE TABLE IF NOT EXISTS receipts(src INTEGER,seq INTEGER,digest TEXT,PRIMARY '\n     \
      \      'KEY(src,seq));\\n'\n           '        CREATE TABLE IF NOT EXISTS received(src INTEGER,id TEXT,kind\
      \ TEXT,name TEXT,data '\n           'BLOB,PRIMARY KEY(src,id));\\n'\n           '        CREATE TABLE IF NOT\
      \ EXISTS settings(key TEXT PRIMARY KEY,value INTEGER);\\n'\n           \"        ''')\\n\"\n           ' \
      \       self.db.execute(\"INSERT OR IGNORE INTO settings '\n           'VALUES(\\'sequence\\',?)\",(self.rng.randrange(1,2**30),))\\\
      n'\n           '        self.db.execute(\"UPDATE jobs SET status=\\'queued\\' WHERE status IN '\n        \
