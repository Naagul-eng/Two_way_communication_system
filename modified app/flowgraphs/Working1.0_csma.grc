      \              '        return n\\n'\n              '\\n'\n              '\\n'\n              \"_NATIVE_SOURCE\
      \ = '// Batched regularized complex NLMS. y = w^H x, e = d-y.\\\\n#include \"\n              '<complex>\\\\\
      n#include <cmath>\\\\n#include <algorithm>\\\\nusing C = std::complex<float>;\\\\nextern '\n             \
      \ '\"C\" void nlms_process(const C* input, C* output, int n, int '\n              'taps,\\\\n            \
