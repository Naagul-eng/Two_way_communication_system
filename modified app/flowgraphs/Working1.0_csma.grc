      \              '\\n'\n              'def training_symbols():\\n'\n              '    # Last 64 bytes of the\
      \ EXISTING deterministic prefix. Constant differential\\n'\n              '    # phase before this segment\
      \ is absorbed by training; no change to TX bytes.\\n'\n              '    bits=np.unpackbits(np.frombuffer(training_bytes()[-64:],dtype=np.uint8)).reshape(-1,2)\\\
      n'\n              '    chunks=bits[:,0]*2+bits[:,1]\\n'\n              '    mapped=np.array([0,1,3,2])[chunks]\\\
