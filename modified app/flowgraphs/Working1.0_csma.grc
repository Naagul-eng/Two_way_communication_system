      \              '    def __init__(self, threshold=.6):\\n'\n              \"        gr.sync_block.__init__(self,name='QPSK\
      \ training \"\n              \"correlator',in_sig=[np.complex64],out_sig=[np.complex64])\\n\"\n          \
      \    '        symbols=training_symbols()[:64]\\n'\n              '        t=np.arange(-8,9)/2.;a=.35\\n'\n\
      \              '        pulse=np.sinc(t)*np.cos(np.pi*a*t)/(1-(2*a*t)**2)\\n'\n              '        '\n\
      \              'self.ref=np.convolve(np.kron(symbols,[1,0]),pulse)[8:8+2*len(symbols)-1].astype(np.complex64)\\\
      n'\n              '        self.energy=float(np.vdot(self.ref,self.ref).real);self.threshold=threshold\\n'\n\
      \              '        self.delay=(len(self.ref)+9)//2*2\\n'\n              '        self.set_history(self.delay+1);self.set_tag_propagation_policy(gr.TPP_DONT)\\\
