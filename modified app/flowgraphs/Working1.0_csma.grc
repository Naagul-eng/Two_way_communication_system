      \ QPSK \"\n              \"NLMS',in_sig=[np.complex64],out_sig=[np.complex64],decim=2)\\n\"\n            \
      \  '        if taps<3 or taps%2!=1 or not 0<mu<2 or not 0<dd_mu<2 or eps<=0:raise '\n              \"ValueError('Invalid\
