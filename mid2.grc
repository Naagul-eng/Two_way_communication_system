    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ json\nfrom cryptography.fernet import Fernet\n\nclass mac_arq_sink(gr.basic_block):\n\
      \    \"\"\"\n    MAC ARQ Sink: Address Filtering, Decryption, RX Logging,\n\
      \    and RF ACK Response Generation.\n    \"\"\"\n    def __init__(self, rx_file=\"\
      /tmp/nodeA_rx.json\", my_addr=\"A1\", shared_key=\"Q0ZfOGE3UFRidWk1N3FYYXpWbDV5UTlwMldHNUFZN00=\"\
      ):\n        gr.basic_block.__init__(\n            self,\n            name=\"\
      MAC ARQ Sink\",\n            in_sig=None,\n            out_sig=None\n      \
      \  )\n        \n        # Message Ports\n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.message_port_register_out(pmt.intern(\"local_ack\"))\n\
      \        self.message_port_register_out(pmt.intern(\"ack_out\"))\n        self.set_msg_handler(pmt.intern(\"\
      in\"), self.handle_msg)\n\n        # Config Params\n        self.rx_file = rx_file\n\
      \        self.my_addr = my_addr\n        \n        key_bytes = shared_key.encode('utf-8')\
      \ if isinstance(shared_key, str) else shared_key\n        self.cipher = Fernet(key_bytes)\n\
      \n    def handle_msg(self, msg):\n        try:\n            raw_frame = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n\
      \            if len(raw_frame) < 4:\n                return\n\n            src\
      \ = raw_frame[0:2].decode('utf-8', errors='ignore')\n            dest = raw_frame[2:4].decode('utf-8',\
      \ errors='ignore')\n\n            # Drop frame if not addressed to this node\n\
      \            if dest != self.my_addr:\n                return\n\n          \
      \  # Decrypt Payload\n            encrypted_payload = raw_frame[4:]\n      \
      \      decrypted_bytes = self.cipher.decrypt(encrypted_payload)\n          \
      \  payload_dict = json.loads(decrypted_bytes.decode('utf-8'))\n\n          \
      \  pkt_type = payload_dict.get(\"type\", \"DATA\")\n\n            if pkt_type\
      \ == \"ACK\":\n                # Received ACK frame: Route to local MAC ARQ\
      \ Source\n                ack_bytes = json.dumps(payload_dict).encode('utf-8')\n\
      \                pmt_ack = pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(ack_bytes),\
      \ list(ack_bytes)))\n                self.message_port_pub(pmt.intern(\"local_ack\"\
      ), pmt_ack)\n\n            elif pkt_type == \"DATA\":\n                # Received\
      \ DATA frame: Record data & generate return ACK over RF\n                payload_dict[\"\
      src\"] = src\n                self.append_to_rx_file(payload_dict)\n\n     \
      \           # Formulate ACK frame\n                ack_pkt = {\n           \
      \         \"type\": \"ACK\",\n                    \"src\": self.my_addr,\n \
      \                   \"dest\": src,\n                    \"ack_seq\": payload_dict.get(\"\
      seq\", 0)\n                }\n                encrypted_ack = self.cipher.encrypt(json.dumps(ack_pkt).encode('utf-8'))\n\
      \                ack_frame = self.my_addr.encode('utf-8')[:2] + src.encode('utf-8')[:2]\
      \ + encrypted_ack\n\n                # Emit ACK frame to transmitter chain (CRC\
      \ Append)\n                pmt_ack_frame = pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(ack_frame),\
      \ list(ack_frame)))\n                self.message_port_pub(pmt.intern(\"ack_out\"\
      ), pmt_ack_frame)\n\n        except Exception:\n            pass\n\n    def\
      \ append_to_rx_file(self, pkt):\n        try:\n            existing = []\n \
      \           if gr.os.path.exists(self.rx_file):\n                try:\n    \
      \                with open(self.rx_file, 'r') as f:\n                      \
      \  content = f.read().strip()\n                        if content:\n       \
      \                     existing = json.loads(content)\n                     \
      \       if not isinstance(existing, list):\n                               \
      \ existing = [existing]\n                except Exception:\n               \
      \     existing = []\n\n            existing.append(pkt)\n            with open(self.rx_file,\
      \ 'w') as f:\n                json.dump(existing, f, indent=2)\n        except\
      \ Exception:\n            pass\n"
