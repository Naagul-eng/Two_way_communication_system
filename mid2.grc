- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ json\nimport time\nimport threading\nfrom queue import PriorityQueue\nfrom\
      \ cryptography.fernet import Fernet\n\nclass mac_arq_source(gr.basic_block):\n\
      \    \"\"\"\n    MAC ARQ Source: Priority-based frame transmission with AES-Fernet\
      \ Encryption\n    and Stop-and-Wait Retransmission.\n    \"\"\"\n    def __init__(self,\
      \ msg_file=\"/tmp/nodeA_tx.json\", my_addr=\"A1\", shared_key=\"Q0ZfOGE3UFRidWk1N3FYYXpWbDV5UTlwMldHNUFZN00=\"\
      ):\n        gr.basic_block.__init__(\n            self,\n            name=\"\
      MAC ARQ Source\",\n            in_sig=None,\n            out_sig=None\n    \
      \    )\n        \n        # Message Ports\n        self.message_port_register_in(pmt.intern(\"\
      ack_in\"))\n        self.message_port_register_out(pmt.intern(\"out\"))\n  \
      \      self.set_msg_handler(pmt.intern(\"ack_in\"), self.handle_ack)\n\n   \
      \     # Config Params\n        self.msg_file = msg_file\n        self.my_addr\
      \ = my_addr\n        \n        # Ensure Fernet Key is standard bytes\n     \
      \   key_bytes = shared_key.encode('utf-8') if isinstance(shared_key, str) else\
      \ shared_key\n        self.cipher = Fernet(key_bytes)\n\n        # Priority\
      \ Queue: stores tuples (priority_level, counter, packet_dict)\n        self.tx_queue\
      \ = PriorityQueue()\n        self.counter = 0\n        self.current_pkt = None\n\
      \        self.waiting_for_ack = False\n        self.last_tx_time = 0.0\n   \
      \     self.timeout = 2.0  # Retransmission timeout in seconds\n\n        # Start\
      \ Background Thread for Queue Processing & Retransmission\n        self.running\
      \ = True\n        self.worker_thread = threading.Thread(target=self.worker_loop)\n\
      \        self.worker_thread.daemon = True\n        self.worker_thread.start()\n\
      \n    def handle_ack(self, msg):\n        \"\"\" Processes local incoming ACKs\
      \ from MAC ARQ Sink \"\"\"\n        try:\n            raw_payload = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n\
      \            ack_data = json.loads(raw_payload.decode('utf-8'))\n          \
      \  \n            if self.waiting_for_ack and self.current_pkt:\n           \
      \     if ack_data.get(\"type\") == \"ACK\" and ack_data.get(\"ack_seq\") ==\
      \ self.current_pkt.get(\"seq\"):\n                    # ACK matched, clear current\
      \ transmission state\n                    self.waiting_for_ack = False\n   \
      \                 self.current_pkt = None\n        except Exception:\n     \
      \       pass\n\n    def poll_msg_file(self):\n        \"\"\" Ingests JSON packets\
      \ into Priority Queue \"\"\"\n        try:\n            if not gr.os.path.exists(self.msg_file):\n\
      \                return\n            with open(self.msg_file, 'r+') as f:\n\
      \                content = f.read().strip()\n                if content:\n \
      \                   data = json.loads(content)\n                    packets\
      \ = data if isinstance(data, list) else [data]\n                    for pkt\
      \ in packets:\n                        prio = pkt.get(\"priority\", 2)\n   \
      \                     self.counter += 1\n                        # PriorityQueue\
      \ pops lowest numerical priority value first (1 = High, 2 = Low)\n         \
      \               self.tx_queue.put((prio, self.counter, pkt))\n             \
      \       f.seek(0)\n                    f.truncate()\n        except Exception:\n\
      \            pass\n\n    def worker_loop(self):\n        while self.running:\n\
      \            self.poll_msg_file()\n            now = time.time()\n\n       \
      \     if self.waiting_for_ack:\n                # Retransmit if timeout elapsed\n\
      \                if now - self.last_tx_time > self.timeout:\n              \
      \      self.send_frame(self.current_pkt)\n            else:\n              \
      \  # Pop highest priority packet from queue\n                if not self.tx_queue.empty():\n\
      \                    prio, count, pkt = self.tx_queue.get()\n              \
      \      self.current_pkt = pkt\n                    self.waiting_for_ack = True\n\
      \                    self.send_frame(pkt)\n\n            time.sleep(0.05)\n\n\
      \    def send_frame(self, pkt):\n        try:\n            dest = pkt.get(\"\
      dest\", \"B1\")\n            raw_bytes = json.dumps(pkt).encode('utf-8')\n \
      \           encrypted_payload = self.cipher.encrypt(raw_bytes)\n\n         \
      \   # Build Header: Src (2 bytes) + Dest (2 bytes) + Encrypted Payload\n   \
      \         header = self.my_addr.encode('utf-8')[:2] + dest.encode('utf-8')[:2]\n\
      \            frame = header + encrypted_payload\n\n            # Emit PMT message\n\
      \            pmt_msg = pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(frame), list(frame)))\n\
      \            self.message_port_pub(pmt.intern(\"out\"), pmt_msg)\n         \
      \   self.last_tx_time = time.time()\n        except Exception:\n           \
      \ pass\n\n    def stop(self):\n        self.running = False\n        return\
      \ True\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    msg_file: '"/tmp/nodeA_tx.json"'
    my_addr: '''A1'''
    shared_key: shared_key
  states:
    _io_cache: '(''MAC ARQ Source'', ''mac_arq_source'', [(''msg_file'', "''/tmp/nodeA_tx.json''"),
      (''my_addr'', "''A1''"), (''shared_key'', "''Q0ZfOGE3UFRidWk1N3FYYXpWbDV5UTlwMldHNUFZN00=''")],
      [(''ack_in'', ''message'', 1)], [(''out'', ''message'', 1)], ''\nMAC ARQ Source:
      Priority-based frame transmission with AES-Fernet Encryption\nand Stop-and-Wait
      Retransmission.\n'', [''msg_file'', ''my_addr''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [64, 668.0]
    rotation: 0
    state: enabled
