- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass\
      \ blk(gr.basic_block):\n    \"\"\"Prints PDU payloads as readable ASCII text\"\
      \"\"\n\n    def __init__(self):\n        gr.basic_block.__init__(\n        \
      \    self,\n            name='Plain Text Printer',\n            in_sig=None,\n\
      \            out_sig=None\n        )\n        self.message_port_register_in(pmt.intern('pdu_in'))\n\
      \        self.set_msg_handler(pmt.intern('pdu_in'), self.handle_msg)\n\n   \
      \ def handle_msg(self, msg):\n        if pmt.is_pair(msg):\n            data_pmt\
      \ = pmt.cdr(msg)\n            try:\n                # Extract the raw bytes\
      \ from the packet\n                raw_bytes = bytes(pmt.u8vector_elements(data_pmt))\n\
      \                \n                # Strip off the last 4 bytes (which is the\
      \ CRC32 checksum math)\n                text_bytes = raw_bytes[:-4]\n      \
      \          \n                # Decode the remaining bytes into readable English\
      \ text\n                text = text_bytes.decode('utf-8', errors='ignore')\n\
      \                \n                # Print a clean, formatted message to the\
      \ console\n                print(f\"\\nSUCCESS! RECEIVED MESSAGE: {text}\\n\"\
      )\n            except Exception as e:\n                print(\"Could not decode\
      \ text:\", e)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Plain Text Printer', 'blk', [], [('pdu_in', 'message', 1)], [], 'Prints
      PDU payloads as readable ASCII text', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2704, 136.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0
